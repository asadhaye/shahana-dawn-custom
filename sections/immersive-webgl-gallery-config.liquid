      ]
    },
    {
      "name": "t:sections.immersive_webgl_gallery.presets.narrative_story.name",
      "settings": {
        "room_key": "occasions",
        "layout": "narrative-story",
        "max_items": 8,
        "draggable": true,
        "physics": false,
        "shader_effects": true,
        "parallax_strength": 0
      },
      "blocks": [
        { "type": "gallery_item", "settings": { "title": "Narrative Chapter" } },
        { "type": "gallery_item", "settings": { "title": "Narrative Chapter" } },
        { "type": "gallery_item", "settings": { "title": "Narrative Chapter" } }
      ]
    },
    {
      "name": "t:sections.immersive_webgl_gallery.presets.codex_list.name",
