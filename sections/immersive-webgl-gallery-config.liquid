{% comment %}
  Immersive WebGL Gallery Config Section
  Allows merchants to configure WebGL gallery layouts for specific rooms.
  Supports all 9 layouts from LAYOUT_REGISTRY:
  - asymmetric-gallery, scroll-narrative, masonry-featured
  - infinite-drag-gallery, scroll-story, scroll-tunnel
  - narrative-story, codex-list, artifact-gallery
{% endcomment %}

<section
  id="immersive-webgl-gallery-{{ section.id }}"
  class="immersive-webgl-gallery-config"
  data-immersive-webgl-gallery-config
  data-section-id="{{ section.id }}"
  data-room-key="{{ section.settings.room_key | escape }}"
  data-layout="{{ section.settings.layout | escape }}"
  {% unless request.design_mode %}hidden{% endunless %}
  {% unless request.design_mode %}aria-hidden="true"{% endunless %}
>
  {%- for block in section.blocks -%}
    <div
      class="immersive-webgl-gallery-config__item"
      data-gallery-index="{{ forloop.index0 }}"
      data-gallery-room="{{ section.settings.room_key | escape }}"
      data-gallery-title="{{ block.settings.title | escape }}"
      data-gallery-subtitle="{{ block.settings.subtitle | escape }}"
      data-gallery-product-handle="{% if block.settings.product %}{{ block.settings.product.handle | escape }}{% endif %}"
      data-gallery-collection-handle="{% if block.settings.collection %}{{ block.settings.collection.handle | escape }}{% endif %}"
      {{ block.shopify_attributes }}
      {% unless request.design_mode %}hidden{% endunless %}
    >
      {%- if block.settings.image != blank -%}
        <img
          class="immersive-webgl-gallery-config__img"
          src="{{ block.settings.image | image_url: width: 1920, format: 'webp', quality: 75 }}"
          width="{{ block.settings.image.width | default: 1920 }}"
          height="{{ block.settings.image.height | default: 1080 }}"
          alt="{{ block.settings.title | escape }}"
          hidden
        >
      {%- endif -%}
    </div>
  {%- endfor -%}
</section>

{%- if section.settings.layout == 'asymmetric-gallery' -%}
  {% comment %} Ghost Grid: invisible CSS Grid that computes responsive masonry packing.
      Rendered OUTSIDE the hidden <section> so the browser computes its layout
      (display:none on the parent would prevent getBoundingClientRect from working).
      WebGL meshes read getBoundingClientRect() from these items at runtime. {% endcomment %}
  <div
    id="ghost-grid-{{ section.id }}"
    class="ghost-grid"
    data-ghost-grid
    data-room-key="{{ section.settings.room_key | escape }}"
    aria-hidden="true"
  >
    {%- for block in section.blocks -%}
      {% assign span_class = 'span-standard' %}
      {% if forloop.index0 == 0 or forloop.index0 == 4 %}{% assign span_class = 'span-hero' %}{% endif %}
      {% if forloop.index0 == 2 or forloop.index0 == 7 %}{% assign span_class = 'span-tall' %}{% endif %}

      <div class="ghost-item {{ span_class }}" data-ghost-index="{{ forloop.index0 }}"></div>
    {%- endfor -%}
  </div>

  {%- comment -%} EDITOR PREVIEW: Visual layout preview in Theme Editor {%- endcomment -%}
  {% if request.design_mode %}
    <div class="editor-preview editor-preview--indrajaal" data-room-key="{{ section.settings.room_key | escape }}">
      <div class="editor-preview__header">
        <span class="editor-preview__label">Indrajaal Grid Preview</span>
        <span class="editor-preview__room">{{ section.settings.room_key | capitalize }}</span>
      </div>
      <div class="editor-preview__grid" style="--grid-cols: 6; --gap: 1.5vw;">
        {%- for block in section.blocks -%}
          {% assign span_class = 'span-standard' %}
          {% if forloop.index0 == 0 or forloop.index0 == 4 %}{% assign span_class = 'span-hero' %}{% endif %}
          {% if forloop.index0 == 2 or forloop.index0 == 7 %}{% assign span_class = 'span-tall' %}{% endif %}
          
          {% if span_class == 'span-hero' %}
            {% assign item_style = 'grid-column: span 3; grid-row: span 3;' %}
          {% elsif span_class == 'span-tall' %}
            {% assign item_style = 'grid-column: span 2; grid-row: span 3;' %}
          {% else %}
            {% assign item_style = 'grid-column: span 2; grid-row: span 2;' %}
          {% endif %}
          
          <div class="editor-preview__item editor-preview__item--{{ span_class }}" style="{{ item_style }}">
            {%- if block.settings.image != blank -%}
              {% assign img_url = block.settings.image | image_url: width: 400 %}
              <img class="editor-preview__img" src="{{ img_url }}" alt="{{ block.settings.title | escape }}" loading="lazy" width="400" height="400">
            {%- else -%}
              <div class="editor-preview__placeholder">{{ block.settings.title | escape | default: 'Item ' | append: forloop.index }}</div>
            {%- endif -%}
            {% if block.settings.title != blank %}
              <div class="editor-preview__title">{{ block.settings.title | escape }}</div>
            {% endif %}
          </div>
        {%- endfor -%}
      </div>
      <style>
        .editor-preview { background: rgba(10,15,30,0.95); border: 1px solid rgba(212,175,55,0.2); border-radius: 8px; padding: 16px; margin-top: 16px; font-family: -apple-system, BlinkMacSystemFont, 'Segoe UI', sans-serif; }
        .editor-preview__header { display: flex; justify-content: space-between; align-items: center; margin-bottom: 12px; padding-bottom: 8px; border-bottom: 1px solid rgba(212,175,55,0.15); }
        .editor-preview__label { font-size: 12px; font-weight: 600; letter-spacing: 0.1em; text-transform: uppercase; color: #d4af37; }
        .editor-preview__room { font-size: 11px; color: rgba(212,175,55,0.6); text-transform: uppercase; letter-spacing: 0.08em; }
        .editor-preview__grid { display: grid; grid-template-columns: repeat(var(--grid-cols), 1fr); gap: var(--gap); min-height: 200px; }
        .editor-preview__item { position: relative; background: rgba(212,175,55,0.08); border: 1px solid rgba(212,175,55,0.15); border-radius: 4px; overflow: hidden; display: flex; flex-direction: column; }
        .editor-preview__item--span-hero { grid-column: span 3; grid-row: span 3; }
        .editor-preview__item--span-tall { grid-column: span 2; grid-row: span 3; }
        .editor-preview__item--span-standard { grid-column: span 2; grid-row: span 2; }
        .editor-preview__img { width: 100%; height: 100%; object-fit: cover; opacity: 0.9; }
        .editor-preview__placeholder { display: flex; align-items: center; justify-content: center; height: 100%; min-height: 80px; color: rgba(212,175,55,0.5); font-size: 12px; text-align: center; padding: 8px; }
        .editor-preview__title { position: absolute; bottom: 0; left: 0; right: 0; background: linear-gradient(transparent, rgba(10,15,30,0.95)); padding: 8px 6px 6px; font-size: 10px; font-weight: 600; color: #d4af37; text-transform: uppercase; letter-spacing: 0.05em; }
        @media (max-width: 768px) { .editor-preview__grid { --grid-cols: 2; --gap: 4vw; } .editor-preview__item--span-hero, .editor-preview__item--span-tall, .editor-preview__item--span-standard { grid-column: span 1 !important; grid-row: auto !important; } }
      </style>
    </div>
  {% endif %}
{%- endif -%}

{% schema %}
{
  "name": "t:sections.immersive_webgl_gallery.name",
  "tag": "section",
  "class": "section",
  "settings": [
    {
      "type": "select",
      "id": "room_key",
      "default": "featured_collections",
      "label": "t:sections.immersive_webgl_gallery.settings.room_key.label",
      "info": "t:sections.immersive_webgl_gallery.settings.room_key.info",
      "options": [
        { "value": "designer_houses", "label": "Designer Houses" },
        { "value": "occasions", "label": "Occasions" },
        { "value": "featured_collections", "label": "Featured Collections" }
      ]
    },
    {
      "type": "select",
      "id": "layout",
      "default": "asymmetric-gallery",
      "label": "t:sections.immersive_webgl_gallery.settings.layout.label",
      "info": "t:sections.immersive_webgl_gallery.settings.layout.info",
      "options": [
        { "value": "asymmetric-gallery", "label": "Asymmetric Gallery" },
        { "value": "scroll-narrative", "label": "Scroll Narrative" },
        { "value": "masonry-featured", "label": "Masonry Featured" },
        { "value": "infinite-drag-gallery", "label": "Infinite Drag Gallery" },
        { "value": "scroll-story", "label": "Scroll Story" },
        { "value": "scroll-tunnel", "label": "Scroll Tunnel" },
        { "value": "narrative-story", "label": "Narrative Story" },
        { "value": "codex-list", "label": "Codex List" },
        { "value": "artifact-gallery", "label": "Artifact Gallery" }
      ]
    },
    {
      "type": "range",
      "id": "max_items",
      "min": 3,
      "max": 24,
      "step": 1,
      "default": 12,
      "label": "Maximum Items",
      "info": "Limit the number of items displayed in this gallery"
    },
    {
      "type": "checkbox",
      "id": "draggable",
      "default": true,
      "label": "Enable Dragging",
      "info": "Allow users to drag the gallery"
    },
    {
      "type": "checkbox",
      "id": "physics",
      "default": true,
      "label": "Enable Physics",
      "info": "Apply inertia and physics to gallery movement"
    },
    {
      "type": "checkbox",
      "id": "shader_effects",
      "default": true,
      "label": "Shader Effects",
      "info": "Enable WebGL shader effects on hover/scroll"
    },
    {
      "type": "range",
      "id": "parallax_strength",
      "min": 0,
      "max": 2,
      "step": 0.1,
      "default": 0.6,
      "label": "Parallax Strength",
      "info": "Intensity of mouse parallax effect"
    }
  ],
  "blocks": [
    {
      "type": "gallery_item",
      "name": "t:sections.immersive_webgl_gallery.blocks.gallery_item.name",
      "limit": 50,
      "settings": [
        {
          "type": "image_picker",
          "id": "image",
          "label": "t:sections.immersive_webgl_gallery.blocks.gallery_item.settings.image.label"
        },
        {
          "type": "text",
          "id": "title",
          "label": "t:sections.immersive_webgl_gallery.blocks.gallery_item.settings.title.label",
          "default": "Title"
        },
        {
          "type": "text",
          "id": "subtitle",
          "label": "t:sections.immersive_webgl_gallery.blocks.gallery_item.settings.subtitle.label",
          "default": "Subtitle"
        },
        {
          "type": "product",
          "id": "product",
          "label": "t:sections.immersive_webgl_gallery.blocks.gallery_item.settings.product.label",
          "info": "t:sections.immersive_webgl_gallery.blocks.gallery_item.settings.product.info"
        },
        {
          "type": "collection",
          "id": "collection",
          "label": "t:sections.immersive_webgl_gallery.blocks.gallery_item.settings.collection.label",
          "info": "t:sections.immersive_webgl_gallery.blocks.gallery_item.settings.collection.info"
        },
        {
          "type": "url",
          "id": "cta_url",
          "label": "t:sections.immersive_webgl_gallery.blocks.gallery_item.settings.cta_url.label"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "t:sections.immersive_webgl_gallery.presets.asymmetric_gallery.name",
      "settings": {
        "room_key": "designer_houses",
        "layout": "asymmetric-gallery",
        "max_items": 12,
        "draggable": true,
        "physics": true,
        "shader_effects": true,
        "parallax_strength": 0.8
      },
      "blocks": [
        { "type": "gallery_item", "settings": { "title": "Designer One" } },
        { "type": "gallery_item", "settings": { "title": "Designer Two" } },
        { "type": "gallery_item", "settings": { "title": "Designer Three" } }
      ]
    },
    {
      "name": "t:sections.immersive_webgl_gallery.presets.scroll_narrative.name",
      "settings": {
        "room_key": "occasions",
        "layout": "scroll-narrative",
        "max_items": 8,
        "draggable": false,
        "physics": false,
        "shader_effects": true,
        "parallax_strength": 0.4
      },
      "blocks": [
        { "type": "gallery_item", "settings": { "title": "Eid Collection" } },
        { "type": "gallery_item", "settings": { "title": "Bridal & Mehndi" } },
        { "type": "gallery_item", "settings": { "title": "Luxury Formals" } }
      ]
    },
    {
      "name": "t:sections.immersive_webgl_gallery.presets.masonry_featured.name",
      "settings": {
        "room_key": "featured_collections",
        "layout": "masonry-featured",
        "max_items": 9,
        "draggable": true,
        "physics": false,
        "shader_effects": true,
        "parallax_strength": 0.6
      },
      "blocks": [
        { "type": "gallery_item", "settings": { "title": "Featured Collection" } },
        { "type": "gallery_item", "settings": { "title": "Summer Pret" } },
        { "type": "gallery_item", "settings": { "title": "Luxury Pret" } }
      ]
    },
    {
      "name": "t:sections.immersive_webgl_gallery.presets.infinite_drag_gallery.name",
      "settings": {
        "room_key": "featured_collections",
        "layout": "infinite-drag-gallery",
        "max_items": 16,
        "draggable": true,
        "physics": true,
        "shader_effects": true,
        "parallax_strength": 0
      },
      "blocks": [
        { "type": "gallery_item", "settings": { "title": "Item One" } },
        { "type": "gallery_item", "settings": { "title": "Item Two" } },
        { "type": "gallery_item", "settings": { "title": "Item Three" } },
        { "type": "gallery_item", "settings": { "title": "Item Four" } }
      ]
    },
    {
      "name": "t:sections.immersive_webgl_gallery.presets.scroll_story.name",
      "settings": {
        "room_key": "designer_houses",
        "layout": "scroll-story",
        "max_items": 12,
        "draggable": true,
        "physics": true,
        "shader_effects": true,
        "parallax_strength": 0
      },
      "blocks": [
        { "type": "gallery_item", "settings": { "title": "Story Item" } },
        { "type": "gallery_item", "settings": { "title": "Story Item" } },
        { "type": "gallery_item", "settings": { "title": "Story Item" } }
      ]
    },
    {
      "name": "t:sections.immersive_webgl_gallery.presets.scroll_tunnel.name",
      "settings": {
        "room_key": "occasions",
