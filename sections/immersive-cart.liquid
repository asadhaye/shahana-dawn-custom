{# Immersive cart shell with polished visuals #}
<section
  class="immersive-cart-shell"
  aria-label="Immersive Cart"
  data-overlay-opacity="{{ section.settings.overlay_opacity | default: 0.65 }}"
  data-panel-background="{{ section.settings.panel_background | default: '#0a0f1e' }}"
  data-title="{{ section.settings.title | default: 'Your Immersive Cart' }}"
  data-close-label="{{ section.settings.close_label | default: 'Close' }}"
>
  <div class="immersive-cart-shell__panel" role="region" aria-label="Cart">
    <header class="immersive-cart-shell__header">
      {%- if section.settings.logo != blank -%}
        <img
          class="immersive-cart-shell__logo"
          src="{{ section.settings.logo | image_url: width: 120 }}"
          alt="{{ shop.name | escape }}"
          width="120"
          height="40"
          style="display:block; margin:0 auto 6px;"
        >
      {%- endif -%}
      <h2 class="immersive-cart-shell__title">{{ section.settings.title | default: 'Your Immersive Cart' }}</h2>
      <button
        class="immersive-cart-shell__close"
        aria-label="{{ section.settings.close_label | default: 'Close' }}"
        data-close-href="/pages/immersive"
        type="button"
      >
        ✕
      </button>
    </header>
    <div class="immersive-cart-shell__content">
      {% section 'main-cart-items' %}
      {% section 'main-cart-footer' %}
    </div>
  </div>
</section>
<script src="{{ 'immersive-cart.js' | asset_url }}" defer="defer"></script>

{% schema %}
{
  "name": "t:sections.immersive_cart.name",
  "settings": [
    {
      "type": "range",
      "id": "overlay_opacity",
      "min": 0,
      "max": 1,
      "step": 0.1,
      "default": 0.6,
      "label": "Overlay opacity"
    },
    {
      "type": "image_picker",
      "id": "logo",
      "label": "Logo"
    },
    {
      "type": "color",
      "id": "panel_background",
      "label": "Panel background color",
      "default": "#0a0f1e"
    },
    {
      "type": "text",
      "id": "title",
      "label": "Cart title",
      "default": "Your Immersive Cart"
    },
    {
      "type": "text",
      "id": "close_label",
      "label": "Close button label",
      "default": "Close"
    }
  ]
}
{% endschema %}
