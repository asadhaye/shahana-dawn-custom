<section
  id="immersive-story-rail-{{ section.id }}"
  class="immersive-story-rail"
  aria-label="{{ 'sections.immersive_story.aria_section_label' | t }}"
  data-immersive-story-rail
  data-section-id="{{ section.id }}"
>
  <div class="immersive-story-rail__inner">
    {%- if section.settings.show_hero -%}
      <header class="immersive-story-rail__hero">
        <div class="immersive-story-rail__hero-copy">
          <p class="immersive-story-rail__hero-eyebrow">
            {%- if section.settings.hero_eyebrow != blank -%}
              {{ section.settings.hero_eyebrow | escape }}
            {%- else -%}
              {{ 'sections.immersive_story.hero_eyebrow_default' | t }}
            {%- endif -%}
          </p>
          <h1 class="immersive-story-rail__hero-title">
            {%- if section.settings.hero_heading != blank -%}
              {{ section.settings.hero_heading | escape }}
            {%- else -%}
              {{ 'sections.immersive_story.hero_heading_default' | t }}
            {%- endif -%}
          </h1>
          <p class="immersive-story-rail__hero-subtitle">
            {%- if section.settings.hero_subheading != blank -%}
              {{ section.settings.hero_subheading | escape }}
            {%- else -%}
              {{ 'sections.immersive_story.hero_subheading_default' | t }}
            {%- endif -%}
          </p>
        </div>

        {%- if section.settings.hero_image -%}
          {%- assign hero_img = section.settings.hero_image | image_url: width: 1600, height: 900 -%}
          <div class="immersive-story-rail__hero-media">
            <img
              src="{{ hero_img }}"
              alt="{{ 'sections.immersive_story.hero_image_alt' | t }}"
              width="1600"
              height="900"
              loading="lazy"
            >
          </div>
        {%- endif -%}
      </header>
    {%- endif -%}

    {%- assign has_chapters = false -%}
    <div class="immersive-story-rail__chapters">
      {%- for block in section.blocks -%}
        {%- case block.type -%}
          {%- when 'intro' -%}
            {%- assign has_chapters = true -%}
            <div
              class="immersive-story-rail__chapter immersive-story-rail__chapter--intro"
              data-story-chapter
              {{ block.shopify_attributes }}
            >
              {%- if block.settings.eyebrow != blank -%}
                <p class="immersive-story-rail__chapter-eyebrow">{{ block.settings.eyebrow | escape }}</p>
              {%- endif -%}
              {%- if block.settings.heading != blank -%}
                <h2 class="immersive-story-rail__chapter-heading">{{ block.settings.heading | escape }}</h2>
              {%- endif -%}
              {%- if block.settings.body != blank -%}
                <div class="immersive-story-rail__chapter-body rte">{{ block.settings.body }}</div>
              {%- endif -%}
            </div>

          {%- when 'journey' -%}
            {%- assign has_chapters = true -%}
            <div
              class="immersive-story-rail__chapter immersive-story-rail__chapter--journey"
              data-story-chapter
              {{ block.shopify_attributes }}
            >
              {%- if block.settings.image -%}
                {%- assign journey_img = block.settings.image | image_url: width: 1200, height: 800 -%}
                <div class="immersive-story-rail__chapter-media">
                  <img
                    src="{{ journey_img }}"
                    alt="{{ block.settings.heading | default: '' | escape }}"
                    width="1200"
                    height="800"
                    loading="lazy"
                  >
                </div>
              {%- endif -%}
              <div class="immersive-story-rail__chapter-content">
                {%- if block.settings.eyebrow != blank -%}
                  <p class="immersive-story-rail__chapter-eyebrow">{{ block.settings.eyebrow | escape }}</p>
                {%- endif -%}
                {%- if block.settings.heading != blank -%}
                  <h2 class="immersive-story-rail__chapter-heading">{{ block.settings.heading | escape }}</h2>
                {%- endif -%}
                {%- if block.settings.body != blank -%}
                  <div class="immersive-story-rail__chapter-body rte">{{ block.settings.body }}</div>
                {%- endif -%}
              </div>
            </div>

          {%- when 'chapter' -%}
            {%- assign has_chapters = true -%}
            <div
              class="immersive-story-rail__chapter immersive-story-rail__chapter--generic"
              data-story-chapter
              {{ block.shopify_attributes }}
            >
              {%- if block.settings.eyebrow != blank -%}
                <p class="immersive-story-rail__chapter-eyebrow">{{ block.settings.eyebrow | escape }}</p>
              {%- endif -%}
              {%- if block.settings.heading != blank -%}
                <h2 class="immersive-story-rail__chapter-heading">{{ block.settings.heading | escape }}</h2>
              {%- endif -%}
              {%- if block.settings.body != blank -%}
                <div class="immersive-story-rail__chapter-body rte">{{ block.settings.body }}</div>
              {%- endif -%}
            </div>

          {%- when 'marquee' -%}
            {%- assign has_chapters = true -%}
            <div
              class="immersive-story-rail__marquee"
              data-story-chapter
              aria-hidden="true"
              {{ block.shopify_attributes }}
            >
              {%- assign marquee_text = block.settings.marquee_text
                | default: 'sections.immersive_story.marquee_label_default'
                | t
              -%}
              <div class="immersive-story-rail__marquee-track" data-marquee-track>
                <span class="immersive-story-rail__marquee-item">{{ marquee_text | escape }}</span>
                <span class="immersive-story-rail__marquee-item" aria-hidden="true">{{ marquee_text | escape }}</span>
                <span class="immersive-story-rail__marquee-item" aria-hidden="true">{{ marquee_text | escape }}</span>
              </div>
            </div>

          {%- when 'closing' -%}
            {%- assign has_chapters = true -%}
            <div
              class="immersive-story-rail__chapter immersive-story-rail__chapter--closing"
              data-story-chapter
              {{ block.shopify_attributes }}
            >
              {%- if block.settings.eyebrow != blank -%}
                <p class="immersive-story-rail__chapter-eyebrow">{{ block.settings.eyebrow | escape }}</p>
              {%- endif -%}
              {%- if block.settings.heading != blank -%}
                <h2 class="immersive-story-rail__chapter-heading">{{ block.settings.heading | escape }}</h2>
              {%- endif -%}
              {%- if block.settings.body != blank -%}
                <div class="immersive-story-rail__chapter-body rte">{{ block.settings.body }}</div>
              {%- endif -%}
              {%- if block.settings.cta_label != blank and block.settings.cta_url != blank -%}
                <a
                  class="immersive-story-rail__chapter-cta"
                  href="{{ block.settings.cta_url }}"
                  data-immersive-bridge
                >
                  {{ block.settings.cta_label | escape }}
                </a>
              {%- endif -%}
            </div>
        {%- endcase -%}
      {%- endfor -%}
    </div>

    {%- unless has_chapters -%}
      <p class="immersive-story-rail__empty">
        {{ 'sections.immersive_story.empty_state' | t }}
      </p>
    {%- endunless -%}
  </div>
</section>

{% stylesheet %}
  .immersive-story-rail {
    position: relative;
    background: #050509;
    color: #f5f5f5;
    overflow: hidden;
  }

  .immersive-story-rail__inner {
    max-width: 72rem;
    margin: 0 auto;
    padding: 0 1.5rem;
  }

  .immersive-story-rail__hero {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 3rem;
    align-items: center;
    padding: 5rem 0 4rem;
    border-bottom: 1px solid rgba(212, 175, 55, 0.12);
    margin-bottom: 4rem;
  }

  .immersive-story-rail__hero-eyebrow {
    font-size: 0.75rem;
    letter-spacing: 0.18em;
    text-transform: uppercase;
    color: #d4af37;
    margin: 0 0 1rem;
  }

  .immersive-story-rail__hero-title {
    font-size: clamp(2rem, 4vw, 3.5rem);
    font-weight: 600;
    letter-spacing: 0.03em;
    line-height: 1.1;
    margin: 0 0 1.25rem;
    color: #f5f5f5;
  }

  .immersive-story-rail__hero-subtitle {
    font-size: 1rem;
    line-height: 1.7;
    opacity: 0.7;
    max-width: 36rem;
    margin: 0;
  }

  .immersive-story-rail__hero-media {
    border-radius: 0.75rem;
    overflow: hidden;
    aspect-ratio: 16 / 9;
  }

  .immersive-story-rail__hero-media img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    display: block;
  }

  .immersive-story-rail__chapters {
    display: flex;
    flex-direction: column;
    gap: 5rem;
    padding-bottom: 5rem;
  }

  [data-story-chapter] {
    opacity: 0;
    transform: translateY(2.5rem);
    transition: opacity 0.7s ease, transform 0.7s ease;
  }

  [data-story-chapter].is-visible {
    opacity: 1;
    transform: translateY(0);
  }

  .immersive-story-rail__chapter--intro {
    max-width: 52rem;
  }

  .immersive-story-rail__chapter--journey {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 3rem;
    align-items: center;
  }

  .immersive-story-rail__chapter-media {
    border-radius: 0.75rem;
    overflow: hidden;
    aspect-ratio: 3 / 2;
  }

  .immersive-story-rail__chapter-media img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    display: block;
  }

  .immersive-story-rail__chapter--generic {
    max-width: 52rem;
  }

  .immersive-story-rail__chapter--closing {
    text-align: center;
    max-width: 44rem;
    margin: 0 auto;
    padding: 3rem 0;
    border-top: 1px solid rgba(212, 175, 55, 0.12);
  }

  .immersive-story-rail__chapter-eyebrow {
    font-size: 0.75rem;
    letter-spacing: 0.16em;
    text-transform: uppercase;
    color: #d4af37;
    margin: 0 0 0.75rem;
  }

  .immersive-story-rail__chapter-heading {
    font-size: clamp(1.5rem, 3vw, 2.5rem);
    font-weight: 600;
    letter-spacing: 0.03em;
    line-height: 1.15;
    margin: 0 0 1.25rem;
    color: #f5f5f5;
  }

  .immersive-story-rail__chapter-body {
    font-size: 1rem;
    line-height: 1.75;
    opacity: 0.75;
    max-width: 44rem;
  }

  .immersive-story-rail__chapter-body p {
    margin: 0 0 1em;
  }

  .immersive-story-rail__chapter-body p:last-child {
    margin-bottom: 0;
  }

  .immersive-story-rail__chapter-cta {
    display: inline-block;
    margin-top: 2rem;
    padding: 0.75rem 2rem;
    border: 1px solid rgba(212, 175, 55, 0.6);
    border-radius: 999px;
    color: #d4af37;
    font-size: 0.875rem;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    text-decoration: none;
    transition: background 0.2s ease, border-color 0.2s ease;
  }

  .immersive-story-rail__chapter-cta:hover {
    background: rgba(212, 175, 55, 0.12);
    border-color: #d4af37;
  }

  .immersive-story-rail__chapter-cta:focus-visible {
    outline: 2px solid #d4af37;
    outline-offset: 3px;
  }

  .immersive-story-rail__marquee {
    overflow: hidden;
    padding: 1.5rem 0;
    border-top: 1px solid rgba(212, 175, 55, 0.1);
    border-bottom: 1px solid rgba(212, 175, 55, 0.1);
    opacity: 0;
    transform: translateY(2.5rem);
    transition: opacity 0.7s ease, transform 0.7s ease;
  }

  .immersive-story-rail__marquee.is-visible {
    opacity: 1;
    transform: translateY(0);
  }

  .immersive-story-rail__marquee-track {
    display: flex;
    gap: 3rem;
    white-space: nowrap;
    animation: story-marquee 18s linear infinite;
  }

  .immersive-story-rail__marquee-item {
    font-size: clamp(1.25rem, 2.5vw, 2rem);
    font-weight: 600;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: rgba(212, 175, 55, 0.5);
    flex-shrink: 0;
  }

  @keyframes story-marquee {
    from {
      transform: translateX(0);
    }
    to {
      transform: translateX(-33.333%);
    }
  }

  .immersive-story-rail__empty {
    text-align: center;
    opacity: 0.4;
    font-size: 0.9rem;
    padding: 4rem 0;
  }

  @media (prefers-reduced-motion: reduce) {
    [data-story-chapter],
    .immersive-story-rail__marquee {
      opacity: 1;
      transform: none;
      transition: none;
    }

    .immersive-story-rail__marquee-track {
      animation: none;
    }
  }

  @media (max-width: 768px) {
    .immersive-story-rail__inner {
      padding-inline: 1rem;
    }

    .immersive-story-rail__hero {
      grid-template-columns: 1fr;
      padding: 3rem 0 2.5rem;
      gap: 2rem;
    }

    .immersive-story-rail__chapter--journey {
      grid-template-columns: 1fr;
      gap: 1.5rem;
    }

    .immersive-story-rail__chapters {
      gap: 3.5rem;
    }
  }
{% endstylesheet %}

{% javascript %}
  (function () {
    var sections = document.querySelectorAll('[data-immersive-story-rail]');
    if (!sections.length) return;

    var prefersReducedMotion =
      window.matchMedia && window.matchMedia('(prefers-reduced-motion: reduce)').matches;

    function dispatchStoryMode(active) {
      try {
        window.dispatchEvent(
          new CustomEvent('immersive:story-mode-change', {
            detail: { active: active },
            bubbles: false
          })
        );
      } catch (e) {}
    }

    function initStoryRail(section) {
      var chapters = section.querySelectorAll('[data-story-chapter]');
      if (!chapters.length) return;

      var sectionId = section.getAttribute('data-section-id') || null;

      if (prefersReducedMotion) {
        chapters.forEach(function (ch) {
          ch.classList.add('is-visible');
        });
        return;
      }

      if (!('IntersectionObserver' in window)) {
        chapters.forEach(function (ch) {
          ch.classList.add('is-visible');
        });
        return;
      }

      var chapterObserver = new IntersectionObserver(
        function (entries) {
          entries.forEach(function (entry) {
            if (entry.isIntersecting) {
              entry.target.classList.add('is-visible');
              chapterObserver.unobserve(entry.target);
            }
          });
        },
        {
          threshold: 0.15,
          rootMargin: '0px 0px -60px 0px'
        }
      );

      chapters.forEach(function (ch) {
        chapterObserver.observe(ch);
      });

      var sectionObserver = new IntersectionObserver(
        function (entries) {
          entries.forEach(function (entry) {
            dispatchStoryMode(entry.isIntersecting);
          });
        },
        { threshold: 0.4 }
      );
      sectionObserver.observe(section);

      document.addEventListener('shopify:section:select', function (e) {
        if (!e.detail || !sectionId) return;
        if (e.detail.sectionId !== sectionId) return;

        chapters.forEach(function (ch) {
          ch.classList.add('is-visible');
        });
        dispatchStoryMode(true);
      });

      document.addEventListener('shopify:section:deselect', function (e) {
        if (!e.detail || !sectionId) return;
        if (e.detail.sectionId !== sectionId) return;

        dispatchStoryMode(false);
      });
    }

    sections.forEach(function (section) {
      initStoryRail(section);
    });

    document.addEventListener('shopify:section:load', function (event) {
      var loadedSection =
        event.target && event.target.querySelector('[data-immersive-story-rail]');
      if (loadedSection) {
        initStoryRail(loadedSection);
      }
    });
  })();
{% endjavascript %}

