{% comment %}
  SHAHANA COLLECTION - IMMERSIVE CANVAS SECTION
  WebGL scroll-driven experience using Three.js and Lenis
  Follows Shopify best practices with {% javascript %} tags
{% endcomment %}

<section 
  id="immersive-canvas-{{ section.id }}" 
  class="immersive-canvas-section"
  data-section-id="{{ section.id }}"
  data-section-type="immersive-canvas"
>
  
  <!-- Sticky canvas wrapper -->
  <div class="canvas-wrapper" style="position: sticky; top: 0; width: 100vw; height: 100vh; overflow: hidden; background: #000;">
    
    <!-- Canvas Two: The Lounge Reveal (bottom layer) -->
    <canvas 
      id="canvas-two-{{ section.id }}" 
      class="immersive-canvas immersive-canvas-two"
      style="position: absolute; top: 0; left: 0; z-index: 1;"
    ></canvas>
    
    <!-- Canvas One: The Exterior Dissolve (top layer) -->
    <canvas 
      id="canvas-one-{{ section.id }}" 
      class="immersive-canvas immersive-canvas-one"
      style="position: absolute; top: 0; left: 0; z-index: 2; pointer-events: none;"
    ></canvas>
    
    <!-- UI Layer for hotspots and interactions -->
    <div class="ui-layer" style="position: absolute; top: 0; left: 0; width: 100%; height: 100%; z-index: 10; pointer-events: none;">
      
      {% for block in section.blocks %}
        {% case block.type %}
          {% when 'hotspot' %}
            <div 
              class="hotspot" 
              data-collection="{{ block.settings.collection }}"
              data-block-id="{{ block.id }}"
              style="position: absolute; top: {{ block.settings.position_top }}%; left: {{ block.settings.position_left }}%;"
              {{ block.shopify_attributes }}
            >
              <div class="hotspot-dot"></div>
              <div class="hotspot-label">{{ block.settings.label }}</div>
            </div>
        {% endcase %}
      {% endfor %}

    </div>

  </div>

  <!-- Glass Panel for Product Grid (hidden off-screen) -->
  <aside id="glass-panel-{{ section.id }}" class="glass-panel">
    <button class="close-panel" aria-label="{{ 'sections.immersive_canvas.close_panel' | t }}">
      <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
        <line x1="18" y1="6" x2="6" y2="18"></line>
        <line x1="6" y1="6" x2="18" y2="18"></line>
      </svg>
    </button>
    <div class="panel-content"></div>
  </aside>

</section>

{% stylesheet %}
  .hotspot {
    pointer-events: auto;
    cursor: pointer;
    opacity: 0;
    transform: scale(0.8);
    transition: all 0.4s cubic-bezier(0.34, 1.56, 0.64, 1);
  }

  .hotspot.visible {
    opacity: 1;
    transform: scale(1);
  }

  .hotspot-dot {
    width: 20px;
    height: 20px;
    background: radial-gradient(circle, #d4af37 0%, rgba(212, 175, 55, 0.3) 70%, transparent 100%);
    border: 2px solid #d4af37;
    border-radius: 50%;
    animation: pulse 2s ease-in-out infinite;
  }

  @keyframes pulse {
    0%, 100% { transform: scale(1); opacity: 1; }
    50% { transform: scale(1.2); opacity: 0.7; }
  }

  .hotspot-label {
    position: absolute;
    top: 30px;
    left: 50%;
    transform: translateX(-50%);
    white-space: nowrap;
    color: #d4af37;
    font-size: 11px;
    font-weight: 700;
    letter-spacing: 1.5px;
    text-shadow: 0 2px 8px rgba(0, 0, 0, 0.8);
  }

  .glass-panel {
    position: fixed;
    top: 0;
    right: -100%;
    width: 600px;
    max-width: 100vw;
    height: 100vh;
    background: rgba(0, 0, 0, 0.85);
    backdrop-filter: blur(24px);
    -webkit-backdrop-filter: blur(24px);
    border-left: 1px solid rgba(212, 175, 55, 0.2);
    z-index: 1000;
    overflow-y: auto;
    transition: right 0.6s cubic-bezier(0.34, 1.56, 0.64, 1);
    padding: 40px 30px;
  }

  .glass-panel.open {
    right: 0;
  }

  .close-panel {
    position: absolute;
    top: 20px;
    right: 20px;
    width: 40px;
    height: 40px;
    background: rgba(212, 175, 55, 0.1);
    border: 1px solid rgba(212, 175, 55, 0.3);
    border-radius: 50%;
    cursor: pointer;
    display: flex;
    align-items: center;
    justify-content: center;
    transition: all 0.3s ease;
    color: #d4af37;
  }

  .close-panel:hover {
    background: rgba(212, 175, 55, 0.2);
    transform: rotate(90deg);
  }

  .canvas-wrapper.blurred {
    filter: blur(8px);
    transition: filter 0.6s ease;
  }
{% endstylesheet %}

{% javascript %}
  class ImmersiveCanvas {
    constructor(section) {
      this.section = section;
      this.sectionId = section.dataset.sectionId;
      this.scrollProgress = 0;
      this.time = 0;
      this.initialized = false;
      
      this.init();
    }
    
    init() {
      console.log('🎨 Initializing Immersive Canvas Section:', this.sectionId);
      
      // Wait for immersive:ready event or check if already ready
      if (window.THREE && window.Lenis && window.lenis) {
        this.onReady();
      } else {
        document.addEventListener('immersive:ready', () => this.onReady(), { once: true });
      }
    }
    
    onReady() {
      if (this.initialized) return;
      this.initialized = true;
      
      console.log('✅ Libraries ready, initializing WebGL...');
      
      this.initWebGL();
      this.initHotspots();
      this.initGlassPanel();
      this.startAnimation();
    }
    
    initWebGL() {
      const canvasOne = document.getElementById(`canvas-one-${this.sectionId}`);
      const canvasTwo = document.getElementById(`canvas-two-${this.sectionId}`);
      
      if (!canvasOne || !canvasTwo) {
        console.error('Canvas elements not found');
        return;
      }
      
      const THREE = window.THREE;
      const width = window.innerWidth;
      const height = window.innerHeight;
      
      // Initialize renderers
      this.rendererOne = new THREE.WebGLRenderer({
        canvas: canvasOne,
        alpha: true,
        antialias: true
      });
      this.rendererOne.setSize(width, height);
      this.rendererOne.setPixelRatio(Math.min(window.devicePixelRatio, 2));
      
      this.rendererTwo = new THREE.WebGLRenderer({
        canvas: canvasTwo,
        alpha: false,
        antialias: true
      });
      this.rendererTwo.setSize(width, height);
      this.rendererTwo.setPixelRatio(Math.min(window.devicePixelRatio, 2));
      
      // Create scenes and cameras
      this.sceneOne = new THREE.Scene();
      this.sceneTwo = new THREE.Scene();
      
      const aspect = width / height;
      this.cameraOne = new THREE.OrthographicCamera(-aspect, aspect, 1, -1, 0.1, 10);
      this.cameraOne.position.z = 1;
      
      this.cameraTwo = new THREE.OrthographicCamera(-aspect, aspect, 1, -1, 0.1, 10);
      this.cameraTwo.position.z = 1;
      
      // Load textures
      const textureLoader = new THREE.TextureLoader();
      const baseImageUrl = window.IMMERSIVE_ASSETS?.baseImage || '';
      const depthImageUrl = window.IMMERSIVE_ASSETS?.depthImage || '';
      
      console.log('🖼️ Loading textures...');
      
      const textureOne = textureLoader.load(baseImageUrl, () => console.log('✅ Texture 1 loaded'));
      const textureTwo = textureLoader.load(baseImageUrl, () => console.log('✅ Texture 2 loaded'));
      const depthMap = textureLoader.load(depthImageUrl, () => console.log('✅ Depth map loaded'));
      
      // Create simple materials for now (shaders will be added later)
      const geometry = new THREE.PlaneGeometry(2, 2);
      
      this.materialOne = new THREE.MeshBasicMaterial({
        map: textureOne,
        transparent: true,
        opacity: 1
      });
      
      this.materialTwo = new THREE.MeshBasicMaterial({
        map: textureTwo,
        transparent: false
      });
      
      this.meshOne = new THREE.Mesh(geometry, this.materialOne);
      this.meshTwo = new THREE.Mesh(geometry, this.materialTwo);
      
      this.sceneOne.add(this.meshOne);
      this.sceneTwo.add(this.meshTwo);
      
      console.log('✅ WebGL initialized');
      
      // Handle resize
      window.addEventListener('resize', () => this.onResize());
    }
    
    initHotspots() {
      const hotspots = this.section.querySelectorAll('.hotspot');
      hotspots.forEach(hotspot => {
        hotspot.addEventListener('click', (e) => this.handleHotspotClick(e));
      });
      console.log(`🎯 ${hotspots.length} hotspots initialized`);
    }
    
    initGlassPanel() {
      const closeButton = this.section.querySelector('.close-panel');
      if (closeButton) {
        closeButton.addEventListener('click', () => this.closePanel());
      }
    }
    
    handleHotspotClick(e) {
      e.preventDefault();
      const collection = e.currentTarget.dataset.collection;
      console.log(`🔍 Loading collection: ${collection}`);
      
      const wrapper = this.section.querySelector('.canvas-wrapper');
      wrapper.classList.add('blurred');
      
      const panel = document.getElementById(`glass-panel-${this.sectionId}`);
      panel.classList.add('open');
      
      this.loadProducts(collection);
    }
    
    closePanel() {
      const wrapper = this.section.querySelector('.canvas-wrapper');
      const panel = document.getElementById(`glass-panel-${this.sectionId}`);
      
      wrapper.classList.remove('blurred');
      panel.classList.remove('open');
    }
    
    loadProducts(collection) {
      const panelContent = this.section.querySelector('.panel-content');
      panelContent.innerHTML = '<div style="text-align: center; padding: 40px; color: #d4af37;">Loading...</div>';
      
      fetch(`/?section_id=immersive-product-grid&collection=${collection}`)
        .then(response => response.text())
        .then(html => {
          panelContent.innerHTML = html;
          console.log(`✅ Products loaded for: ${collection}`);
        })
        .catch(error => {
          console.error('❌ Error loading products:', error);
          panelContent.innerHTML = '<div style="text-align: center; padding: 40px; color: #d4af37;">Error loading products</div>';
        });
    }
    
    startAnimation() {
      const animate = () => {
        requestAnimationFrame(animate);
        
        // Update scroll progress
        if (window.lenis) {
          window.lenis.raf(Date.now());
          
          const scrollY = window.scrollY || window.pageYOffset;
          const maxScroll = document.documentElement.scrollHeight - window.innerHeight;
          this.scrollProgress = Math.min(Math.max(scrollY / maxScroll, 0), 1);
          
          // Show/hide hotspots
          const hotspots = this.section.querySelectorAll('.hotspot');
          if (this.scrollProgress >= 0.95) {
            hotspots.forEach(h => h.classList.add('visible'));
          } else {
            hotspots.forEach(h => h.classList.remove('visible'));
          }
        }
        
        // Update materials based on scroll
        if (this.materialOne) {
          this.materialOne.opacity = 1 - this.scrollProgress;
        }
        
        this.time += 0.01;
        
        // Render scenes
        if (this.rendererOne && this.sceneOne && this.cameraOne) {
          this.rendererOne.render(this.sceneOne, this.cameraOne);
        }
        
        if (this.rendererTwo && this.sceneTwo && this.cameraTwo) {
          this.rendererTwo.render(this.sceneTwo, this.cameraTwo);
        }
      };
      
      animate();
    }
    
    onResize() {
      const width = window.innerWidth;
      const height = window.innerHeight;
      const aspect = width / height;
      
      if (this.cameraOne) {
        this.cameraOne.left = -aspect;
        this.cameraOne.right = aspect;
        this.cameraOne.updateProjectionMatrix();
      }
      
      if (this.cameraTwo) {
        this.cameraTwo.left = -aspect;
        this.cameraTwo.right = aspect;
        this.cameraTwo.updateProjectionMatrix();
      }
      
      if (this.rendererOne) this.rendererOne.setSize(width, height);
      if (this.rendererTwo) this.rendererTwo.setSize(width, height);
    }
    
    onUnload() {
      // Cleanup
      if (this.rendererOne) this.rendererOne.dispose();
      if (this.rendererTwo) this.rendererTwo.dispose();
      console.log('🧹 Section unloaded');
    }
  }

  // Initialize section
  const section = document.querySelector('[data-section-type="immersive-canvas"]');
  if (section) {
    const instance = new ImmersiveCanvas(section);
    
    // Handle theme editor events
    document.addEventListener('shopify:section:load', function(event) {
      if (event.detail.sectionId === section.dataset.sectionId) {
        new ImmersiveCanvas(section);
      }
    });
    
    document.addEventListener('shopify:section:unload', function(event) {
      if (event.detail.sectionId === section.dataset.sectionId && instance) {
        instance.onUnload();
      }
    });
  }
{% endjavascript %}

{% schema %}
{
  "name": "Immersive Canvas",
  "tag": "section",
  "class": "section-immersive-canvas",
  "settings": [
    {
      "type": "header",
      "content": "Scroll Settings"
    },
    {
      "type": "range",
      "id": "hotspot_trigger",
      "min": 0.5,
      "max": 1.0,
      "step": 0.1,
      "default": 0.9,
      "label": "Hotspot trigger point",
      "info": "When hotspots appear (0.5 = 50% scroll, 1.0 = 100% scroll)"
    }
  ],
  "blocks": [
    {
      "type": "hotspot",
      "name": "Hotspot",
      "settings": [
        {
          "type": "text",
          "id": "label",
          "label": "Label",
          "default": "COLLECTION"
        },
        {
          "type": "collection",
          "id": "collection",
          "label": "Collection"
        },
        {
          "type": "range",
          "id": "position_top",
          "min": 0,
          "max": 100,
          "step": 5,
          "default": 50,
          "label": "Vertical position (%)"
        },
        {
          "type": "range",
          "id": "position_left",
          "min": 0,
          "max": 100,
          "step": 5,
          "default": 50,
          "label": "Horizontal position (%)"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "Immersive Canvas",
      "blocks": [
        {
          "type": "hotspot",
          "settings": {
            "label": "DESIGNER HOUSES",
            "position_top": 35,
            "position_left": 25
          }
        },
        {
          "type": "hotspot",
          "settings": {
            "label": "OCCASIONS",
            "position_top": 50,
            "position_left": 60
          }
        },
        {
          "type": "hotspot",
          "settings": {
            "label": "FEATURED",
            "position_top": 65,
            "position_left": 35
          }
        }
      ]
    }
  ]
}
{% endschema %}
