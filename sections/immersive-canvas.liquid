          placeholder="{{ 'sections.immersive_store.promo_code.placeholder' | t | escape }}"
          autocomplete="off"
          spellcheck="false"
          required
        >
        <button
          type="submit"
          class="immersive-promo-code-overlay__submit"
          aria-label="{{ 'sections.immersive_store.promo_code.apply' | t | escape }}"
        >
          {{ 'sections.immersive_store.promo_code.apply' | t }}
        </button>
      </form>
      <div class="immersive-promo-code-overlay__feedback" data-promo-code-feedback hidden></div>
      {%- if cart.discounts.size > 0 -%}
        <div class="immersive-promo-code-overlay__active" data-promo-code-active>
          <p class="immersive-promo-code-overlay__active-label">
            {{ 'sections.immersive_store.promo_code.active_codes' | t }}
          </p>
          {%- for discount in cart.discounts -%}
            <div class="immersive-promo-code-overlay__active-item">
              <span class="immersive-promo-code-overlay__active-title">{{ discount.title | escape }}</span>
              <span class="immersive-promo-code-overlay__active-amount">-{{ discount.amount | money }}</span>
              <button
                type="button"
                class="immersive-promo-code-overlay__remove"
                data-promo-code-remove="{{ discount.code | escape }}"
                aria-label="{{ 'sections.immersive_store.promo_code.remove' | t: code: discount.title | escape }}"
              >
                &times;
              </button>
            </div>
          {%- endfor -%}
        </div>
      {%- endif -%}
    </div>
    <button
      type="button"
      class="immersive-promo-code-overlay__close"
      aria-label="{{ 'sections.immersive_store.close' | t }}"
    >
      <svg
        width="20"
        height="20"
        viewBox="0 0 24 24"
        fill="none"
        stroke="currentColor"
        stroke-width="2"
        aria-hidden="true"
      >
        <line x1="18" y1="6" x2="6" y2="18"/><line x1="6" y1="6" x2="18" y1="18"/>
      </svg>
    </button>
  </div>

  <!-- Cookie consent banner -->
  <div
    id="immersive-cookie-banner"
    class="immersive-cookie-banner"
    role="dialog"
    aria-modal="true"
    aria-label="{{ 'sections.immersive_store.cookie_banner.aria_label' | t }}"
    hidden
  >
    <p class="immersive-cookie-banner__text">
      {{ 'sections.immersive_store.cookie_banner.text' | t }}
      <a href="{{ pages.privacy-policy.url }}" class="immersive-cookie-banner__learn-more">
        {{- 'sections.immersive_store.cookie_banner.learn_more' | t -}}
      </a>
    </p>

    <div class="immersive-cookie-banner__actions">
      <button
        type="button"
        id="immersive-cookie-accept"
        class="immersive-cookie-banner__btn immersive-cookie-banner__btn--accept"
      >
        {{ 'sections.immersive_store.cookie_banner.accept' | t }}
      </button>
      <button
        type="button"
        id="immersive-cookie-decline"
        class="immersive-cookie-banner__btn immersive-cookie-banner__btn--decline"
      >
        {{ 'sections.immersive_store.cookie_banner.decline' | t }}
      </button>
    </div>
  </div>
</section>

{% stylesheet %}
  /* ============================================================================ 1. BASE LAYOUT & CANVAS
  ============================================================================ */
  .immersive-store {
    position: relative;
    height: 100vh;
    padding: 0;
    overflow: hidden;
  }

  .immersive-store__tagline {
    position: absolute;
    bottom: 6rem;
    left: 50%;
    transform: translateX(-50%);
    text-align: center;
    z-index: 50;
    pointer-events: none;
    white-space: nowrap;
    opacity: 0;
    transition: opacity 0.4s ease;
  }

  .immersive-store__tagline.is-visible {
    opacity: 1;
  }

  .immersive-store__tagline p {
    font-size: 1.5rem;
    color: rgba(255, 255, 255, 0.9);
    margin: 0;
    text-shadow: 0 2px 12px rgba(0, 0, 0, 0.7);
    letter-spacing: 0.05em;
    font-weight: 500;
  }

  @media (max-width: 768px) {
    .immersive-store__tagline {
      bottom: 5rem;
    }
    .immersive-store__tagline p {
      font-size: 1.25rem;
    }
  }

  .immersive-store__canvas-wrapper {
    position: sticky;
    top: 0;
    width: 100%;
    height: 100vw;
    left: 0;
    transform: none;
    height: 100vh;
    min-height: 500px;
    overflow: hidden;
    background: #f4f4f4;
    background: #000;
    z-index: 2;
  }

  /* Keep immersive viewport below the fixed notification bar */
  body:has([data-immersive-notif-bar]) .immersive-store__canvas-wrapper,
  body.has-immersive-notif-bar .immersive-store__canvas-wrapper {
    top: var(--notif-height, 48px);
    height: calc(100vh - var(--notif-height, 48px));
  }

  #immersive-canvas {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    display: block;
    /* Ensure canvas matches wrapper width and handles scrollbar correctly */
    max-width: 100vw;
    left: 0;
    /* Prevent native mobile gestures (pull-to-refresh, scroll, bounce) */
    touch-action: none;
    -webkit-overflow-scrolling: touch;
    -webkit-touch-callout: none;
    -webkit-user-select: none;
    user-select: none;
  }

  /* -------------------------------------------------------------------------- */
  /* INITIAL LOADER — DOM overlay shown until Three.js renders the first room   */
  /* -------------------------------------------------------------------------- */
  .immersive-initial-loader {
    position: absolute;
    inset: 0;
    z-index: 10;
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    background: #000;
    transition: opacity 0.35s ease;
    opacity: 1;
  }

  .immersive-initial-loader.is-hidden {
    opacity: 0;
    pointer-events: none;
  }

  .immersive-initial-loader__logo {
    width: 180px;
    height: auto;
    max-height: 240px;
    margin-bottom: 2rem;
    opacity: 0;
    object-fit: contain;
    filter: drop-shadow(0 4px 24px rgba(0, 0, 0, 0.15));
    animation: immersive-loader-logo-in 0.6s ease 0.15s forwards;
  }

  @keyframes immersive-loader-logo-in {
    from {
      opacity: 0;
      transform: scale(0.92);
    }
    to {
      opacity: 1;
      transform: scale(1);
    }
  }

  .immersive-initial-loader__spinner {
    width: 32px;
    height: 32px;
    border: 2px solid rgba(212, 175, 55, 0.2);
    border-top-color: #d4af37;
    border-radius: 50%;
    animation: immersive-loader-spin 0.8s linear infinite;
  }

  @keyframes immersive-loader-spin {
    to {
      transform: rotate(360deg);
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .immersive-initial-loader.is-hidden {
      transition: none;
      opacity: 0;
    }

    .immersive-initial-loader__logo {
      animation: none;
      opacity: 1;
    }

    .immersive-initial-loader__spinner {
      animation: none;
      opacity: 0;
    }
  }

  /* ── Header center: logo + search ── */
  .immersive-header__center {
    display: flex;
    align-items: center;
    gap: 1rem;
    flex: 0 1 auto;
    min-width: 0;
  }
  .immersive-header__logo-btn {
    display: flex;
    align-items: center;
    justify-content: center;
    background: none;
    border: none;
    padding: 0;
    cursor: pointer;
    opacity: 0.85;
    transition: opacity 0.3s ease;
    flex-shrink: 0;
  }
  .immersive-header__logo-btn:hover {
    opacity: 1;
  }
  .immersive-header__logo-img {
    display: block;
    height: 40px;
    width: auto;
    max-width: 120px;
    object-fit: contain;
    filter: drop-shadow(0 0 8px rgba(212, 175, 55, 0.4));
  }

  @media (max-width: 768px) {
    .immersive-header__logo-img {
      height: 32px;
      max-width: 90px;
    }
  }

  /* ============================================================================ 2. UI LAYER & HOTSPOTS
  ============================================================================ */
  #ui-layer {
    position: absolute;
    inset: 0;
    pointer-events: none;
  }

  #ui-layer .immersive-hotspot {
    pointer-events: auto;
    position: absolute;
    padding: 0;
    border-radius: 0;
    border: none;
    outline: none;
    appearance: none;
    -webkit-appearance: none;
    background: transparent;
    color: transparent;
    backdrop-filter: none;
    -webkit-backdrop-filter: none;
    cursor: pointer;
    font: inherit;
    font-size: 0;
    min-width: 120px;
    min-height: 64px;
    transition: box-shadow 200ms ease-out, background-color 200ms ease-out;
  }

  #ui-layer .immersive-hotspot::after {
    content: '';
    position: absolute;
    bottom: 4px;
    left: 10%;
    width: 80%;
    height: 1.5px;
    background: rgba(255, 255, 255, 0.6);
    border-radius: 1px;
    transition: background 200ms ease-out, width 200ms ease-out, left 200ms ease-out;
  }

  #ui-layer .immersive-hotspot:focus-visible {
    outline: 2px solid rgba(212, 175, 55, 0.8);
    outline-offset: 3px;
  }

  #ui-layer .immersive-hotspot:hover {
    transform: translate(-50%, -50%) scale(1.05);
    background: rgba(212, 175, 55, 0.06);
    box-shadow: 0 0 18px 4px rgba(212, 175, 55, 0.2);
  }

  #ui-layer .immersive-hotspot:hover::after {
    background: rgba(212, 175, 55, 1);
    left: 0;
    width: 100%;
  }

  /* ── Infinite Gallery hover label ── */
  #ui-layer .infinite-gallery-label {
    position: absolute;
    bottom: 6rem;
    left: 50%;
    transform: translateX(-50%);
    padding: 0.5rem 1.25rem;
    background: rgba(0, 0, 0, 0.65);
    backdrop-filter: blur(8px);
    -webkit-backdrop-filter: blur(8px);
    border: 1px solid rgba(212, 175, 55, 0.3);
    border-radius: 4px;
    color: #d4af37;
    font-family: serif;
    font-size: 0.875rem;
    letter-spacing: 0.05em;
    pointer-events: none;
    white-space: nowrap;
    z-index: 30;
  }

  @media (prefers-reduced-motion: reduce) {
    #ui-layer .immersive-hotspot,
    #ui-layer .immersive-hotspot::after {
      transition: none;
    }
  }

  /* ============================================================================ 3. FIXED HEADER — frosted glass top bar
  (dark, immersive) ============================================================================ */
  .immersive-header {
    position: fixed;
    top: 0;
    left: 0;
    width: 100%;
    height: 72px;
    padding: 0 1.5rem;
    display: flex;
    justify-content: space-between;
    align-items: center;
    z-index: 310;
    background: linear-gradient(to bottom, rgba(8, 6, 2, 0.82) 0%, rgba(8, 6, 2, 0.65) 70%, rgba(8, 6, 2, 0) 100%);
    backdrop-filter: blur(14px) saturate(1.2);
    -webkit-backdrop-filter: blur(14px) saturate(1.2);
    border-bottom: none;
    box-shadow: 0 2px 32px rgba(0, 0, 0, 0.35);
    --header-bottom-position: 72px;
  }

  .immersive-header__left,
  .immersive-header__right {
    display: flex;
    align-items: center;
    gap: 0.5rem;
  }

  /* All icon buttons — gold on dark frosted background */
  .immersive-header__icon-btn {
    display: flex;
    align-items: center;
    justify-content: center;
    background: transparent;
    color: #d4af37;
    border: none;
    padding: 0.5rem;
    border-radius: 4px;
    cursor: pointer;
    transition: color 0.2s ease, background 0.2s ease;
    text-decoration: none;
    position: relative;
  }

  .immersive-header__icon-btn:hover {
    color: #e8c84a;
    background: rgba(212, 175, 55, 0.12);
  }

  .immersive-header__icon-btn:focus-visible {
    outline: 2px solid #d4af37;
    outline-offset: 2px;
  }

  /* Back button — navigation history */
  .immersive-back-btn {
    opacity: 1;
    transition: opacity 0.2s ease, color 0.2s ease, background 0.2s ease, transform 0.15s ease;
  }

  .immersive-back-btn:hover:not(:disabled) {
    color: #e8c84a;
    background: rgba(212, 175, 55, 0.12);
    transform: scale(1.05);
  }

  .immersive-back-btn:disabled {
    opacity: 0.3;
    cursor: not-allowed;
    pointer-events: none;
  }

  .immersive-back-btn[hidden] {
    display: none;
  }

  .immersive-back-btn:focus-visible {
    outline: 2px solid #d4af37;
    outline-offset: 2px;
  }

  /* Mobile: smaller size for touch */
  @media (max-width: 768px) {
    .immersive-back-btn {
      width: 2.25rem;
      height: 2.25rem;
      padding: 0.4rem;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .immersive-back-btn {
      transition: none;
      transform: none !important;
    }
  }

  /* Menu hamburger icon — force gold always, override Dawn globals */
  .immersive-header .header__icon--menu,
  .immersive-header .header__icon--summary,
  .immersive-header .header__icon--menu.link,
  .immersive-header .header__icon--summary.link {
    color: #d4af37 !important;
    background: transparent;
    border: none;
    padding: 0.5rem;
    cursor: pointer;
    display: flex;
    align-items: center;
    justify-content: center;
    border-radius: 4px;
    transition: color 0.2s ease, background 0.2s ease;
    list-style: none;
  }

  .immersive-header .header__icon--menu::-webkit-details-marker,
  .immersive-header .header__icon--summary::-webkit-details-marker {
    display: none;
  }

  .immersive-header .header__icon--menu:hover,
  .immersive-header .header__icon--summary:hover {
    color: #e8c84a !important;
    background: rgba(212, 175, 55, 0.12);
  }

  .immersive-header .header__icon--menu svg,
  .immersive-header .header__icon--summary svg {
    stroke: currentColor !important;
    fill: none;
  }

  /* Show hamburger, hide close by default; swap when drawer is open */
  .immersive-header .icon-close {
    display: none;
  }
  .immersive-header .menu-drawer-container[open] .icon-hamburger {
    display: none;
  }
  .immersive-header .menu-drawer-container[open] .icon-close {
    display: block;
  }

  /* Cart badge */
  .immersive-header__cart-badge {
    position: absolute;
    top: 2px;
    right: 2px;
    min-width: 16px;
    height: 16px;
    padding: 0 3px;
    background: #d4af37;
    color: #000;
    font-size: 0.6rem;
    font-weight: 700;
    border-radius: 999px;
    display: flex;
    align-items: center;
    justify-content: center;
    line-height: 1;
  }

  /* Tilt toggle button — mobile-only experiment */
  .immersive-tilt-toggle {
    position: relative;
  }

  .immersive-tilt-toggle[aria-pressed='true'] {
    background: rgba(212, 175, 55, 0.2);
    box-shadow: 0 0 8px rgba(212, 175, 55, 0.4);
  }

  .immersive-tilt-toggle[aria-pressed='true'] svg {
    fill: rgba(212, 175, 55, 0.3);
    stroke: #d4af37;
  }

  /* Hide tilt toggle on desktop (mobile-only feature) */
  @media (min-width: 769px) {
    .immersive-tilt-toggle {
      display: none;
    }
  }

  /* Tablet: shrink padding slightly */
  @media (max-width: 768px) {
    .immersive-header__mode-switch {
      padding: 0.4rem 0.7rem;
      font-size: 0.68rem;
    }
  }

  /* Mobile: icon-only, larger tap target */
  @media (max-width: 480px) {
    .immersive-header__mode-switch {
      padding: 0.5rem;
      min-width: 36px;
      min-height: 36px;
      justify-content: center;
      border-radius: 50%;
    }
    .immersive-header__mode-switch-label {
      display: none;
    }
    .immersive-header__mode-switch svg {
      width: 18px;
      height: 18px;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .immersive-header__mode-switch {
      transition: none;
    }
  }

  /* Offset the canvas so it starts below both header + announcement bar */
  .immersive-store__canvas-wrapper {
    padding-top: 0;
  }

  @media (max-width: 768px) {
    .immersive-header {
      padding: 0 0.75rem;
      height: 60px;
    }

    /* ============================================================================ 3b-search. DAWN HEADER SEARCH —
  immersive overrides ============================================================================ */

    /* Search trigger button — match other icon buttons */
    .immersive-header .header__icon--search {
      display: flex;
      align-items: center;
      justify-content: center;
      background: transparent;
      color: #d4af37;
      border: none;
      padding: 0.5rem;
      border-radius: 4px;
      cursor: pointer;
      transition: color 0.2s ease, background 0.2s ease;
      width: 40px;
      height: 40px;
      margin: 0;
      text-decoration: none;
    }

    .immersive-header .header__icon--search:hover {
      color: #e8c84a;
      background: rgba(212, 175, 55, 0.12);
    }

    .immersive-header .header__icon--search:focus-visible {
      outline: 2px solid #d4af37;
      outline-offset: 2px;
    }

    /* Search modal — dark immersive style */
    .immersive-header .search-modal {
      background: rgba(10, 15, 30, 0.97);
      backdrop-filter: blur(20px);
      -webkit-backdrop-filter: blur(20px);
      border-bottom: 1px solid rgba(212, 175, 55, 0.2);
    }

    .immersive-header .search__input,
    .immersive-header .field__input {
      background: rgba(255, 255, 255, 0.06) !important;
      color: #d4af37 !important;
      border-color: rgba(212, 175, 55, 0.4) !important;
      caret-color: #d4af37;
    }

    .immersive-header .field__input::placeholder,
    .immersive-header .field__label {
      color: rgba(212, 175, 55, 0.5) !important;
    }

    .immersive-header .field__input:focus {
      border-color: #d4af37 !important;
    }

    .immersive-header .search__button,
    .immersive-header .reset__button {
      color: rgba(212, 175, 55, 0.7) !important;
    }

    .immersive-header .search-modal__close-button {
      color: rgba(212, 175, 55, 0.7) !important;
    }

    .immersive-header .search-modal__close-button:hover {
      color: #d4af37 !important;
    }

    /* Predictive search dropdown */
    .immersive-header .predictive-search {
      background: rgba(10, 15, 30, 0.98) !important;
      border: 1px solid rgba(212, 175, 55, 0.2) !important;
    }

    .immersive-header .predictive-search__item {
      color: #d4af37 !important;
      border-bottom-color: rgba(255, 255, 255, 0.05) !important;
    }

    .immersive-header .predictive-search__item:hover,
    .immersive-header .predictive-search__item--link:hover {
      background: rgba(212, 175, 55, 0.08) !important;
    }

    .immersive-header .predictive-search__item-heading {
      color: #d4af37 !important;
    }

    .immersive-header .predictive-search .price {
      color: rgba(212, 175, 55, 0.8) !important;
    }

    /* ============================================================================ 3c. DAWN HEADER-DRAWER — immersive theme
  overrides ============================================================================ */

    /* Force drawer always visible (Dawn hides it above 990px by default) */
    .immersive-header menu-drawer {
      display: flex !important;
      align-items: center;
    }

    /* Summary trigger — match our icon button style */
    .immersive-header .header__icon--menu {
      display: flex;
      align-items: center;
      justify-content: center;
      background: transparent;
      color: #1a1a1a;
      border: none;
      padding: 0.5rem;
      border-radius: 4px;
      cursor: pointer;
      transition: color 0.2s ease, background 0.2s ease;
      width: 40px;
      height: 40px;
      margin: 0;
      text-decoration: none;
    }

    .immersive-header .header__icon--menu:hover {
      color: #d4af37;
      background: rgba(212, 175, 55, 0.1);
    }

    .immersive-header .header__icon--menu:focus-visible {
      outline: 2px solid #d4af37;
      outline-offset: 2px;
    }

    .immersive-header .header__icon--menu .svg-wrapper svg {
      width: 22px;
      height: 22px;
    }

    /* Drawer panel — dark immersive style */
    .immersive-store #menu-drawer {
      background: rgba(10, 15, 30, 0.97) !important;
      backdrop-filter: blur(20px);
      -webkit-backdrop-filter: blur(20px);
      border-right: 1px solid rgba(212, 175, 55, 0.15);
      top: 72px !important;
    }

    body:has([data-immersive-notif-bar]) .immersive-store #menu-drawer {
      top: calc(var(--notif-height, 48px) + 72px) !important;
    }

    @media (max-width: 768px) {
      .immersive-store #menu-drawer {
        top: 60px !important;
      }
      body:has([data-immersive-notif-bar]) .immersive-store #menu-drawer {
        top: calc(var(--notif-height, 48px) + 60px) !important;
      }
    }

    /* Top-level menu items */
    .immersive-store .menu-drawer__menu-item {
      color: #d4af37 !important;
      font-size: 1rem;
      font-weight: 600;
      letter-spacing: 0.06em;
      text-transform: uppercase;
      border-bottom: 1px solid rgba(255, 255, 255, 0.06) !important;
    }

    .immersive-store .menu-drawer__menu-item:hover {
      color: #fff !important;
    }

    /* Sub-menu panel */
    .immersive-store .menu-drawer__submenu {
      background: rgba(5, 8, 20, 0.98) !important;
    }

    .immersive-store .menu-drawer__submenu .menu-drawer__menu-item {
      font-size: 0.9rem;
      font-weight: 500;
      color: rgba(212, 175, 55, 0.85) !important;
    }

    .immersive-store .menu-drawer__submenu .menu-drawer__menu-item:hover {
      color: #d4af37 !important;
    }

    /* Back button */
    .immersive-store .menu-drawer__close-button {
      color: rgba(255, 255, 255, 0.6) !important;
    }

    .immersive-store .menu-drawer__close-button:hover {
      color: #d4af37 !important;
    }

    /* Arrow/caret icons */
    .immersive-store .menu-drawer__menu-item .svg-wrapper svg {
      fill: rgba(212, 175, 55, 0.6);
    }

    /* mobile drawer handled by the body:has rules above */

    /* ============================================================================ 5. GLASS PANEL - Full Screen Overlay
  ============================================================================ */
    #glass-panel {
      position: fixed;
      top: 0;
      left: 0;
      width: 100vw;
      height: 100vh;
      opacity: 0;
      pointer-events: none;
      transition: opacity 0.4s ease;
      z-index: 300;
      overflow-y: auto;
    }

    #glass-panel.hidden {
      display: none;
    }

    #glass-panel[data-open='true'] {
      opacity: 1;
      pointer-events: auto;
    }

