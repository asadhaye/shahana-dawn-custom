  {% comment %}Build hotspots from blocks{% endcomment %}
  {%- assign hotspot_blocks = section.blocks | where: 'type', 'hotspot' -%}
  {%- assign storefront_hotspots = '' -%}
  {%- assign lounge_hotspots = '' -%}
  {%- assign designer_houses_hotspots = '' -%}
  {%- assign occasions_hotspots = '' -%}
  {%- assign featured_collections_hotspots = '' -%}
  {%- for block in hotspot_blocks -%}
    {%- assign target_type = block.settings.target_type -%}
    {%- assign target_key = '' -%}
    {%- if target_type == 'room' -%}
      {%- assign target_key = 'targetRoom' -%}
    {%- elsif target_type == 'editorial_room' -%}
      {%- assign target_key = 'targetEditorialRoom' -%}
    {%- elsif target_type == 'collection' -%}
      {%- assign target_key = 'targetCollection' -%}
    {%- endif -%}
    {%- capture hotspot_json -%}{"x":{{ block.settings.x }},"y":{{ block.settings.y }},"label":{{ block.settings.label | json }},"{{ target_key }}":{{ block.settings.target_value | json }},"mobileX":{{ block.settings.mobile_x }},"mobileY":{{ block.settings.mobile_y }}}{% endcapture -%}
    {%- if block.settings.room == 'storefront' -%}
      {%- if storefront_hotspots != '' -%}
        {%- assign storefront_hotspots = storefront_hotspots | append: ',' -%}
      {%- endif -%}
      {%- assign storefront_hotspots = storefront_hotspots | append: hotspot_json -%}
    {%- elsif block.settings.room == 'lounge' -%}
      {%- if lounge_hotspots != '' -%}
        {%- assign lounge_hotspots = lounge_hotspots | append: ',' -%}
      {%- endif -%}
      {%- assign lounge_hotspots = lounge_hotspots | append: hotspot_json -%}
    {%- elsif block.settings.room == 'designer_houses' -%}
      {%- if designer_houses_hotspots != '' -%}
        {%- assign designer_houses_hotspots = designer_houses_hotspots | append: ',' -%}
      {%- endif -%}
      {%- assign designer_houses_hotspots = designer_houses_hotspots | append: hotspot_json -%}
    {%- elsif block.settings.room == 'occasions' -%}
      {%- if occasions_hotspots != '' -%}
        {%- assign occasions_hotspots = occasions_hotspots | append: ',' -%}
      {%- endif -%}
      {%- assign occasions_hotspots = occasions_hotspots | append: hotspot_json -%}
    {%- elsif block.settings.room == 'featured_collections' -%}
      {%- if featured_collections_hotspots != '' -%}
        {%- assign featured_collections_hotspots = featured_collections_hotspots | append: ',' -%}
      {%- endif -%}
      {%- assign featured_collections_hotspots = featured_collections_hotspots | append: hotspot_json -%}
    {%- endif -%}
  {%- endfor -%}

