    /* ============================================================================ 7. FIRST-TIME ONBOARDING OVERLAY
  ============================================================================ */
    .immersive-onboarding {
      position: fixed;
      inset: 0;
      z-index: 300;
      display: flex;
      align-items: center;
      justify-content: center;
      background: rgba(0, 0, 0, 0.72);
      backdrop-filter: blur(4px);
      -webkit-backdrop-filter: blur(4px);
      animation: immersive-onboarding-fade-in 0.35s ease;
    }

    .immersive-onboarding[hidden] {
      display: none;
    }

    @keyframes immersive-onboarding-fade-in {
      from {
        opacity: 0;
      }
      to {
        opacity: 1;
      }
    }

    @keyframes immersive-onboarding-fade-out {
      from {
        opacity: 1;
      }
      to {
        opacity: 0;
      }
    }

    .immersive-onboarding.is-dismissing {
      animation: immersive-onboarding-fade-out 0.25s ease forwards;
      pointer-events: none;
    }

    .immersive-onboarding__inner {
      max-width: 420px;
      width: calc(100vw - 3rem);
      padding: 2.5rem 2rem;
      background: rgba(10, 15, 30, 0.95);
      border: 1px solid rgba(212, 175, 55, 0.35);
      border-radius: 1rem;
      text-align: center;
      box-shadow: 0 8px 40px rgba(0, 0, 0, 0.6);
    }

    .immersive-onboarding__title {
      margin: 0 0 1rem;
      font-size: 1.5rem;
      font-weight: 700;
      color: #d4af37;
      line-height: 1.2;
    }

    .immersive-onboarding__description {
      margin: 0 0 1.75rem;
      font-size: 0.95rem;
      color: rgba(255, 255, 255, 0.8);
      line-height: 1.6;
