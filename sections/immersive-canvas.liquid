    @media (max-width: 600px) {
      .immersive-cookie-banner {
        flex-direction: column;
        align-items: flex-start;
        bottom: 1rem;
      }
    }
    .immersive-cookie-banner__btn {
      transition: none;
    }
  }

  /* ============================================================================
     PROMO CODE OVERLAY
  ============================================================================ */
  .immersive-promo-code-overlay {
    position: fixed;
    inset: 0;
    z-index: 8800;
    background: rgba(10, 15, 30, 0.95);
    backdrop-filter: blur(20px);
    -webkit-backdrop-filter: blur(20px);
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    padding: 2rem;
    opacity: 0;
    visibility: hidden;
    transition: opacity 0.3s ease, visibility 0.3s ease;
  }

  .immersive-promo-code-overlay:not([hidden]) {
    opacity: 1;
    visibility: visible;
  }

  .immersive-promo-code-overlay__heading {
    margin: 0 0 1.5rem;
    font-size: clamp(1.5rem, 5vw, 2rem);
    font-weight: 600;
    color: #d4af37;
    text-align: center;
    letter-spacing: 0.08em;
    text-transform: uppercase;
  }

  .immersive-promo-code-overlay__body {
    width: 100%;
    max-width: 400px;
  }

  .immersive-promo-code-overlay__form {
    display: flex;
    gap: 0.5rem;
    align-items: stretch;
  }

  .immersive-promo-code-overlay__input {
    flex: 1;
    height: 48px;
    padding: 0 1rem;
    background: rgba(255, 255, 255, 0.08);
    border: 1px solid rgba(212, 175, 55, 0.35);
    border-radius: 8px;
    color: #d4af37;
    font-size: 1rem;
    font-weight: 500;
    letter-spacing: 0.04em;
    text-transform: uppercase;
    outline: none;
    transition: border-color 0.2s ease;
  }

  .immersive-promo-code-overlay__input::placeholder {
    color: rgba(212, 175, 55, 0.4);
    text-transform: none;
    letter-spacing: 0;
  }

  .immersive-promo-code-overlay__input:focus {
    border-color: rgba(212, 175, 55, 0.7);
  }

  .immersive-promo-code-overlay__submit {
    height: 48px;
    padding: 0 1.25rem;
    background: #d4af37;
    border: none;
    border-radius: 8px;
    color: #0a0f1e;
    font-weight: 700;
    font-size: 0.875rem;
    letter-spacing: 0.05em;
    cursor: pointer;
    transition: background 0.2s ease;
  }

  .immersive-promo-code-overlay__submit:hover {
    background: #e8c84a;
  }

  .immersive-promo-code-overlay__submit:focus-visible {
    outline: 2px solid #d4af37;
    outline-offset: 3px;
  }

  .immersive-promo-code-overlay__feedback {
    margin: 1rem 0;
    padding: 0.75rem 1rem;
    border-radius: 8px;
    font-size: 0.875rem;
    text-align: center;
    line-height: 1.5;
  }

  .immersive-promo-code-overlay__feedback--success {
    background: rgba(34, 197, 94, 0.15);
    border: 1px solid rgba(34, 197, 94, 0.4);
    color: rgb(134, 239, 172);
  }

  .immersive-promo-code-overlay__feedback--error {
    background: rgba(239, 68, 68, 0.15);
    border: 1px solid rgba(239, 68, 68, 0.4);
    color: rgb(252, 165, 165);
  }

  .immersive-promo-code-overlay__active {
    margin-top: 1.5rem;
    padding: 1rem;
    background: rgba(212, 175, 55, 0.08);
    border: 1px solid rgba(212, 175, 55, 0.2);
    border-radius: 8px;
  }

  .immersive-promo-code-overlay__active-label {
    margin: 0 0 0.75rem;
    font-size: 0.75rem;
    text-transform: uppercase;
    letter-spacing: 0.08em;
    color: rgba(212, 175, 55, 0.6);
    font-weight: 600;
  }

  .immersive-promo-code-overlay__active-item {
    display: flex;
    align-items: center;
    gap: 0.5rem;
    padding: 0.5rem 0;
    border-bottom: 1px solid rgba(255, 255, 255, 0.1);
  }

  .immersive-promo-code-overlay__active-item:last-child {
    border-bottom: none;
  }

  .immersive-promo-code-overlay__active-title {
    font-size: 0.875rem;
    color: #d4af37;
    font-weight: 500;
  }

  .immersive-promo-code-overlay__active-amount {
    font-size: 0.875rem;
    color: rgb(134, 239, 172);
    font-weight: 600;
  }

  .immersive-promo-code-overlay__remove {
    margin-left: auto;
    background: transparent;
    border: 1px solid rgba(255, 255, 255, 0.2);
    border-radius: 4px;
    color: rgba(255, 255, 255, 0.5);
    font-size: 1rem;
    cursor: pointer;
    padding: 0.25rem 0.5rem;
    transition: border-color 0.2s, color 0.2s;
  }

  .immersive-promo-code-overlay__remove:hover {
    border-color: rgba(239, 68, 68, 0.5);
    color: rgb(239, 68, 68);
  }

  .immersive-promo-code-overlay__close {
    position: absolute;
    top: 1rem;
    right: 1rem;
    background: none;
    border: none;
    color: rgba(212, 175, 55, 0.6);
    cursor: pointer;
    padding: 0.5rem;
    transition: color 0.2s;
  }

  .immersive-promo-code-overlay__close:hover {
    color: #d4af37;
  }

  .immersive-promo-code-overlay__close:focus-visible {
    outline: 2px solid #d4af37;
    outline-offset: 3px;
  }

  @media (max-width: 600px) {
    .immersive-promo-code-overlay__form {
      flex-direction: column;
    }

    .immersive-promo-code-overlay__submit {
      width: 100%;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .immersive-promo-code-overlay {
      transition: none !important;
    }
  }

  /* Focus-visible styles for interactive elements */
  button:focus-visible,
  a:focus-visible,
  [data-immersive-home-btn]:focus-visible,
  [data-fab-trigger]:focus-visible,
  [data-fab-actions] button:focus-visible {
    outline: 2px solid #d4af37;
    outline-offset: 2px;
  }

  /* Issue 20: Boost gold text contrast for users who need higher contrast.
     Gold (#d4af37) on dark bg fails WCAG AA at reduced opacity. */
  @media (prefers-contrast: high) {
    .immersive-header__logo-tagline,
    .glass-panel-section__breadcrumb-current,
    .glass-product-section__breadcrumb-current {
      color: #e8c84a !important;
    }

    .glass-panel-section__breadcrumb-btn,
    .glass-product-section__breadcrumb-btn {
      color: #e8c84a !important;
    }

    .immersive-search__input,
    .immersive-header .field__input {
      color: #e8c84a !important;
      border-color: #e8c84a !important;
    }

    .immersive-header .field__input::placeholder,
    .immersive-header .field__label {
      color: #c4a030 !important;
    }

    .immersive-search__group-label,
    .immersive-search-result__title {
      color: #fff !important;
    }

    .immersive-wishlist-card__title,
    .immersive-wishlist-card__price,
    [data-wishlist-empty] {
      color: #e8c84a !important;
    }

    .immersive-header__icon-btn,
    .immersive-back-btn,
    .immersive-search__icon,
    .immersive-search__button,
    .immersive-header .search__button,
    .immersive-header .reset__button {
      color: #e8c84a !important;
    }
  }

  /* Hide Dawn/Shopify cookie banner on immersive page -- our immersive banner handles consent */
  .shopify-privacy-policy__banner,
  .shopify-cookie-banner,
  #shopify-privacy-policy-banner,
  .shopify-pc__banner__dialog,
  .shopify-pc__banner,
  .shopify-pc__banner__wrapper,
  .shopify-pc__modal,
  #shopify-pc__banner,
  .cc-banner,
  .cc-window,
  .osano-cm-window,
  #onetrust-banner-sdk,
  .trustarc-banner,
  [class*='cookie-consent']:not(.immersive-cookie-banner),
  [class*='cookie-banner']:not(.immersive-cookie-banner),
  [class*='privacy-policy']:not(.immersive-cookie-banner),
  [data-testid*='cookie'],
  iframe[src*='privacy'],
  iframe[src*='cookie'],
  iframe[src*='consent'] {
    display: none !important;
  }
{% endstylesheet %}

