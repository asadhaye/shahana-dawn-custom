{%- # theme-check-disable UnknownFilter -%}
{{ 'component-menu-drawer.css' | asset_url | stylesheet_tag }}

{% comment %}Preload critical 3D textures — use captured vars so preload URLs match JS config exactly{% endcomment %}
{%- capture storefront_base_desktop -%}{%- if section.settings.storefront_base_image != blank -%}{{ section.settings.storefront_base_image | image_url: width: 1440, format: 'webp', quality: 75 }}{%- endif -%}{%- endcapture -%}
{%- capture storefront_base_mobile -%}{%- if section.settings.storefront_base_image_mobile != blank -%}{{ section.settings.storefront_base_image_mobile | image_url: width: 900, format: 'webp', quality: 75 }}{%- elsif section.settings.storefront_base_image != blank -%}{{ section.settings.storefront_base_image | image_url: width: 900, format: 'webp', quality: 75 }}{%- endif -%}{%- endcapture -%}
{%- capture storefront_depth_desktop -%}{%- if section.settings.storefront_depth_map != blank -%}{{ section.settings.storefront_depth_map | image_url: width: 1440, format: 'webp', quality: 75 }}{%- endif -%}{%- endcapture -%}
{%- capture storefront_depth_mobile -%}{%- if section.settings.storefront_depth_map_mobile != blank -%}{{ section.settings.storefront_depth_map_mobile | image_url: width: 900, format: 'webp', quality: 75 }}{%- elsif section.settings.storefront_depth_map != blank -%}{{ section.settings.storefront_depth_map | image_url: width: 900, format: 'webp', quality: 75 }}{%- endif -%}{%- endcapture -%}

{%- comment %}theme-check-disable AssetPreload{%- endcomment %}
{%- if storefront_base_desktop != blank -%}
  <link
    rel="preload"
    as="image"
    href="{{ storefront_base_desktop }}"
    crossorigin="anonymous"
    fetchpriority="high"
    media="(min-width: 750px)"
  >
{%- endif -%}
{%- if storefront_base_mobile != blank -%}
  <link
    rel="preload"
    as="image"
    href="{{ storefront_base_mobile }}"
    crossorigin="anonymous"
    fetchpriority="high"
    media="(max-width: 749px)"
  >
{%- endif -%}
{%- if storefront_depth_desktop != blank -%}
  <link
    rel="preload"
    as="image"
    href="{{ storefront_depth_desktop }}"
    crossorigin="anonymous"
    fetchpriority="high"
    media="(min-width: 750px)"
  >
{%- endif -%}
{%- if storefront_depth_mobile != blank -%}
  <link
    rel="preload"
    as="image"
    href="{{ storefront_depth_mobile }}"
    crossorigin="anonymous"
    fetchpriority="high"
    media="(max-width: 749px)"
  >
{%- endif -%}
{%- comment %}theme-check-enable AssetPreload{%- endcomment %}

{% liquid
  assign base_url = ''
  assign depth_url = ''
  assign logo_src = ''

  if section.settings.base_image != blank
    assign base_url = section.settings.base_image | image_url: width: 2000
  endif

  if section.settings.depth_map != blank
    assign depth_url = section.settings.depth_map | image_url: width: 2000
  endif

  if section.settings.logo_image != blank
    assign logo_src = section.settings.logo_image | image_url: width: 600
  else
    assign logo_src = 'golden-s-logo.webp' | asset_url
  endif
%}

<section
  id="immersive-store-{{ section.id }}"
  class="immersive-store"
  data-section-id="{{ section.id }}"
  data-collections-base-url="{{ routes.collections_url }}"
  data-msg-welcome-toast="{{ 'sections.immersive_store.welcome_toast' | t | escape }}"
  data-low-stock-threshold="{{ section.settings.low_stock_threshold | default: 5 }}"
  data-guided-featured-wing="{{ section.settings.guided_featured_wing | default: 'designer_houses' | escape }}"
  data-gallery-layout="{{ section.settings.gallery_layout | default: 'vertical' }}"
>
  {% comment %} Pass Liquid configuration to JavaScript {% endcomment %}
  <div
    class="immersive-config"
    style="display:none;"
    data-config="{{ section.settings | json }}"
    data-routes="{{ routes | json }}"
    data-cart-count="{{ cart.item_count }}"
  ></div>
  <div
    class="immersive-store__canvas-wrapper"
    data-base-url="{{ base_url }}"
    data-depth-url="{{ depth_url }}"
    data-logo-url="{{ logo_src }}"
    data-transition-style="{{ section.settings.transition_style | default: 'crossfade' | escape }}"
    {%- if section.settings.fallback_base_image -%}
      data-fallback-base-url="{{ section.settings.fallback_base_image | asset_url }}"
    {%- endif -%}
    {%- if section.settings.fallback_depth_image -%}
      data-fallback-depth-url="{{ section.settings.fallback_depth_image | asset_url }}"
    {%- endif -%}
  >
    <div
      id="immersive-initial-loader"
      class="immersive-initial-loader"
      aria-hidden="true"
    >
      {%- if logo_src != blank -%}
        <img
          src="{{ logo_src }}"
          alt="{{ shop.name | escape }}"
          class="immersive-initial-loader__logo"
          width="180"
          height="180"
          loading="eager"
        >
      {%- endif -%}
      <div class="immersive-initial-loader__spinner" aria-hidden="true"></div>
    </div>
    <canvas
      id="immersive-canvas"
      data-recording-ignore="true"
      role="img"
      aria-label="3D immersive store"
    >
      <p>
        Your browser does not support canvas. Please visit our <a href="{{ routes.root_url }}">standard store</a> for
        the full shopping experience.
      </p>
    </canvas>
    <div
      id="ui-layer"
      data-msg-back-to-room="{{ 'sections.immersive_store.back_to_room' | t: room_name: '' | escape }}"
      data-msg-based-on-saves="{{ 'sections.immersive_store.based_on_saves' | t | escape }}"
    >
      <!-- ARIA live region for hotspot announcements -->
      <div id="immersive-hotspot-announcer" class="visually-hidden" aria-live="polite" aria-atomic="true"></div>

      <!-- InfiniteGallery hover label -->
      <div class="infinite-gallery-label" data-infinite-gallery-label hidden>
        <span class="infinite-gallery-label__text"></span>
      </div>

      {%- for block in section.blocks -%}
        {%- if block.type == 'flash_sale' and block.settings.enabled -%}
          <div
            class="immersive-flash-sale-banner"
            data-flash-sale-banner
            data-sale-end-date="{{ block.settings.sale_end_date | escape }}"
            data-message="{{ block.settings.message | escape }}"
            data-dismiss-label="{{ 'sections.immersive_store.limited_time.flash_dismiss' | t | escape }}"
            {{ block.shopify_attributes }}
            hidden
          >
            <span class="immersive-flash-sale-banner__message">{{ block.settings.message | escape }}</span>
            <span class="immersive-flash-sale-banner__countdown" data-flash-countdown></span>
            <button
              type="button"
              class="immersive-flash-sale-banner__dismiss"
              data-flash-dismiss
              aria-label="{{ 'sections.immersive_store.limited_time.flash_dismiss' | t | escape }}"
            >
              ×
            </button>
          </div>
        {%- endif -%}
      {%- endfor -%}
    </div>

    <!-- Floating Assistive Ball (FAB) — replaces bottom nav pill -->
    <div
      class="immersive-fab"
      data-immersive-fab
      aria-label="{{ 'sections.immersive_store.fab.label' | t | escape }}"
    >
      <!-- FAB trigger button -->
      <button
        type="button"
        class="immersive-fab__trigger"
        data-fab-trigger
        aria-expanded="false"
        aria-haspopup="true"
        aria-label="{{ 'sections.immersive_store.fab.open' | t | escape }}"
      >
        {%- if section.settings.fab_text_icon != blank -%}
          <svg viewBox="0 0 40 40" fill="none" xmlns="http://www.w3.org/2000/svg" aria-hidden="true">
            <text x="50%" y="54%" dominant-baseline="middle" text-anchor="middle" font-family="var(--luxury-font-heading, serif)" font-size="22" font-weight="700" fill="currentColor">
              {{- section.settings.fab_text_icon | escape -}}
            </text>
          </svg>
        {%- elsif section.settings.fab_icon_svg != blank -%}
          <img
            src="{{ section.settings.fab_icon_svg | image_url: width: 80 }}"
            alt=""
            aria-hidden="true"
            width="40"
            height="40"
            loading="eager"
          >
        {%- else -%}
          <svg viewBox="0 0 40 40" fill="none" xmlns="http://www.w3.org/2000/svg" aria-hidden="true">
            <text x="50%" y="54%" dominant-baseline="middle" text-anchor="middle" font-family="var(--luxury-font-heading, serif)" font-size="22" font-weight="700" fill="currentColor">S</text>
          </svg>
        {%- endif -%}
      </button>

      <!-- FAB action items — revealed on open -->
      <div class="immersive-fab__actions" data-fab-actions hidden>
        <!-- Wishlist -->
        <button
          type="button"
          class="immersive-fab__action"
          data-bottom-nav-wishlist
          aria-label="{{ 'sections.immersive_store.bottom_nav.wishlist' | t | escape }}"
        >
          <span class="immersive-fab__icon-wrap">
            <svg
              aria-hidden="true"
              focusable="false"
              width="20"
              height="20"
              viewBox="0 0 24 24"
              fill="none"
              stroke="currentColor"
              stroke-width="1.75"
            >
              <path d="M20.84 4.61a5.5 5.5 0 0 0-7.78 0L12 5.67l-1.06-1.06a5.5 5.5 0 0 0-7.78 7.78l1.06 1.06L12 21.23l7.78-7.78 1.06-1.06a5.5 5.5 0 0 0 0-7.78z"/>
            </svg>
            <span class="immersive-fab__badge" data-bottom-nav-wishlist-badge hidden>0</span>
          </span>
          <span class="immersive-fab__action-label">{{ 'sections.immersive_store.bottom_nav.wishlist' | t }}</span>
        </button>

        <!-- Cart -->
        <button
          type="button"
          class="immersive-fab__action"
          data-bottom-nav-cart
          aria-label="{{ 'sections.immersive_store.bottom_nav.cart' | t | escape }}"
        >
          <span class="immersive-fab__icon-wrap">
            <svg
              aria-hidden="true"
              focusable="false"
              width="20"
              height="20"
              viewBox="0 0 24 24"
              fill="none"
              stroke="currentColor"
              stroke-width="1.75"
            >
              <path d="M6 2 3 6v14a2 2 0 0 0 2 2h14a2 2 0 0 0 2-2V6l-3-4z"/><line x1="3" y1="6" x2="21" y2="6"/><path d="M16 10a4 4 0 0 1-8 0"/>
            </svg>
            <span class="immersive-fab__badge" data-bottom-nav-cart-badge hidden>0</span>
          </span>
          <span class="immersive-fab__action-label">{{ 'sections.immersive_store.bottom_nav.cart' | t }}</span>
        </button>

        <!-- Account -->
        {%- if customer -%}
          <a
            href="{{ routes.account_url }}"
            class="immersive-fab__action"
            aria-label="{{ 'customer.account.title' | t }}"
          >
            <svg
              aria-hidden="true"
              focusable="false"
              width="20"
              height="20"
              viewBox="0 0 24 24"
              fill="none"
              stroke="currentColor"
              stroke-width="1.75"
            >
              <path d="M20 21v-2a4 4 0 0 0-4-4H8a4 4 0 0 0-4 4v2"></path>
              <circle cx="12" cy="7" r="4"></circle>
            </svg>
            <span class="immersive-fab__action-label">{{ 'customer.account.title' | t }}</span>
          </a>
        {%- else -%}
          <a
            href="{{ routes.account_login_url }}"
            class="immersive-fab__action"
            aria-label="{{ 'customer.log_in' | t }}"
          >
            <svg
              aria-hidden="true"
              focusable="false"
              width="20"
              height="20"
              viewBox="0 0 24 24"
              fill="none"
              stroke="currentColor"
              stroke-width="1.75"
            >
              <path d="M20 21v-2a4 4 0 0 0-4-4H8a4 4 0 0 0-4 4v2"></path>
              <circle cx="12" cy="7" r="4"></circle>
            </svg>
            <span class="immersive-fab__action-label">{{ 'customer.log_in' | t }}</span>
          </a>
        {%- endif -%}

        <!-- Story Rail -->
        <button
          type="button"
          class="immersive-fab__action"
          data-immersive-overlay="immersive-story-rail"
          data-overlay-title="{{ 'sections.immersive_canvas.fab_story_rail' | t | escape }}"
          aria-label="{{ 'sections.immersive_canvas.fab_story_rail' | t | escape }}"
        >
          <span class="immersive-fab__icon-wrap">
            <svg
              aria-hidden="true"
              focusable="false"
              width="20"
              height="20"
              viewBox="0 0 24 24"
              fill="none"
              stroke="currentColor"
              stroke-width="1.75"
            >
              <path d="M2 3h6a4 4 0 0 1 4 4v14a3 3 0 0 0-3-3H2z"/><path d="M22 3h-6a4 4 0 0 0-4 4v14a3 3 0 0 1 3-3h7z"/>
            </svg>
          </span>
          <span class="immersive-fab__action-label">{{ 'sections.immersive_canvas.fab_story_rail' | t | escape }}</span>
        </button>

        <!-- Typo Index -->
        <button
          type="button"
          class="immersive-fab__action"
          data-immersive-overlay="codex-typo-index"
          data-overlay-title="{{ 'sections.immersive_canvas.fab_typo_index' | t | escape }}"
          aria-label="{{ 'sections.immersive_canvas.fab_typo_index' | t | escape }}"
        >
          <span class="immersive-fab__icon-wrap">
            <svg
              aria-hidden="true"
              focusable="false"
              width="20"
              height="20"
              viewBox="0 0 24 24"
              fill="none"
              stroke="currentColor"
              stroke-width="1.75"
            >
              <polyline points="4 7 4 4 20 4 20 7"/><line x1="9" y1="20" x2="15" y2="20"/><line x1="12" y1="4" x2="12" y2="20"/>
            </svg>
          </span>
          <span class="immersive-fab__action-label">{{ 'sections.immersive_canvas.fab_typo_index' | t | escape }}</span>
        </button>

        <!-- Promo Code -->
        <button
          type="button"
          class="immersive-fab__action"
          data-immersive-overlay="immersive-promo-code"
          data-overlay-title="{{ 'sections.immersive_canvas.fab_promo_code' | t | escape }}"
          aria-label="{{ 'sections.immersive_canvas.fab_promo_code' | t | escape }}"
        >
          <span class="immersive-fab__icon-wrap">
            <svg
              aria-hidden="true"
              focusable="false"
              width="20"
              height="20"
              viewBox="0 0 24 24"
              fill="none"
              stroke="currentColor"
              stroke-width="1.75"
            >
              <path d="M20 12V8H6a2 2 0 0 1-2-2c0-1.1.9-2 2-2h12v4"/><path d="M4 6v12c0 1.1.9 2 2 2h14v-4"/><path d="M18 12a2 2 0 0 0 0 4h4v-4z"/>
            </svg>
          </span>
          <span class="immersive-fab__action-label">{{ 'sections.immersive_canvas.fab_promo_code' | t | escape }}</span>
        </button>

        <!-- Classic Store -->
        <a
          href="{{ routes.root_url }}"
          class="immersive-fab__action"
          data-bottom-nav-2d
          aria-label="{{ 'sections.immersive_store.bottom_nav.back_to_2d' | t | escape }}"
        >
          <svg
            aria-hidden="true"
            focusable="false"
            width="20"
            height="20"
            viewBox="0 0 24 24"
            fill="none"
            stroke="currentColor"
            stroke-width="1.75"
          >
            <rect x="2" y="3" width="20" height="14" rx="2"/><path d="M8 21h8M12 17v4"/>
          </svg>
          <span class="immersive-fab__action-label">{{ 'sections.immersive_store.bottom_nav.back_to_2d' | t }}</span>
        </a>
      </div>
    </div>

    <!-- Guided mode progress dots — visible only when immersiveState.guided === true -->
    <div
      id="immersive-guided-progress"
      class="immersive-guided-progress"
      aria-hidden="true"
      hidden
    >
      {%- comment %}Issue 24: Dynamic guided tour dots based on room count{%- endcomment %}
      {%- assign guided_rooms = 'storefront,lounge,designer_houses,occasions,featured_collections' | split: ',' -%}
      {%- if section.settings.guided_featured_wing == 'occasions' -%}
        {%- assign guided_rooms = 'storefront,lounge,occasions' | split: ',' -%}
      {%- elsif section.settings.guided_featured_wing == 'designer_houses' -%}
        {%- assign guided_rooms = 'storefront,lounge,designer_houses' | split: ',' -%}
      {%- elsif section.settings.guided_featured_wing == 'featured_collections' -%}
        {%- assign guided_rooms = 'storefront,lounge,featured_collections' | split: ',' -%}
      {%- endif -%}
      {%- for room in guided_rooms -%}
        <span class="immersive-guided-progress__dot" data-guided-step="{{ forloop.index0 }}" aria-hidden="true"></span>
      {%- endfor -%}
    </div>

    <!-- Guided mode soft prompt — "Begin a curated experience" -->
    <div
      id="immersive-guided-prompt"
      class="immersive-guided-prompt"
      hidden
    >
      <button
        type="button"
        class="immersive-guided-prompt__cta"
        data-guided-prompt-cta
        aria-label="{{ 'sections.immersive_store.guided.prompt_cta' | t | escape }}"
      >
        {{ 'sections.immersive_store.guided.prompt_cta' | t }}
      </button>
      <button
        type="button"
        class="immersive-guided-prompt__skip"
        data-guided-prompt-skip
        aria-label="{{ 'sections.immersive_store.guided.prompt_skip' | t | escape }}"
      >
        {{ 'sections.immersive_store.guided.prompt_skip' | t }}
      </button>
    </div>

    <div
      id="immersive-room-badge"
      class="immersive-room-badge"
      aria-live="polite"
      aria-atomic="true"
      data-room-name-storefront="{{ 'sections.immersive_store.room_badge.name_storefront' | t | escape }}"
      data-room-guidance-storefront="{{ 'sections.immersive_store.room_badge.guidance_storefront' | t | escape }}"
      data-room-name-lounge="{{ 'sections.immersive_store.room_badge.name_lounge' | t | escape }}"
      data-room-guidance-lounge="{{ 'sections.immersive_store.room_badge.guidance_lounge' | t | escape }}"
      data-room-name-designer_houses="{{ 'sections.immersive_store.room_badge.name_designer_houses' | t | escape }}"
      data-room-guidance-designer_houses="{{ 'sections.immersive_store.room_badge.guidance_designer_houses' | t | escape }}"
      data-room-name-occasions="{{ 'sections.immersive_store.room_badge.name_occasions' | t | escape }}"
      data-room-guidance-occasions="{{ 'sections.immersive_store.room_badge.guidance_occasions' | t | escape }}"
      data-room-name-featured_collections="{{ 'sections.immersive_store.room_badge.name_featured_collections' | t | escape }}"
      data-room-guidance-featured_collections="{{ 'sections.immersive_store.room_badge.guidance_featured_collections' | t | escape }}"
    >
      <span class="immersive-room-badge__name" data-room-badge-name></span>
      <span class="immersive-room-badge__guidance" data-room-badge-guidance></span>
    </div>
    {%- comment -%}Logo moved to header center{%- endcomment -%}
    <div class="immersive-store__tagline" id="immersive-tagline" aria-hidden="true">
      <p>{{ 'sections.immersive_store.intro' | t }}</p>
    </div>
  </div>

  <!-- Fixed Header — dark frosted glass top bar -->
  <header class="immersive-header">
    <!-- Left: burger menu only -->
    <div class="immersive-header__left">
      {%- if section.settings.menu != blank -%}
        <menu-drawer data-breakpoint="desktop">
          <details id="Details-menu-drawer-container" class="menu-drawer-container">
            <summary
              class="immersive-header__icon-btn header__icon header__icon--menu header__icon--summary link focus-inset"
              aria-label="{{ 'sections.header.menu' | t }}"
            >
              <span>
                <svg
                  xmlns="http://www.w3.org/2000/svg"
                  width="20"
                  height="20"
                  viewBox="0 0 24 24"
                  fill="none"
                  stroke="currentColor"
                  stroke-width="2"
                  stroke-linecap="round"
                  stroke-linejoin="round"
                  aria-hidden="true"
                  class="icon icon-hamburger"
                >
                  <line x1="3" y1="6" x2="21" y2="6"></line>
                  <line x1="3" y1="12" x2="21" y2="12"></line>
                  <line x1="3" y1="18" x2="21" y2="18"></line>
                </svg>
                <svg
                  xmlns="http://www.w3.org/2000/svg"
                  width="20"
                  height="20"
                  viewBox="0 0 24 24"
                  fill="none"
                  stroke="currentColor"
                  stroke-width="2"
                  stroke-linecap="round"
                  stroke-linejoin="round"
                  aria-hidden="true"
                  class="icon icon-close"
                >
                  <line x1="18" y1="6" x2="6" y2="18"></line>
                  <line x1="6" y1="6" x2="18" y2="18"></line>
                </svg>
              </span>
            </summary>
            <div id="menu-drawer" class="gradient menu-drawer motion-reduce color-scheme-1">
              <div class="menu-drawer__inner-container">
                <div class="menu-drawer__navigation-container">
                  <nav class="menu-drawer__navigation">
                    <ul class="menu-drawer__menu has-submenu list-menu" role="list">
                      {%- for link in section.settings.menu.links -%}
                        <li>
                          {%- if link.links != blank -%}
                            <details id="Details-menu-drawer-menu-item-{{ forloop.index }}">
                              <summary
                                id="HeaderDrawer-{{ link.handle }}"
                                class="menu-drawer__menu-item list-menu__item link link--text focus-inset{% if link.child_active %} menu-drawer__menu-item--active{% endif %}"
                              >
                                {{ link.title | escape }}
                                <span class="svg-wrapper">{{- 'icon-arrow.svg' | inline_asset_content -}}</span>
                                <span class="svg-wrapper">{{- 'icon-caret.svg' | inline_asset_content -}}</span>
                              </summary>
                              <div
                                id="link-{{ link.handle | escape }}"
                                class="menu-drawer__submenu has-submenu gradient motion-reduce"
                                tabindex="-1"
                              >
                                <div class="menu-drawer__inner-submenu">
                                  <button
                                    class="menu-drawer__close-button link link--text focus-inset"
                                    aria-expanded="true"
                                  >
                                    <span class="svg-wrapper">{{- 'icon-arrow.svg' | inline_asset_content -}}</span>
                                    {{ link.title | escape }}
                                  </button>
                                  <ul class="menu-drawer__menu list-menu" role="list" tabindex="-1">
                                    {%- for childlink in link.links -%}
                                      <li>
                                        <a
                                          id="HeaderDrawer-{{ link.handle }}-{{ childlink.handle }}"
                                          href="{{ childlink.url }}"
                                          class="menu-drawer__menu-item link link--text list-menu__item focus-inset{% if childlink.current %} menu-drawer__menu-item--active{% endif %}"
                                          {% if childlink.current %}
                                            aria-current="page"
                                          {% endif %}
                                        >
                                          {{ childlink.title | escape }}
                                        </a>
                                      </li>
                                    {%- endfor -%}
                                  </ul>
                                </div>
                              </div>
                            </details>
                          {%- else -%}
                            <a
                              id="HeaderDrawer-{{ link.handle }}"
                              href="{{ link.url }}"
                              class="menu-drawer__menu-item list-menu__item link link--text focus-inset{% if link.current %} menu-drawer__menu-item--active{% endif %}"
                              {% if link.current %}
                                aria-current="page"
                              {% endif %}
                            >
                              {{ link.title | escape }}
                            </a>
                          {%- endif -%}
                        </li>
                      {%- endfor -%}
                    </ul>
                  </nav>
                </div>
              </div>
            </div>
          </details>
        </menu-drawer>
