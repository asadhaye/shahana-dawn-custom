{% liquid
  assign base_url = ''
  assign depth_url = ''

  if section.settings.base_image != blank
    assign base_url = section.settings.base_image | image_url: width: 2000
  else
    # theme-check-disable MissingAsset
    assign base_url = 'immersive-base.png' | asset_url
    # theme-check-enable MissingAsset
  endif

  if section.settings.depth_map != blank
    assign depth_url = section.settings.depth_map | image_url: width: 2000
  else
    # theme-check-disable MissingAsset
    assign depth_url = 'immersive-depth.png' | asset_url
    # theme-check-enable MissingAsset
  endif
%}

<section id="immersive-store-{{ section.id }}" class="immersive-store" data-section-id="{{ section.id }}">
  <div
    class="immersive-store__canvas-wrapper"
    data-base-url="{{ base_url }}"
    data-depth-url="{{ depth_url }}"
  >
    <canvas
      id="immersive-canvas"
      aria-hidden="true"
    ></canvas>
    <div id="ui-layer"></div>
  </div>
   <nav class="immersive-nav" aria-label="Explore rooms">
    <div class="immersive-nav__inner">
      <h3 class="immersive-nav__heading">
        {{ 'sections.immersive_store.explore_heading' | t }}
      </h3>
      <ul class="immersive-nav__list">
        <li class="immersive-nav__item">
          <button
            type="button"
            class="immersive-nav__link immersive-nav__link--active"
            data-room="storefront"
          >
            {{ 'sections.immersive_store.nav_exterior' | t }}
          </button>
        </li>
        <li class="immersive-nav__item">
          <button
            type="button"
            class="immersive-nav__link"
            data-room="lounge"
          >
            {{ 'sections.immersive_store.nav_lounge' | t }}
          </button>
        </li>
        <li class="immersive-nav__item">
          <button
            type="button"
            class="immersive-nav__link"
            data-room="designer"
          >
            {{ 'sections.immersive_store.nav_designer' | t }}
          </button>
        </li>
        <li class="immersive-nav__item">
          <button
            type="button"
            class="immersive-nav__link"
            data-room="festive"
          >
            {{ 'sections.immersive_store.nav_festive' | t }}
          </button>
        </li>
        <li class="immersive-nav__item">
          <button
            type="button"
            class="immersive-nav__link"
            data-collection="eid-edit-2026"
          >
            {{ 'sections.immersive_store.nav_eid_edit' | t }}
          </button>
        </li>
      </ul>
    </div>
  </nav>
  <aside
    id="glass-panel"
    class="immersive-store__panel hidden"
    aria-live="polite"
  >
    <header class="immersive-store__panel-header">
      <h3 class="immersive-store__panel-title">{{ 'sections.immersive_store.panel_title' | t }}</h3>
      <button
        type="button"
        class="immersive-store__panel-close"
      >
        {{ 'sections.immersive_store.close' | t }}
      </button>
    </header>
    <div class="immersive-store__panel-content"></div>
  </aside>
</section>

{% stylesheet %}
.immersive-store {
  position: relative;
  min-height: 100vh;
  padding: 0;
}

.immersive-store__canvas-wrapper {
  position: relative;
  width: 100%;
  height: 100vh;
  overflow: hidden;
  background: radial-gradient(circle at top, rgba(15,23,42,0.4), rgba(0,0,0,1));
}

/* Canvas used by Three.js */
#immersive-canvas {
  position: absolute;
  inset: 0;
  width: 100%;
  height: 100%;
  display: block;
}

/* Overlay layer where JS injects hotspots */
#ui-layer {
  position: absolute;
  inset: 0;
  pointer-events: none;
}

/* Hotspot buttons generated by renderHotspots() */
#ui-layer .immersive-hotspot {
  pointer-events: auto;
  padding: 0.75rem 1.5rem;
  border-radius: 999px;
  border: 1px solid rgba(255, 255, 255, 0.85);
  background: rgba(15, 23, 42, 0.9);
  color: #f9fafb;
  backdrop-filter: blur(18px);
  cursor: pointer;
  font: inherit;
  font-size: 0.875rem;
  letter-spacing: 0.06em;
  text-transform: uppercase;
  transition: transform 150ms ease-out, box-shadow 150ms ease-out, background-color 150ms ease-out, border-color 150ms ease-out;
}

#ui-layer .immersive-hotspot:focus-visible {
  outline: 2px solid #ffffff;
  outline-offset: 3px;
}

#ui-layer .immersive-hotspot:hover {
  transform: translate(-50%, -50%) scale(1.05);
  box-shadow: 0 0 40px rgba(212, 175, 55, 0.4);
  border-color: rgba(244, 197, 94, 0.9);
}

/* Left-side Explore navigation */
.immersive-nav {
  position: absolute;
  inset-block: 0;
  left: 0;
  display: flex;
  align-items: flex-end;
  justify-content: flex-start;
  padding: 7rem 1.5rem 4rem;
  pointer-events: none;
  z-index: 20;
}

.immersive-nav__inner {
  pointer-events: auto;
}

.immersive-nav__heading {
  margin: 0 0 1.5rem;
  font-size: 0.875rem;
  letter-spacing: 0.12em;
  text-transform: uppercase;
  opacity: 0.8;
}

.immersive-nav__list {
  list-style: none;
  margin: 0;
  padding: 0;
}

.immersive-nav__item + .immersive-nav__item {
  margin-top: 0.5rem;
}

.immersive-nav__link {
  border: none;
  background: transparent;
  color: #f9fafb;
  font: inherit;
  font-size: 1.4rem;
  font-weight: 600;
  letter-spacing: 0.04em;
  text-transform: uppercase;
  cursor: pointer;
  opacity: 0.85;
  transform: translateX(0);
  transition: opacity 200ms ease-out, transform 200ms ease-out, color 200ms ease-out;
}

.immersive-nav__link:hover {
  opacity: 1;
  transform: translateX(4px);
}

.immersive-nav__link--active {
  opacity: 1;
  color: #facc15;
}

/* Glass panel that slides in when a collection is opened */
#glass-panel {
  position: fixed;
  top: 0;
  right: 0;
  width: min(420px, 100vw);
  height: 100vh;
  transform: translateX(100%);
  opacity: 0;
  transition: transform 0.4s ease, opacity 0.4s ease;
  background: rgba(15, 23, 42, 0.96);
  color: #f9fafb;
  backdrop-filter: blur(20px);
  box-shadow: 0 24px 60px rgba(15, 23, 42, 0.65);
  z-index: 40;
  overflow-y: auto;
}

/* Panel content styling */
.immersive-store__panel {
  max-width: min(420px, 100vw);
  padding: 1.25rem 1.25rem 1.5rem;
  border-radius: 0;
  display: flex;
  flex-direction: column;
  gap: 0.75rem;
}

.immersive-store__panel.hidden {
  display: none;
}

.immersive-store__panel-header {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 1rem;
  border-bottom: 1px solid rgba(148, 163, 184, 0.3);
  padding-bottom: 0.75rem;
}

.immersive-store__panel-title {
  margin: 0;
  font-size: 1rem;
  font-weight: 600;
}

.immersive-store__panel-close {
  border: none;
  background: transparent;
  color: inherit;
  font-size: 0.875rem;
  cursor: pointer;
  padding: 0.25rem 0.75rem;
  border-radius: 999px;
}

.immersive-store__panel-close:hover {
  background-color: rgba(148, 163, 184, 0.16);
}

.immersive-store__panel-content {
  font-size: 0.875rem;
}
{% endstylesheet %}

{% schema %}
{
  "name": "t:sections.immersive_store.name",
  "settings": [
    {
      "type": "image_picker",
      "id": "base_image",
      "label": "t:sections.immersive_store.settings.base_image.label"
    },
    {
      "type": "image_picker",
      "id": "depth_map",
      "label": "t:sections.immersive_store.settings.depth_map.label"
    }
  ],
  "presets": [
    {
      "name": "t:sections.immersive_store.presets.name"
    }
  ]
}
{% endschema %}