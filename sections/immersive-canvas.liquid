    .immersive-onboarding__dismiss {
      display: inline-block;
      position: relative;
      z-index: 301;
      padding: 0.65rem 2rem;
      background: rgba(212, 175, 55, 0.9);
      color: #000;
      border: none;
      border-radius: 999px;
      font-size: 0.9rem;
      font-weight: 700;
      letter-spacing: 0.05em;
      text-transform: uppercase;
      cursor: pointer;
      transition: background 0.2s ease, transform 0.15s ease;
    }

    .immersive-onboarding__dismiss:hover {
      background: #d4af37;
      transform: scale(1.03);
    }

    .immersive-onboarding__dismiss:focus-visible {
      outline: 2px solid #d4af37;
      outline-offset: 3px;
    }

    @media (prefers-reduced-motion: reduce) {
      .immersive-onboarding {
        animation: none;
      }
      .immersive-onboarding.is-dismissing {
        animation: none;
        opacity: 0;
      }
      .immersive-onboarding__dismiss {
        transition: none;
        transform: none !important;
      }
    }

    /* ============================================================================ EDITORIAL OVERLAY — Fixed above canvas,
  fades in over the 3D room ============================================================================ */
    .immersive-editorial-overlay {
      position: fixed;
      inset: 0;
      z-index: 105;
      opacity: 0;
      pointer-events: none;
      overflow-y: auto;
      transition: opacity 0.5s ease;
    }

    .immersive-editorial-overlay.is-active {
      opacity: 1;
      pointer-events: auto;
    }

    .immersive-editorial-overlay__back {
      position: relative;
      top: auto;
      left: auto;
      left: 1.5rem;
      z-index: 120;
      display: flex;
      align-items: center;
      gap: 0.5rem;
      padding: 0.5rem 1.25rem 0.5rem 0.875rem;
      background: rgba(10, 15, 30, 0.75);
      backdrop-filter: blur(10px);
      -webkit-backdrop-filter: blur(10px);
      border: 1px solid rgba(212, 175, 55, 0.5);
      border-radius: 999px;
      color: #d4af37;
      font-size: 0.8125rem;
      font-weight: 700;
      letter-spacing: 0.08em;
      text-transform: uppercase;
      cursor: pointer;
      transition: background 0.2s ease, border-color 0.2s ease;
      opacity: 0;
      transform: translateY(-8px);
      transition: opacity 0.4s ease 0.2s, transform 0.4s ease 0.2s, background 0.2s ease, border-color 0.2s ease;
    }

    .immersive-editorial-overlay.is-active .immersive-editorial-overlay__back {
      opacity: 1;
      transform: translateY(0);
    }

    .immersive-editorial-overlay__back:hover {
      background: rgba(10, 15, 30, 0.95);
      border-color: #d4af37;
    }

    .immersive-editorial-overlay__back:focus-visible {
      outline: 2px solid #d4af37;
      outline-offset: 3px;
    }

    .immersive-editorial-overlay__content {
      min-height: 100vh;
      box-sizing: border-box;
      padding: 5rem 1.5rem 3rem;
    }

    /* Canvas blur when editorial is active */
