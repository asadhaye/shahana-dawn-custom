{% if product %}
<section
  id="ai-vton-section"
  class="ai-vton-section"
  style="
    --vton-button-bg: {{ section.settings.button_background_color }};
    --vton-button-bg-hover: {{ section.settings.button_background_hover_color }};
    --vton-button-text: {{ section.settings.button_text_color }};
    --vton-accent-color: {{ section.settings.accent_color }};
    --vton-success-color: {{ section.settings.success_color }};
  "
  data-endpoint-url="{{ section.settings.endpoint_url | escape }}"
  data-product-image="{{ product.featured_image | image_url: width: 1024 }}"
  data-text-upload-required="{{ 'sections.ai_vton.upload_required' | t | escape }}"
  data-text-error-generic="{{ 'sections.ai_vton.error_generic' | t | escape }}"
  data-text-error-start="{{ 'sections.ai_vton.error_start' | t | escape }}"
  data-text-error-timeout="{{ 'sections.ai_vton.error_timeout' | t | escape }}"
  data-text-ai-working="{{ 'sections.ai_vton.ai_working' | t | escape }}"
  data-text-change-photo="{{ 'sections.ai_vton.change_photo' | t | escape }}"
  data-text-uploading="{{ 'sections.ai_vton.uploading_images' | t | escape }}"
  data-text-try-another="{{ 'sections.ai_vton.try_another' | t | escape }}"
>
  <button
    type="button"
    id="vton-trigger-btn"
    class="vton-btn"
    aria-haspopup="dialog"
    aria-controls="vton-modal"
  >
    {% if section.settings.button_label != blank %}
      {{ section.settings.button_label | escape }}
    {% else %}
      {{ 'sections.ai_vton.button_label' | t }}
    {% endif %}
  </button>

  <div
    id="vton-modal-overlay"
    class="vton-overlay"
    aria-hidden="true"
  >
    <dialog
      id="vton-modal"
      class="vton-modal"
      aria-labelledby="vton-modal-title"
    >
      <header class="vton-modal-header">
        <h3 id="vton-modal-title" class="vton-modal-title">
          {% if section.settings.heading != blank %}
            {{ section.settings.heading | escape }}
          {% else %}
            {{ 'sections.ai_vton.heading' | t }}
          {% endif %}
        </h3>
        <button
          class="vton-close-btn"
          type="button"
          aria-label="{{ 'sections.ai_vton.close' | t | escape }}"
          data-vton-close
        >
          &times;
        </button>
      </header>

      <div class="vton-modal-body">
        <p class="vton-instruction">
          {% if section.settings.instruction_text != blank %}
            {{ section.settings.instruction_text | escape }}
          {% else %}
            {{ 'sections.ai_vton.instruction' | t }}
          {% endif %}
        </p>

        <div class="vton-upload-area">
          <input
            type="file"
            id="user-image-upload-input"
            class="vton-file-input"
            accept="image/*"
          >
          <label for="user-image-upload-input" class="vton-upload-label">
            {% if section.settings.upload_label != blank %}
              {{ section.settings.upload_label | escape }}
            {% else %}
              {{ 'sections.ai_vton.upload_label' | t }}
            {% endif %}
          </label>
          <img
            id="vton-user-preview"
            class="vton-user-preview"
            alt="{{ 'sections.ai_vton.user_photo_alt' | t | escape }}"
            hidden
            width="600"
            height="800"
          >
        </div>

        <button
          type="button"
          id="vton-submit-btn"
          class="vton-btn vton-btn-primary"
        >
          {% if section.settings.submit_label != blank %}
            {{ section.settings.submit_label | escape }}
          {% else %}
            {{ 'sections.ai_vton.submit_label' | t }}
          {% endif %}
        </button>

        <div id="loading-spinner" class="vton-loading" hidden>
          <div class="vton-spinner"></div>
          <p id="loading-text" class="vton-loading-text">
            {{ 'sections.ai_vton.loading_initial' | t }}
          </p>
        </div>

        <div id="vton-result-area" class="vton-result" hidden>
          <h4 class="vton-result-heading">
            {% if section.settings.result_heading != blank %}
              {{ section.settings.result_heading | escape }}
            {% else %}
              {{ 'sections.ai_vton.result_heading' | t }}
            {% endif %}
          </h4>
          <img
            id="result-image-element"
            class="vton-result-image"
            alt="{{ 'sections.ai_vton.result_alt' | t | escape }}"
            width="600"
            height="800"
          >
          <p class="vton-success-text">
            {% if section.settings.success_text != blank %}
              {{ section.settings.success_text | escape }}
            {% else %}
              {{ 'sections.ai_vton.success_text' | t }}
            {% endif %}
          </p>
        </div>
      </div>
    </dialog>
  </div>
</section>
{% endif %}

{% stylesheet %}
  .ai-vton-section {
    width: 100%;
  }

  .vton-btn {
    background-color: var(--vton-button-bg);
    color: var(--vton-button-text);
    border: none;
    padding: 12px 24px;
    font-size: 16px;
    cursor: pointer;
    border-radius: 4px;
    font-weight: bold;
    width: 100%;
    margin-top: 10px;
    transition: background-color 0.3s ease, transform 0.15s ease;
  }

  .vton-btn:hover {
    background-color: var(--vton-button-bg-hover);
    transform: translateY(-1px);
  }

  .vton-btn:focus-visible {
    outline: 2px solid var(--vton-accent-color);
    outline-offset: 2px;
  }

  .vton-btn-primary {
    background-color: var(--vton-accent-color);
    color: #000;
  }

  .vton-overlay {
    position: fixed;
    inset: 0;
    width: 100%;
    height: 100%;
    background: rgba(0, 0, 0, 0.7);
    display: none;
    justify-content: center;
    align-items: center;
    z-index: 999999;
    padding: 20px;
    box-sizing: border-box;
  }

  .vton-overlay.is-visible {
    display: flex;
  }

  .vton-modal {
    margin: 0;
    padding: 0;
    border: none;
    background: transparent;
  }

  .vton-modal::backdrop {
    background: transparent;
  }

  .vton-modal-body {
    padding: 20px;
    overflow-y: auto;
    text-align: center;
    background: #fff;
    width: 100%;
    max-width: 450px;
    border-radius: 12px;
    box-shadow: 0 10px 30px rgba(0, 0, 0, 0.3);
    max-height: 90vh;
  }

  .vton-modal-header {
    display: flex;
    justify-content: space-between;
    align-items: center;
    padding: 15px 20px;
    background: #f8f8f8;
    border-bottom: 1px solid #eee;
  }

  .vton-modal-title {
    margin: 0;
    font-size: 18px;
    color: #333;
  }

  .vton-close-btn {
    background: none;
    border: none;
    font-size: 24px;
    cursor: pointer;
    color: #666;
    padding: 0;
    line-height: 1;
  }

  .vton-instruction {
    font-size: 14px;
    color: #666;
    margin: 20px 0;
  }

  .vton-upload-area {
    border: 2px dashed #ccc;
    border-radius: 8px;
    padding: 20px;
    margin-bottom: 20px;
    background: #fafafa;
    position: relative;
  }

  .vton-file-input {
    display: none;
  }

  .vton-upload-label {
    display: inline-block;
    padding: 10px 20px;
    background: #eee;
    border-radius: 4px;
    cursor: pointer;
    font-weight: bold;
    color: #333;
    transition: background-color 0.2s ease;
  }

  .vton-upload-label:hover {
    background-color: #e0e0e0;
  }

  .vton-user-preview,
  .vton-result-image {
    max-width: 100%;
    border-radius: 8px;
    margin-top: 15px;
    box-shadow: 0 4px 10px rgba(0, 0, 0, 0.1);
    height: auto;
  }

  .vton-loading {
    margin: 20px 0;
  }

  .vton-spinner {
    border: 4px solid #f3f3f3;
    border-top: 4px solid var(--vton-accent-color);
    border-radius: 50%;
    width: 40px;
    height: 40px;
    animation: vton-spin 1s linear infinite;
    margin: 0 auto;
  }

  .vton-loading-text {
    margin-top: 15px;
    font-weight: bold;
    color: var(--vton-accent-color);
  }

  @keyframes vton-spin {
    0% {
      transform: rotate(0deg);
    }

    100% {
      transform: rotate(360deg);
    }
  }

  .vton-result-heading {
    margin-top: 10px;
    font-size: 16px;
    font-weight: 600;
  }

  .vton-success-text {
    margin-top: 15px;
    font-weight: bold;
    color: var(--vton-success-color);
    font-size: 18px;
  }
{% endstylesheet %}

{% javascript %}
  (function () {
    const section = document.getElementById('ai-vton-section');
    if (!section) return;

    const triggerButton = section.querySelector('#vton-trigger-btn');
    const overlay = section.querySelector('#vton-modal-overlay');
    const dialog = section.querySelector('#vton-modal');
    const closeButtons = section.querySelectorAll('[data-vton-close]');
    const fileInput = section.querySelector('#user-image-upload-input');
    const uploadLabel = section.querySelector('.vton-upload-label');
    const userPreview = section.querySelector('#vton-user-preview');
    const submitBtn = section.querySelector('#vton-submit-btn');
    const loadingSpinner = section.querySelector('#loading-spinner');
    const loadingText = section.querySelector('#loading-text');
    const resultArea = section.querySelector('#vton-result-area');
    const resultImg = section.querySelector('#result-image-element');

    if (
      !triggerButton ||
      !overlay ||
      !dialog ||
      !fileInput ||
      !uploadLabel ||
      !userPreview ||
      !submitBtn ||
      !loadingSpinner ||
      !loadingText ||
      !resultArea ||
      !resultImg
    ) {
      return;
    }

    const endpointUrl = section.dataset.endpointUrl || '';
    const productImageUrl = section.dataset.productImage || '';

    const textUploadRequired = section.dataset.textUploadRequired || '';
    const textErrorGeneric = section.dataset.textErrorGeneric || '';
    const textErrorStart = section.dataset.textErrorStart || '';
    const textErrorTimeout = section.dataset.textErrorTimeout || '';
    const textAiWorking = section.dataset.textAiWorking || '';

    const textChangePhoto = section.dataset.textChangePhoto || '';
    const textUploading = section.dataset.textUploading || '';
    const textTryAnother = section.dataset.textTryAnother || '';

    function openModal() {
      if (!overlay || !dialog) return;
      overlay.classList.add('is-visible');
      overlay.setAttribute('aria-hidden', 'false');
      if (typeof dialog.showModal === 'function') {
        dialog.showModal();
      }
      dialog.focus();
    }

    function closeModal() {
      if (!overlay || !dialog) return;
      if (typeof dialog.close === 'function') {
        dialog.close();
      }
      overlay.classList.remove('is-visible');
      overlay.setAttribute('aria-hidden', 'true');
      triggerButton.focus();
    }

    function handleOverlayClick(event) {
      if (event.target === overlay) {
        closeModal();
      }
    }

    function handleKeyDown(event) {
      if (event.key === 'Escape') {
        closeModal();
      }
    }

    function previewUserImage(event) {
      const file = event.target.files && event.target.files[0];
      if (!file) return;

      const reader = new FileReader();
      reader.onload = function (e) {
        const result = e.target && e.target.result ? String(e.target.result) : '';
        if (!result) return;
        userPreview.src = result;
        userPreview.hidden = false;
        uploadLabel.textContent = textChangePhoto || uploadLabel.textContent;
      };
      reader.readAsDataURL(file);
    }

    function getBase64FromFile(file) {
      return new Promise(function (resolve, reject) {
        const reader = new FileReader();
        reader.readAsDataURL(file);
        reader.onload = function () {
          const result = reader.result || '';
          const parts = String(result).split(',');
          resolve(parts.length > 1 ? parts[1] : '');
        };
        reader.onerror = function (error) {
          reject(error);
        };
      });
    }

    const delay = function (ms) {
      return new Promise(function (resolve) {
        setTimeout(resolve, ms);
      });
    };

    function resetVtonUI() {
      loadingSpinner.hidden = true;
      submitBtn.hidden = false;
    }

    async function generateVirtualTryOn() {
      if (!endpointUrl || !productImageUrl) {
        alert(textErrorGeneric);
        return;
      }

      submitBtn.hidden = true;
      loadingSpinner.hidden = false;
      loadingText.textContent = textUploading || loadingText.textContent;
      resultArea.hidden = true;

      try {
        if (!fileInput.files || !fileInput.files[0]) {
          alert(textUploadRequired);
          resetVtonUI();
          return;
        }

        const userFile = fileInput.files[0];
        const userBase64 = await getBase64FromFile(userFile);

        const formattedProductUrl = productImageUrl.startsWith('//')
          ? 'https:' + productImageUrl
          : productImageUrl;

        const submitResponse = await fetch(endpointUrl, {
          method: 'POST',
          headers: { 'Content-Type': 'application/json' },
          body: JSON.stringify({
            action: 'create_task',
            user_image_base64: userBase64,
            product_image_url: formattedProductUrl
          })
        });

        const submitData = await submitResponse.json();

        if (!submitData.task_id) {
          alert(textErrorStart + ' ' + (submitData.error || ''));
          resetVtonUI();
          return;
        }

        const taskId = submitData.task_id;
        loadingText.textContent = textAiWorking;

        let isFinished = false;
        let attempts = 0;
        const maxAttempts = 25;

        while (!isFinished && attempts < maxAttempts) {
          attempts += 1;
          await delay(3000);

          const statusResponse = await fetch(endpointUrl, {
            method: 'POST',
            headers: { 'Content-Type': 'application/json' },
            body: JSON.stringify({
              action: 'check_status',
              task_id: taskId
            })
          });

          const statusData = await statusResponse.json();
          const status = statusData.task_status
            ? String(statusData.task_status).toLowerCase()
            : '';

          if (
            status === 'success' ||
            status === 'completed' ||
            status === 'succeeded'
          ) {
            isFinished = true;

            const resultArray = statusData.task_result || [];
            const finalImageUrl =
              resultArray[0] && resultArray[0].url ? resultArray[0].url : '';

            const showResult = function () {
              if (finalImageUrl) {
                resultImg.src = finalImageUrl;
              }
              loadingSpinner.hidden = true;
              resultArea.hidden = false;
              submitBtn.textContent = textTryAnother || submitBtn.textContent;
              submitBtn.hidden = false;
            };

            if (document.startViewTransition) {
              document.startViewTransition(showResult);
            } else {
              showResult();
            }
          } else if (status === 'failed' || status === 'error') {
            isFinished = true;
            alert(textErrorGeneric + ' ' + (statusData.fail_reason || ''));
            resetVtonUI();
          }
        }

        if (!isFinished) {
          alert(textErrorTimeout);
          resetVtonUI();
        }
      } catch (error) {
        console.error('Try-on error:', error);
        alert(textErrorGeneric);
        resetVtonUI();
      }
    }

    triggerButton.addEventListener('click', openModal);
    overlay.addEventListener('click', handleOverlayClick);
    closeButtons.forEach(function (btn) {
      btn.addEventListener('click', closeModal);
    });
    document.addEventListener('keydown', handleKeyDown);
    fileInput.addEventListener('change', previewUserImage);
    submitBtn.addEventListener('click', generateVirtualTryOn);
  })();
{% endjavascript %}

{% schema %}
{
  "name": "t:sections.ai_vton.name",
  "settings": [
    {
      "type": "header",
      "content": "t:sections.ai_vton.headers.content"
    },
    {
      "type": "url",
      "id": "endpoint_url",
      "label": "t:sections.ai_vton.endpoint_label",
      "default": "https://scuk-vton.vercel.app/api/tryon"
    },
    {
      "type": "header",
      "content": "t:sections.ai_vton.headers.texts"
    },
    {
      "type": "text",
      "id": "button_label",
      "label": "t:sections.ai_vton.button_label",
      "default": ""
    },
    {
      "type": "text",
      "id": "heading",
      "label": "t:sections.ai_vton.heading",
      "default": ""
    },
    {
      "type": "textarea",
      "id": "instruction_text",
      "label": "t:sections.ai_vton.instruction",
      "default": ""
    },
    {
      "type": "text",
      "id": "upload_label",
      "label": "t:sections.ai_vton.upload_label",
      "default": ""
    },
    {
      "type": "text",
      "id": "submit_label",
      "label": "t:sections.ai_vton.submit_label",
      "default": ""
    },
    {
      "type": "text",
      "id": "result_heading",
      "label": "t:sections.ai_vton.result_heading",
      "default": ""
    },
    {
      "type": "text",
      "id": "success_text",
      "label": "t:sections.ai_vton.success_text",
      "default": ""
    },
    {
      "type": "header",
      "content": "t:sections.ai_vton.headers.colors"
    },
    {
      "type": "color",
      "id": "button_background_color",
      "label": "t:sections.ai_vton.button_background_color",
      "default": "#000000"
    },
    {
      "type": "color",
      "id": "button_background_hover_color",
      "label": "t:sections.ai_vton.button_background_hover_color",
      "default": "#333333"
    },
    {
      "type": "color",
      "id": "button_text_color",
      "label": "t:sections.ai_vton.button_text_color",
      "default": "#ffffff"
    },
    {
      "type": "color",
      "id": "accent_color",
      "label": "t:sections.ai_vton.accent_color",
      "default": "#d4af37"
    },
    {
      "type": "color",
      "id": "success_color",
      "label": "t:sections.ai_vton.success_color",
      "default": "#28a745"
    }
  ],
  "presets": [
    {
      "name": "t:sections.ai_vton.preset_name"
    }
  ]
}
{% endschema %}