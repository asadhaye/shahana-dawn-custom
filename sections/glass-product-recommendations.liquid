{% if recommendations.performed and recommendations.products_count > 0 %}
  <div class="glass-product-section__related-inner">
    <h3 class="glass-product-section__related-title">
      {{ 'sections.immersive_store.recommendations.heading' | t }}
    </h3>
    <div class="glass-product-section__related-grid">
      {% for product in recommendations.products %}
        <a
          href="{{ product.url }}"
          class="immersive-rec-card"
          data-product-handle="{{ product.handle }}"
          aria-label="{{ 'sections.immersive_store.recommendations.card_aria' | t: title: product.title | escape }}"
        >
          <div class="immersive-rec-card__media">
            {% if product.featured_image %}
              <img
                src="{{ product.featured_image | image_url: width: 300 }}"
                alt="{{ product.featured_image.alt | escape }}"
                width="300"
                height="400"
                loading="lazy"
              >
            {% endif %}
          </div>
          <div class="immersive-rec-card__info">
            <p class="immersive-rec-card__title">{{ product.title | escape }}</p>
            <p class="immersive-rec-card__price">{{ product.price | money }}</p>
          </div>
        </a>
      {% endfor %}
    </div>
  </div>
{% endif %}

{% stylesheet %}
  .glass-product-section__related-inner {
    width: 100%;
  }

  .glass-product-section__related-title {
    margin: 0 0 1.5rem;
    font-size: 1.5rem;
    font-weight: 600;
    color: #d4af37;
    text-align: center;
  }

  .glass-product-section__related-grid {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(140px, 1fr));
    gap: 1rem;
  }

  .immersive-rec-card {
    display: block;
    text-decoration: none;
    border-radius: 0.5rem;
    overflow: hidden;
    background: rgba(255, 255, 255, 0.05);
    border: 1px solid rgba(212, 175, 55, 0.15);
    transition: transform 0.2s ease, border-color 0.2s ease;
  }

  .immersive-rec-card:hover {
    transform: translateY(-4px);
    border-color: rgba(212, 175, 55, 0.4);
  }

  .immersive-rec-card__media {
    overflow: hidden;
    aspect-ratio: 3 / 4;
    width: 100%;
    background: rgba(255, 255, 255, 0.03);
  }

  .immersive-rec-card__media img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    display: block;
  }

  .immersive-rec-card__info {
    padding: 0.6rem 0.5rem 0.75rem;
  }

  .immersive-rec-card__title {
    margin: 0 0 0.25rem;
    font-size: 0.8rem;
    color: #d4af37;
    font-weight: 500;
    overflow: hidden;
    text-overflow: ellipsis;
    white-space: nowrap;
  }

  .immersive-rec-card__price {
    margin: 0;
    font-size: 0.8rem;
    color: rgba(212, 175, 55, 0.8);
    font-weight: 600;
  }

  @media (prefers-reduced-motion: reduce) {
    .immersive-rec-card {
      transform: none !important;
      transition: none !important;
    }
  }
{% endstylesheet %}

{% schema %}
{
  "name": "Product Recommendations",
  "settings": []
}
{% endschema %}
