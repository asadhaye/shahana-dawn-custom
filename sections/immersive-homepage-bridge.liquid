{%- liquid
  assign bridge_label = 'sections.immersive_journey_bridges.switch_to_3d' | t
  assign bridge_aria = 'sections.immersive_journey_bridges.switch_to_3d_aria' | t
-%}
<div
  class="immersive-homepage-bridge page-width color-{{ section.settings.color_scheme }}"
  style="padding-top: {{ section.settings.padding_top }}px; padding-bottom: {{ section.settings.padding_bottom }}px; --button-width: {{ section.settings.button_width }}px;"
>
  {%- render 'immersive-bridge-btn',
    bridge_url: '/pages/immersive',
    bridge_label: bridge_label,
    bridge_aria: bridge_aria,
    bridge_class: 'homepage'
  -%}
</div>

{% stylesheet %}
  .immersive-homepage-bridge {
    text-align: center;
  }

  .immersive-homepage-bridge .immersive-bridge-btn--homepage {
    min-width: var(--button-width);
    padding: 1rem 2rem 1rem 1.75rem;
    gap: 0.85rem;
    background: linear-gradient(135deg, rgba(10, 15, 30, 0.95) 0%, rgba(20, 14, 4, 0.95) 100%);
    border: 1.5px solid rgba(212, 175, 55, 0.85);
    box-shadow: 0 4px 28px rgba(212, 175, 55, 0.12), 0 2px 12px rgba(0, 0, 0, 0.25);
  }

  .immersive-homepage-bridge .immersive-bridge-btn--homepage:hover {
    border-color: #d4af37;
    box-shadow: 0 6px 36px rgba(212, 175, 55, 0.28), 0 2px 12px rgba(0, 0, 0, 0.3);
    transform: translateY(-1px);
  }

  .immersive-homepage-bridge .immersive-bridge-btn--homepage .immersive-bridge-btn__eyebrow {
    font-size: 0.7rem;
  }

  .immersive-homepage-bridge .immersive-bridge-btn--homepage .immersive-bridge-btn__label {
    font-size: 0.9rem;
  }

  .immersive-homepage-bridge .immersive-bridge-btn--homepage .immersive-bridge-btn__dot {
    width: 6px;
    height: 6px;
  }

  .immersive-homepage-bridge .immersive-bridge-btn--homepage .immersive-bridge-btn__arrow {
    width: 18px;
    height: 18px;
  }

  .immersive-homepage-bridge .immersive-bridge-btn--homepage:hover .immersive-bridge-btn__arrow {
    transform: translateX(4px);
  }

  @media screen and (max-width: 749px) {
    .immersive-homepage-bridge .immersive-bridge-btn--homepage {
      min-width: 0;
      padding: 0.9rem 1.5rem;
      gap: 0.7rem;
    }

    .immersive-homepage-bridge .immersive-bridge-btn--homepage .immersive-bridge-btn__label {
      font-size: 0.82rem;
    }
  }
{% endstylesheet %}

{% schema %}
{
  "name": "3D Store Bridge",
  "tag": "div",
  "settings": [
    {
      "type": "header",
      "content": "3D Store link"
    },
    {
      "type": "paragraph",
      "content": "Links visitors to the immersive 3D store from the homepage."
    },
    {
      "type": "color_scheme",
      "id": "color_scheme",
      "label": "t:sections.all.colors.label",
      "default": "scheme-1"
    },
    {
      "type": "range",
      "id": "button_width",
      "min": 100,
      "max": 600,
      "step": 10,
      "unit": "px",
      "label": "Button width",
      "default": 400
    },
    {
      "type": "range",
      "id": "padding_top",
      "min": 0,
      "max": 60,
      "step": 4,
      "unit": "px",
      "label": "t:sections.all.padding.padding_top",
      "default": 8
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "min": 0,
      "max": 60,
      "step": 4,
      "unit": "px",
      "label": "t:sections.all.padding.padding_bottom",
      "default": 8
    }
  ],
  "presets": [
    {
      "name": "3D Store Bridge"
    }
  ]
}
{% endschema %}
