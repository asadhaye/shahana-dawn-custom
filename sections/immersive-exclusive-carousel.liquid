{%- comment -%}
  Immersive Exclusive Carousel
  A CSS 3D ring of exclusive product cards arranged around a y-axis.
  DOM-only — no new WebGL canvas. Drag-to-rotate with pointer events.
  On click: calls openProductPanel(handle) if available (immersive store),
  otherwise falls back to the canonical product URL.
  Associated room: featured_collections / exclusives_story.
{%- endcomment -%}

{%- liquid
  assign source_collection = section.settings.exclusive_collection
  assign max_items = section.settings.max_items | default: 8
  assign products = null
  if source_collection != blank
    assign products = source_collection.products | limit: max_items
  endif
-%}

<section
  id="immersive-exclusive-carousel-{{ section.id }}"
  class="immersive-exclusive-carousel"
  aria-label="{{ 'sections.immersive_exclusive_carousel.aria_section_label' | t }}"
  data-immersive-exclusive-carousel
  data-ring-radius="{{ section.settings.ring_radius | default: 420 }}"
  data-drag-friction="{{ section.settings.drag_friction | default: 0.88 }}"
  data-snap-strength="{{ section.settings.snap_strength | default: 0.12 }}"
>
  <div class="immersive-exclusive-carousel__inner">
    {%- if section.settings.eyebrow != blank or section.settings.heading != blank -%}
      <header class="immersive-exclusive-carousel__header">
        {%- if section.settings.eyebrow != blank -%}
          <p class="immersive-exclusive-carousel__eyebrow">{{ section.settings.eyebrow | escape }}</p>
        {%- endif -%}
        {%- if section.settings.heading != blank -%}
          <h2 class="immersive-exclusive-carousel__heading">{{ section.settings.heading | escape }}</h2>
        {%- endif -%}
        {%- if section.settings.subheading != blank -%}
          <p class="immersive-exclusive-carousel__subheading">{{ section.settings.subheading | escape }}</p>
        {%- endif -%}
      </header>
    {%- endif -%}

    {%- if products and products.size > 0 -%}
      <div
        class="immersive-exclusive-carousel__stage"
        data-carousel-stage
        role="region"
        aria-label="{{ 'sections.immersive_exclusive_carousel.stage_aria_label' | t }}"
      >
        <div class="immersive-exclusive-carousel__ring" data-carousel-ring>
          {%- for product in products -%}
            {%- assign img_src = null -%}
            {%- if product.featured_image -%}
              {%- assign img_src = product.featured_image | image_url: width: 480, height: 640 -%}
            {%- endif -%}

            <div
              class="immersive-exclusive-carousel__panel"
              data-carousel-panel
              data-product-handle="{{ product.handle | escape }}"
              data-panel-index="{{ forloop.index0 }}"
            >
              <a
                class="immersive-exclusive-carousel__card"
                href="{{ product.url }}"
                data-immersive-bridge
                aria-label="{{ 'sections.immersive_exclusive_carousel.card_aria_label' | t: title: product.title }}"
              >
                <div class="immersive-exclusive-carousel__card-media">
                  {%- if img_src -%}
                    <img
                      class="immersive-exclusive-carousel__card-img"
                      src="{{ img_src }}"
                      alt="{{ product.featured_image.alt | default: product.title | escape }}"
                      width="480"
                      height="640"
                      loading="lazy"
                    >
                  {%- else -%}
                    {{ 'product-1' | placeholder_svg_tag: 'immersive-exclusive-carousel__card-placeholder' }}
                  {%- endif -%}
                  {%- if product.compare_at_price > product.price -%}
                    <span class="immersive-exclusive-carousel__badge">
                      {{ 'sections.immersive_exclusive_carousel.sale_badge' | t }}
                    </span>
                  {%- endif -%}
                </div>
                <div class="immersive-exclusive-carousel__card-body">
                  <p class="immersive-exclusive-carousel__card-vendor">{{ product.vendor | escape }}</p>
                  <h3 class="immersive-exclusive-carousel__card-title">{{ product.title | escape }}</h3>
                  <p class="immersive-exclusive-carousel__card-price">
                    {{ product.price | money }}
                  </p>
                </div>
              </a>
            </div>
          {%- endfor -%}
        </div>

        {%- comment -%}Drag hint — hidden once user interacts{%- endcomment -%}
        <p class="immersive-exclusive-carousel__hint" data-carousel-hint aria-hidden="true">
          {{ 'sections.immersive_exclusive_carousel.drag_hint' | t }}
        </p>
      </div>

    {%- else -%}
      <p class="immersive-exclusive-carousel__empty">
        {{ 'sections.immersive_exclusive_carousel.empty_state' | t }}
      </p>
    {%- endif -%}
  </div>
</section>

{% stylesheet %}
  /* ── Immersive Exclusive Carousel ───────────────────────────────── */
  .immersive-exclusive-carousel {
    padding: 5rem 0 6rem;
    background: #050509;
    color: #f5f5f5;
    overflow: hidden;
    user-select: none;
    -webkit-user-select: none;
  }

  .immersive-exclusive-carousel__inner {
    max-width: 80rem;
    margin: 0 auto;
    padding: 0 1.5rem;
  }

  /* Header */
  .immersive-exclusive-carousel__header {
    text-align: center;
    margin-bottom: 3.5rem;
  }

  .immersive-exclusive-carousel__eyebrow {
    font-size: 0.75rem;
    letter-spacing: 0.18em;
    text-transform: uppercase;
    color: #d4af37;
    margin: 0 0 0.75rem;
  }

  .immersive-exclusive-carousel__heading {
    font-size: clamp(1.75rem, 3.5vw, 3rem);
    font-weight: 600;
    letter-spacing: 0.03em;
    margin: 0 0 0.75rem;
    color: #f5f5f5;
  }

  .immersive-exclusive-carousel__subheading {
    font-size: 1rem;
    line-height: 1.6;
    opacity: 0.65;
    max-width: 40rem;
    margin: 0 auto;
  }

  /* Stage — the 3D perspective container */
  .immersive-exclusive-carousel__stage {
    position: relative;
    height: 520px;
    perspective: 1200px;
    perspective-origin: 50% 40%;
    cursor: grab;
  }

  .immersive-exclusive-carousel__stage:active {
    cursor: grabbing;
  }

  /* Ring — rotates around the y-axis */
  .immersive-exclusive-carousel__ring {
    position: absolute;
    inset: 0;
    transform-style: preserve-3d;
    /* Initial rotation set by JS */
  }

  /* Individual panel */
  .immersive-exclusive-carousel__panel {
    position: absolute;
    top: 50%;
    left: 50%;
    width: 220px;
    margin-left: -110px;
    margin-top: -260px;
    transform-style: preserve-3d;
    /* translateZ and rotateY set by JS */
    transition: opacity 0.3s ease;
  }

  /* Card */
  .immersive-exclusive-carousel__card {
    display: block;
    text-decoration: none;
    color: #f5f5f5;
    border-radius: 0.75rem;
    overflow: hidden;
    background: rgba(255, 255, 255, 0.04);
    border: 1px solid rgba(212, 175, 55, 0.15);
    transition: border-color 0.25s ease;
    backface-visibility: hidden;
  }

  .immersive-exclusive-carousel__card:hover {
    border-color: rgba(212, 175, 55, 0.5);
  }

  .immersive-exclusive-carousel__card:focus-visible {
    outline: 2px solid #d4af37;
    outline-offset: 3px;
  }

  .immersive-exclusive-carousel__card-media {
    position: relative;
    aspect-ratio: 3 / 4;
    overflow: hidden;
    background: #0a0a14;
  }

  .immersive-exclusive-carousel__card-img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    display: block;
    transition: transform 0.4s ease;
  }

  .immersive-exclusive-carousel__card:hover .immersive-exclusive-carousel__card-img {
    transform: scale(1.04);
  }

  .immersive-exclusive-carousel__card-placeholder {
    width: 100%;
    height: 100%;
    display: block;
    opacity: 0.2;
  }

  /* Sale badge */
  .immersive-exclusive-carousel__badge {
    position: absolute;
    top: 0.75rem;
    left: 0.75rem;
    background: #d4af37;
    color: #050509;
    font-size: 0.65rem;
    font-weight: 700;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    padding: 0.2rem 0.5rem;
    border-radius: 999px;
  }

  .immersive-exclusive-carousel__card-body {
    padding: 0.875rem 1rem 1rem;
  }

  .immersive-exclusive-carousel__card-vendor {
    font-size: 0.7rem;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    color: rgba(212, 175, 55, 0.7);
    margin: 0 0 0.25rem;
  }

  .immersive-exclusive-carousel__card-title {
    font-size: 0.9rem;
    font-weight: 600;
    margin: 0 0 0.375rem;
    line-height: 1.3;
    white-space: nowrap;
    overflow: hidden;
    text-overflow: ellipsis;
  }

  .immersive-exclusive-carousel__card-price {
    font-size: 0.875rem;
    color: rgba(245, 245, 245, 0.7);
    margin: 0;
  }

  /* Drag hint */
  .immersive-exclusive-carousel__hint {
    position: absolute;
    bottom: 0;
    left: 50%;
    transform: translateX(-50%);
    font-size: 0.75rem;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    color: rgba(212, 175, 55, 0.5);
    pointer-events: none;
    transition: opacity 0.4s ease;
  }

  .immersive-exclusive-carousel__hint[hidden] {
    display: none;
  }

  /* Empty state */
  .immersive-exclusive-carousel__empty {
    text-align: center;
    opacity: 0.5;
    font-size: 0.9rem;
    padding: 3rem 0;
  }

  /* Mobile: flatten to a horizontal scroll strip */
  @media (max-width: 767px) {
    .immersive-exclusive-carousel__stage {
      height: auto;
      perspective: none;
      overflow-x: auto;
      overflow-y: hidden;
      -webkit-overflow-scrolling: touch;
      scrollbar-width: none;
      cursor: default;
    }

    .immersive-exclusive-carousel__stage::-webkit-scrollbar {
      display: none;
    }

    .immersive-exclusive-carousel__ring {
      position: static;
      display: flex;
      gap: 1rem;
      padding: 1rem 1.5rem 2rem;
      transform: none !important;
      transform-style: flat;
    }

    .immersive-exclusive-carousel__panel {
      position: static;
      flex: 0 0 200px;
      width: 200px;
      margin: 0;
      transform: none !important;
      opacity: 1 !important;
    }

    .immersive-exclusive-carousel__hint {
      display: none;
    }
  }

  /* Reduced motion */
  @media (prefers-reduced-motion: reduce) {
    .immersive-exclusive-carousel__card,
    .immersive-exclusive-carousel__card-img {
      transition: none !important;
    }

    .immersive-exclusive-carousel__ring {
      transition: none !important;
    }
  }
{% endstylesheet %}

{% javascript %}
  (function () {
    var section = document.getElementById('immersive-exclusive-carousel-{{ section.id }}');
    if (!section) return;

    var stage = section.querySelector('[data-carousel-stage]');
    var ring = section.querySelector('[data-carousel-ring]');
    var panels = section.querySelectorAll('[data-carousel-panel]');
    var hint = section.querySelector('[data-carousel-hint]');

    if (!ring || !panels.length) return;

    // Mobile: native scroll, no 3D
    if (window.innerWidth < 768) return;

    var prefersReducedMotion = window.matchMedia && window.matchMedia('(prefers-reduced-motion: reduce)').matches;

    var radius = parseInt(section.getAttribute('data-ring-radius') || '420', 10);
    var friction = parseFloat(section.getAttribute('data-drag-friction') || '0.88');
    var snapStrength = parseFloat(section.getAttribute('data-snap-strength') || '0.12');

    var count = panels.length;
    var angleStep = 360 / count;

    // Position each panel around the ring
    panels.forEach(function (panel, i) {
      var angle = angleStep * i;
      panel.style.transform = 'rotateY(' + angle + 'deg) translateZ(' + radius + 'px)';
    });

    // Ring rotation state
    var currentAngle = 0;
    var targetAngle = 0;
    var velocity = 0;
    var isDragging = false;
    var lastX = 0;
    var rafId = null;

    function snapToNearest() {
      var nearest = Math.round(targetAngle / angleStep) * angleStep;
      targetAngle = nearest;
    }

    function animate() {
      rafId = null;
      if (!isDragging) {
        // Apply friction and snap
        velocity *= friction;
        targetAngle += velocity;
        currentAngle += (targetAngle - currentAngle) * snapStrength;
      } else {
        currentAngle += (targetAngle - currentAngle) * 0.3;
      }

      ring.style.transform = 'rotateY(' + -currentAngle + 'deg)';

      // Fade panels that are facing away
      panels.forEach(function (panel, i) {
        var panelAngle = (angleStep * i - currentAngle) % 360;
        // Normalise to [-180, 180]
        while (panelAngle > 180) panelAngle -= 360;
        while (panelAngle < -180) panelAngle += 360;
        var absAngle = Math.abs(panelAngle);
        var opacity = absAngle > 90 ? 0 : 1 - (absAngle / 90) * 0.4;
        panel.style.opacity = opacity;
      });

      if (Math.abs(velocity) > 0.05 || Math.abs(targetAngle - currentAngle) > 0.05) {
        rafId = requestAnimationFrame(animate);
      }
    }

    function startRaf() {
      if (rafId === null) {
        rafId = requestAnimationFrame(animate);
      }
    }

    if (!prefersReducedMotion) {
      // Pointer drag
      stage.addEventListener('pointerdown', function (e) {
        isDragging = true;
        lastX = e.clientX;
        velocity = 0;
        stage.setPointerCapture(e.pointerId);
        if (hint) hint.setAttribute('hidden', '');
        startRaf();
      });

      stage.addEventListener('pointermove', function (e) {
        if (!isDragging) return;
        var dx = e.clientX - lastX;
        lastX = e.clientX;
        velocity = dx * 0.4;
        targetAngle += dx * 0.25;
        startRaf();
      });

      stage.addEventListener('pointerup', function () {
        isDragging = false;
        snapToNearest();
        startRaf();
      });

      stage.addEventListener('pointercancel', function () {
        isDragging = false;
        snapToNearest();
        startRaf();
      });

      // Initial gentle spin to show depth
      targetAngle = angleStep * 0.5;
      startRaf();
    } else {
      // Reduced motion: just position the ring, no animation
      ring.style.transform = 'rotateY(0deg)';
      panels.forEach(function (panel) {
        panel.style.opacity = '1';
      });
    }

    // Click interception — open glass product panel if available
    section.addEventListener('click', function (e) {
      // Ignore drag-end clicks (significant pointer movement)
      if (Math.abs(velocity) > 2) return;

      var card = e.target.closest('[data-carousel-panel]');
      if (!card) return;

      var handle = card.getAttribute('data-product-handle');
      if (!handle) return;

      if (typeof window.openProductPanel === 'function') {
        e.preventDefault();
        window.openProductPanel(handle);
      }
      // else: let the <a href> navigate naturally
    });

    // Theme editor re-init
    document.addEventListener('shopify:section:load', function (e) {
      if (e.target && e.target.querySelector('[data-immersive-exclusive-carousel]')) {
        // Re-init handled by the IIFE re-running on section load
      }
    });
  })();
{% endjavascript %}

{% schema %}
{
  "name": "t:sections.immersive_exclusive_carousel.name",
  "settings": [
    {
      "type": "text",
      "id": "eyebrow",
      "label": "t:sections.immersive_exclusive_carousel.eyebrow_label"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "t:sections.immersive_exclusive_carousel.heading_label"
    },
    {
      "type": "text",
      "id": "subheading",
      "label": "t:sections.immersive_exclusive_carousel.subheading_label"
    },
    {
      "type": "collection",
      "id": "exclusive_collection",
      "label": "t:sections.immersive_exclusive_carousel.collection_label"
    },
    {
      "type": "range",
      "id": "max_items",
      "label": "t:sections.immersive_exclusive_carousel.max_items_label",
      "min": 3,
      "max": 12,
      "step": 1,
      "default": 8
    },
    {
      "type": "header",
      "content": "t:sections.immersive_exclusive_carousel.physics_header"
    },
    {
      "type": "range",
      "id": "ring_radius",
      "label": "t:sections.immersive_exclusive_carousel.ring_radius_label",
      "min": 280,
      "max": 600,
      "step": 20,
      "default": 420,
      "unit": "px"
    },
    {
      "type": "range",
      "id": "drag_friction",
      "label": "t:sections.immersive_exclusive_carousel.drag_friction_label",
      "min": 70,
      "max": 98,
      "step": 1,
      "default": 88,
      "info": "t:sections.immersive_exclusive_carousel.drag_friction_info"
    },
    {
      "type": "range",
      "id": "snap_strength",
      "label": "t:sections.immersive_exclusive_carousel.snap_strength_label",
      "min": 5,
      "max": 30,
      "step": 1,
      "default": 12,
      "info": "t:sections.immersive_exclusive_carousel.snap_strength_info"
    }
  ],
  "presets": [
    {
      "name": "t:sections.immersive_exclusive_carousel.preset_name"
    }
  ]
}
{% endschema %}
