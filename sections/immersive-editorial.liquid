<section
  id="immersive-editorial-{{ section.settings.room_key | escape }}"
  class="immersive-editorial immersive-editorial--{{ section.settings.room_key | escape }} immersive-editorial--layout-{{ section.settings.layout | escape }}"
  data-room-key="{{ section.settings.room_key | escape }}"
  data-layout="{{ section.settings.layout | escape }}"
  data-section-id="{{ section.id }}"
>
  <div class="immersive-editorial__hero {% if section.settings.layout == 'designers' %}immersive-editorial__hero--designers{% endif %}">
    {%- if section.settings.layout == 'designers' -%}
      <div class="immersive-designers__hero-transition-wrap">
        {%- for block in section.blocks -%}
          {%- if block.type == 'designer' -%}
            <div
              class="immersive-designers__hero-state {% if forloop.first %}is-active{% endif %}"
              data-hero-index="{{ forloop.index0 }}"
            >
              {%- if block.settings.image -%}
                <img
                  class="immersive-designers__hero-bg"
                  src="{{ block.settings.image | image_url: width: 1600 }}"
                  alt="{{ block.settings.image.alt | escape }}"
                  loading="lazy"
                  width="{{ block.settings.image.width }}"
                  height="{{ block.settings.image.height }}"
                >
              {%- else -%}
                {%- comment -%}Placeholder — replace with designer hero image in theme editor{%- endcomment -%}
                {%- assign _designer_placeholders = '1062,1074,1076' | split: ',' -%}
                {%- assign _dp_index = forloop.index0 | modulo: 3 -%}
                {%- assign _dp_id = _designer_placeholders[_dp_index] -%}
                <img
                  class="immersive-designers__hero-bg immersive-designers__hero-bg--placeholder"
                  src="https://picsum.photos/id/{{ _dp_id }}/1600/900"
                  alt=""
                  loading="lazy"
                  width="1600"
                  height="900"
                >
              {%- endif -%}
              <div class="immersive-designers__hero-content">
                {%- if block.settings.logo -%}
                  <img
                    class="immersive-designers__hero-logo"
                    src="{{ block.settings.logo | image_url: width: 400 }}"
                    alt="{{ block.settings.heading | escape }}"
                    loading="lazy"
                    width="{{ block.settings.logo.width }}"
                    height="{{ block.settings.logo.height }}"
                  >
                {%- endif -%}
                {%- if block.settings.body != blank -%}
                  <div class="immersive-designers__manifest">{{ block.settings.body }}</div>
                {%- endif -%}
              </div>
            </div>
          {%- endif -%}
        {%- endfor -%}
      </div>
    {%- else -%}
      {%- if section.settings.hero_background_image -%}
        <img
          class="immersive-editorial__hero-bg"
          src="{{ section.settings.hero_background_image | image_url: width: 1600 }}"
          srcset="
            {{ section.settings.hero_background_image | image_url: width: 800 }} 800w,
            {{ section.settings.hero_background_image | image_url: width: 1200 }} 1200w,
            {{ section.settings.hero_background_image | image_url: width: 1600 }} 1600w
          "
          sizes="100vw"
          width="{{ section.settings.hero_background_image.width }}"
          height="{{ section.settings.hero_background_image.height }}"
          alt="{{ section.settings.hero_background_image.alt | escape }}"
          loading="lazy"
        >
      {%- else -%}
        {%- comment -%}Placeholder stock image — replace with merchant image in theme editor{%- endcomment -%}
        {%- assign _placeholder_map = 'occasions:1041,featured_collections:1083,designer_houses:1062' | split: ',' -%}
        {%- assign _placeholder_src = 'https://picsum.photos/id/1062/1600/900' -%}
        {%- for _entry in _placeholder_map -%}
          {%- assign _parts = _entry | split: ':' -%}
          {%- if _parts[0] == section.settings.room_key -%}
            {%- assign _placeholder_src = 'https://picsum.photos/id/' | append: _parts[1] | append: '/1600/900' -%}
          {%- endif -%}
        {%- endfor -%}
        <img
          class="immersive-editorial__hero-bg immersive-editorial__hero-bg--placeholder"
          src="{{ _placeholder_src }}"
          alt=""
          loading="lazy"
          width="1600"
          height="900"
        >
      {%- endif -%}
      <div class="immersive-editorial__hero-panel">
        {%- if section.settings.hero_eyebrow != blank -%}
          <p class="immersive-editorial__eyebrow">{{ section.settings.hero_eyebrow | escape }}</p>
        {%- endif -%}
        {%- if section.settings.hero_heading != blank -%}
          <h2 class="immersive-editorial__heading">{{ section.settings.hero_heading | escape }}</h2>
        {%- endif -%}
        {%- if section.settings.hero_subheading != blank -%}
          <div class="immersive-editorial__subheading">{{ section.settings.hero_subheading }}</div>
        {%- endif -%}
      </div>
    {%- endif -%}
  </div>

  {%- if section.settings.layout == 'occasions' -%}
    <div class="immersive-occasions" data-room-key="{{ section.settings.room_key | escape }}">
      <div
        class="immersive-occasions__list"
        role="list"
        aria-label="{{ section.settings.hero_heading | default: 'Occasions' | escape }}"
      >
        {%- for block in section.blocks -%}
          {%- if block.type == 'occasion_card' -%}
            {%- if forloop.index == 2 or forloop.index == 4 -%}
              <div class="immersive-occasions__interstitial" {{ block.shopify_attributes }}>
                <span class="immersive-occasions__interstitial-line"></span>
                <p class="immersive-occasions__interstitial-text">A Celebration of Heritage</p>
              </div>
            {%- endif -%}

            {%- assign collection = block.settings.collection -%}
            {%- assign card_url = collection.url | default: block.settings.cta_url | default: '#' -%}
            {%- assign card_label = block.settings.heading | default: collection.title -%}
            <a
              class="immersive-occasions__card immersive-occasions__card--{{ forloop.index | modulo: 3 }}"
              href="{{ card_url }}"
              role="listitem"
              aria-label="{{ card_label | escape }}"
              {%- if collection != blank -%}
                data-collection="{{ collection.handle }}"
              {%- endif -%}
              {{ block.shopify_attributes }}
            >
              <div class="immersive-occasions__card-media">
                {%- if block.settings.image != blank -%}
                  <img
                    src="{{ block.settings.image | image_url: width: 1200 }}"
                    srcset="
                      {{ block.settings.image | image_url: width: 600 }} 600w,
                      {{ block.settings.image | image_url: width: 900 }} 900w,
                      {{ block.settings.image | image_url: width: 1200 }} 1200w
                    "
                    sizes="(max-width: 768px) 100vw, 1100px"
                    width="{{ block.settings.image.width }}"
                    height="{{ block.settings.image.height }}"
                    alt="{{ block.settings.image.alt | default: card_label | escape }}"
                    loading="lazy"
                  >
                {%- elsif collection.featured_image != blank -%}
                  <img
                    src="{{ collection.featured_image | image_url: width: 1200 }}"
                    srcset="
                      {{ collection.featured_image | image_url: width: 600 }} 600w,
                      {{ collection.featured_image | image_url: width: 900 }} 900w,
                      {{ collection.featured_image | image_url: width: 1200 }} 1200w
                    "
                    sizes="(max-width: 768px) 100vw, 1100px"
                    width="{{ collection.featured_image.width }}"
                    height="{{ collection.featured_image.height }}"
                    alt="{{ collection.featured_image.alt | default: card_label | escape }}"
                    loading="lazy"
                  >
                {%- else -%}
                  {%- comment -%}Placeholder — replace with occasion card image in theme editor{%- endcomment -%}
                  {%- assign _occ_placeholders = '64,65,66,67,68' | split: ',' -%}
                  {%- assign _occ_index = forloop.index0 | modulo: 5 -%}
                  {%- assign _occ_id = _occ_placeholders[_occ_index] -%}
                  <img
                    class="immersive-occasions__card-placeholder-img"
                    src="https://picsum.photos/id/{{ _occ_id }}/900/1200"
                    alt="{{ card_label | escape }}"
                    loading="lazy"
                    width="900"
                    height="1200"
                  >
                {%- endif -%}
              </div>
              <div class="immersive-occasions__card-content">
                <h3 class="immersive-occasions__card-heading">{{ card_label | escape }}</h3>
                {%- if block.settings.body != blank -%}
                  <div class="immersive-occasions__card-body">{{ block.settings.body }}</div>
                {%- endif -%}
                <div class="immersive-occasions__card-footer">
                  <span class="immersive-occasions__card-discover">Discover the Edit</span>
                  <span class="immersive-occasions__card-arrow" aria-hidden="true">→</span>
                </div>
              </div>
            </a>
          {%- endif -%}
        {%- endfor -%}
      </div>
    </div>
  {%- endif -%}

  {%- if section.settings.layout == 'featured_collections' -%}
    <div class="immersive-featured" data-room-key="{{ section.settings.room_key | escape }}">
      <div
        class="immersive-featured__grid"
        role="list"
        aria-label="{{ section.settings.hero_heading | default: 'Featured collections' | escape }}"
      >
        {%- for block in section.blocks -%}
          {%- if block.type == 'featured_item' -%}
            {%- assign collection = block.settings.collection -%}
            {%- assign card_url = collection.url | default: block.settings.cta_url | default: '#' -%}
            {%- assign card_label = block.settings.heading | default: collection.title -%}
            <a
              class="immersive-featured__item immersive-featured__item--{{ forloop.index | modulo: 4 }}"
              href="{{ card_url }}"
              role="listitem"
              aria-label="{{ card_label | escape }}"
              {%- if collection != blank -%}
                data-collection="{{ collection.handle }}"
              {%- endif -%}
              {{ block.shopify_attributes }}
            >
              <div class="immersive-featured__item-media">
                {%- if block.settings.image != blank -%}
                  <img
                    src="{{ block.settings.image | image_url: width: 1000 }}"
                    srcset="
                      {{ block.settings.image | image_url: width: 600 }} 600w,
                      {{ block.settings.image | image_url: width: 800 }} 800w,
                      {{ block.settings.image | image_url: width: 1000 }} 1000w
                    "
                    sizes="(max-width: 768px) 100vw, 800px"
                    width="{{ block.settings.image.width }}"
                    height="{{ block.settings.image.height }}"
                    alt="{{ block.settings.image.alt | default: card_label | escape }}"
                    loading="lazy"
                  >
                {%- elsif collection.featured_image != blank -%}
                  <img
                    src="{{ collection.featured_image | image_url: width: 1000 }}"
                    srcset="
                      {{ collection.featured_image | image_url: width: 600 }} 600w,
                      {{ collection.featured_image | image_url: width: 800 }} 800w,
                      {{ collection.featured_image | image_url: width: 1000 }} 1000w
                    "
                    sizes="(max-width: 768px) 100vw, 800px"
                    width="{{ collection.featured_image.width }}"
                    height="{{ collection.featured_image.height }}"
                    alt="{{ collection.featured_image.alt | default: card_label | escape }}"
                    loading="lazy"
                  >
                {%- else -%}
                  {%- comment -%}Placeholder — replace with featured item image in theme editor{%- endcomment -%}
                  {%- assign _feat_placeholders = '1080,1081,1082,1083' | split: ',' -%}
                  {%- assign _feat_index = forloop.index0 | modulo: 4 -%}
                  {%- assign _feat_id = _feat_placeholders[_feat_index] -%}
                  <img
                    class="immersive-featured__item-placeholder-img"
                    src="https://picsum.photos/id/{{ _feat_id }}/1000/750"
                    alt="{{ card_label | escape }}"
                    loading="lazy"
                    width="1000"
                    height="750"
                  >
                {%- endif -%}
                <div class="immersive-featured__item-reveal">
                  <span class="immersive-featured__item-tag">New Collection</span>
                  <span class="immersive-featured__item-view">View Editorial →</span>
                </div>
              </div>
              <div class="immersive-featured__item-info">
                <h3 class="immersive-featured__item-heading">{{ card_label | escape }}</h3>
                {%- if block.settings.body != blank -%}
                  <div class="immersive-featured__item-body">{{ block.settings.body }}</div>
                {%- endif -%}
              </div>
            </a>
          {%- endif -%}
        {%- endfor -%}
      </div>
    </div>
  {%- endif -%}

  {%- if section.settings.layout == 'designers' -%}
    <div class="immersive-designers" data-room-key="{{ section.settings.room_key | escape }}">
      <div
        class="immersive-designers__timeline"
        role="list"
        aria-label="{{ section.settings.hero_heading | default: 'Designers' | escape }}"
      >
        <div class="immersive-designers__timeline-ghost-label">Select Designer</div>
        <div class="immersive-designers__rail">
          {%- for block in section.blocks -%}
            {%- if block.type == 'designer' -%}
              {%- assign collection = block.settings.collection -%}
              <button
                class="immersive-designers__marker"
                type="button"
                role="listitem"
                data-index="{{ forloop.index0 }}"
                {%- if collection != blank -%}
                  data-collection-handle="{{ collection.handle }}"
                {%- endif -%}
                data-designer-label="{{ block.settings.heading | escape }}"
                {{ block.shopify_attributes }}
              >
                <span class="immersive-designers__marker-label">{{ block.settings.heading | escape }}</span>
              </button>
            {%- endif -%}
          {%- endfor -%}
        </div>
        <div class="immersive-designers__thumb" aria-hidden="true"></div>
      </div>
      <div
        class="immersive-designers__products"
        id="immersive-designers-products-{{ section.settings.room_key | escape }}"
      ></div>
    </div>
  {%- endif -%}

  {%- if section.settings.layout == 'custom' -%}
    <div class="immersive-editorial__banners">
      {%- for block in section.blocks -%}
        {%- if block.type == 'banner' -%}
          <article
            class="immersive-editorial__banner immersive-editorial__banner--{{ section.settings.layout | escape }}"
            data-editorial-layer="{{ block.settings.depth_layer | default: 50 }}"
            {{ block.shopify_attributes }}
          >
            {%- if block.settings.image -%}
              <div class="immersive-editorial__banner-media">
                <img
                  src="{{ block.settings.image | image_url: width: 1200 }}"
                  srcset="
                    {{ block.settings.image | image_url: width: 600 }} 600w,
                    {{ block.settings.image | image_url: width: 900 }} 900w,
                    {{ block.settings.image | image_url: width: 1200 }} 1200w
                  "
                  sizes="(max-width: 768px) 100vw, 50vw"
                  width="{{ block.settings.image.width }}"
                  height="{{ block.settings.image.height }}"
                  alt="{{ block.settings.image.alt | escape }}"
                  loading="lazy"
                >
                {%- if block.settings.logo -%}
                  <img
                    class="immersive-editorial__banner-logo"
                    src="{{ block.settings.logo | image_url: width: 300 }}"
                    width="{{ block.settings.logo.width }}"
                    height="{{ block.settings.logo.height }}"
                    alt="{{ block.settings.logo.alt | escape }}"
                    loading="lazy"
                  >
                {%- endif -%}
              </div>
            {%- endif -%}
            <div class="immersive-editorial__banner-content">
              <h3 class="immersive-editorial__banner-heading">{{ block.settings.heading | escape }}</h3>
              {%- if block.settings.body != blank -%}
                <div class="immersive-editorial__banner-body">{{ block.settings.body }}</div>
              {%- endif -%}
              {%- if block.settings.cta_label != blank and block.settings.cta_url != blank -%}
                <a class="immersive-editorial__cta" href="{{ block.settings.cta_url }}">
                  {{- block.settings.cta_label | escape -}}
                </a>
              {%- endif -%}
              {%- if block.settings.collection != blank -%}
                <a
                  class="immersive-editorial__collection-link"
                  href="{{ block.settings.collection.url }}"
                  data-collection="{{ block.settings.collection.handle | escape }}"
                >
                  {{- block.settings.collection.title | escape -}}
                </a>
              {%- endif -%}
            </div>
          </article>
        {%- endif -%}
      {%- endfor -%}
    </div>
  {%- endif -%}

  {%- if section.settings.layout == 'coverflow' -%}
    <div
      class="immersive-coverflow"
      data-room-key="{{ section.settings.room_key | escape }}"
      aria-label="{{ section.settings.hero_heading | default: 'Collections' | escape }}"
    >
      <div class="immersive-coverflow__track" data-coverflow-track>
        {%- for block in section.blocks -%}
          {%- if block.type == 'carousel_slide' -%}
            {%- assign collection = block.settings.collection -%}
            {%- assign slide_url = collection.url | default: block.settings.cta_url | default: '#' -%}
            {%- assign slide_label = block.settings.heading | default: collection.title -%}
            <a
              class="immersive-coverflow__slide"
              href="{{ slide_url }}"
              aria-label="{{ slide_label | escape }}"
              {%- if collection != blank -%}
                data-collection="{{ collection.handle }}"
              {%- endif -%}
              {{ block.shopify_attributes }}
            >
              <div class="immersive-coverflow__slide-media">
                {%- if block.settings.image != blank -%}
                  <img
                    src="{{ block.settings.image | image_url: width: 600 }}"
                    srcset="{{ block.settings.image | image_url: width: 400 }} 400w, {{ block.settings.image | image_url: width: 600 }} 600w, {{ block.settings.image | image_url: width: 800 }} 800w"
                    sizes="300px"
                    width="{{ block.settings.image.width }}"
                    height="{{ block.settings.image.height }}"
                    alt="{{ block.settings.image.alt | default: slide_label | escape }}"
                    loading="lazy"
                  >
                {%- elsif collection.featured_image != blank -%}
                  <img
                    src="{{ collection.featured_image | image_url: width: 600 }}"
                    srcset="{{ collection.featured_image | image_url: width: 400 }} 400w, {{ collection.featured_image | image_url: width: 600 }} 600w, {{ collection.featured_image | image_url: width: 800 }} 800w"
                    sizes="300px"
                    width="{{ collection.featured_image.width }}"
                    height="{{ collection.featured_image.height }}"
                    alt="{{ collection.featured_image.alt | default: slide_label | escape }}"
                    loading="lazy"
                  >
                {%- else -%}
                  <div class="immersive-coverflow__slide-placeholder" aria-hidden="true"></div>
                {%- endif -%}
              </div>
              <div class="immersive-coverflow__slide-label">{{ slide_label | escape }}</div>
            </a>
          {%- endif -%}
        {%- endfor -%}
      </div>
      <button
        type="button"
        class="immersive-coverflow__btn immersive-coverflow__btn--prev"
        aria-label="{{ 'sections.immersive_editorial.carousel_prev' | t | escape }}"
      >
        &#8592;
      </button>
      <button
        type="button"
        class="immersive-coverflow__btn immersive-coverflow__btn--next"
        aria-label="{{ 'sections.immersive_editorial.carousel_next' | t | escape }}"
      >
        &#8594;
      </button>
    </div>
  {%- endif -%}

  {%- if section.settings.layout == 'stacked' -%}
    <div
      class="immersive-stacked"
      data-room-key="{{ section.settings.room_key | escape }}"
      aria-label="{{ section.settings.hero_heading | default: 'Collections' | escape }}"
    >
      <div class="immersive-stacked__deck" data-stacked-deck>
        {%- for block in section.blocks -%}
          {%- if block.type == 'carousel_slide' -%}
            {%- assign collection = block.settings.collection -%}
            {%- assign slide_url = collection.url | default: block.settings.cta_url | default: '#' -%}
            {%- assign slide_label = block.settings.heading | default: collection.title -%}
            <a
              class="immersive-stacked__card"
              href="{{ slide_url }}"
              aria-label="{{ slide_label | escape }}"
              {%- if collection != blank -%}
                data-collection="{{ collection.handle }}"
              {%- endif -%}
              {{ block.shopify_attributes }}
            >
              {%- if block.settings.image != blank -%}
                <img
                  src="{{ block.settings.image | image_url: width: 800 }}"
                  srcset="{{ block.settings.image | image_url: width: 600 }} 600w, {{ block.settings.image | image_url: width: 800 }} 800w"
                  sizes="(max-width: 768px) 90vw, 480px"
                  width="{{ block.settings.image.width }}"
                  height="{{ block.settings.image.height }}"
                  alt="{{ block.settings.image.alt | default: slide_label | escape }}"
                  loading="lazy"
                >
              {%- elsif collection.featured_image != blank -%}
                <img
                  src="{{ collection.featured_image | image_url: width: 800 }}"
                  srcset="{{ collection.featured_image | image_url: width: 600 }} 600w, {{ collection.featured_image | image_url: width: 800 }} 800w"
                  sizes="(max-width: 768px) 90vw, 480px"
                  width="{{ collection.featured_image.width }}"
                  height="{{ collection.featured_image.height }}"
                  alt="{{ collection.featured_image.alt | default: slide_label | escape }}"
                  loading="lazy"
                >
              {%- else -%}
                <div class="immersive-stacked__card-placeholder" aria-hidden="true"></div>
              {%- endif -%}
              <div class="immersive-stacked__card-content">
                <h3 class="immersive-stacked__card-heading">{{ slide_label | escape }}</h3>
                {%- if block.settings.body != blank -%}
                  <p class="immersive-stacked__card-body">{{ block.settings.body | strip_html | truncate: 120 }}</p>
                {%- endif -%}
              </div>
            </a>
          {%- endif -%}
        {%- endfor -%}
      </div>
      <button
        type="button"
        class="immersive-stacked__btn"
        data-stacked-next
        aria-label="{{ 'sections.immersive_editorial.carousel_next' | t | escape }}"
      >
        <span>{{ 'sections.immersive_editorial.stacked_next' | t | escape }}</span>
        <span aria-hidden="true">&#8594;</span>
      </button>
    </div>
  {%- endif -%}

  {%- if section.settings.layout == 'perspective' -%}
    <div
      class="immersive-perspective"
      data-room-key="{{ section.settings.room_key | escape }}"
      aria-label="{{ section.settings.hero_heading | default: 'Collections' | escape }}"
    >
      <div class="immersive-perspective__stage" data-perspective-stage>
        {%- for block in section.blocks -%}
          {%- if block.type == 'carousel_slide' -%}
            {%- assign collection = block.settings.collection -%}
            {%- assign slide_url = collection.url | default: block.settings.cta_url | default: '#' -%}
            {%- assign slide_label = block.settings.heading | default: collection.title -%}
            <a
              class="immersive-perspective__item"
              href="{{ slide_url }}"
              aria-label="{{ slide_label | escape }}"
              {%- if collection != blank -%}
                data-collection="{{ collection.handle }}"
              {%- endif -%}
              {{ block.shopify_attributes }}
            >
              {%- if block.settings.image != blank -%}
                <img
                  src="{{ block.settings.image | image_url: width: 600 }}"
                  srcset="{{ block.settings.image | image_url: width: 400 }} 400w, {{ block.settings.image | image_url: width: 600 }} 600w"
                  sizes="220px"
                  width="{{ block.settings.image.width }}"
                  height="{{ block.settings.image.height }}"
                  alt="{{ block.settings.image.alt | default: slide_label | escape }}"
                  loading="lazy"
                >
              {%- elsif collection.featured_image != blank -%}
                <img
                  src="{{ collection.featured_image | image_url: width: 600 }}"
                  srcset="{{ collection.featured_image | image_url: width: 400 }} 400w, {{ collection.featured_image | image_url: width: 600 }} 600w"
                  sizes="220px"
                  width="{{ collection.featured_image.width }}"
                  height="{{ collection.featured_image.height }}"
                  alt="{{ collection.featured_image.alt | default: slide_label | escape }}"
                  loading="lazy"
                >
              {%- else -%}
                <div class="immersive-perspective__item-placeholder" aria-hidden="true"></div>
              {%- endif -%}
              <span class="immersive-perspective__item-label">{{ slide_label | escape }}</span>
            </a>
          {%- endif -%}
        {%- endfor -%}
      </div>
      <button
        type="button"
        class="immersive-perspective__btn immersive-perspective__btn--prev"
        aria-label="{{ 'sections.immersive_editorial.carousel_prev' | t | escape }}"
      >
        &#8592;
      </button>
      <button
        type="button"
        class="immersive-perspective__btn immersive-perspective__btn--next"
        aria-label="{{ 'sections.immersive_editorial.carousel_next' | t | escape }}"
      >
        &#8594;
      </button>
    </div>
  {%- endif -%}

  {%- if section.settings.layout == 'marquee' -%}
    <div
      class="immersive-marquee"
      data-room-key="{{ section.settings.room_key | escape }}"
      aria-label="{{ section.settings.hero_heading | default: 'Designers' | escape }}"
    >
      <div class="immersive-marquee__track" aria-hidden="true">
        {%- comment -%} Render twice for seamless loop {%- endcomment -%}
        {%- for pass in (1..2) -%}
          <div class="immersive-marquee__row">
            {%- for block in section.blocks -%}
              {%- if block.type == 'marquee_item' -%}
                {%- assign item_url = block.settings.collection.url | default: block.settings.cta_url | default: '#' -%}
                <a
                  class="immersive-marquee__item"
                  href="{{ item_url }}"
                  tabindex="{%- if pass == 1 -%}0{%- else -%}-1{%- endif -%}"
                  {%- if block.settings.collection != blank -%}
                    data-collection="{{ block.settings.collection.handle }}"
                  {%- endif -%}
                  {{ block.shopify_attributes }}
                >
                  {%- if block.settings.logo != blank -%}
                    <img
                      class="immersive-marquee__logo"
                      src="{{ block.settings.logo | image_url: width: 300 }}"
                      width="{{ block.settings.logo.width }}"
                      height="{{ block.settings.logo.height }}"
                      alt="{{ block.settings.heading | default: block.settings.collection.title | escape }}"
                      loading="lazy"
                    >
                  {%- else -%}
                    <span class="immersive-marquee__name">
                      {{- block.settings.heading | default: block.settings.collection.title | escape -}}
                    </span>
                  {%- endif -%}
                </a>
              {%- endif -%}
            {%- endfor -%}
          </div>
        {%- endfor -%}
      </div>
    </div>
  {%- endif -%}
</section>

{% stylesheet %}
  /* Source editorial sections are hidden — content is cloned into the overlay by JS */
  .immersive-editorial {
    display: none;
  }

  /* When rendered inside the overlay, show normally */
  .immersive-editorial-overlay__content .immersive-editorial {
    display: block;
    position: relative;
    width: 100%;
    color: #fff;
    min-height: 100vh;
    background: transparent;
  }

  /* Hero */
  .immersive-editorial__hero {
    position: relative;
    min-height: 60vh;
    display: flex;
    align-items: center;
    justify-content: center;
    overflow: hidden;
  }

  .immersive-editorial__hero--designers {
    height: 100vh;
    min-height: 600px;
    background: #000;
  }

  .immersive-designers__hero-transition-wrap {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
  }

  .immersive-designers__hero-state {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    opacity: 0;
    visibility: hidden;
    transition: opacity 0.8s cubic-bezier(0.4, 0, 0.2, 1), visibility 0.8s;
    display: flex;
    align-items: center;
    justify-content: center;
  }

  .immersive-designers__hero-state.is-active {
    opacity: 1;
    visibility: visible;
    z-index: 1;
  }

  .immersive-designers__hero-bg {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    object-fit: cover;
    filter: brightness(0.6) contrast(1.1);
    transform: scale(1.1);
    transition: transform 1.2s cubic-bezier(0.4, 0, 0.2, 1);
  }

  .immersive-designers__hero-state.is-active .immersive-designers__hero-bg {
    transform: scale(1);
  }

  .immersive-designers__hero-content {
    position: relative;
    z-index: 2;
    text-align: center;
    max-width: 800px;
    padding: 2rem;
    transform: translateY(30px);
    transition: transform 0.8s cubic-bezier(0.4, 0, 0.2, 1);
  }

  .immersive-designers__hero-state.is-active .immersive-designers__hero-content {
    transform: translateY(0);
  }

  .immersive-designers__hero-logo {
    max-width: 300px;
    height: auto;
    margin-bottom: 2rem;
    filter: drop-shadow(0 0 20px rgba(0, 0, 0, 0.5));
  }

  .immersive-designers__manifest {
    font-family: serif;
    font-style: italic;
    font-size: clamp(1.1rem, 2.5vw, 1.75rem);
    line-height: 1.4;
    color: #fff;
    text-shadow: 0 2px 15px rgba(0, 0, 0, 0.4);
    opacity: 0.9;
  }

  .immersive-editorial__hero-bg {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: center;
    z-index: 0;
  }

  .immersive-editorial__hero-panel {
    position: relative;
    z-index: 1;
    max-width: 640px;
    margin: 0 auto;
    padding: 2.5rem 2rem;
    background: rgba(10, 15, 30, 0.45);
    backdrop-filter: blur(24px);
    -webkit-backdrop-filter: blur(24px);
    border: 1px solid rgba(255, 255, 255, 0.15);
    border-radius: 1px;
    box-shadow: inset 0 0 20px rgba(255, 255, 255, 0.05), 0 8px 32px rgba(0, 0, 0, 0.3);
    text-align: center;
  }

  .immersive-editorial__eyebrow {
    font-size: 0.75rem;
    letter-spacing: 0.15em;
    text-transform: uppercase;
    color: rgba(212, 175, 55, 0.8);
    margin: 0 0 0.75rem;
  }

  .immersive-editorial__heading {
    font-size: clamp(1.75rem, 4vw, 3rem);
    font-weight: 600;
    color: #d4af37;
    margin: 0 0 1rem;
    line-height: 1.2;
  }

  .immersive-editorial__subheading {
    font-size: 1rem;
    line-height: 1.6;
    color: rgba(255, 255, 255, 0.85);
  }

  /* Banners */
  .immersive-editorial__banners {
    display: grid;
    grid-template-columns: 1fr;
    gap: 2rem;
    padding: 3rem 1.5rem;
  }

  .immersive-editorial__banner {
    display: grid;
    grid-template-columns: 1fr;
    gap: 1.5rem;
    border-radius: 1px;
    overflow: hidden;
  }

  .immersive-editorial__banner-media {
    position: relative;
    overflow: hidden;
    border-radius: 1px;
  }

  .immersive-editorial__banner-media img {
    width: 100%;
    height: auto;
    display: block;
    transition: transform 0.4s ease;
  }

  .immersive-editorial__banner:hover .immersive-editorial__banner-media img {
    transform: scale(1.03);
  }

  .immersive-editorial__banner-logo {
    position: absolute;
    bottom: 1rem;
    left: 1rem;
    max-width: 120px;
    height: auto;
    background: rgba(10, 15, 30, 0.7);
    padding: 0.5rem;
    border-radius: 0.25rem;
  }

  .immersive-editorial__banner-content {
    padding: 2rem;
    background: rgba(10, 15, 30, 0.4);
    backdrop-filter: blur(16px);
    -webkit-backdrop-filter: blur(16px);
    border: 1px solid rgba(255, 255, 255, 0.1);
    border-radius: 1px;
    box-shadow: inset 0 0 15px rgba(255, 255, 255, 0.03), 0 4px 20px rgba(0, 0, 0, 0.25);
  }

  .immersive-editorial__banner-heading {
    font-size: 1.25rem;
    font-weight: 600;
    color: #d4af37;
    margin: 0 0 0.75rem;
  }

  .immersive-editorial__banner-body {
    font-size: 0.9375rem;
    line-height: 1.6;
    color: rgba(255, 255, 255, 0.8);
    margin-bottom: 1rem;
  }

  .immersive-editorial__cta,
  .immersive-editorial__collection-link {
    display: inline-block;
    padding: 0.6rem 1.4rem;
    border: 1px solid #d4af37;
    color: #d4af37;
    text-decoration: none;
    font-size: 0.875rem;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    border-radius: 0.25rem;
    transition: background 0.2s ease, color 0.2s ease;
    margin-top: 0.5rem;
    margin-right: 0.5rem;
  }

  .immersive-editorial__cta:hover,
  .immersive-editorial__collection-link:hover {
    background: #d4af37;
    color: #0a0f1e;
  }

  .immersive-editorial__cta:focus-visible,
  .immersive-editorial__collection-link:focus-visible {
    outline: 2px solid #d4af37;
    outline-offset: 3px;
  }

  /* Mobile Asymmetric Layout */
  @media screen and (max-width: 767px) {
    .immersive-editorial__banner:nth-child(even) {
      margin-left: 10%;
      width: 90%;
    }
    .immersive-editorial__banner:nth-child(odd) {
      margin-right: 10%;
      width: 90%;
    }
  }

  /* Desktop: alternating two-column for collections and occasions */
  @media screen and (min-width: 768px) {
    .immersive-editorial__banners {
      padding: 4rem 3rem;
      gap: 3rem;
    }

    .immersive-editorial--layout-collections .immersive-editorial__banner,
    .immersive-editorial--layout-occasions .immersive-editorial__banner {
      grid-template-columns: 1fr 1fr;
      align-items: center;
    }

    .immersive-editorial--layout-collections .immersive-editorial__banner:nth-child(even),
    .immersive-editorial--layout-occasions .immersive-editorial__banner:nth-child(even) {
      direction: rtl;
    }

    .immersive-editorial--layout-collections .immersive-editorial__banner:nth-child(even) > *,
    .immersive-editorial--layout-occasions .immersive-editorial__banner:nth-child(even) > * {
      direction: ltr;
    }

    /* Three-column grid for designers */
    .immersive-editorial--layout-designers .immersive-editorial__banners {
      grid-template-columns: repeat(3, 1fr);
    }

    .immersive-editorial--layout-designers .immersive-editorial__banner {
      grid-template-columns: 1fr;
    }
  }

  /* Reduced motion */
  @media (prefers-reduced-motion: reduce) {
    .immersive-editorial *,
    .immersive-editorial *::before,
    .immersive-editorial *::after {
      animation-duration: 0.01ms !important;
      animation-iteration-count: 1 !important;
      transition-duration: 0.01ms !important;
      transform: none !important;
    }
  }

  /* ============================================================================
      Gallery layout — horizontal scrolling portrait cards
  ============================================================================ */
  .immersive-editorial__gallery {
    display: flex;
    gap: 1.25rem;
    padding: 2rem 1.5rem 3rem;
    overflow-x: auto;
    scroll-snap-type: x mandatory;
    -webkit-overflow-scrolling: touch;
    scrollbar-width: none;
  }

  .immersive-editorial__gallery::-webkit-scrollbar {
    display: none;
  }

  .immersive-editorial__gallery-card {
    flex: 0 0 260px;
    scroll-snap-align: start;
    display: flex;
    flex-direction: column;
    text-decoration: none;
    border-radius: 2px;
    overflow: hidden;
    background: rgba(10, 15, 30, 0.5);
    border: 1px solid rgba(255, 255, 255, 0.08);
    transition: transform 0.3s ease, box-shadow 0.3s ease, border-color 0.3s ease;
    cursor: pointer;
  }

  .immersive-editorial__gallery-card:hover {
    transform: translateY(-4px);
    box-shadow: 0 12px 40px rgba(0, 0, 0, 0.5);
    border-color: rgba(212, 175, 55, 0.5);
  }

  .immersive-editorial__gallery-card:focus-visible {
    outline: 2px solid #d4af37;
    outline-offset: 3px;
  }

  .immersive-editorial__gallery-card-media {
    aspect-ratio: 3 / 4;
    overflow: hidden;
    background: rgba(10, 15, 30, 0.8);
  }

  .immersive-editorial__gallery-card-media img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: center top;
    display: block;
    transition: transform 0.5s ease;
  }

  .immersive-editorial__gallery-card:hover .immersive-editorial__gallery-card-media img {
    transform: scale(1.05);
  }

  .immersive-editorial__gallery-card-placeholder {
    width: 100%;
    height: 100%;
    background: linear-gradient(160deg, rgba(212, 175, 55, 0.08), rgba(10, 15, 30, 0.6));
  }

  .immersive-editorial__gallery-card-label {
    padding: 1rem 1.1rem;
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 0.5rem;
  }

  .immersive-editorial__gallery-card-label span {
    font-size: 0.875rem;
    font-weight: 600;
    letter-spacing: 0.06em;
    text-transform: uppercase;
    color: #d4af37;
    line-height: 1.3;
  }

  .immersive-editorial__gallery-card-label::after {
    content: '→';
    color: rgba(212, 175, 55, 0.5);
    font-size: 1rem;
    flex-shrink: 0;
    transition: transform 0.2s ease, color 0.2s ease;
  }

  .immersive-editorial__gallery-card:hover .immersive-editorial__gallery-card-label::after {
    transform: translateX(4px);
    color: #d4af37;
  }

  @media (max-width: 768px) {
    .immersive-editorial__gallery {
      padding: 1.5rem 1rem 2.5rem;
      gap: 1rem;
    }

    .immersive-editorial__gallery-card {
      flex: 0 0 200px;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .immersive-editorial__gallery-card,
    .immersive-editorial__gallery-card-media img,
    .immersive-editorial__gallery-card-label::after {
      transition: none !important;
      transform: none !important;
    }
  }

  /* ============================================================================
      Designers timeline + product grid
  ============================================================================ */
  .immersive-designers {
    display: flex;
    flex-direction: column;
    gap: 0;
    padding: 0;
  }

  .immersive-designers__timeline {
    position: sticky;
    top: calc(100vh - 120px);
    z-index: 10;
    padding: 0 2rem 2rem;
    margin-top: -100px;
  }

  .immersive-designers__timeline-ghost-label {
    font-size: 0.65rem;
    letter-spacing: 0.2em;
    text-transform: uppercase;
    color: rgba(255, 255, 255, 0.4);
    text-align: center;
    margin-bottom: 1rem;
  }

  .immersive-designers__rail {
    position: relative;
    display: flex;
    justify-content: space-between;
    align-items: center;
    border-radius: 1px;
    padding: 1rem 2rem;
    background: rgba(10, 15, 30, 0.3);
    backdrop-filter: blur(20px);
    -webkit-backdrop-filter: blur(20px);
    border: 1px solid rgba(255, 255, 255, 0.1);
    max-width: 1000px;
    margin: 0 auto;
    box-shadow: 0 20px 50px rgba(0, 0, 0, 0.3);
  }

  .immersive-designers__marker {
    position: relative;
    background: transparent;
    border: 0;
    padding: 0.25rem 0.5rem;
    color: rgba(255, 255, 255, 0.7);
    font-size: 0.8125rem;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    cursor: pointer;
    white-space: nowrap;
    transition: color 0.2s ease;
    z-index: 1;
  }

  .immersive-designers__marker:hover {
    color: #fff;
  }

  .immersive-designers__marker.is-active {
    color: #0a0f1e;
    font-weight: 600;
  }

  .immersive-designers__marker:focus-visible {
    outline: 2px solid #d4af37;
    outline-offset: 3px;
    border-radius: 4px;
  }

  .immersive-designers__thumb {
    position: absolute;
    bottom: 0;
    height: 2px;
    background: #d4af37;
    pointer-events: none;
    transition: left 0.3s cubic-bezier(0.4, 0, 0.2, 1), width 0.3s cubic-bezier(0.4, 0, 0.2, 1);
    z-index: 2;
  }

  .immersive-designers__products {
    min-height: 40vh;
    padding: 4rem 2rem;
    background: linear-gradient(to bottom, #0a0f1e, #050812);
  }

  .immersive-designers__products-loading {
    display: flex;
    align-items: center;
    justify-content: center;
    height: 12rem;
    color: rgba(212, 175, 55, 0.7);
    font-size: 0.85rem;
    letter-spacing: 0.1em;
    text-transform: uppercase;
  }

  @media (prefers-reduced-motion: reduce) {
    .immersive-designers__thumb {
      transition: none !important;
    }
  }

  /* ============================================================================
      Occasions layout — vertical scroll cards
  ============================================================================ */
  .immersive-occasions {
    position: relative;
    padding: 6rem 0;
  }

  .immersive-occasions__list {
    display: flex;
    flex-direction: column;
    gap: 8rem;
    max-width: 1400px;
    margin: 0 auto;
    padding: 0 2rem;
  }

  .immersive-occasions__interstitial {
    text-align: center;
    padding: 4rem 0;
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 2rem;
  }

  .immersive-occasions__interstitial-line {
    width: 1px;
    height: 120px;
    background: linear-gradient(to bottom, transparent, rgba(212, 175, 55, 0.5), transparent);
  }

  .immersive-occasions__interstitial-text {
    font-family: serif;
    font-style: italic;
    font-size: 1.5rem;
    letter-spacing: 0.1em;
    color: rgba(255, 255, 255, 0.5);
  }

  .immersive-occasions__card {
    position: relative;
    display: flex;
    flex-direction: column;
    text-decoration: none;
    color: #fff;
    overflow: visible;
    cursor: pointer;
    transition: transform 0.4s cubic-bezier(0.2, 1, 0.3, 1);
  }

  /* Asymmetric layout variants */
  .immersive-occasions__card--1 {
    /* Large centered */
    max-width: 1100px;
    align-self: center;
  }

  .immersive-occasions__card--2 {
    /* Left aligned, portrait */
    max-width: 700px;
    align-self: flex-start;
  }

  .immersive-occasions__card--0 {
    /* Right aligned, portrait */
    max-width: 700px;
    align-self: flex-end;
  }

  .immersive-occasions__card:hover .immersive-occasions__card-media img {
    transform: scale(1.02);
  }

  .immersive-occasions__card:focus-visible {
    outline: 2px solid #d4af37;
    outline-offset: 10px;
  }

  .immersive-occasions__card-media {
    position: relative;
    overflow: hidden;
    background: rgba(0, 0, 0, 0.2);
    box-shadow: 0 40px 100px rgba(0, 0, 0, 0.5);
  }

  .immersive-occasions__card-media img {
    width: 100%;
    height: auto;
    display: block;
    transition: transform 1.2s cubic-bezier(0.2, 1, 0.3, 1);
  }

  .immersive-occasions__card-placeholder {
    width: 100%;
    aspect-ratio: 16 / 9;
    background: linear-gradient(160deg, rgba(212, 175, 55, 0.1), rgba(10, 15, 30, 0.7));
  }

  .immersive-occasions__card-content {
    padding: 2.5rem 0;
    display: flex;
    flex-direction: column;
    gap: 1.5rem;
  }

  .immersive-occasions__card--2 .immersive-occasions__card-content,
  .immersive-occasions__card--0 .immersive-occasions__card-content {
    padding: 2.5rem 1rem;
  }

  .immersive-occasions__card-heading {
    font-family: serif;
    font-size: clamp(2.5rem, 6vw, 4.5rem);
    font-weight: 400;
    color: #fff;
    margin: 0;
    line-height: 1;
    letter-spacing: -0.02em;
  }

  .immersive-occasions__card-body {
    font-size: 1.125rem;
    line-height: 1.6;
    color: rgba(255, 255, 255, 0.6);
    max-width: 500px;
  }

  .immersive-occasions__card-footer {
    display: flex;
    align-items: center;
    gap: 1.5rem;
    margin-top: 1rem;
  }

  .immersive-occasions__card-discover {
    font-size: 0.75rem;
    letter-spacing: 0.2em;
    text-transform: uppercase;
    color: #d4af37;
    position: relative;
    padding-bottom: 4px;
  }

  .immersive-occasions__card-discover::after {
    content: '';
    position: absolute;
    bottom: 0;
    left: 0;
    width: 0;
    height: 1px;
    background: #d4af37;
    transition: width 0.4s cubic-bezier(0.4, 0, 0.2, 1);
  }

  .immersive-occasions__card:hover .immersive-occasions__card-discover::after {
    width: 100%;
  }

  .immersive-occasions__card-arrow {
    font-size: 1.25rem;
    color: #d4af37;
    transition: transform 0.4s cubic-bezier(0.2, 1, 0.3, 1);
  }

  .immersive-occasions__card:hover .immersive-occasions__card-arrow {
    transform: translateX(10px);
  }

  @media (max-width: 768px) {
    .immersive-occasions__list {
      gap: 5rem;
    }
    .immersive-occasions__card--1,
    .immersive-occasions__card--2,
    .immersive-occasions__card--0 {
      max-width: 100%;
    }
    .immersive-occasions__card-heading {
      font-size: 2.5rem;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .immersive-occasions__card,
    .immersive-occasions__card-media img,
    .immersive-occasions__card-arrow {
      transition: none !important;
      transform: none !important;
    }
  }

  /* ============================================================================
      Featured collections layout — portrait cube-style banners
  ============================================================================ */
  .immersive-featured {
    position: relative;
    padding: 6rem 0;
    background: linear-gradient(to bottom, #0a0f1e, #050812);
  }

  .immersive-featured__grid {
    display: grid;
    grid-template-columns: repeat(12, 1fr);
    gap: 4rem 2rem;
    max-width: 1600px;
    margin: 0 auto;
    padding: 0 4rem;
  }

  .immersive-featured__item {
    position: relative;
    display: flex;
    flex-direction: column;
    text-decoration: none;
    color: #fff;
    transition: transform 0.6s cubic-bezier(0.2, 1, 0.3, 1);
  }

  .immersive-featured__item--1 {
    grid-column: 1 / span 7;
  }
  .immersive-featured__item--2 {
    grid-column: 8 / span 5;
    padding-top: 15vh;
  }
  .immersive-featured__item--3 {
    grid-column: 2 / span 5;
    margin-top: -10vh;
  }
  .immersive-featured__item--0 {
    grid-column: 7 / span 6;
    padding-top: 5vh;
  }

  .immersive-featured__item:hover {
    transform: translateY(-20px);
  }

  .immersive-featured__item-media {
    position: relative;
    overflow: hidden;
    background: #000;
    margin-bottom: 2rem;
