{%- assign layout = section.settings.layout -%}
<section
  id="immersive-editorial-{{ section.settings.room_key | escape }}"
  class="immersive-editorial immersive-editorial--source immersive-editorial--{{ section.settings.room_key | escape }} immersive-editorial--layout-{{ layout | escape }}"
  data-room-key="{{ section.settings.room_key | escape }}"
  data-layout="{{ layout | escape }}"
  data-section-id="{{ section.id }}"
  {% unless request.design_mode %}hidden{% endunless %}
  {% unless request.design_mode %}aria-hidden="true"{% endunless %}
>

  {%- comment -%}============================================================
    DESIGNER HOUSES — GALLERY MODE
    Mobile-first: Full-viewport cinematic hero with swipeable designer cards.
    Desktop: Full hero + horizontal scrollable timeline + product grid.
  {%- endcomment -%}
  {%- if section.settings.layout == 'designers' -%}
    <div class="immersive-designers" data-room-key="{{ section.settings.room_key | escape }}">

      {%- comment -%}Hero: Full-viewport designer image + text overlay{%- endcomment -%}
      <div class="immersive-designers__hero">
        <div class="immersive-designers__hero-slides">
          {%- for block in section.blocks -%}
            {%- if block.type == 'designer' -%}
              <div class="immersive-designers__hero-slide {% if forloop.first %}is-active{% endif %}" data-slide-index="{{ forloop.index0 }}">
                <div class="immersive-designers__hero-media">
                  {%- if block.settings.image -%}
                    <img
                      src="{{ block.settings.image | image_url: width: 1200 }}"
                      srcset="{{ block.settings.image | image_url: width: 400 }} 400w, {{ block.settings.image | image_url: width: 800 }} 800w, {{ block.settings.image | image_url: width: 1200 }} 1200w, {{ block.settings.image | image_url: width: 1600 }} 1600w"
                      sizes="100vw"
                      alt="{{ block.settings.image.alt | default: block.settings.heading | escape }}"
                      loading="{% if forloop.first %}eager{% else %}{% endif %}"
                      width="{{ block.settings.image.width }}"
                      height="{{ block.settings.image.height }}"
                    >
                  {%- else -%}
                    <div class="immersive-designers__hero-bg-placeholder"></div>
                  {%- endif -%}
                  <div class="immersive-designers__hero-overlay"></div>
                </div>
                <div class="immersive-designers__hero-text">
                  {%- if block.settings.logo -%}
                    <img class="immersive-designers__hero-logo" src="{{ block.settings.logo | image_url: width: 300 }}" alt="{{ block.settings.heading | escape }}" loading="lazy" width="{{ block.settings.logo.width }}" height="{{ block.settings.logo.height }}">
                  {%- endif -%}
                  <h2 class="immersive-designers__hero-name">{{ block.settings.heading | escape }}</h2>
                  {%- if block.settings.body != blank -%}
                    <p class="immersive-designers__hero-manifesto">{{ block.settings.body | strip_html | truncatewords: 25 }}</p>
                  {%- endif -%}
                </div>
              </div>
            {%- endif -%}
          {%- endfor -%}
        </div>
        <div class="immersive-designers__hero-dots" role="tablist">
          {%- for block in section.blocks -%}
            {%- if block.type == 'designer' -%}
              <button type="button" class="immersive-designers__hero-dot {% if forloop.first %}is-active{% endif %}" role="tab" aria-label="{{ block.settings.heading | escape }}" data-slide-index="{{ forloop.index0 }}"></button>
            {%- endif -%}
          {%- endfor -%}
        </div>
      </div>

      {%- comment -%}Timeline: Horizontal scrollable designer selector{%- endcomment -%}
      <div class="immersive-designers__timeline">
        <div class="immersive-designers__timeline-label">{{ section.settings.hero_heading | default: 'Designers' | escape }}</div>
        <div class="immersive-designers__timeline-rail" role="list">
          {%- for block in section.blocks -%}
            {%- if block.type == 'designer' -%}
              {%- assign collection = block.settings.collection -%}
              <button
                type="button"
                class="immersive-designers__timeline-marker {% if forloop.first %}is-active{% endif %}"
                role="listitem"
                data-index="{{ forloop.index0 }}"
                {%- if collection != blank -%}
                  data-collection-handle="{{ collection.handle }}"
                {%- endif -%}
                {{ block.shopify_attributes }}
              >
                <span class="immersive-designers__marker-number">
                  <small>{{ forloop.index | prepend: '0' }}</small>
                </span>
                <span class="immersive-designers__marker-label">{{ block.settings.heading | escape }}</span>
              </button>
            {%- endif -%}
          {%- endfor -%}
        </div>
      </div>

      {%- comment -%}Products: Loaded dynamically when designer is selected{%- endcomment -%}
      <div class="immersive-designers__products" id="immersive-designers-products-{{ section.settings.room_key | escape }}" data-room-key="{{ section.settings.room_key | escape }}">
        <div class="immersive-designers__products-placeholder">
          <p>Select a designer to view collection</p>
        </div>
      </div>

    </div>

  {%- comment -%}============================================================
    OCCASIONS — STORY MODE
    Mobile-first: Full-viewport scroll-driven narrative chapters.
  {%- endcomment -%}
  {%- elsif section.settings.layout == 'occasions' -%}
    <div class="immersive-occasions" data-room-key="{{ section.settings.room_key | escape }}">

      <div class="immersive-occasions__story-hero">
        {%- if section.settings.hero_background_image -%}
          <div class="immersive-occasions__story-hero-media">
            <img
              src="{{ section.settings.hero_background_image | image_url: width: 1200 }}"
              srcset="{{ section.settings.hero_background_image | image_url: width: 400 }} 400w, {{ section.settings.hero_background_image | image_url: width: 800 }} 800w, {{ section.settings.hero_background_image | image_url: width: 1200 }} 1200w"
              sizes="100vw"
              alt="{{ section.settings.hero_background_image.alt | escape }}"
              loading="eager"
              width="{{ section.settings.hero_background_image.width }}"
              height="{{ section.settings.hero_background_image.height }}"
            >
            <div class="immersive-occasions__story-hero-overlay"></div>
          </div>
        {%- endif -%}
        <div class="immersive-occasions__story-hero-text">
          {%- if section.settings.hero_eyebrow != blank -%}
            <span class="immersive-occasions__story-eyebrow">{{ section.settings.hero_eyebrow | escape }}</span>
          {%- endif -%}
          {%- if section.settings.hero_heading != blank -%}
            <h2 class="immersive-occasions__story-heading">{{ section.settings.hero_heading | escape }}</h2>
          {%- endif -%}
          {%- if section.settings.hero_subheading != blank -%}
            <div class="immersive-occasions__story-subheading">{{ section.settings.hero_subheading }}</div>
          {%- endif -%}
        </div>
        <div class="immersive-occasions__story-scroll-hint">
          <span>Scroll to explore</span>
          <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M12 5v14M5 12l7 7 7-7"/></svg>
        </div>
      </div>

      <div class="immersive-occasions__chapters">
        {%- for block in section.blocks -%}
          {%- if block.type == 'occasion_card' -%}
            {%- assign collection = block.settings.collection -%}
            <section class="immersive-occasions__chapter" data-chapter="{{ forloop.index0 }}" {{ block.shopify_attributes }}>
              <div class="immersive-occasions__chapter-inner">
                <div class="immersive-occasions__chapter-media">
                  {%- if block.settings.image -%}
                    <img
                      src="{{ block.settings.image | image_url: width: 1200 }}"
                      srcset="{{ block.settings.image | image_url: width: 400 }} 400w, {{ block.settings.image | image_url: width: 800 }} 800w, {{ block.settings.image | image_url: width: 1200 }} 1200w"
                      sizes="100vw"
                      alt="{{ block.settings.image.alt | default: block.settings.heading | escape }}"
                      loading="{% if forloop.first %}eager{% else %}{% endif %}"
                      width="{{ block.settings.image.width }}"
                      height="{{ block.settings.image.height }}"
                    >
                  {%- elsif collection.featured_image != blank -%}
                    <img
                      src="{{ collection.featured_image | image_url: width: 1200 }}"
                      srcset="{{ collection.featured_image | image_url: width: 400 }} 400w, {{ collection.featured_image | image_url: width: 800 }} 800w, {{ collection.featured_image | image_url: width: 1200 }} 1200w"
                      sizes="100vw"
                      alt="{{ collection.featured_image.alt | default: block.settings.heading | escape }}"
                      loading="{% if forloop.first %}eager{% else %}{% endif %}"
                      width="{{ collection.featured_image.width }}"
                      height="{{ collection.featured_image.height }}"
                    >
                  {%- else -%}
                    <div class="immersive-occasions__chapter-media-placeholder"></div>
                  {%- endif -%}
                  <div class="immersive-occasions__chapter-overlay"></div>
                </div>
                <div class="immersive-occasions__chapter-content">
                  <span class="immersive-occasions__chapter-number">{{ forloop.index | prepend: '0' }}</span>
                  {%- if block.settings.heading != blank -%}
                    <h3 class="immersive-occasions__chapter-heading">{{ block.settings.heading | escape }}</h3>
                  {%- endif -%}
                  {%- if block.settings.body != blank -%}
                    <div class="immersive-occasions__chapter-body">{{ block.settings.body }}</div>
                  {%- endif -%}
                  {%- if collection != blank -%}
                    <button type="button" class="immersive-occasions__chapter-cta" data-collection-handle="{{ collection.handle }}">
                      <span>Explore Collection</span>
                      <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M5 12h14M12 5l7 7-7 7"/></svg>
                    </button>
                  {%- elsif block.settings.cta_url != blank -%}
                    <a href="{{ block.settings.cta_url }}" class="immersive-occasions__chapter-cta">
                      <span>Learn More</span>
                      <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M5 12h14M12 5l7 7-7 7"/></svg>
                    </a>
                  {%- endif -%}
                </div>
              </div>
            </section>
          {%- endif -%}
        {%- endfor -%}
      </div>

    </div>

  {%- comment -%}============================================================
    FEATURED COLLECTIONS — CODEX MODE
    Mobile-first: Stacked editorial cards with varying sizes.
    Desktop: Asymmetric masonry-like grid.
  {%- endcomment -%}
  {%- elsif section.settings.layout == 'featured_collections' -%}
    <div class="immersive-featured" data-room-key="{{ section.settings.room_key | escape }}">

      <div class="immersive-featured__hero">
        {%- if section.settings.hero_eyebrow != blank -%}
          <span class="immersive-featured__hero-eyebrow">{{ section.settings.hero_eyebrow | escape }}</span>
        {%- endif -%}
        {%- if section.settings.hero_heading != blank -%}
          <h2 class="immersive-featured__hero-heading">{{ section.settings.hero_heading | escape }}</h2>
        {%- endif -%}
        {%- if section.settings.hero_subheading != blank -%}
          <div class="immersive-featured__hero-subheading">{{ section.settings.hero_subheading }}</div>
        {%- endif -%}
      </div>

      <div class="immersive-featured__grid" role="list">
        {%- for block in section.blocks -%}
          {%- if block.type == 'featured_item' -%}
            {%- assign collection = block.settings.collection -%}
            {%- assign card_label = block.settings.heading | default: collection.title -%}
            {%- assign card_mod = forloop.index | modulo: 5 -%}
            <button
              type="button"
              class="immersive-featured__card immersive-featured__card--{% if card_mod == 1 or card_mod == 0 %}large{% else %}small{% endif %}"
              role="listitem"
              aria-label="{{ card_label | escape }}"
              {%- if collection != blank -%}
                data-collection-handle="{{ collection.handle }}"
              {%- endif -%}
              {{ block.shopify_attributes }}
            >
              <div class="immersive-featured__card-media">
                {%- if block.settings.image -%}
                  <img
                    src="{{ block.settings.image | image_url: width: 1000 }}"
                    srcset="{{ block.settings.image | image_url: width: 400 }} 400w, {{ block.settings.image | image_url: width: 600 }} 600w, {{ block.settings.image | image_url: width: 800 }} 800w, {{ block.settings.image | image_url: width: 1000 }} 1000w"
                    sizes="(max-width: 768px) 100vw, (max-width: 1200px) 50vw, 33vw"
                    alt="{{ block.settings.image.alt | default: card_label | escape }}"
                    loading="{% if forloop.first or forloop.second %}eager{% else %}{% endif %}"
                    width="{{ block.settings.image.width }}"
                    height="{{ block.settings.image.height }}"
                  >
                {%- elsif collection.featured_image != blank -%}
                  <img
                    src="{{ collection.featured_image | image_url: width: 1000 }}"
                    srcset="{{ collection.featured_image | image_url: width: 400 }} 400w, {{ collection.featured_image | image_url: width: 600 }} 600w, {{ collection.featured_image | image_url: width: 800 }} 800w, {{ collection.featured_image | image_url: width: 1000 }} 1000w"
                    sizes="(max-width: 768px) 100vw, (max-width: 1200px) 50vw, 33vw"
                    alt="{{ collection.featured_image.alt | default: card_label | escape }}"
                    loading="{% if forloop.first or forloop.second %}eager{% else %}{% endif %}"
                    width="{{ collection.featured_image.width }}"
                    height="{{ collection.featured_image.height }}"
                  >
                {%- else -%}
                  <div class="immersive-featured__card-media-placeholder"></div>
                {%- endif -%}
                <div class="immersive-featured__card-overlay"></div>
              </div>
              <div class="immersive-featured__card-info">
                <span class="immersive-featured__card-number">{{ forloop.index | prepend: '0' }}</span>
                <h3 class="immersive-featured__card-heading">{{ card_label | escape }}</h3>
                {%- if block.settings.body != blank -%}
                  <p class="immersive-featured__card-body">{{ block.settings.body | strip_html | truncatewords: 12 }}</p>
                {%- endif -%}
                <span class="immersive-featured__card-cta">
                  <span>View Collection</span>
                  <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M5 12h14M12 5l7 7-7 7"/></svg>
                </span>
              </div>
            </button>
          {%- endif -%}
        {%- endfor -%}
      </div>

    </div>
  {%- endif -%}

  {%- comment -%}============================================================
    DISABLED LAYOUTS — Kept for future routing work ({% if false %})
    These are intentionally disabled but preserved for reference.
  {%- endcomment -%}

  {%- if false and layout == 'story' -%}
    <div class="immersive-story-layout" data-room-key="{{ section.settings.room_key | escape }}">
      <div class="immersive-story-layout__chapters" role="list">
        {%- for block in section.blocks -%}
          {%- if block.type == 'story_chapter' -%}
            <article class="immersive-story-layout__chapter" {{ block.shopify_attributes }}>
              <div class="immersive-story-layout__chapter-media">
                {%- if block.settings.image != blank -%}
                  <img src="{{ block.settings.image | image_url: width: 1200 }}" alt="{{ block.settings.image.alt | escape }}" loading="lazy" width="{{ block.settings.image.width }}" height="{{ block.settings.image.height }}">
                {%- endif -%}
              </div>
              <div class="immersive-story-layout__chapter-content">
                {%- if block.settings.eyebrow != blank -%}<span class="immersive-story-layout__chapter-eyebrow">{{ block.settings.eyebrow | escape }}</span>{%- endif -%}
                {%- if block.settings.heading != blank -%}<h3 class="immersive-story-layout__chapter-heading">{{ block.settings.heading | escape }}</h3>{%- endif -%}
                {%- if block.settings.body != blank -%}<div class="immersive-story-layout__chapter-body">{{ block.settings.body }}</div>{%- endif -%}
                {%- if block.settings.collection != blank or block.settings.cta_url != blank -%}
                  <div class="immersive-story-layout__chapter-cta">
                    {%- if block.settings.collection != blank -%}
                      <a href="{{ block.settings.collection.url }}" class="immersive-story-layout__cta-link" data-collection="{{ block.settings.collection.handle }}">Explore Collection</a>
                    {%- elsif block.settings.cta_url != blank -%}
                      <a href="{{ block.settings.cta_url }}" class="immersive-story-layout__cta-link">Learn More</a>
                    {%- endif -%}
                  </div>
                {%- endif -%}
              </div>
            </article>
          {%- endif -%}
        {%- endfor -%}
      </div>
    </div>
  {%- endif -%}

  {%- if false and section.settings.layout == 'custom' -%}
    <div class="immersive-custom" data-room-key="{{ section.settings.room_key | escape }}">
      <div class="immersive-editorial__banners">
        {%- for block in section.blocks -%}
          {%- if block.type == 'banner' -%}
            <a href="{{ block.settings.collection.url | default: block.settings.cta_url | default: '#' }}" class="immersive-editorial__banner immersive-custom__card" data-collection="{{ block.settings.collection.handle }}" {{ block.shopify_attributes }}>
              <div class="immersive-editorial__banner-media immersive-custom__card-media">
                {%- if block.settings.image != blank -%}
                  <img src="{{ block.settings.image | image_url: width: 800 }}" alt="{{ block.settings.image.alt | escape }}" loading="lazy" width="{{ block.settings.image.width }}" height="{{ block.settings.image.height }}">
                {%- endif -%}
              </div>
              <div class="immersive-editorial__banner-content immersive-custom__card-content">
                {%- if block.settings.heading != blank -%}<h3 class="immersive-editorial__banner-heading immersive-custom__card-heading">{{ block.settings.heading | escape }}</h3>{%- endif -%}
                {%- if block.settings.body != blank -%}<div class="immersive-editorial__banner-body immersive-custom__card-body">{{ block.settings.body }}</div>{%- endif -%}
              </div>
            </a>
          {%- endif -%}
        {%- endfor -%}
      </div>
    </div>
  {%- endif -%}

  {%- if false and layout == 'gallery' -%}
    <div class="immersive-gallery-layout" data-room-key="{{ section.settings.room_key | escape }}">
      <div class="immersive-gallery-layout__grid" role="list">
        {%- for block in section.blocks -%}
          {%- if block.type == 'gallery_card' -%}
            {%- assign card_collection = block.settings.collection -%}
            <a href="{{ card_collection.url | default: block.settings.cta_url | default: '#' }}" class="immersive-gallery-layout__card" data-collection="{{ card_collection.handle }}" role="listitem" {{ block.shopify_attributes }}>
              <div class="immersive-gallery-layout__card-media">
                {%- if block.settings.image != blank -%}
                  <img src="{{ block.settings.image | image_url: width: 600 }}" alt="{{ block.settings.image.alt | escape }}" loading="lazy" width="{{ block.settings.image.width }}" height="{{ block.settings.image.height }}">
                {%- endif -%}
              </div>
              <div class="immersive-gallery-layout__card-label"><span>{{ block.settings.heading | escape }}</span></div>
            </a>
          {%- endif -%}
        {%- endfor -%}
      </div>
    </div>
  {%- endif -%}

  {%- if false and section.settings.layout == 'stacked' -%}
    <div class="immersive-stacked" data-room-key="{{ section.settings.room_key | escape }}">
      <div class="immersive-stacked__slides" role="list">
        {%- for block in section.blocks -%}
          {%- if block.type == 'stacked_slide' -%}
            {%- assign collection = block.settings.collection -%}
            <a class="immersive-stacked__card" href="{{ collection.url | default: block.settings.cta_url | default: '#' }}" data-collection="{{ collection.handle }}" role="listitem" {{ block.shopify_attributes }}>
              <div class="immersive-stacked__card-media">
                {%- if block.settings.image != blank -%}
                  <img src="{{ block.settings.image | image_url: width: 1200 }}" alt="{{ block.settings.image.alt | escape }}" loading="lazy" width="{{ block.settings.image.width }}" height="{{ block.settings.image.height }}">
                {%- endif -%}
              </div>
              <div class="immersive-stacked__card-info">
                {%- if block.settings.heading != blank -%}<h3 class="immersive-stacked__heading-heading">{{ block.settings.heading | escape }}</h3>{%- endif -%}
              </div>
            </a>
          {%- endif -%}
        {%- endfor -%}
      </div>
    </div>
  {%- endif -%}

  {%- if false and section.settings.layout == 'perspective' -%}
    <div class="immersive-perspective" data-room-key="{{ section.settings.room_key | escape }}">
      <div class="immersive-perspective__scene" role="list">
        {%- for block in section.blocks -%}
          {%- if block.type == 'perspective_item' -%}
            {%- assign collection = block.settings.collection -%}
            <a class="immersive-perspective__item" href="{{ collection.url | default: block.settings.cta_url | default: '#' }}" data-collection="{{ collection.handle }}" role="listitem" {{ block.shopify_attributes }}>
              <div class="immersive-perspective__item-media">
                {%- if block.settings.image != blank -%}
                  <img src="{{ block.settings.image | image_url: width: 1200 }}" alt="{{ block.settings.image.alt | escape }}" loading="lazy" width="{{ block.settings.image.width }}" height="{{ block.settings.image.height }}">
                {%- endif -%}
              </div>
              <div class="immersive-perspective__item-info">
                {%- if block.settings.heading != blank -%}<h3 class="immersive-perspective__heading-heading">{{ block.settings.heading | escape }}</h3>{%- endif -%}
              </div>
            </a>
          {%- endif -%}
        {%- endfor -%}
      </div>
    </div>
  {%- endif -%}

  {%- if false and section.settings.layout == 'coverflow' -%}
    <div class="immersive-coverflow" data-room-key="{{ section.settings.room_key | escape }}" aria-label="{{ section.settings.hero_heading | default: 'Collections' | escape }}">
      <div class="immersive-coverflow__track" data-coverflow-track>
        {%- for block in section.blocks -%}
          {%- if block.type == 'carousel_slide' -%}
            {%- assign collection = block.settings.collection -%}
            <a class="immersive-coverflow__slide" href="{{ collection.url | default: block.settings.cta_url | default: '#' }}" data-collection="{{ collection.handle }}" aria-label="{{ block.settings.heading | default: collection.title | escape }}" {{ block.shopify_attributes }}>
              <div class="immersive-coverflow__slide-media">
                {%- if block.settings.image != blank -%}
                  <img src="{{ block.settings.image | image_url: width: 800 }}" alt="{{ block.settings.image.alt | escape }}" loading="lazy" width="{{ block.settings.image.width }}" height="{{ block.settings.image.height }}">
                {%- endif -%}
              </div>
              <div class="immersive-coverflow__slide-info">
                {%- if block.settings.heading != blank -%}<h3 class="immersive-coverflow__slide-heading">{{ block.settings.heading | escape }}</h3>{%- endif -%}
              </div>
            </a>
          {%- endif -%}
        {%- endfor -%}
      </div>
    </div>
  {%- endif -%}

  {%- if false and section.settings.layout == 'marquee' -%}
    <div class="immersive-marquee" data-room-key="{{ section.settings.room_key | escape }}">
      <div class="immersive-marquee__track">
        {%- for block in section.blocks -%}
          {%- if block.type == 'marquee_item' -%}
            {%- assign collection = block.settings.collection -%}
            <a class="immersive-marquee__item" href="{{ collection.url | default: block.settings.cta_url | default: '#' }}" data-collection="{{ collection.handle }}" {{ block.shopify_attributes }}>
              <span class="immersive-marquee__item-label">{{ block.settings.heading | escape }}</span>
            </a>
          {%- endif -%}
        {%- endfor -%}
      </div>
    </div>
  {%- endif -%}

</section>


{% schema %}
{
  "name": "t:sections.immersive_editorial.name",
  "settings": [
    {
      "type": "select",
      "id": "room_key",
      "default": "featured_collections",
      "label": "t:sections.immersive_editorial.settings.room_key.label",
      "options": [
        { "value": "designer_houses", "label": "t:sections.immersive_editorial.settings.room_key.options__1.label" },
        { "value": "occasions", "label": "t:sections.immersive_editorial.settings.room_key.options__2.label" },
        { "value": "featured_collections", "label": "t:sections.immersive_editorial.settings.room_key.options__3.label" }
      ]
    },
    {
      "type": "select",
      "id": "layout",
