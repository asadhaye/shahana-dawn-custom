{% javascript %}
  (function () {
    var reduceMotion = window.matchMedia('(prefers-reduced-motion: reduce)').matches;

    function clamp(val, min, max) {
      return Math.min(Math.max(val, min), max);
    }

    function initEditorialParallax(sectionId) {
      var root = document.getElementById('immersive-editorial-' + sectionId);
      if (!root) return;

      var layers = root.querySelectorAll('[data-editorial-layer]');
      if (!layers.length) return;

      if (reduceMotion) return;

      var rafPending = false;

      function tick() {
        rafPending = false;
        var rect = root.getBoundingClientRect();
        var viewportH = window.innerHeight || document.documentElement.clientHeight;
        var progress = clamp((rect.top + rect.height / 2 - viewportH / 2) / viewportH, -1, 1);
        for (var i = 0; i < layers.length; i++) {
          var depth = parseInt(layers[i].dataset.editorialLayer, 10) / 100;
          var offset = progress * depth * 40;
          layers[i].style.transform = 'translateY(' + offset + 'px)';
        }
      }

      function onScroll() {
        if (!rafPending) {
          rafPending = true;
          requestAnimationFrame(tick);
        }
      }

      window.addEventListener('scroll', onScroll, { passive: true });
      tick();
    }

    function initAll() {
      var sections = document.querySelectorAll('[data-section-id]');
      for (var i = 0; i < sections.length; i++) {
        var el = sections[i];
        if (el.classList.contains('immersive-editorial')) {
          initEditorialParallax(el.dataset.roomKey);
        }
      }
    }

    document.addEventListener('shopify:section:load', function (e) {
      var section = e.target;
      if (section && section.classList.contains('immersive-editorial')) {
        initEditorialParallax(section.dataset.roomKey);
      }
    });

    document.addEventListener('shopify:section:select', function (e) {
      var section = e.target;
      if (section && section.classList.contains('immersive-editorial')) {
        initEditorialParallax(section.dataset.roomKey);
      }
    });

    if (document.readyState === 'loading') {
      document.addEventListener('DOMContentLoaded', initAll);
    } else {
      initAll();
    }

    // ── CoverFlow carousel ──────────────────────────────────────────────────
    function initCoverflow(root) {
      var track = root.querySelector('[data-coverflow-track]');
      if (!track) return;
      var slides = Array.from(track.querySelectorAll('.immersive-coverflow__slide'));
      if (!slides.length) return;
      var current = Math.floor(slides.length / 2);

      function render() {
        slides.forEach(function (slide, i) {
          var offset = i - current;
          var absOffset = Math.abs(offset);
          var x = offset * 220;
          var rotY = offset < 0 ? 45 : offset > 0 ? -45 : 0;
          var scale = absOffset === 0 ? 1 : absOffset === 1 ? 0.85 : 0.7;
          var opacity = absOffset === 0 ? 1 : absOffset === 1 ? 0.7 : 0.4;
          var zIndex = slides.length - absOffset;
          var shadow = absOffset === 0 ? '0 30px 80px rgba(0,0,0,0.6)' : 'none';
          if (reduceMotion) {
            slide.style.transform = 'translateX(' + x + 'px)';
          } else {
            slide.style.transform = 'translateX(' + x + 'px) rotateY(' + rotY + 'deg) scale(' + scale + ')';
          }
          slide.style.opacity = opacity;
          slide.style.zIndex = zIndex;
          slide.style.boxShadow = shadow;
        });
      }

      function prev() {
        if (current > 0) {
          current--;
          render();
        }
      }
      function next() {
        if (current < slides.length - 1) {
          current++;
          render();
        }
      }

      var prevBtn = root.querySelector('.immersive-coverflow__btn--prev');
      var nextBtn = root.querySelector('.immersive-coverflow__btn--next');
      if (prevBtn) prevBtn.addEventListener('click', prev);
      if (nextBtn) nextBtn.addEventListener('click', next);

      slides.forEach(function (slide, i) {
        slide.addEventListener('click', function (e) {
          if (i !== current) {
            e.preventDefault();
            current = i;
            render();
          }
        });
      });

      render();
    }

    // ── Stacked card carousel ───────────────────────────────────────────────
    function initStacked(root) {
      var deck = root.querySelector('[data-stacked-deck]');
      if (!deck) return;
      var cards = Array.from(deck.querySelectorAll('.immersive-stacked__card'));
      if (!cards.length) return;
      var current = 0;

      function render() {
        cards.forEach(function (card, i) {
          var offset = (i - current + cards.length) % cards.length;
          var maxVisible = Math.min(4, cards.length);
          if (offset >= maxVisible) {
            card.style.opacity = '0';
            card.style.pointerEvents = 'none';
            card.style.zIndex = '0';
            return;
          }
          var scale = 1 - offset * 0.05;
          var translateY = offset * -12;
          var translateX = offset * 6;
          card.style.transform =
            'translateY(' + translateY + 'px) translateX(' + translateX + 'px) scale(' + scale + ')';
          card.style.opacity = offset === 0 ? '1' : String(1 - offset * 0.2);
          card.style.zIndex = String(maxVisible - offset);
          card.style.pointerEvents = offset === 0 ? 'auto' : 'none';
          card.style.boxShadow = offset === 0 ? '0 40px 80px rgba(0,0,0,0.5)' : 'none';
        });
      }

      var nextBtn = root.querySelector('[data-stacked-next]');
      if (nextBtn) {
        nextBtn.addEventListener('click', function () {
          current = (current + 1) % cards.length;
          render();
        });
      }

      render();
    }

    // ── 3D Perspective carousel ─────────────────────────────────────────────
    function initPerspective(root) {
      var stage = root.querySelector('[data-perspective-stage]');
      if (!stage) return;
      var items = Array.from(stage.querySelectorAll('.immersive-perspective__item'));
      if (!items.length) return;
      var current = 0;
      var total = items.length;

      function render() {
        items.forEach(function (item, i) {
          var offset = i - current;
          // Wrap around
          if (offset > total / 2) offset -= total;
          if (offset < -total / 2) offset += total;
          var absOffset = Math.abs(offset);
          var x = offset * 260;
          var z = -absOffset * 120;
          var scale = absOffset === 0 ? 1 : Math.max(0.6, 1 - absOffset * 0.15);
          var opacity = absOffset === 0 ? 1 : Math.max(0.3, 1 - absOffset * 0.25);
          var zIndex = total - absOffset;
          if (reduceMotion) {
            item.style.transform = 'translateX(' + x + 'px)';
          } else {
            item.style.transform = 'translateX(' + x + 'px) translateZ(' + z + 'px) scale(' + scale + ')';
          }
          item.style.opacity = opacity;
          item.style.zIndex = zIndex;
          item.style.boxShadow = absOffset === 0 ? '0 20px 60px rgba(0,0,0,0.5)' : 'none';
        });
      }

      function prev() {
        current = (current - 1 + total) % total;
        render();
      }
      function next() {
        current = (current + 1) % total;
        render();
      }

      var prevBtn = root.querySelector('.immersive-perspective__btn--prev');
      var nextBtn = root.querySelector('.immersive-perspective__btn--next');
      if (prevBtn) prevBtn.addEventListener('click', prev);
      if (nextBtn) nextBtn.addEventListener('click', next);

      items.forEach(function (item, i) {
        item.addEventListener('click', function (e) {
          if (i !== current) {
            e.preventDefault();
            current = i;
            render();
          }
        });
      });

      render();
    }

    // ── Init all carousel layouts ───────────────────────────────────────────
    function initCarousels(container) {
      container = container || document;
      container.querySelectorAll('.immersive-coverflow').forEach(initCoverflow);
      container.querySelectorAll('.immersive-stacked').forEach(initStacked);
      container.querySelectorAll('.immersive-perspective').forEach(initPerspective);
    }

    document.addEventListener('shopify:section:load', function (e) {
      initCarousels(e.target);
    });

    document.addEventListener('shopify:section:select', function (e) {
      initCarousels(e.target);
    });

    if (document.readyState === 'loading') {
      document.addEventListener('DOMContentLoaded', function () {
        initCarousels();
      });
    } else {
      initCarousels();
    }
  })();
{% endjavascript %}

