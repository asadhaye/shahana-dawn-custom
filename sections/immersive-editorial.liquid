<section
  id="immersive-editorial-{{ section.settings.room_key | escape }}"
  class="immersive-editorial immersive-editorial--{{ section.settings.room_key | escape }} immersive-editorial--layout-{{ section.settings.layout | escape }}"
  data-room-key="{{ section.settings.room_key | escape }}"
  data-layout="{{ section.settings.layout | escape }}"
  data-section-id="{{ section.id }}"
>
  <div class="immersive-editorial__hero {% if section.settings.layout == 'designers' %}immersive-editorial__hero--designers{% endif %}">
    {%- if section.settings.layout == 'designers' -%}
      <div class="immersive-designers__hero-transition-wrap">
        {%- for block in section.blocks -%}
          {%- if block.type == 'designer' -%}
            <div
              class="immersive-designers__hero-state {% if forloop.first %}is-active{% endif %}"
              data-hero-index="{{ forloop.index0 }}"
            >
              {%- if block.settings.image -%}
                <img
                  class="immersive-designers__hero-bg"
                  src="{{ block.settings.image | image_url: width: 1600 }}"
                  alt="{{ block.settings.image.alt | escape }}"
                  loading="lazy"
                  width="{{ block.settings.image.width }}"
                  height="{{ block.settings.image.height }}"
                >
              {%- endif -%}
              <div class="immersive-designers__hero-content">
                {%- if block.settings.logo -%}
                  <img
                    class="immersive-designers__hero-logo"
                    src="{{ block.settings.logo | image_url: width: 400 }}"
                    alt="{{ block.settings.heading | escape }}"
                    loading="lazy"
                    width="{{ block.settings.logo.width }}"
                    height="{{ block.settings.logo.height }}"
                  >
                {%- endif -%}
                {%- if block.settings.body != blank -%}
                  <div class="immersive-designers__manifest">{{ block.settings.body }}</div>
                {%- endif -%}
              </div>
            </div>
          {%- endif -%}
        {%- endfor -%}
      </div>
    {%- else -%}
      {%- if section.settings.hero_background_image -%}
        <img
          class="immersive-editorial__hero-bg"
          src="{{ section.settings.hero_background_image | image_url: width: 1600 }}"
          srcset="
            {{ section.settings.hero_background_image | image_url: width: 800 }} 800w,
            {{ section.settings.hero_background_image | image_url: width: 1200 }} 1200w,
            {{ section.settings.hero_background_image | image_url: width: 1600 }} 1600w
          "
          sizes="100vw"
          width="{{ section.settings.hero_background_image.width }}"
          height="{{ section.settings.hero_background_image.height }}"
          alt="{{ section.settings.hero_background_image.alt | escape }}"
          loading="lazy"
        >
      {%- endif -%}
      <div class="immersive-editorial__hero-panel">
        {%- if section.settings.hero_eyebrow != blank -%}
          <p class="immersive-editorial__eyebrow">{{ section.settings.hero_eyebrow | escape }}</p>
        {%- endif -%}
        {%- if section.settings.hero_heading != blank -%}
          <h2 class="immersive-editorial__heading">{{ section.settings.hero_heading | escape }}</h2>
        {%- endif -%}
        {%- if section.settings.hero_subheading != blank -%}
          <div class="immersive-editorial__subheading">{{ section.settings.hero_subheading }}</div>
        {%- endif -%}
      </div>
    {%- endif -%}
  </div>

  {%- if section.settings.layout == 'occasions' -%}
    <div class="immersive-occasions" data-room-key="{{ section.settings.room_key | escape }}">
      <div
        class="immersive-occasions__list"
        role="list"
        aria-label="{{ section.settings.hero_heading | default: 'Occasions' | escape }}"
      >
        {%- for block in section.blocks -%}
          {%- if block.type == 'occasion_card' -%}
            {%- if forloop.index == 2 or forloop.index == 4 -%}
              <div class="immersive-occasions__interstitial" {{ block.shopify_attributes }}>
                <span class="immersive-occasions__interstitial-line"></span>
                <p class="immersive-occasions__interstitial-text">A Celebration of Heritage</p>
              </div>
            {%- endif -%}

            {%- assign collection = block.settings.collection -%}
            {%- assign card_url = collection.url | default: block.settings.cta_url | default: '#' -%}
            {%- assign card_label = block.settings.heading | default: collection.title -%}
            <a
              class="immersive-occasions__card immersive-occasions__card--{{ forloop.index | modulo: 3 }}"
              href="{{ card_url }}"
              role="listitem"
              aria-label="{{ card_label | escape }}"
              {%- if collection != blank -%}
                data-collection="{{ collection.handle }}"
              {%- endif -%}
              {{ block.shopify_attributes }}
            >
              <div class="immersive-occasions__card-media">
                {%- if block.settings.image != blank -%}
                  <img
                    src="{{ block.settings.image | image_url: width: 1200 }}"
                    srcset="
                      {{ block.settings.image | image_url: width: 600 }} 600w,
                      {{ block.settings.image | image_url: width: 900 }} 900w,
                      {{ block.settings.image | image_url: width: 1200 }} 1200w
                    "
                    sizes="(max-width: 768px) 100vw, 1100px"
                    width="{{ block.settings.image.width }}"
                    height="{{ block.settings.image.height }}"
                    alt="{{ block.settings.image.alt | default: card_label | escape }}"
                    loading="lazy"
                  >
                {%- elsif collection.featured_image != blank -%}
                  <img
                    src="{{ collection.featured_image | image_url: width: 1200 }}"
                    srcset="
                      {{ collection.featured_image | image_url: width: 600 }} 600w,
                      {{ collection.featured_image | image_url: width: 900 }} 900w,
                      {{ collection.featured_image | image_url: width: 1200 }} 1200w
                    "
                    sizes="(max-width: 768px) 100vw, 1100px"
                    width="{{ collection.featured_image.width }}"
                    height="{{ collection.featured_image.height }}"
                    alt="{{ collection.featured_image.alt | default: card_label | escape }}"
                    loading="lazy"
                  >
                {%- else -%}
                  <div class="immersive-occasions__card-placeholder" aria-hidden="true"></div>
                {%- endif -%}
              </div>
              <div class="immersive-occasions__card-content">
                <h3 class="immersive-occasions__card-heading">{{ card_label | escape }}</h3>
                {%- if block.settings.body != blank -%}
                  <div class="immersive-occasions__card-body">{{ block.settings.body }}</div>
                {%- endif -%}
                <div class="immersive-occasions__card-footer">
                  <span class="immersive-occasions__card-discover">Discover the Edit</span>
                  <span class="immersive-occasions__card-arrow" aria-hidden="true">→</span>
                </div>
              </div>
            </a>
          {%- endif -%}
        {%- endfor -%}
      </div>
    </div>
  {%- endif -%}

  {%- if section.settings.layout == 'featured_collections' -%}
    <div class="immersive-featured" data-room-key="{{ section.settings.room_key | escape }}">
      <div
        class="immersive-featured__grid"
        role="list"
        aria-label="{{ section.settings.hero_heading | default: 'Featured collections' | escape }}"
      >
        {%- for block in section.blocks -%}
          {%- if block.type == 'featured_item' -%}
            {%- assign collection = block.settings.collection -%}
            {%- assign card_url = collection.url | default: block.settings.cta_url | default: '#' -%}
            {%- assign card_label = block.settings.heading | default: collection.title -%}
            <a
              class="immersive-featured__item immersive-featured__item--{{ forloop.index | modulo: 4 }}"
              href="{{ card_url }}"
              role="listitem"
              aria-label="{{ card_label | escape }}"
              {%- if collection != blank -%}
                data-collection="{{ collection.handle }}"
              {%- endif -%}
              {{ block.shopify_attributes }}
            >
              <div class="immersive-featured__item-media">
                {%- if block.settings.image != blank -%}
                  <img
                    src="{{ block.settings.image | image_url: width: 1000 }}"
                    srcset="
                      {{ block.settings.image | image_url: width: 600 }} 600w,
                      {{ block.settings.image | image_url: width: 800 }} 800w,
                      {{ block.settings.image | image_url: width: 1000 }} 1000w
                    "
                    sizes="(max-width: 768px) 100vw, 800px"
                    width="{{ block.settings.image.width }}"
                    height="{{ block.settings.image.height }}"
                    alt="{{ block.settings.image.alt | default: card_label | escape }}"
                    loading="lazy"
                  >
                {%- elsif collection.featured_image != blank -%}
                  <img
                    src="{{ collection.featured_image | image_url: width: 1000 }}"
                    srcset="
                      {{ collection.featured_image | image_url: width: 600 }} 600w,
                      {{ collection.featured_image | image_url: width: 800 }} 800w,
                      {{ collection.featured_image | image_url: width: 1000 }} 1000w
                    "
                    sizes="(max-width: 768px) 100vw, 800px"
                    width="{{ collection.featured_image.width }}"
                    height="{{ collection.featured_image.height }}"
                    alt="{{ collection.featured_image.alt | default: card_label | escape }}"
                    loading="lazy"
                  >
                {%- else -%}
                  <div class="immersive-featured__item-placeholder" aria-hidden="true"></div>
                {%- endif -%}
                <div class="immersive-featured__item-reveal">
                  <span class="immersive-featured__item-tag">New Collection</span>
                  <span class="immersive-featured__item-view">View Editorial →</span>
                </div>
              </div>
              <div class="immersive-featured__item-info">
                <h3 class="immersive-featured__item-heading">{{ card_label | escape }}</h3>
                {%- if block.settings.body != blank -%}
                  <div class="immersive-featured__item-body">{{ block.settings.body }}</div>
                {%- endif -%}
              </div>
            </a>
          {%- endif -%}
        {%- endfor -%}
      </div>
    </div>
  {%- endif -%}

  {%- if section.settings.layout == 'designers' -%}
    <div class="immersive-designers" data-room-key="{{ section.settings.room_key | escape }}">
      <div
        class="immersive-designers__timeline"
        role="list"
        aria-label="{{ section.settings.hero_heading | default: 'Designers' | escape }}"
      >
        <div class="immersive-designers__timeline-ghost-label">Select Designer</div>
        <div class="immersive-designers__rail">
          {%- for block in section.blocks -%}
            {%- if block.type == 'designer' -%}
              {%- assign collection = block.settings.collection -%}
              <button
                class="immersive-designers__marker"
                type="button"
                role="listitem"
                data-index="{{ forloop.index0 }}"
                {%- if collection != blank -%}
                  data-collection-handle="{{ collection.handle }}"
                {%- endif -%}
                data-designer-label="{{ block.settings.heading | escape }}"
                {{ block.shopify_attributes }}
              >
                <span class="immersive-designers__marker-label">{{ block.settings.heading | escape }}</span>
              </button>
            {%- endif -%}
          {%- endfor -%}
        </div>
        <div class="immersive-designers__thumb" aria-hidden="true"></div>
      </div>
      <div
        class="immersive-designers__products"
        id="immersive-designers-products-{{ section.settings.room_key | escape }}"
      ></div>
    </div>
  {%- endif -%}

  {%- if section.settings.layout == 'custom' -%}
    <div class="immersive-editorial__banners">
      {%- for block in section.blocks -%}
        {%- if block.type == 'banner' -%}
          <article
            class="immersive-editorial__banner immersive-editorial__banner--{{ section.settings.layout | escape }}"
            data-editorial-layer="{{ block.settings.depth_layer | default: 50 }}"
            {{ block.shopify_attributes }}
          >
            {%- if block.settings.image -%}
              <div class="immersive-editorial__banner-media">
                <img
                  src="{{ block.settings.image | image_url: width: 1200 }}"
                  srcset="
                    {{ block.settings.image | image_url: width: 600 }} 600w,
                    {{ block.settings.image | image_url: width: 900 }} 900w,
                    {{ block.settings.image | image_url: width: 1200 }} 1200w
                  "
                  sizes="(max-width: 768px) 100vw, 50vw"
                  width="{{ block.settings.image.width }}"
                  height="{{ block.settings.image.height }}"
                  alt="{{ block.settings.image.alt | escape }}"
                  loading="lazy"
                >
                {%- if block.settings.logo -%}
                  <img
                    class="immersive-editorial__banner-logo"
                    src="{{ block.settings.logo | image_url: width: 300 }}"
                    width="{{ block.settings.logo.width }}"
                    height="{{ block.settings.logo.height }}"
                    alt="{{ block.settings.logo.alt | escape }}"
                    loading="lazy"
                  >
                {%- endif -%}
              </div>
            {%- endif -%}
            <div class="immersive-editorial__banner-content">
              <h3 class="immersive-editorial__banner-heading">{{ block.settings.heading | escape }}</h3>
              {%- if block.settings.body != blank -%}
                <div class="immersive-editorial__banner-body">{{ block.settings.body }}</div>
              {%- endif -%}
              {%- if block.settings.cta_label != blank and block.settings.cta_url != blank -%}
                <a class="immersive-editorial__cta" href="{{ block.settings.cta_url }}">
                  {{- block.settings.cta_label | escape -}}
                </a>
              {%- endif -%}
              {%- if block.settings.collection != blank -%}
                <a
                  class="immersive-editorial__collection-link"
                  href="{{ block.settings.collection.url }}"
                  data-collection="{{ block.settings.collection.handle | escape }}"
                >
                  {{- block.settings.collection.title | escape -}}
                </a>
              {%- endif -%}
            </div>
          </article>
        {%- endif -%}
      {%- endfor -%}
    </div>
  {%- endif -%}

  {%- if section.settings.layout == 'gallery' -%}
    <div
      class="immersive-editorial__gallery"
      role="list"
      aria-label="{{ section.settings.hero_heading | default: 'Collections' | escape }}"
    >
      {%- for block in section.blocks -%}
        {%- if block.type == 'gallery_card' -%}
          {%- assign collection = block.settings.collection -%}
          {%- assign card_url = collection.url | default: block.settings.cta_url | default: '#' -%}
          {%- assign card_label = block.settings.heading | default: collection.title -%}
          <a
            class="immersive-editorial__gallery-card"
            href="{{ card_url }}"
            role="listitem"
            aria-label="{{ card_label | escape }}"
            {%- if collection != blank -%}
              data-collection="{{ collection.handle }}"
            {%- endif -%}
            {{ block.shopify_attributes }}
          >
            <div class="immersive-editorial__gallery-card-media">
              {%- if block.settings.image != blank -%}
                <img
                  src="{{ block.settings.image | image_url: width: 600 }}"
                  srcset="
                    {{ block.settings.image | image_url: width: 400 }} 400w,
                    {{ block.settings.image | image_url: width: 600 }} 600w,
                    {{ block.settings.image | image_url: width: 800 }} 800w
                  "
                  sizes="280px"
                  width="{{ block.settings.image.width }}"
                  height="{{ block.settings.image.height }}"
                  alt="{{ block.settings.image.alt | default: card_label | escape }}"
                  loading="lazy"
                >
              {%- elsif collection.featured_image != blank -%}
                <img
                  src="{{ collection.featured_image | image_url: width: 600 }}"
                  srcset="
                    {{ collection.featured_image | image_url: width: 400 }} 400w,
                    {{ collection.featured_image | image_url: width: 600 }} 600w,
                    {{ collection.featured_image | image_url: width: 800 }} 800w
                  "
                  sizes="280px"
                  width="{{ collection.featured_image.width }}"
                  height="{{ collection.featured_image.height }}"
                  alt="{{ collection.featured_image.alt | default: card_label | escape }}"
                  loading="lazy"
                >
              {%- else -%}
                <div class="immersive-editorial__gallery-card-placeholder" aria-hidden="true"></div>
              {%- endif -%}
            </div>
            <div class="immersive-editorial__gallery-card-label">
              <span>{{ card_label | escape }}</span>
            </div>
          </a>
        {%- endif -%}
      {%- endfor -%}
    </div>
  {%- endif -%}
</section>

{% stylesheet %}
  /* Source editorial sections are hidden — content is cloned into the overlay by JS */
  .immersive-editorial {
    display: none;
  }

  /* When rendered inside the overlay, show normally */
  .immersive-editorial-overlay__content .immersive-editorial {
    display: block;
    position: relative;
    width: 100%;
    color: #fff;
    min-height: 100vh;
    background: transparent;
  }

  /* Hero */
  .immersive-editorial__hero {
    position: relative;
    min-height: 60vh;
    display: flex;
    align-items: center;
    justify-content: center;
    overflow: hidden;
  }

  .immersive-editorial__hero--designers {
    height: 100vh;
    min-height: 600px;
    background: #000;
  }

  .immersive-designers__hero-transition-wrap {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
  }

  .immersive-designers__hero-state {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    opacity: 0;
    visibility: hidden;
    transition: opacity 0.8s cubic-bezier(0.4, 0, 0.2, 1), visibility 0.8s;
    display: flex;
    align-items: center;
    justify-content: center;
  }

  .immersive-designers__hero-state.is-active {
    opacity: 1;
    visibility: visible;
    z-index: 1;
  }

  .immersive-designers__hero-bg {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    object-fit: cover;
    filter: brightness(0.6) contrast(1.1);
    transform: scale(1.1);
    transition: transform 1.2s cubic-bezier(0.4, 0, 0.2, 1);
  }

  .immersive-designers__hero-state.is-active .immersive-designers__hero-bg {
    transform: scale(1);
  }

  .immersive-designers__hero-content {
    position: relative;
    z-index: 2;
    text-align: center;
    max-width: 800px;
    padding: 2rem;
    transform: translateY(30px);
    transition: transform 0.8s cubic-bezier(0.4, 0, 0.2, 1);
  }

  .immersive-designers__hero-state.is-active .immersive-designers__hero-content {
    transform: translateY(0);
  }

  .immersive-designers__hero-logo {
    max-width: 300px;
    height: auto;
    margin-bottom: 2rem;
    filter: drop-shadow(0 0 20px rgba(0, 0, 0, 0.5));
  }

  .immersive-designers__manifest {
    font-family: serif;
    font-style: italic;
    font-size: clamp(1.1rem, 2.5vw, 1.75rem);
    line-height: 1.4;
    color: #fff;
    text-shadow: 0 2px 15px rgba(0, 0, 0, 0.4);
    opacity: 0.9;
  }

  .immersive-editorial__hero-bg {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: center;
    z-index: 0;
  }

  .immersive-editorial__hero-panel {
    position: relative;
    z-index: 1;
    max-width: 640px;
    margin: 0 auto;
    padding: 2.5rem 2rem;
    background: rgba(10, 15, 30, 0.45);
    backdrop-filter: blur(24px);
    -webkit-backdrop-filter: blur(24px);
    border: 1px solid rgba(255, 255, 255, 0.15);
    border-radius: 1px;
    box-shadow: inset 0 0 20px rgba(255, 255, 255, 0.05), 0 8px 32px rgba(0, 0, 0, 0.3);
    text-align: center;
  }

  .immersive-editorial__eyebrow {
    font-size: 0.75rem;
    letter-spacing: 0.15em;
    text-transform: uppercase;
    color: rgba(212, 175, 55, 0.8);
    margin: 0 0 0.75rem;
  }

  .immersive-editorial__heading {
    font-size: clamp(1.75rem, 4vw, 3rem);
    font-weight: 600;
    color: #d4af37;
    margin: 0 0 1rem;
    line-height: 1.2;
  }

  .immersive-editorial__subheading {
    font-size: 1rem;
    line-height: 1.6;
    color: rgba(255, 255, 255, 0.85);
  }

  /* Banners */
  .immersive-editorial__banners {
    display: grid;
    grid-template-columns: 1fr;
    gap: 2rem;
    padding: 3rem 1.5rem;
  }

  .immersive-editorial__banner {
    display: grid;
    grid-template-columns: 1fr;
    gap: 1.5rem;
    border-radius: 1px;
    overflow: hidden;
  }

  .immersive-editorial__banner-media {
    position: relative;
    overflow: hidden;
    border-radius: 1px;
  }

  .immersive-editorial__banner-media img {
    width: 100%;
    height: auto;
    display: block;
    transition: transform 0.4s ease;
  }

  .immersive-editorial__banner:hover .immersive-editorial__banner-media img {
    transform: scale(1.03);
  }

  .immersive-editorial__banner-logo {
    position: absolute;
    bottom: 1rem;
    left: 1rem;
    max-width: 120px;
    height: auto;
    background: rgba(10, 15, 30, 0.7);
    padding: 0.5rem;
    border-radius: 0.25rem;
  }

  .immersive-editorial__banner-content {
    padding: 2rem;
    background: rgba(10, 15, 30, 0.4);
    backdrop-filter: blur(16px);
    -webkit-backdrop-filter: blur(16px);
    border: 1px solid rgba(255, 255, 255, 0.1);
    border-radius: 1px;
    box-shadow: inset 0 0 15px rgba(255, 255, 255, 0.03), 0 4px 20px rgba(0, 0, 0, 0.25);
  }

  .immersive-editorial__banner-heading {
    font-size: 1.25rem;
    font-weight: 600;
    color: #d4af37;
    margin: 0 0 0.75rem;
  }

  .immersive-editorial__banner-body {
    font-size: 0.9375rem;
    line-height: 1.6;
    color: rgba(255, 255, 255, 0.8);
    margin-bottom: 1rem;
  }

  .immersive-editorial__cta,
  .immersive-editorial__collection-link {
    display: inline-block;
    padding: 0.6rem 1.4rem;
    border: 1px solid #d4af37;
    color: #d4af37;
    text-decoration: none;
    font-size: 0.875rem;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    border-radius: 0.25rem;
    transition: background 0.2s ease, color 0.2s ease;
    margin-top: 0.5rem;
    margin-right: 0.5rem;
  }

  .immersive-editorial__cta:hover,
  .immersive-editorial__collection-link:hover {
    background: #d4af37;
    color: #0a0f1e;
  }

  .immersive-editorial__cta:focus-visible,
  .immersive-editorial__collection-link:focus-visible {
    outline: 2px solid #d4af37;
    outline-offset: 3px;
  }

  /* Mobile Asymmetric Layout */
  @media screen and (max-width: 767px) {
    .immersive-editorial__banner:nth-child(even) {
      margin-left: 10%;
      width: 90%;
    }
    .immersive-editorial__banner:nth-child(odd) {
      margin-right: 10%;
      width: 90%;
    }
  }

  /* Desktop: alternating two-column for collections and occasions */
  @media screen and (min-width: 768px) {
    .immersive-editorial__banners {
      padding: 4rem 3rem;
      gap: 3rem;
    }

    .immersive-editorial--layout-collections .immersive-editorial__banner,
    .immersive-editorial--layout-occasions .immersive-editorial__banner {
      grid-template-columns: 1fr 1fr;
      align-items: center;
    }

    .immersive-editorial--layout-collections .immersive-editorial__banner:nth-child(even),
    .immersive-editorial--layout-occasions .immersive-editorial__banner:nth-child(even) {
      direction: rtl;
    }

    .immersive-editorial--layout-collections .immersive-editorial__banner:nth-child(even) > *,
