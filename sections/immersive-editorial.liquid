<section
  id="immersive-editorial-{{ section.settings.room_key | escape }}"
  class="immersive-editorial immersive-editorial--source immersive-editorial--{{ section.settings.room_key | escape }}"
  data-room-key="{{ section.settings.room_key | escape }}"
  data-section-id="{{ section.id }}"
  {% unless request.design_mode %}hidden{% endunless %}
  {% unless request.design_mode %}aria-hidden="true"{% endunless %}
>

  {%- comment -%}2D overlay layouts removed — gallery is now 3D canvas only{% endcomment -%}
</section>


{% schema %}
{
  "name": "t:sections.immersive_editorial.name",
  "settings": [
    {
      "type": "select",
      "id": "room_key",
      "default": "featured_collections",
      "label": "t:sections.immersive_editorial.settings.room_key.label",
      "options": [
        { "value": "designer_houses", "label": "t:sections.immersive_editorial.settings.room_key.options__1.label" },
        { "value": "occasions", "label": "t:sections.immersive_editorial.settings.room_key.options__2.label" },
        { "value": "featured_collections", "label": "t:sections.immersive_editorial.settings.room_key.options__3.label" }
      ]
    },
    {
      "type": "text",
      "id": "hero_heading",
      "label": "t:sections.immersive_editorial.settings.hero_heading.label"
    },
    {
      "type": "text",
      "id": "hero_eyebrow",
      "label": "t:sections.immersive_editorial.settings.hero_eyebrow.label"
    },
    {
      "type": "richtext",
      "id": "hero_subheading",
      "label": "t:sections.immersive_editorial.settings.hero_subheading.label"
    },
    {
      "type": "image_picker",
      "id": "hero_background_image",
      "label": "t:sections.immersive_editorial.settings.hero_background_image.label"
    }
  ],
  "blocks": [
    {
      "type": "designer",
      "name": "t:sections.immersive_editorial.blocks.designer.name",
      "limit": 10,
      "settings": [
        { "type": "text", "id": "heading", "label": "t:sections.immersive_editorial.blocks.designer.settings.heading.label", "default": "Designer Name" },
        { "type": "image_picker", "id": "image", "label": "t:sections.immersive_editorial.blocks.designer.settings.image.label" },
        { "type": "image_picker", "id": "logo", "label": "t:sections.immersive_editorial.blocks.designer.settings.logo.label" },
        { "type": "richtext", "id": "body", "label": "t:sections.immersive_editorial.blocks.designer.settings.body.label" },
        { "type": "collection", "id": "collection", "label": "t:sections.immersive_editorial.blocks.designer.settings.collection.label" }
      ]
    },
    {
      "type": "occasion_card",
      "name": "t:sections.immersive_editorial.blocks.occasion_card.name",
      "limit": 10,
      "settings": [
        { "type": "text", "id": "heading", "label": "t:sections.immersive_editorial.blocks.occasion_card.settings.heading.label", "default": "Occasion Name" },
        { "type": "image_picker", "id": "image", "label": "t:sections.immersive_editorial.blocks.occasion_card.settings.image.label" },
        { "type": "richtext", "id": "body", "label": "t:sections.immersive_editorial.blocks.occasion_card.settings.body.label" },
        { "type": "collection", "id": "collection", "label": "t:sections.immersive_editorial.blocks.occasion_card.settings.collection.label" },
        { "type": "url", "id": "cta_url", "label": "t:sections.immersive_editorial.blocks.occasion_card.settings.cta_url.label" }
      ]
    },
    {
      "type": "featured_item",
      "name": "t:sections.immersive_editorial.blocks.featured_item.name",
      "limit": 20,
      "settings": [
        { "type": "text", "id": "heading", "label": "t:sections.immersive_editorial.blocks.featured_item.settings.heading.label", "default": "Collection Name" },
        { "type": "image_picker", "id": "image", "label": "t:sections.immersive_editorial.blocks.featured_item.settings.image.label" },
        { "type": "richtext", "id": "body", "label": "t:sections.immersive_editorial.blocks.featured_item.settings.body.label" },
        { "type": "collection", "id": "collection", "label": "t:sections.immersive_editorial.blocks.featured_item.settings.collection.label" },
        { "type": "url", "id": "cta_url", "label": "t:sections.immersive_editorial.blocks.featured_item.settings.cta_url.label" }
      ]
    }
  ],
  "presets": [
    {
      "name": "t:sections.immersive_editorial.presets.designer_houses.name",
      "settings": { "room_key": "designer_houses" },
      "blocks": [
        { "type": "designer", "settings": { "heading": "Suffuse" } },
        { "type": "designer", "settings": { "heading": "Soraya" } },
        { "type": "designer", "settings": { "heading": "Saad Bin Shahzad" } }
      ]
    },
    {
      "name": "t:sections.immersive_editorial.presets.occasions.name",
      "settings": { "room_key": "occasions" },
      "blocks": [
        { "type": "occasion_card", "settings": { "heading": "Eid Collection" } },
        { "type": "occasion_card", "settings": { "heading": "Bridal & Mehndi" } },
        { "type": "occasion_card", "settings": { "heading": "Luxury Formals" } }
      ]
    },
    {
      "name": "t:sections.immersive_editorial.presets.featured_collections.name",
      "settings": { "room_key": "featured_collections" },
      "blocks": [
        { "type": "featured_item", "settings": { "heading": "Collection One" } },
        { "type": "featured_item", "settings": { "heading": "Collection Two" } },
        { "type": "featured_item", "settings": { "heading": "Collection Three" } }
      ]
    }
  ]
}
{% endschema %}
