{%- if section.settings.enabled -%}
  {%- liquid
    assign bar_height = section.settings.bar_height | default: 96
    assign half_depth = bar_height | divided_by: 2
    assign scroll_duration = section.settings.scroll_speed | default: 40
  -%}
  <div
    class="immersive-notif-bar"
    role="marquee"
    aria-label="{{ section.settings.aria_label | default: 'Store announcements' | escape }}"
    aria-live="off"
    data-immersive-notif-bar
    style="--notif-height: {{ bar_height }}px; --notif-half: {{ half_depth }}px; --notif-duration: {{ scroll_duration }}s;"
  >
    <div class="immersive-notif-bar__hue" aria-hidden="true"></div>

    <div class="immersive-notif-bar__stage" aria-hidden="true">
      <div class="immersive-notif-bar__cube">
        {%- comment -%} Three faces — left, back, right — each offset by 1/3 so text wraps continuously {%- endcomment -%}
        {%- for face in (1..3) -%}
          {%- assign face_class = 'immersive-notif-bar__face--left' -%}
          {%- assign text_class = 'immersive-notif-bar__text--left' -%}
          {%- if face == 2 -%}
            {%- assign face_class = 'immersive-notif-bar__face--back' -%}
            {%- assign text_class = 'immersive-notif-bar__text--back' -%}
          {%- elsif face == 3 -%}
            {%- assign face_class = 'immersive-notif-bar__face--right' -%}
            {%- assign text_class = 'immersive-notif-bar__text--right' -%}
          {%- endif -%}
          <div class="immersive-notif-bar__face {{ face_class }}">
            <p class="immersive-notif-bar__text {{ text_class }}">
              {%- for block in section.blocks -%}
                <span class="immersive-notif-bar__item" {{ block.shopify_attributes }}>
                  {%- if block.settings.icon != blank -%}
                    <span class="immersive-notif-bar__icon" aria-hidden="true">{{ block.settings.icon }}</span>
                  {%- endif -%}
                  {%- if block.settings.url != blank -%}
                    <a href="{{ block.settings.url }}" class="immersive-notif-bar__link">
                      {{- block.settings.text | escape -}}
                    </a>
                  {%- else -%}
                    {{- block.settings.text | escape -}}
                  {%- endif -%}
                </span>
                <span class="immersive-notif-bar__sep" aria-hidden="true">{{ section.settings.separator }}</span>
              {%- endfor -%}
            </p>
          </div>
        {%- endfor -%}
      </div>
    </div>

    <div class="visually-hidden">
      {%- for block in section.blocks -%}
        {{ block.settings.text | escape }}
        {%- unless forloop.last %} · {% endunless -%}
      {%- endfor -%}
    </div>
  </div>
{%- endif -%}

{% stylesheet %}
  .immersive-notif-bar {
    position: fixed;
    top: 0;
    left: 0;
    right: 0;
    height: var(--notif-height, 96px);
    z-index: 200;
    overflow: hidden;
    background: #080610;
    border-bottom: 1px solid rgba(212, 175, 55, 0.2);
  }

  /* Hue colour-shift overlay */
  .immersive-notif-bar__hue {
    position: absolute;
    inset: 0;
    z-index: 2;
    pointer-events: none;
    mix-blend-mode: overlay;
    background: radial-gradient(ellipse at 50% 120%, rgba(212, 175, 55, 0.55) 0%, rgba(10, 15, 30, 0.1) 70%);
    animation: immersive-notif-hue 8s ease-in-out infinite;
  }

  @keyframes immersive-notif-hue {
    0%,
    100% {
      filter: hue-rotate(0deg);
      opacity: 0.85;
    }
    50% {
      filter: hue-rotate(55deg);
      opacity: 1;
    }
  }

  /* Stage clips the cube */
  .immersive-notif-bar__stage {
    position: absolute;
    inset: 0;
    overflow: hidden;
    display: flex;
    align-items: center;
    justify-content: center;
  }

  /* 3-D cube — depth = half the bar height */
  .immersive-notif-bar__cube {
    position: relative;
    width: 100vw;
    height: var(--notif-height, 96px);
    transform-style: preserve-3d;
    perspective: calc(var(--notif-height, 96px) * 5);
    perspective-origin: 50% 65%;
  }

  .immersive-notif-bar__face {
    position: absolute;
    width: 100vw;
    height: var(--notif-height, 96px);
    display: flex;
    align-items: center;
    overflow: hidden;
  }

  /* Face transforms use --notif-half (= height / 2) */
  .immersive-notif-bar__face--left {
    transform: translateX(calc(-1 * var(--notif-half, 48px))) rotateY(-90deg) scaleX(-1);
    opacity: 0.7;
  }

  .immersive-notif-bar__face--back {
    transform: translateZ(calc(-1 * var(--notif-half, 48px))) rotateY(180deg) scaleX(-1);
    opacity: 0.55;
  }

  .immersive-notif-bar__face--right {
    transform: translateX(var(--notif-half, 48px)) rotateY(90deg) scaleX(-1);
    opacity: 0.7;
  }

  /* Scrolling text */
  .immersive-notif-bar__text {
    white-space: nowrap;
    font-family: 'Bebas Neue', 'Impact', sans-serif;
    font-size: calc(var(--notif-height, 96px) * 0.52);
    font-weight: 400;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    color: #d4af37;
    margin: 0;
    padding: 0;
    line-height: var(--notif-height, 96px);
    animation-timing-function: linear;
    animation-iteration-count: infinite;
    animation-duration: var(--notif-duration, 40s);
    will-change: transform;
  }

  .immersive-notif-bar__text--left {
    animation-name: immersive-notif-scroll-a;
  }
  .immersive-notif-bar__text--back {
    animation-name: immersive-notif-scroll-b;
  }
  .immersive-notif-bar__text--right {
    animation-name: immersive-notif-scroll-c;
  }

  @keyframes immersive-notif-scroll-a {
    from {
      transform: translateX(0);
    }
    to {
      transform: translateX(-50%);
    }
  }
  @keyframes immersive-notif-scroll-b {
    from {
      transform: translateX(-16.66%);
    }
    to {
      transform: translateX(-66.66%);
    }
  }
  @keyframes immersive-notif-scroll-c {
    from {
      transform: translateX(-33.33%);
    }
    to {
      transform: translateX(-83.33%);
    }
  }

  .immersive-notif-bar__item {
    display: inline;
    padding: 0 0.4em;
  }

  .immersive-notif-bar__icon {
    margin-right: 0.25em;
  }

  .immersive-notif-bar__sep {
    color: rgba(212, 175, 55, 0.35);
    padding: 0 0.6em;
  }

  .immersive-notif-bar__link {
    color: inherit;
    text-decoration: none;
    border-bottom: 2px solid rgba(212, 175, 55, 0.4);
    transition: color 0.2s, border-color 0.2s;
  }

  .immersive-notif-bar__link:hover {
    color: #fff;
    border-color: #fff;
  }
  .immersive-notif-bar__link:focus-visible {
    outline: 2px solid #d4af37;
    outline-offset: 2px;
    border-radius: 2px;
  }

  /* Push immersive header below the bar */
  body:has([data-immersive-notif-bar]) .immersive-header {
    top: var(--notif-height, 96px);
  }

  @media (prefers-reduced-motion: reduce) {
    .immersive-notif-bar__face--back,
    .immersive-notif-bar__face--right {
      display: none;
    }
    .immersive-notif-bar__face--left {
      transform: none;
      opacity: 1;
    }
    .immersive-notif-bar__text {
      animation: none !important;
      padding-left: 1.5rem;
    }
    .immersive-notif-bar__hue {
      animation: none !important;
    }
  }
{% endstylesheet %}

{% schema %}
{
  "name": "Notification Bar",
  "settings": [
    {
      "type": "checkbox",
      "id": "enabled",
      "label": "Show notification bar",
      "default": true
    },
    {
      "type": "range",
      "id": "bar_height",
      "label": "Bar height (px)",
      "min": 48,
      "max": 160,
      "step": 8,
      "default": 96
    },
    {
      "type": "range",
      "id": "scroll_speed",
      "label": "Scroll speed (lower = faster)",
      "min": 15,
      "max": 80,
      "step": 5,
      "default": 40
    },
    {
      "type": "text",
      "id": "separator",
      "label": "Separator between items",
      "default": "✦"
    },
    {
      "type": "text",
      "id": "aria_label",
      "label": "Accessible label (screen readers)",
      "default": "Store announcements"
    }
  ],
  "blocks": [
    {
      "type": "announcement",
      "name": "Announcement",
      "settings": [
        {
          "type": "text",
          "id": "text",
          "label": "Text",
          "default": "Free shipping on orders over PKR 5,000"
        },
        {
          "type": "text",
          "id": "icon",
          "label": "Icon (emoji or symbol)",
          "default": "✦"
        },
        {
          "type": "url",
          "id": "url",
          "label": "Link (optional)"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "Notification Bar",
      "settings": { "enabled": true, "bar_height": 96, "scroll_speed": 40, "separator": "✦" },
      "blocks": [
        { "type": "announcement", "settings": { "text": "Free shipping on orders over PKR 5,000", "icon": "✦" } },
        { "type": "announcement", "settings": { "text": "New arrivals — Eid Collection 2026", "icon": "✦" } },
        { "type": "announcement", "settings": { "text": "Explore the 3D Immersive Store", "icon": "✦" } }
      ]
    }
  ]
}
{% endschema %}
