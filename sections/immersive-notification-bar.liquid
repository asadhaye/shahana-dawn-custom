{%- if section.settings.enabled -%}
  {%- liquid
    assign bar_height = section.settings.bar_height | default: 48
    assign display_duration = section.settings.display_duration | default: 4
  -%}
  <style>
    :root { --notif-height: {{ bar_height }}px; }
  </style>
  <div
    class="immersive-notif-bar"
    role="region"
    aria-label="{{ section.settings.aria_label | default: 'Store announcements' | escape }}"
    aria-live="polite"
    aria-atomic="true"
    data-immersive-notif-bar
    style="--notif-height: {{ bar_height }}px; --notif-display: {{ display_duration }}s;"
  >
    <div class="immersive-notif-bar__hue" aria-hidden="true"></div>

    <div class="immersive-notif-bar__stage" aria-hidden="true">
      <div class="immersive-notif-bar__scene">
        {%- for face in (1..3) -%}
          {%- assign face_class = 'immersive-notif-bar__face--left' -%}
          {%- if face == 2 -%}
            {%- assign face_class = 'immersive-notif-bar__face--front' -%}
          {%- elsif face == 3 -%}
            {%- assign face_class = 'immersive-notif-bar__face--right' -%}
          {%- endif -%}

          <div class="immersive-notif-bar__face {{ face_class }}">
            <div class="immersive-notif-bar__ticker" data-notif-ticker>
              {%- for block in section.blocks -%}
                <span
                  class="immersive-notif-bar__msg{% if forloop.first %} is-active{% endif %}"
                  data-notif-msg
                  {% if face == 1 %}
                    {{- block.shopify_attributes -}}
                  {% endif %}
                >
                  {%- if block.settings.icon != blank -%}
                    <span class="immersive-notif-bar__icon" aria-hidden="true">{{ block.settings.icon }}</span>
                  {%- endif -%}
                  {%- if block.settings.url != blank -%}
                    <a href="{{ block.settings.url }}" class="immersive-notif-bar__link">
                      {{- block.settings.text | escape -}}
                    </a>
                  {%- else -%}
                    {{- block.settings.text | escape -}}
                  {%- endif -%}
                </span>
              {%- endfor -%}
            </div>
          </div>
        {%- endfor -%}
      </div>
    </div>

    <div class="visually-hidden" aria-live="polite" data-notif-a11y>
      {%- for block in section.blocks -%}
        {{ block.settings.text | escape }}
        {%- unless forloop.last %} · {% endunless -%}
      {%- endfor -%}
    </div>
  </div>
{%- endif -%}

{% stylesheet %}
  .immersive-notif-bar {
    position: fixed;
    top: 0;
    left: 0;
    right: 0;
    height: var(--notif-height, 48px);
    z-index: 320;
    overflow: hidden;
    background: #080610;
    border-bottom: 1px solid rgba(212, 175, 55, 0.2);
  }

  .immersive-notif-bar__hue {
    position: absolute;
    inset: 0;
    z-index: 3;
    pointer-events: none;
    mix-blend-mode: overlay;
    background: radial-gradient(ellipse at 50% 120%, rgba(212, 175, 55, 0.45) 0%, transparent 70%);
    animation: notif-hue 8s ease-in-out infinite;
  }
  @keyframes notif-hue {
    0%,
    100% {
      filter: hue-rotate(0deg);
      opacity: 0.8;
    }
    50% {
      filter: hue-rotate(50deg);
      opacity: 1;
    }
  }

  /* ── 3-D stage ── */
  .immersive-notif-bar__stage {
    position: absolute;
    inset: 0;
    perspective: 55vw;
    perspective-origin: 50% 50%;
  }

  .immersive-notif-bar__scene {
    position: relative;
    width: 100%;
    height: 100%;
    transform-style: preserve-3d;
  }

  .immersive-notif-bar__face {
    position: absolute;
    inset: 0;
    display: flex;
    align-items: center;
    justify-content: center;
    overflow: hidden;
  }

  .immersive-notif-bar__face--left {
    transform-origin: left center;
    transform: rotateY(42deg);
    opacity: 0.55;
  }
  .immersive-notif-bar__face--front {
    transform: translateZ(0);
    opacity: 1;
  }
  .immersive-notif-bar__face--right {
    transform-origin: right center;
    transform: rotateY(-42deg);
    opacity: 0.55;
  }

  /* ── Ticker container ── */
  .immersive-notif-bar__ticker {
    position: relative;
    width: 100%;
    height: 100%;
    display: flex;
    align-items: center;
    justify-content: center;
    overflow: hidden;
  }

  /* ── Individual messages ── */
  .immersive-notif-bar__msg {
    position: absolute;
    white-space: nowrap;
    font-family: 'Bebas Neue', 'Impact', sans-serif;
    font-size: clamp(0.7rem, calc(var(--notif-height, 48px) * 0.3), 1rem);
    font-weight: 400;
    letter-spacing: 0.18em;
    text-transform: uppercase;
    color: #d4af37;
    line-height: 1;
    /* Start off-screen right, invisible */
    transform: translateX(110vw);
    opacity: 0;
    transition: none;
  }

  /* Slide in from right */
  .immersive-notif-bar__msg.is-entering {
    transform: translateX(110vw);
    opacity: 0;
    transition: transform 0.6s cubic-bezier(0.22, 1, 0.36, 1), opacity 0.3s ease;
  }
  .immersive-notif-bar__msg.is-entering.is-active {
    transform: translateX(0);
    opacity: 1;
  }

  /* Visible and centered */
  .immersive-notif-bar__msg.is-active {
    transform: translateX(0);
    opacity: 1;
  }

  /* Slide out to left */
  .immersive-notif-bar__msg.is-leaving {
    transform: translateX(-110vw);
    opacity: 0;
    transition: transform 0.5s cubic-bezier(0.55, 0, 1, 0.45), opacity 0.3s ease 0.1s;
  }

  .immersive-notif-bar__icon {
    margin-right: 0.35em;
  }

  .immersive-notif-bar__link {
    color: inherit;
    text-decoration: none;
    border-bottom: 1px solid rgba(212, 175, 55, 0.4);
  }
  .immersive-notif-bar__link:hover {
    color: #fff;
    border-color: #fff;
  }
  .immersive-notif-bar__link:focus-visible {
    outline: 2px solid #d4af37;
    outline-offset: 2px;
  }

  /* ── Header offset ── */
  body:has([data-immersive-notif-bar]) .immersive-header {
    top: var(--notif-height, 48px);
  }
  body:has([data-immersive-notif-bar]) {
    --announcement-bar-height: var(--notif-height, 48px);
  }

  /* ── Reduced motion — just fade ── */
  @media (prefers-reduced-motion: reduce) {
    .immersive-notif-bar__face--left,
    .immersive-notif-bar__face--right {
      display: none;
    }
    .immersive-notif-bar__face--front {
      transform: none;
      opacity: 1;
    }
    .immersive-notif-bar__msg.is-entering,
    .immersive-notif-bar__msg.is-leaving {
      transition: opacity 0.4s ease !important;
      transform: translateX(0) !important;
    }
    .immersive-notif-bar__hue {
      animation: none;
    }
  }
{% endstylesheet %}

{% javascript %}
  (function () {
    function syncNotificationOffset(bar) {
      if (!bar) return;
      var height = bar.offsetHeight || parseFloat(getComputedStyle(bar).getPropertyValue('--notif-height')) || 48;
      document.documentElement.style.setProperty('--notif-height', height + 'px');
      if (document.body) document.body.classList.add('has-immersive-notif-bar');
    }

    function initTicker(bar) {
      var tickers = bar.querySelectorAll('[data-notif-ticker]');
      if (!tickers.length) return;

      syncNotificationOffset(bar);

      var style = getComputedStyle(bar);
      var holdMs = (parseFloat(style.getPropertyValue('--notif-display')) || 4) * 1000;
      var inMs = 650;
      var outMs = 550;

      // Collect messages from the FIRST ticker (front face) — all tickers are synced
      var msgs = Array.from(tickers[0].querySelectorAll('[data-notif-msg]'));
      if (msgs.length <= 1) {
        // Only one message — just show it
        msgs.forEach(function (m) {
          m.classList.add('is-active');
          m.style.opacity = 1;
          m.style.transform = 'translateX(0)';
        });
        return;
      }

      var current = 0;

      function getMsgsAt(index) {
        // Return the message at `index` from every ticker (all faces stay in sync)
        return Array.from(tickers).map(function (ticker) {
          return ticker.querySelectorAll('[data-notif-msg]')[index];
        });
      }

      function showNext() {
        var outIndex = current;
        current = (current + 1) % msgs.length;
        var inIndex = current;

        var outEls = getMsgsAt(outIndex);
        var inEls = getMsgsAt(inIndex);

        // Slide out current
        outEls.forEach(function (el) {
          if (!el) return;
          el.classList.remove('is-active');
          el.classList.add('is-leaving');
        });

        // Prepare incoming — position off-screen right, no transition
        inEls.forEach(function (el) {
          if (!el) return;
          el.style.transition = 'none';
          el.style.transform = 'translateX(110vw)';
          el.style.opacity = '0';
          el.classList.remove('is-active', 'is-leaving');
        });

        // After a frame, slide in
        requestAnimationFrame(function () {
          requestAnimationFrame(function () {
            inEls.forEach(function (el) {
              if (!el) return;
              el.style.transition = '';
              el.classList.add('is-entering');
              // Trigger transition
              requestAnimationFrame(function () {
                el.classList.add('is-active');
              });
            });

            // Clean up after slide-in
            setTimeout(function () {
              inEls.forEach(function (el) {
                if (!el) return;
                el.classList.remove('is-entering');
                el.style.transition = '';
                el.style.transform = '';
                el.style.opacity = '';
              });
              outEls.forEach(function (el) {
                if (!el) return;
                el.classList.remove('is-leaving');
                el.style.transition = '';
                el.style.transform = 'translateX(110vw)';
                el.style.opacity = '0';
              });
            }, Math.max(inMs, outMs) + 50);
          });
        });
      }

      // Show first message immediately
      getMsgsAt(0).forEach(function (el) {
        if (!el) return;
        el.style.transform = 'translateX(0)';
        el.style.opacity = '1';
        el.classList.add('is-active');
      });

      // Cycle
      setInterval(showNext, holdMs + inMs);
    }

    function init() {
      document.querySelectorAll('[data-immersive-notif-bar]').forEach(initTicker);
    }

    if (document.readyState === 'loading') {
      document.addEventListener('DOMContentLoaded', init);
    } else {
      init();
    }

    document.addEventListener('shopify:section:load', function (e) {
      var bar = e.target && e.target.querySelector('[data-immersive-notif-bar]');
      if (bar) initTicker(bar);
    });

    window.addEventListener('resize', function () {
      var bar = document.querySelector('[data-immersive-notif-bar]');
      if (bar) syncNotificationOffset(bar);
    });
  })();
{% endjavascript %}

{% schema %}
{
  "name": "Notification Bar",
  "settings": [
    {
      "type": "checkbox",
      "id": "enabled",
      "label": "Show notification bar",
      "default": true
    },
    {
      "type": "range",
      "id": "bar_height",
      "label": "Bar height (px)",
      "min": 36,
      "max": 120,
      "step": 4,
      "default": 48
    },
    {
      "type": "range",
      "id": "display_duration",
      "label": "Seconds each message is shown",
      "min": 2,
      "max": 10,
      "step": 1,
      "default": 4
    },
    {
      "type": "text",
      "id": "separator",
      "label": "Separator (unused in ticker mode)",
      "default": "✦"
    },
    {
      "type": "text",
      "id": "aria_label",
      "label": "Accessible label (screen readers)",
      "default": "Store announcements"
    }
  ],
  "blocks": [
    {
      "type": "announcement",
      "name": "Announcement",
      "settings": [
        {
          "type": "text",
          "id": "text",
          "label": "Text",
          "default": "Free shipping on orders over PKR 5,000"
        },
        {
          "type": "text",
          "id": "icon",
          "label": "Icon (emoji or symbol)",
          "default": "✦"
        },
        {
          "type": "url",
          "id": "url",
          "label": "Link (optional)"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "Notification Bar",
      "settings": { "enabled": true, "bar_height": 48, "display_duration": 4, "separator": "✦" },
      "blocks": [
        { "type": "announcement", "settings": { "text": "Free shipping on orders over PKR 150,000", "icon": "✦" } },
        { "type": "announcement", "settings": { "text": "New arrivals — Eid Collection 2026", "icon": "✦" } },
        { "type": "announcement", "settings": { "text": "Explore the 3D Immersive Store", "icon": "✦" } }
      ]
    }
  ]
}
{% endschema %}
