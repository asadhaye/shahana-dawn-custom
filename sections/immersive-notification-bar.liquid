{%- if section.settings.enabled -%}
  <div
    class="immersive-notif-bar"
    role="marquee"
    aria-label="{{ section.settings.aria_label | default: 'Store announcements' | escape }}"
    aria-live="off"
    data-immersive-notif-bar
  >
    <div class="immersive-notif-bar__hue" aria-hidden="true"></div>

    <div class="immersive-notif-bar__stage" aria-hidden="true">
      <div class="immersive-notif-bar__cube">
        <div class="immersive-notif-bar__face immersive-notif-bar__face--left">
          <p class="immersive-notif-bar__text immersive-notif-bar__text--left">
            {%- for block in section.blocks -%}
              <span class="immersive-notif-bar__item">
                {%- if block.settings.icon != blank -%}
                  <span class="immersive-notif-bar__icon" aria-hidden="true">{{ block.settings.icon }}</span>
                {%- endif -%}
                {%- if block.settings.url != blank -%}
                  <a href="{{ block.settings.url }}" class="immersive-notif-bar__link">
                    {{- block.settings.text | escape -}}
                  </a>
                {%- else -%}
                  {{- block.settings.text | escape -}}
                {%- endif -%}
              </span>
              <span class="immersive-notif-bar__sep" aria-hidden="true">{{ section.settings.separator }}</span>
            {%- endfor -%}
          </p>
        </div>
        <div class="immersive-notif-bar__face immersive-notif-bar__face--back">
          <p class="immersive-notif-bar__text immersive-notif-bar__text--back">
            {%- for block in section.blocks -%}
              <span class="immersive-notif-bar__item">
                {%- if block.settings.icon != blank -%}
                  <span class="immersive-notif-bar__icon" aria-hidden="true">{{ block.settings.icon }}</span>
                {%- endif -%}
                {%- if block.settings.url != blank -%}
                  <a href="{{ block.settings.url }}" class="immersive-notif-bar__link">
                    {{- block.settings.text | escape -}}
                  </a>
                {%- else -%}
                  {{- block.settings.text | escape -}}
                {%- endif -%}
              </span>
              <span class="immersive-notif-bar__sep" aria-hidden="true">{{ section.settings.separator }}</span>
            {%- endfor -%}
          </p>
        </div>
        <div class="immersive-notif-bar__face immersive-notif-bar__face--right">
          <p class="immersive-notif-bar__text immersive-notif-bar__text--right">
            {%- for block in section.blocks -%}
              <span class="immersive-notif-bar__item">
                {%- if block.settings.icon != blank -%}
                  <span class="immersive-notif-bar__icon" aria-hidden="true">{{ block.settings.icon }}</span>
                {%- endif -%}
                {%- if block.settings.url != blank -%}
                  <a href="{{ block.settings.url }}" class="immersive-notif-bar__link">
                    {{- block.settings.text | escape -}}
                  </a>
                {%- else -%}
                  {{- block.settings.text | escape -}}
                {%- endif -%}
              </span>
              <span class="immersive-notif-bar__sep" aria-hidden="true">{{ section.settings.separator }}</span>
            {%- endfor -%}
          </p>
        </div>
      </div>
    </div>

    {%- comment -%} Accessible static text for screen readers {%- endcomment -%}
    <div class="visually-hidden">
      {%- for block in section.blocks -%}
        {{ block.settings.text | escape }}
        {%- unless forloop.last -%}·{%- endunless -%}
      {%- endfor -%}
    </div>
  </div>
{%- endif -%}

{% stylesheet %}
  /* ============================================================================
     Immersive Notification Bar — 3D cube scrolling ticker
     Adapted from the "Living Words" CSS cube technique.
     Scoped entirely to .immersive-notif-bar* — no global side effects.
  ============================================================================ */

  .immersive-notif-bar {
    position: fixed;
    top: 0;
    left: 0;
    right: 0;
    height: 36px;
    z-index: 200;
    overflow: hidden;
    background: #0a0f1e;
  }

  /* Animated hue overlay — cycles through gold/blue tones */
  .immersive-notif-bar__hue {
    position: absolute;
    inset: 0;
    z-index: 1;
    mix-blend-mode: overlay;
    background: radial-gradient(ellipse at center, rgba(212, 175, 55, 0.6) 0%, rgba(10, 15, 30, 0.2) 100%);
    animation: immersive-notif-hue 8s infinite ease-in-out;
    pointer-events: none;
  }

  @keyframes immersive-notif-hue {
    0%,
    100% {
      filter: hue-rotate(0deg);
      opacity: 0.8;
    }
    50% {
      filter: hue-rotate(60deg);
      opacity: 1;
    }
  }

  /* Stage: clips the cube to the bar height */
  .immersive-notif-bar__stage {
    position: absolute;
    inset: 0;
    display: flex;
    align-items: center;
    justify-content: center;
    overflow: hidden;
  }

  /* Cube: 3D container — width matches viewport, depth = half bar height */
  .immersive-notif-bar__cube {
    position: relative;
    width: 100vw;
    height: 36px;
    transform-style: preserve-3d;
    perspective: 240px;
    perspective-origin: 50% 70%;
  }

  /* All faces share base styles */
  .immersive-notif-bar__face {
    position: absolute;
    width: 100vw;
    height: 36px;
    display: flex;
    align-items: center;
    overflow: hidden;
    opacity: 0.92;
  }

  /* Face transforms — half-depth = 18px (half of 36px bar height) */
  .immersive-notif-bar__face--left {
    transform: translateX(-18px) rotateY(-90deg) scaleX(-1);
  }

  .immersive-notif-bar__face--back {
    transform: translateZ(-18px) rotateY(180deg) scaleX(-1);
  }

  .immersive-notif-bar__face--right {
    transform: translateX(18px) rotateY(90deg) scaleX(-1);
  }

  /* Scrolling text */
  .immersive-notif-bar__text {
    white-space: nowrap;
    font-family: 'Bebas Neue', 'Paytone One', sans-serif;
    font-size: 0.9rem;
    font-weight: 400;
    letter-spacing: 0.12em;
    text-transform: uppercase;
    color: #d4af37;
    margin: 0;
    padding: 0;
    line-height: 36px;
    /* Each face starts at a different offset so text wraps seamlessly */
    animation-duration: 60s;
    animation-timing-function: linear;
    animation-iteration-count: infinite;
  }

  .immersive-notif-bar__text--left {
    margin-left: 0;
    animation-name: immersive-notif-scroll-left;
  }

  .immersive-notif-bar__text--back {
    margin-left: -33.33%;
    animation-name: immersive-notif-scroll-back;
  }

  .immersive-notif-bar__text--right {
    margin-left: -66.66%;
    animation-name: immersive-notif-scroll-right;
  }

  /* Each face scrolls the same distance but starts offset — creates wrap-around illusion */
  @keyframes immersive-notif-scroll-left {
    to {
      margin-left: -20000px;
    }
  }

  @keyframes immersive-notif-scroll-back {
    to {
      margin-left: -20033px;
    }
  }

  @keyframes immersive-notif-scroll-right {
    to {
      margin-left: -20066px;
    }
  }

  /* Items and separators */
  .immersive-notif-bar__item {
    display: inline;
    padding: 0 0.25rem;
  }

  .immersive-notif-bar__icon {
    margin-right: 0.3em;
    font-style: normal;
  }

  .immersive-notif-bar__sep {
    color: rgba(212, 175, 55, 0.4);
    padding: 0 0.5rem;
  }

  .immersive-notif-bar__link {
    color: inherit;
    text-decoration: none;
    border-bottom: 1px solid rgba(212, 175, 55, 0.3);
    transition: border-color 0.2s ease, color 0.2s ease;
  }

  .immersive-notif-bar__link:hover {
    color: #fff;
    border-color: #fff;
  }

  .immersive-notif-bar__link:focus-visible {
    outline: 2px solid #d4af37;
    outline-offset: 2px;
    border-radius: 2px;
  }

  /* Push the immersive header down when the bar is present */
  body:has([data-immersive-notif-bar]) .immersive-header {
    top: 36px;
  }

  /* Reduced motion: replace scroll with a simple fade-in static bar */
  @media (prefers-reduced-motion: reduce) {
    .immersive-notif-bar__face--back,
    .immersive-notif-bar__face--right {
      display: none;
    }

    .immersive-notif-bar__face--left {
      transform: none;
    }

    .immersive-notif-bar__text {
      animation: none !important;
      margin-left: 1rem !important;
      overflow: hidden;
      text-overflow: ellipsis;
    }

    .immersive-notif-bar__hue {
      animation: none !important;
    }
  }
{% endstylesheet %}

{% schema %}
{
  "name": "Notification Bar",
  "settings": [
    {
      "type": "checkbox",
      "id": "enabled",
      "label": "Show notification bar",
      "default": true
    },
    {
      "type": "text",
      "id": "separator",
      "label": "Separator between items",
      "default": "✦"
    },
    {
      "type": "text",
      "id": "aria_label",
      "label": "Accessible label (screen readers)",
      "default": "Store announcements"
    }
  ],
  "blocks": [
    {
      "type": "announcement",
      "name": "Announcement",
      "settings": [
        {
          "type": "text",
          "id": "text",
          "label": "Text",
          "default": "Free shipping on orders over PKR 5,000"
        },
        {
          "type": "text",
          "id": "icon",
          "label": "Icon (emoji or text symbol)",
          "default": "✦"
        },
        {
          "type": "url",
          "id": "url",
          "label": "Link (optional)"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "Immersive Notification Bar",
      "settings": {
        "enabled": true,
        "separator": "✦"
      },
      "blocks": [
        {
          "type": "announcement",
          "settings": {
            "text": "Free shipping on orders over PKR 5,000",
            "icon": "✦"
          }
        },
        {
          "type": "announcement",
          "settings": {
            "text": "New arrivals — Eid Collection 2026",
            "icon": "✦"
          }
        },
        {
          "type": "announcement",
          "settings": {
            "text": "Explore the 3D Immersive Store",
            "icon": "✦"
          }
        }
      ]
    }
  ]
}
{% endschema %}
