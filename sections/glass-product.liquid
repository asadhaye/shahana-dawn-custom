{% liquid
  assign originating_collection_handle = request.params.collection_handle

  # When rendered from /products/{handle}?section_id=glass-product,
  # the product object is automatically available
  if product
    assign panel_product = product
  else
    # Fallback: try to get from all_products if product_handle param exists
    assign product_handle = request.params.product_handle
    if product_handle != blank
      assign panel_product = all_products[product_handle]
    endif
  endif

  # Fall back to the product's first real collection (skip the system 'all' collection)
  if originating_collection_handle == blank and panel_product
    for col in panel_product.collections
      if col.handle != 'all' and col.handle != blank
        assign originating_collection_handle = col.handle
        assign originating_collection_title = col.title
        break
      endif
    endfor
  else
    # Resolve the title from the handle if we have one
    for col in panel_product.collections
      if col.handle == originating_collection_handle
        assign originating_collection_title = col.title
        break
      endif
    endfor
  endif

  # Final fallback title: humanise the handle
  if originating_collection_title == blank and originating_collection_handle != blank
    assign originating_collection_title = originating_collection_handle | replace: '-', ' ' | capitalize
  endif

  # Prev/next navigation within the originating collection
  assign prev_product = null
  assign next_product = null
  if originating_collection_handle != blank and panel_product
    assign nav_collection = collections[originating_collection_handle]
    if nav_collection
      assign found_current = false
      for nav_product in nav_collection.products limit: 50
        if found_current
          assign next_product = nav_product
          break
        endif
        if nav_product.handle == panel_product.handle
          assign found_current = true
        else
          assign prev_product = nav_product
        endif
      endfor
    endif
  endif
%}

<section
  class="glass-product-section"
  aria-label="{{ 'sections.immersive.product_panel.product_detail_aria' | t }}"
  data-error-select-variant="{{ 'sections.immersive_store.error_select_variant' | t | escape }}"
  data-error-add-to-cart="{{ 'sections.immersive_store.error_add_to_cart' | t | escape }}"
  data-success-added="{{ 'sections.immersive_store.added_to_cart' | t | escape }}"
  {%- if panel_product -%}
    data-product-id="{{ panel_product.id }}"
    data-product-handle="{{ panel_product.handle }}"
  {%- endif -%}
>
  {% if panel_product %}
    {% if originating_collection_handle != blank %}
      <button
        type="button"
        class="glass-product-section__back"
        data-collection-handle="{{ originating_collection_handle }}"
      >
        {{ 'sections.immersive.product_grid.back_to_collection' | t }}
      </button>
    {% endif %}

    <header class="glass-product-section__header">
      <nav class="glass-product-section__breadcrumb" aria-label="Breadcrumb">
        <button
          type="button"
          class="glass-product-section__breadcrumb-root glass-product-section__breadcrumb-btn"
          data-breadcrumb-action="close-panel"
        >
          {{- 'sections.immersive_store.breadcrumb_store' | t -}}
        </button>
        <span class="glass-product-section__breadcrumb-separator" aria-hidden="true">/</span>
        {% if originating_collection_handle != blank %}
          <button
            type="button"
            class="glass-product-section__breadcrumb-parent glass-product-section__breadcrumb-btn"
            data-breadcrumb-action="open-collection"
            data-collection-handle="{{ originating_collection_handle }}"
          >
            {{- originating_collection_title | escape -}}
          </button>
          <span class="glass-product-section__breadcrumb-separator" aria-hidden="true">/</span>
        {% endif %}
        <span class="glass-product-section__breadcrumb-current" aria-current="page">
          {{- panel_product.title | escape -}}
        </span>
      </nav>
      <div class="glass-product-section__title-wrap">
        <h2 class="glass-product-section__title">{{ panel_product.title | escape }}</h2>
        {% if panel_product.vendor != blank and section.settings.show_vendor %}
          {%- assign vendor_collection_handle = panel_product.vendor | handleize -%}
          <button
            type="button"
            class="glass-product-section__vendor glass-product-section__vendor--link"
            data-vendor-collection="{{ vendor_collection_handle }}"
            aria-label="{{ panel_product.vendor | escape }}"
          >
            {{ panel_product.vendor | escape }}
          </button>
        {% endif %}
      </div>
    </header>

    {%- if prev_product or next_product -%}
      <nav class="glass-product-section__product-nav" aria-label="Product navigation">
        {%- if prev_product -%}
          <button
            type="button"
            class="glass-product-section__product-nav-btn glass-product-section__product-nav-btn--prev"
            data-product-handle="{{ prev_product.handle }}"
            data-collection-handle="{{ originating_collection_handle }}"
            aria-label="Previous product: {{ prev_product.title | escape }}"
          >
            <svg
              width="20"
              height="20"
              viewBox="0 0 24 24"
              fill="none"
              stroke="currentColor"
              stroke-width="2"
              stroke-linecap="round"
              stroke-linejoin="round"
              aria-hidden="true"
            >
              <polyline points="15 18 9 12 15 6"></polyline>
            </svg>
            <span class="glass-product-section__product-nav-label">
              <span class="glass-product-section__product-nav-hint">Previous</span>
              <span class="glass-product-section__product-nav-title">
                {{- prev_product.title | escape | truncate: 30 -}}
              </span>
            </span>
          </button>
        {%- else -%}
          <span
            class="glass-product-section__product-nav-btn glass-product-section__product-nav-btn--placeholder"
          ></span>
        {%- endif -%}

        {%- if next_product -%}
          <button
            type="button"
            class="glass-product-section__product-nav-btn glass-product-section__product-nav-btn--next"
            data-product-handle="{{ next_product.handle }}"
            data-collection-handle="{{ originating_collection_handle }}"
            aria-label="Next product: {{ next_product.title | escape }}"
          >
            <span class="glass-product-section__product-nav-label">
              <span class="glass-product-section__product-nav-hint">Next</span>
              <span class="glass-product-section__product-nav-title">
                {{- next_product.title | escape | truncate: 30 -}}
              </span>
            </span>
            <svg
              width="20"
              height="20"
              viewBox="0 0 24 24"
              fill="none"
              stroke="currentColor"
              stroke-width="2"
              stroke-linecap="round"
              stroke-linejoin="round"
              aria-hidden="true"
            >
              <polyline points="9 18 15 12 9 6"></polyline>
            </svg>
          </button>
        {%- else -%}
          <span
            class="glass-product-section__product-nav-btn glass-product-section__product-nav-btn--placeholder"
          ></span>
        {%- endif -%}
      </nav>
    {%- endif -%}

    <div class="glass-product-section__layout">
      <div class="glass-product-section__media glass-product-section__media--{{ section.settings.media_size | default: 'medium' }}">
        {% if panel_product.media.size > 0 %}
          <div
            class="glass-product-section__media-main"
            data-parallax-container
            data-parallax-main
            data-parallax-intensity="18"
          >
            {% if panel_product.featured_media.media_type == 'image' %}
              <img
                src="{{ panel_product.featured_media | image_url: width: 800 }}"
                srcset="
                  {{ panel_product.featured_media | image_url: width: 400 }} 400w,
                  {{ panel_product.featured_media | image_url: width: 600 }} 600w,
                  {{ panel_product.featured_media | image_url: width: 800 }} 800w,
                  {{ panel_product.featured_media | image_url: width: 1000 }} 1000w
                "
                sizes="(max-width: 600px) 100vw, 500px"
                alt="{{ panel_product.featured_media.alt | escape }}"
                width="800"
                height="1067"
                loading="eager"
                data-parallax-image
              >
            {% else %}
              {%- assign hero_alt = panel_product.featured_media.alt | escape -%}
              {{
                panel_product.featured_media.preview_image
                | image_url: width: 800
                | image_tag: alt: hero_alt, loading: 'eager', width: 800, height: 1067, data-parallax-image: ''
              }}
            {% endif %}
          </div>
          {% if panel_product.media.size > 1 %}
            <div class="glass-product-section__media-thumbs">
              {%- assign thumb_index = 1 -%}
              {% for media in panel_product.media offset: 1 %}
                <button
                  type="button"
                  class="glass-product-section__thumb"
                  data-media-index="{{ forloop.index0 }}"
                  data-media-type="{{ media.media_type }}"
                  data-full-src="{{ media.preview_image | image_url: width: 800 }}"
                  data-full-srcset="{{ media.preview_image | image_url: width: 400 }} 400w, {{ media.preview_image | image_url: width: 600 }} 600w, {{ media.preview_image | image_url: width: 800 }} 800w, {{ media.preview_image | image_url: width: 1000 }} 1000w"
                  data-full-alt="{{ media.alt | escape }}"
                  aria-label="{%- if media.media_type == 'image' -%}{{ 'products.product.media.load_image' | t: index: thumb_index }}{%- elsif media.media_type == 'model' -%}{{ 'products.product.media.load_model' | t: index: thumb_index }}{%- elsif media.media_type == 'video' or media.media_type == 'external_video' -%}{{ 'products.product.media.load_video' | t: index: thumb_index }}{%- endif -%}"
                >
                  {%- assign thumb_alt = media.alt | escape -%}
                  {{
                    media.preview_image
                    | image_url: width: 120
                    | image_tag: alt: thumb_alt, loading: 'lazy', width: 60, height: 80
                  }}
                </button>
                {%- assign thumb_index = thumb_index | plus: 1 -%}
              {% endfor %}
            </div>
          {% endif %}
        {% endif %}
      </div>

      <div class="glass-product-section__info">
        {% if panel_product.description != blank %}
          <div class="glass-product-section__description">
            {{ panel_product.description }}
          </div>
        {% endif %}

        <div class="glass-product-section__price">
          {% if panel_product.compare_at_price_max > panel_product.price %}
            <span class="glass-product-section__price-compare">
              {{ panel_product.compare_at_price_max | money }}
            </span>
            <span class="glass-product-section__price-sale">
              {{ panel_product.price | money }}
            </span>
          {% else %}
            <span>{{ panel_product.price | money }}</span>
          {% endif %}
        </div>

        {% form 'product', panel_product, class: 'glass-product-section__form' %}
          {% if panel_product.has_only_default_variant == false %}
            <div class="glass-product-section__variants">
              <div
                class="glass-product-section__variant-buttons"
                role="radiogroup"
                aria-label="{{ 'sections.immersive.product_panel.variant_group_label' | t }}"
              >
                {% for variant in panel_product.variants %}
                  <button
                    type="button"
                    role="radio"
                    class="glass-product-section__variant-button"
                    data-variant-id="{{ variant.id }}"
                    data-available="{{ variant.available }}"
                    aria-label="{{ variant.title }}"
                    aria-checked="{% if forloop.first %}true{% else %}false{% endif %}"
                    {% unless variant.available %}
                      disabled
                    {% endunless %}
                  >
                    {{ variant.title | split: ' / ' | first }}
                  </button>
                {% endfor %}
              </div>
              <input
                type="hidden"
                name="id"
                class="glass-product-section__variant-input"
                value="{{ panel_product.selected_or_first_available_variant.id }}"
              >
            </div>
          {% else %}
            <input type="hidden" name="id" value="{{ panel_product.selected_or_first_available_variant.id }}">
          {% endif %}

          <button
            type="submit"
            name="add"
            class="glass-product-section__add-to-cart"
            {% unless panel_product.available %}
              disabled
            {% endunless %}
            aria-label="{{ 'sections.immersive_store.add_to_edit' | t }} - {{ panel_product.title | escape }}"
          >
            {% if panel_product.available %}
              {{ 'sections.immersive_store.add_to_edit' | t }}
            {% else %}
              {{ 'products.product.sold_out' | t }}
            {% endif %}
          </button>
          {{ form | payment_button }}
        {% endform %}

        <button
          type="button"
          class="glass-product-section__wishlist-toggle"
          data-wishlist-toggle
          data-product-handle="{{ panel_product.handle }}"
          aria-pressed="false"
          aria-label="{{ 'sections.immersive_store.wishlist.save' | t: title: panel_product.title | escape }}"
          data-label-save="{{ 'sections.immersive_store.wishlist.save' | t: title: panel_product.title | escape }}"
          data-label-saved="{{ 'sections.immersive_store.wishlist.saved' | t: title: panel_product.title | escape }}"
        >
          <svg
            class="glass-product-section__heart glass-product-section__heart--outline"
            xmlns="http://www.w3.org/2000/svg"
            width="16"
            height="16"
            viewBox="0 0 24 24"
            fill="none"
            stroke="currentColor"
            stroke-width="2"
            stroke-linecap="round"
            stroke-linejoin="round"
            aria-hidden="true"
          >
            <path d="M20.84 4.61a5.5 5.5 0 0 0-7.78 0L12 5.67l-1.06-1.06a5.5 5.5 0 0 0-7.78 7.78l1.06 1.06L12 21.23l7.78-7.78 1.06-1.06a5.5 5.5 0 0 0 0-7.78z"></path>
          </svg>
          <svg
            class="glass-product-section__heart glass-product-section__heart--filled"
            xmlns="http://www.w3.org/2000/svg"
            width="16"
            height="16"
            viewBox="0 0 24 24"
            fill="currentColor"
            stroke="currentColor"
            stroke-width="2"
            stroke-linecap="round"
            stroke-linejoin="round"
            aria-hidden="true"
          >
            <path d="M20.84 4.61a5.5 5.5 0 0 0-7.78 0L12 5.67l-1.06-1.06a5.5 5.5 0 0 0-7.78 7.78l1.06 1.06L12 21.23l7.78-7.78 1.06-1.06a5.5 5.5 0 0 0 0-7.78z"></path>
          </svg>
          <span class="glass-product-section__wishlist-label" aria-hidden="true">
            {{ 'sections.immersive_store.wishlist.save_label' | t }}
          </span>
        </button>

        {%- if section.settings.show_delivery_estimate -%}
          <div class="glass-product-section__delivery">
            <svg
              style="height:18px;float:left;margin-right:8px;margin-top:1px;flex-shrink:0;"
              xmlns="http://www.w3.org/2000/svg"
              viewBox="0 0 24 24"
              fill="currentColor"
              aria-hidden="true"
            >
              <path d="M20 6h-2V4c0-.55-.45-1-1-1s-1 .45-1 1v2H8V4c0-.55-.45-1-1-1s-1 .45-1 1v2H4c-1.1 0-2 .9-2 2v12c0 1.1.9 2 2 2h16c1.1 0 2-.9 2-2V8c0-1.1-.9-2-2-2zm0 14H4V10h16v10z"/>
            </svg>
            <span
              data-delivery-template="{{ 'sections.immersive.product_panel.delivery_estimate' | t: from: '[[from]]', to: '[[to]]' | escape }}"
              ><span class="delivery-from">…</span> – <span class="delivery-to">…</span></span
            >
          </div>
        {%- endif -%}

        <div class="glass-product-section__share">
          {% if section.settings.show_share_buttons %}
            <span class="glass-product-section__share-label">
              {{- 'sections.immersive.product_panel.share_label' | t -}}
            </span>
            <div
              class="glass-product-section__share-buttons"
              data-copied-label="{{ 'general.share.copy_to_clipboard' | t | escape }}"
              data-copied-success="{{ 'general.share.success_message' | t | escape }}"
            >
              <a
                class="glass-product-section__share-btn glass-product-section__share-btn--whatsapp"
                href="#"
                data-platform="whatsapp"
                data-product-url="{{ panel_product.url | prepend: request.origin }}"
                data-product-title="{{ panel_product.title | escape }}"
                target="_blank"
                rel="noopener"
                aria-label="{{ 'sections.immersive.product_panel.share_on_whatsapp_aria' | t }}"
              >
                <svg width="16" height="16" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true">
                  <path d="M17.472 14.382c-.297-.149-1.758-.867-2.03-.967-.273-.099-.471-.148-.67.15-.197.297-.767.966-.94 1.164-.173.199-.347.223-.644.075-.297-.15-1.255-.463-2.39-1.475-.883-.788-1.48-1.761-1.653-2.059-.173-.297-.018-.458.13-.606.134-.133.298-.347.446-.52.149-.174.198-.298.298-.497.099-.198.05-.371-.025-.52-.075-.149-.669-1.612-.916-2.207-.242-.579-.487-.5-.669-.51-.173-.008-.371-.01-.57-.01-.198 0-.52.074-.792.372-.272.297-1.04 1.016-1.04 2.479 0 1.462 1.065 2.875 1.213 3.074.149.198 2.096 3.2 5.077 4.487.709.306 1.262.489 1.694.625.712.227 1.36.195 1.871.118.571-.085 1.758-.719 2.006-1.413.248-.694.248-1.289.173-1.413-.074-.124-.272-.198-.57-.347m-5.421 7.403h-.004a9.87 9.87 0 01-5.031-1.378l-.361-.214-3.741.982.998-3.648-.235-.374a9.86 9.86 0 01-1.51-5.26c.001-5.45 4.436-9.884 9.888-9.884 2.64 0 5.122 1.03 6.988 2.898a9.825 9.825 0 012.893 6.994c-.003 5.45-4.437 9.884-9.885 9.884m8.413-18.297A11.815 11.815 0 0012.05 0C5.495 0 .16 5.335.157 11.892c0 2.096.547 4.142 1.588 5.945L.057 24l6.305-1.654a11.882 11.882 0 005.683 1.448h.005c6.554 0 11.89-5.335 11.893-11.893a11.821 11.821 0 00-3.48-8.413z"/>
                </svg>
                WhatsApp
              </a>
              <a
                class="glass-product-section__share-btn glass-product-section__share-btn--facebook"
                href="#"
                data-platform="facebook"
                data-product-url="{{ panel_product.url | prepend: request.origin }}"
                data-product-title="{{ panel_product.title | escape }}"
                target="_blank"
                rel="noopener"
                aria-label="{{ 'sections.immersive.product_panel.share_on_facebook_aria' | t }}"
              >
                <svg width="16" height="16" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true">
                  <path d="M24 12.073c0-6.627-5.373-12-12-12s-12 5.373-12 12c0 5.99 4.388 10.954 10.125 11.854v-8.385H7.078v-3.47h3.047V9.43c0-3.007 1.792-4.669 4.533-4.669 1.312 0 2.686.235 2.686.235v2.953H15.83c-1.491 0-1.956.925-1.956 1.874v2.25h3.328l-.532 3.47h-2.796v8.385C19.612 23.027 24 18.062 24 12.073z"/>
                </svg>
                Facebook
              </a>
              <a
                class="glass-product-section__share-btn glass-product-section__share-btn--instagram"
                href="#"
                data-platform="instagram"
                data-product-url="{{ panel_product.url | prepend: request.origin }}"
                data-product-title="{{ panel_product.title | escape }}"
                target="_blank"
                rel="noopener"
                aria-label="{{ 'sections.immersive.product_panel.share_on_instagram_aria' | t }}"
              >
                <svg width="16" height="16" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true">
                  <path d="M12 2.163c3.204 0 3.584.012 4.85.07 3.252.148 4.771 1.691 4.919 4.919.058 1.265.069 1.645.069 4.849 0 3.205-.012 3.584-.069 4.849-.149 3.225-1.664 4.771-4.919 4.919-1.266.058-1.644.07-4.85.07-3.204 0-3.584-.012-4.849-.07-3.26-.149-4.771-1.699-4.919-4.92-.058-1.265-.07-1.644-.07-4.849 0-3.204.013-3.583.07-4.849.149-3.227 1.664-4.771 4.919-4.919 1.266-.057 1.645-.069 4.849-.069zM12 0C8.741 0 8.333.014 7.053.072 2.695.272.273 2.69.073 7.052.014 8.333 0 8.741 0 12c0 3.259.014 3.668.072 4.948.2 4.358 2.618 6.78 6.98 6.98C8.333 23.986 8.741 24 12 24c3.259 0 3.668-.014 4.948-.072 4.354-.2 6.782-2.618 6.979-6.98.059-1.28.073-1.689.073-4.948 0-3.259-.014-3.667-.072-4.947-.196-4.354-2.617-6.78-6.979-6.98C15.668.014 15.259 0 12 0zm0 5.838a6.162 6.162 0 100 12.324 6.162 6.162 0 000-12.324zM12 16a4 4 0 110-8 4 4 0 010 8zm6.406-11.845a1.44 1.44 0 100 2.881 1.44 1.44 0 000-2.881z"/>
                </svg>
                Instagram
              </a>
              <a
                class="glass-product-section__share-btn glass-product-section__share-btn--tiktok"
                href="#"
                data-platform="tiktok"
                data-product-url="{{ panel_product.url | prepend: request.origin }}"
                data-product-title="{{ panel_product.title | escape }}"
                target="_blank"
                rel="noopener"
                aria-label="{{ 'sections.immersive.product_panel.share_on_tiktok_aria' | t }}"
              >
                <svg width="16" height="16" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true">
                  <path d="M19.59 6.69a4.83 4.83 0 01-3.77-4.25V2h-3.45v13.67a2.89 2.89 0 01-2.88 2.5 2.89 2.89 0 01-2.89-2.89 2.89 2.89 0 012.89-2.89c.28 0 .54.04.79.1V9.01a6.33 6.33 0 00-.79-.05 6.34 6.34 0 00-6.34 6.34 6.34 6.34 0 006.34 6.34 6.34 6.34 0 006.33-6.34V8.69a8.18 8.18 0 004.78 1.52V6.75a4.85 4.85 0 01-1.01-.06z"/>
                </svg>
                TikTok
              </a>
            </div>
          {% endif %}
        </div>

        {%- if section.settings.enable_virtual_tryon -%}
          {%- render 'virtual-tryon', product: panel_product -%}
        {%- endif -%}

        {%- comment -%} Eid Delivery Badge {%- endcomment -%}
        {% if panel_product.metafields.custom.eid_delivery %}
          <div class="glass-product-section__eid-badge">
            <svg width="20" height="20" viewBox="0 0 20 20" fill="none" xmlns="http://www.w3.org/2000/svg">
              <path d="M10 2L12.5 7.5L18.5 8.5L14.25 12.5L15.5 18.5L10 15.5L4.5 18.5L5.75 12.5L1.5 8.5L7.5 7.5L10 2Z" fill="currentColor"/>
            </svg>
            <span>{{ panel_product.metafields.custom.eid_delivery | escape }}</span>
          </div>
        {% endif %}

        {%- comment -%} Collapsible Sections {%- endcomment -%}
        <div class="glass-product-section__collapsibles">
          {%- comment -%} Care Instructions {%- endcomment -%}
          <details class="glass-product-section__collapsible">
            <summary class="glass-product-section__collapsible-title">
              <span>{{ 'sections.immersive.product_panel.care_heading' | t }}</span>
              <svg width="12" height="8" viewBox="0 0 12 8" fill="none" xmlns="http://www.w3.org/2000/svg">
                <path d="M1 1L6 6L11 1" stroke="currentColor" stroke-width="2" stroke-linecap="round"/>
              </svg>
            </summary>
            <div class="glass-product-section__collapsible-content">
              {% if panel_product.metafields.custom.care_instructions %}
                {{ panel_product.metafields.custom.care_instructions }}
              {% else %}
                <ul>
                  <li>{{ 'sections.immersive.product_panel.care_default_dry_clean' | t }}</li>
                  <li>{{ 'sections.immersive.product_panel.care_default_no_bleach' | t }}</li>
                  <li>{{ 'sections.immersive.product_panel.care_default_iron_low' | t }}</li>
                  <li>{{ 'sections.immersive.product_panel.care_default_store' | t }}</li>
                </ul>
              {% endif %}
            </div>
          </details>

          {%- comment -%} Size Chart {%- endcomment -%}
          <details class="glass-product-section__collapsible">
            <summary class="glass-product-section__collapsible-title">
              <span>{{ 'sections.immersive.product_panel.size_heading' | t }}</span>
              <svg width="12" height="8" viewBox="0 0 12 8" fill="none" xmlns="http://www.w3.org/2000/svg">
                <path d="M1 1L6 6L11 1" stroke="currentColor" stroke-width="2" stroke-linecap="round"/>
              </svg>
            </summary>
            <div class="glass-product-section__collapsible-content">
              {% if panel_product.metafields.custom.size_chart %}
                {{ panel_product.metafields.custom.size_chart }}
              {% else %}
                <table class="glass-product-section__size-table">
                  <thead>
                    <tr>
                      <th>{{ 'sections.immersive.product_panel.size_table.size' | t }}</th>
                      <th>{{ 'sections.immersive.product_panel.size_table.bust' | t }}</th>
                      <th>{{ 'sections.immersive.product_panel.size_table.waist' | t }}</th>
                      <th>{{ 'sections.immersive.product_panel.size_table.hip' | t }}</th>
                    </tr>
                  </thead>
                  <tbody>
                    <tr>
                      <td>S</td>
                      <td>34-36"</td>
                      <td>26-28"</td>
                      <td>36-38"</td>
                    </tr>
                    <tr>
                      <td>M</td>
                      <td>38-40"</td>
                      <td>30-32"</td>
                      <td>40-42"</td>
                    </tr>
                    <tr>
                      <td>L</td>
                      <td>42-44"</td>
                      <td>34-36"</td>
                      <td>44-46"</td>
                    </tr>
                    <tr>
                      <td>XL</td>
                      <td>46-48"</td>
                      <td>38-40"</td>
                      <td>48-50"</td>
                    </tr>
                  </tbody>
                </table>
              {% endif %}
            </div>
          </details>

          {%- comment -%} Disclaimer {%- endcomment -%}
          <details class="glass-product-section__collapsible">
            <summary class="glass-product-section__collapsible-title">
              <span>{{ 'sections.immersive.product_panel.disclaimer_heading' | t }}</span>
              <svg width="12" height="8" viewBox="0 0 12 8" fill="none" xmlns="http://www.w3.org/2000/svg">
                <path d="M1 1L6 6L11 1" stroke="currentColor" stroke-width="2" stroke-linecap="round"/>
              </svg>
            </summary>
            <div class="glass-product-section__collapsible-content">
              {% if panel_product.metafields.custom.disclaimer %}
                {{ panel_product.metafields.custom.disclaimer }}
              {% else %}
                <p>{{ 'sections.immersive.product_panel.disclaimer_default' | t }}</p>
              {% endif %}
            </div>
          </details>
        </div>
      </div>
    </div>

    <div class="glass-product-section__related" data-related-root></div>
  {% else %}
    <p class="glass-product-section__empty">{{ 'sections.immersive.product_grid.empty' | t }}</p>
  {% endif %}

  {% if panel_product %}
    <script type="application/ld+json">
      {{ panel_product | structured_data }}
    </script>
  {% endif %}
</section>

{% stylesheet %}
  .glass-product-section {
    padding: 1.5rem;
    max-width: 1200px;
    margin: 0 auto;
    /* Reset Dawn's font scaling — use a readable base size */
    font-size: 16px;
  }

  .glass-product-section__header {
    text-align: center;
    margin-bottom: 3rem;
    padding: 3rem 1.5rem;
    background: rgba(8, 12, 24, 0.96);
    backdrop-filter: blur(24px);
    -webkit-backdrop-filter: blur(24px);
    border-radius: 1px;
    border: 1px solid rgba(212, 175, 55, 0.2);
    box-shadow: 0 4px 32px rgba(0, 0, 0, 0.5);
  }

  .glass-product-section__breadcrumb {
    display: flex;
    align-items: center;
    justify-content: center;
    gap: 0.75rem;
    margin-bottom: 1.5rem;
    font-size: 0.75rem;
    text-transform: uppercase;
    letter-spacing: 0.15em;
    color: rgba(255, 255, 255, 0.55);
  }

  .glass-product-section__breadcrumb-separator {
    opacity: 0.4;
  }

  .glass-product-section__breadcrumb-current {
    color: #d4af37;
    font-weight: 600;
  }

  /* Breadcrumb buttons — look like text links, not buttons */
  .glass-product-section__breadcrumb-btn {
    background: none;
    border: none;
    padding: 0;
    margin: 0;
    font: inherit;
    font-size: 0.75rem;
    text-transform: uppercase;
    letter-spacing: 0.15em;
    color: rgba(255, 255, 255, 0.55);
    cursor: pointer;
    transition: color 0.2s ease;
  }

  .glass-product-section__breadcrumb-btn:hover {
    color: #fff;
    text-decoration: underline;
    text-underline-offset: 3px;
  }

  .glass-product-section__breadcrumb-btn:focus-visible {
    outline: 2px solid #d4af37;
    outline-offset: 3px;
    border-radius: 2px;
  }

  .glass-product-section__back {
    border: 1px solid rgba(148, 163, 184, 0.8);
    background: rgba(15, 23, 42, 0.85);
    color: #d4af37;
    border-radius: 999px;
    padding: 0.4rem 0.9rem;
    font-size: 1.125rem;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    cursor: pointer;
    margin-bottom: 1rem;
  }

  .glass-product-section__back:hover {
    background: rgba(30, 64, 175, 0.9);
  }

  .glass-product-section__title-wrap {
    margin-top: 0.5rem;
  }

  .glass-product-section__title {
    margin: 0 0 0.75rem;
    font-size: clamp(1.75rem, 4vw, 2.75rem);
    font-weight: 600;
    color: #d4af37;
    text-align: center;
    text-transform: uppercase;
    letter-spacing: 0.1em;
    line-height: 1.1;
  }

  .glass-product-section__vendor {
    margin: 0;
    font-size: 1.125rem;
    color: rgba(212, 175, 55, 0.9);
    text-align: center;
  }

  .glass-product-section__vendor--link {
    background: none;
    border: none;
    padding: 0;
    cursor: pointer;
    font: inherit;
    font-size: 1.125rem;
    color: rgba(212, 175, 55, 0.9);
    text-decoration: underline;
    text-underline-offset: 3px;
    text-decoration-color: rgba(212, 175, 55, 0.4);
    transition: color 0.2s ease, text-decoration-color 0.2s ease;
  }

  .glass-product-section__vendor--link:hover {
    color: #d4af37;
    text-decoration-color: #d4af37;
  }

  .glass-product-section__vendor--link:focus-visible {
    outline: 2px solid #d4af37;
    outline-offset: 3px;
    border-radius: 2px;
  }

  .glass-product-section__layout {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 2rem;
  }

  .glass-product-section__media {
    width: 100%;
    max-width: 500px;
  }

  .glass-product-section__media-main {
    border-radius: 0.75rem;
    overflow: hidden;
    width: 100%;
    aspect-ratio: 3 / 4;
  }

  .glass-product-section__media-main img,
  .glass-product-section__media-main video {
    width: 100%;
    height: 100%;
    object-fit: cover;
    will-change: transform;
    transform: scale(1.06);
    transition: transform 0.1s ease-out;
  }

  .glass-product-section__media-thumbs {
    display: flex;
    gap: 0.5rem;
    margin-top: 0.75rem;
    justify-content: center;
    flex-wrap: wrap;
  }

  .glass-product-section__thumb {
    border: 2px solid transparent;
    padding: 0;
    background: transparent;
    cursor: pointer;
    border-radius: 0.5rem;
    overflow: hidden;
    width: 60px;
    height: 80px;
    transition: border-color 0.2s ease;
  }

  .glass-product-section__thumb:hover {
    border-color: rgba(212, 175, 55, 0.5);
  }

  .glass-product-section__thumb.is-active {
    border-color: #d4af37;
    border-width: 2px;
  }

  .glass-product-section__thumb img,
  .glass-product-section__thumb video {
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  .glass-product-section__info {
    width: 100%;
    max-width: 500px;
    font-size: 1.125rem;
    text-align: center;
    background: rgba(8, 12, 24, 0.96);
    border-radius: 0.75rem;
    border: 1px solid rgba(212, 175, 55, 0.15);
    padding: 1.5rem;
  }

  .glass-product-section__description {
    margin-bottom: 1.5rem;
    color: rgba(255, 255, 255, 0.85);
    line-height: 1.6;
    text-align: left;
  }

  .glass-product-section__description h3 {
    color: #d4af37;
    margin-top: 1rem;
    margin-bottom: 0.5rem;
  }

  .glass-product-section__price {
    margin-bottom: 1.5rem;
    font-size: 1.8rem;
    font-weight: 600;
    color: #d4af37;
  }

  .glass-product-section__price-compare {
    text-decoration: line-through;
    opacity: 0.5;
    margin-right: 0.5rem;
  }

  .glass-product-section__price-sale {
    color: #ff6b6b;
  }

  .glass-product-section__variants {
    margin-bottom: 1.5rem;
  }

  .glass-product-section__variant-buttons {
    display: flex;
    flex-wrap: wrap;
    gap: 0.5rem;
    justify-content: center;
  }

  .glass-product-section__variant-button {
    padding: 0.5rem 1rem;
    background: rgba(255, 255, 255, 0.08);
    border: 1px solid rgba(255, 255, 255, 0.25);
    color: #fff;
    border-radius: 8px;
    font-size: 1rem;
    cursor: pointer;
    transition: border-color 0.2s ease, background-color 0.2s ease, transform 0.2s ease;
  }

  .glass-product-section__variant-button:hover:not(:disabled) {
    background: rgba(212, 175, 55, 0.15);
    border-color: #d4af37;
    color: #d4af37;
    transform: translateY(-1px);
  }

  .glass-product-section__variant-button:focus {
    outline: 2px solid #d4af37;
    outline-offset: 2px;
  }

  .glass-product-section__variant-button.active,
  .glass-product-section__variant-button[aria-checked='true'] {
    border: 2px solid #d4af37;
    background: rgba(212, 175, 55, 0.15);
    color: #d4af37;
    font-weight: 600;
  }

  .glass-product-section__variant-button:disabled {
    opacity: 0.4;
    cursor: not-allowed;
    text-decoration: line-through;
  }

  .glass-product-section__variant-input {
    display: none;
  }

  .glass-product-section__add-to-cart {
    width: 100%;
    max-width: 300px;
    padding: 0.875rem 2rem;
    margin: 0 auto;
    border-radius: 999px;
    border: none;
    background: rgba(212, 175, 55, 0.9);
    backdrop-filter: blur(8px);
    -webkit-backdrop-filter: blur(8px);
    color: #0a0f1e;
    font-weight: 700;
    font-size: 1rem;
    letter-spacing: 0.05em;
    cursor: pointer;
    transition: background 0.2s ease, transform 0.2s ease;
    display: block;
  }

  .glass-product-section__add-to-cart:hover:not(:disabled) {
    background: #e8c84a;
    transform: translateY(-2px);
  }

  .glass-product-section__add-to-cart:focus-visible {
    outline: 3px solid #fff;
    outline-offset: 3px;
  }

  .glass-product-section__add-to-cart:disabled {
    background: rgba(212, 175, 55, 0.35);
    color: rgba(255, 255, 255, 0.5);
    cursor: not-allowed;
  }

  /* Accelerated checkout buttons (PayPal, Apple Pay, etc.)
     Visually separated from the primary "Add to my edit" action.
     Reduced opacity and scale so they read as secondary options. */
  .glass-product-section .shopify-payment-button {
    margin-top: 0.5rem;
    width: 100%;
    max-width: 300px;
    margin-left: auto;
    margin-right: auto;
  }

  .glass-product-section .shopify-payment-button__button {
    border-radius: 999px !important;
    min-height: 44px !important;
    font-size: 0.875rem !important;
    opacity: 0.85;
    transition: opacity 0.2s ease, transform 0.2s ease;
  }

  .glass-product-section .shopify-payment-button__button:hover {
    opacity: 1;
    transform: translateY(-1px);
  }

  /* "More payment options" link */
  .glass-product-section .shopify-payment-button__more-options {
    color: rgba(212, 175, 55, 0.6) !important;
    font-size: 0.8rem !important;
    text-decoration: underline;
    margin-top: 0.5rem;
    display: block;
    text-align: center;
  }

  .glass-product-section .shopify-payment-button__more-options:hover {
    color: #d4af37 !important;
  }

  /* Eid Delivery Badge */
  .glass-product-section__eid-badge {
    display: flex;
    align-items: center;
    justify-content: center;
    gap: 0.5rem;
    margin: 1.5rem auto 0;
    padding: 0.75rem 1.5rem;
    background: rgba(34, 197, 94, 0.15);
    border: 1px solid rgba(34, 197, 94, 0.4);
    border-radius: 999px;
    color: rgb(134, 239, 172);
    font-size: 1.125rem;
    font-weight: 500;
    max-width: fit-content;
  }

  .glass-product-section__eid-badge svg {
    flex-shrink: 0;
  }

  /* Collapsible Sections */
  .glass-product-section__collapsibles {
    margin-top: 2rem;
    border-top: 1px solid rgba(148, 163, 184, 0.2);
  }

  .glass-product-section__collapsible {
    border-bottom: 1px solid rgba(148, 163, 184, 0.2);
  }

  .glass-product-section__collapsible-title {
    display: flex;
    align-items: center;
    justify-content: space-between;
    padding: 1rem 0;
    cursor: pointer;
    font-weight: 500;
    color: #d4af37;
    list-style: none;
    user-select: none;
  }

  .glass-product-section__collapsible-title::-webkit-details-marker {
    display: none;
  }

  .glass-product-section__collapsible-title svg {
    transition: transform 0.2s ease;
    color: rgba(212, 175, 55, 0.9);
  }

  .glass-product-section__collapsible[open] .glass-product-section__collapsible-title svg {
    transform: rotate(180deg);
  }

  .glass-product-section__collapsible-content {
    padding-bottom: 1rem;
    color: rgba(255, 255, 255, 0.8);
    line-height: 1.6;
    text-align: left;
  }

  .glass-product-section__collapsible-content ul {
    margin: 0;
    padding-left: 1.5rem;
  }

  .glass-product-section__collapsible-content li {
    margin-bottom: 0.5rem;
  }

  .glass-product-section__collapsible-content p {
    margin: 0;
  }

  /* Size Chart Table */
  .glass-product-section__size-table {
    width: 100%;
    border-collapse: collapse;
    margin-top: 0.5rem;
  }

  .glass-product-section__size-table th,
  .glass-product-section__size-table td {
    padding: 0.75rem;
    text-align: left;
    border: 1px solid rgba(148, 163, 184, 0.2);
  }

  .glass-product-section__size-table th {
    background: rgba(255, 255, 255, 0.05);
    font-weight: 600;
    color: #fff;
  }

  .glass-product-section__size-table td {
    color: rgba(255, 255, 255, 0.85);
  }

  /* Related Products */
  .glass-product-section__related {
    margin-top: 3rem;
    padding-top: 2rem;
    border-top: 1px solid rgba(148, 163, 184, 0.2);
  }

  .glass-product-section__empty {
    text-align: center;
    color: rgba(255, 255, 255, 0.5);
    font-size: 1rem;
    padding: 3rem 1rem;
  }

  .glass-product-section__related-title {
    margin: 0 0 1.5rem;
    font-size: 1.5rem;
    font-weight: 600;
    color: #d4af37;
    text-align: center;
  }

  .glass-product-section__related-grid {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(150px, 1fr));
    gap: 1rem;
  }

  .glass-product-section__related-item {
    cursor: pointer;
    border-radius: 0.5rem;
    overflow: hidden;
    transition: transform 0.2s ease;
    background: rgba(255, 255, 255, 0.05);
  }

  .glass-product-section__related-item:hover {
    transform: translateY(-4px);
  }

  .glass-product-section__related-item img {
    width: 100%;
    aspect-ratio: 3 / 4;
    object-fit: cover;
    display: block;
  }

  .glass-product-section__related-item-media {
    overflow: hidden;
    aspect-ratio: 3 / 4;
    width: 100%;
  }

  .glass-product-section__related-item-media img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    display: block;
    will-change: transform;
    transform: scale(1.06) translate(0px, 0px);
    transition: transform 0.1s ease-out;
  }

  .glass-product-section__related-item-title {
    margin: 0.75rem 0.5rem 0.25rem;
    font-size: 1.125rem;
    color: #d4af37;
    font-weight: 500;
    overflow: hidden;
    text-overflow: ellipsis;
    white-space: nowrap;
  }

  .glass-product-section__related-item-price {
    margin: 0 0.5rem 0.75rem;
    font-size: 1.125rem;
    color: rgba(212, 175, 55, 0.9);
    font-weight: 600;
  }

  /* Share Button */
  .glass-product-section__share {
    margin-top: 1rem;
    text-align: center;
  }

  .glass-product-section__share-label {
    display: block;
    font-size: 0.75rem;
    text-transform: uppercase;
    letter-spacing: 0.08em;
    color: rgba(255, 255, 255, 0.5);
    margin-bottom: 0.6rem;
  }

  .glass-product-section__share-buttons {
    display: flex;
    gap: 0.5rem;
    justify-content: center;
    flex-wrap: wrap;
  }

  .glass-product-section__share-btn {
    display: inline-flex;
    align-items: center;
    gap: 0.4rem;
    padding: 0.45rem 0.9rem;
    border-radius: 999px;
    font-size: 0.8rem;
    font-weight: 500;
    cursor: pointer;
    text-decoration: none;
    border: 1px solid rgba(212, 175, 55, 0.3);
    background: rgba(212, 175, 55, 0.06);
    color: #d4af37;
    transition: background 0.2s, border-color 0.2s, color 0.2s;
  }

  .glass-product-section__share-btn:hover {
    background: rgba(212, 175, 55, 0.15);
    border-color: rgba(212, 175, 55, 0.6);
    color: #d4af37;
  }

  .glass-product-section__share-btn--whatsapp:hover {
    background: rgba(37, 211, 102, 0.12);
    border-color: rgba(37, 211, 102, 0.5);
    color: #25d366;
  }
  .glass-product-section__share-btn--facebook:hover {
    background: rgba(24, 119, 242, 0.12);
    border-color: rgba(24, 119, 242, 0.5);
    color: #1877f2;
  }
  .glass-product-section__share-btn--instagram:hover {
    background: rgba(225, 48, 108, 0.12);
    border-color: rgba(225, 48, 108, 0.5);
    color: #e1306c;
  }
  .glass-product-section__share-btn--tiktok:hover {
    background: rgba(255, 255, 255, 0.1);
    border-color: rgba(255, 255, 255, 0.4);
    color: #d4af37;
  }
  /* Delivery estimate */
  .glass-product-section__delivery {
    display: flex;
    align-items: flex-start;
    margin: 1rem auto 0;
    padding: 0.7rem 1rem;
    background: rgba(212, 175, 55, 0.06);
    border: 1px solid rgba(212, 175, 55, 0.2);
    border-radius: 10px;
    font-size: 0.85rem;
    color: rgba(255, 255, 255, 0.85);
    max-width: 360px;
    text-align: left;
    line-height: 1.5;
  }

  .glass-product-section__delivery svg {
    color: #d4af37;
    margin-top: 1px;
  }

  .glass-product-section__delivery strong {
    color: #d4af37;
  }

  @media (prefers-reduced-motion: reduce) {
    .glass-product-section__image,
    .glass-product-section__related-item,
    .glass-product-section__variant-btn,
    .glass-product-section__variant-button {
      transform: none !important;
      transition: none !important;
      animation: none !important;
    }
  }

  /* ── Wishlist Toggle (product panel) ─────────────────── */
  .glass-product-section__wishlist-toggle {
    display: flex;
    align-items: center;
    gap: 0.5rem;
    width: 100%;
    max-width: 300px;
    margin: 0.75rem auto 0;
    padding: 0.6rem 1.5rem;
    background: rgba(255, 255, 255, 0.06);
    border: 1px solid rgba(255, 255, 255, 0.2);
    border-radius: 999px;
    color: rgba(255, 255, 255, 0.8);
    font-size: 0.875rem;
    font-weight: 500;
    cursor: pointer;
    justify-content: center;
    transition: border-color 0.2s, color 0.2s, background 0.2s;
  }

  .glass-product-section__wishlist-toggle:hover {
    border-color: rgba(212, 175, 55, 0.6);
    color: #d4af37;
    background: rgba(212, 175, 55, 0.08);
  }

  .glass-product-section__wishlist-toggle:focus-visible {
    outline: 2px solid #d4af37;
    outline-offset: 2px;
  }

  .glass-product-section__heart--filled {
    display: none;
  }

  .glass-product-section__wishlist-toggle.is-saved .glass-product-section__heart--outline {
    display: none;
  }

  .glass-product-section__wishlist-toggle.is-saved .glass-product-section__heart--filled {
    display: block;
  }

  .glass-product-section__wishlist-toggle.is-saved {
    border-color: rgba(212, 175, 55, 0.6);
    color: #d4af37;
    background: rgba(212, 175, 55, 0.08);
  }

  @media (prefers-reduced-motion: reduce) {
    .glass-product-section__wishlist-toggle {
      transition: none !important;
    }
  }

  /* ============================================================================
     MOBILE RESPONSIVE — small phones (≤480px) and large phones (481–767px)
  ============================================================================ */

  /* Base mobile — applies to all phones */
  @media screen and (max-width: 767px) {
    .glass-product-section {
      padding: 1rem;
    }

    /* Product title — large and readable */
    .glass-product-section__title {
      font-size: clamp(1.5rem, 6vw, 2rem);
      line-height: 1.25;
    }

    .glass-product-section__vendor {
      font-size: clamp(0.9rem, 3.5vw, 1.1rem);
    }

    /* Price — prominent */
    .glass-product-section__price {
      font-size: clamp(1.4rem, 5.5vw, 1.8rem);
    }

    /* Description text */
    .glass-product-section__description {
      font-size: clamp(0.95rem, 3.5vw, 1.1rem);
      line-height: 1.65;
    }

    /* Variant buttons — larger tap targets */
    .glass-product-section__variant-button {
      font-size: clamp(0.9rem, 3.5vw, 1.1rem);
      padding: 0.6rem 1.1rem;
      min-height: 44px;
    }

    /* Add to cart — full width, tall tap target */
    .glass-product-section__add-to-cart {
      max-width: 100%;
      font-size: clamp(1rem, 4vw, 1.2rem);
      padding: 1rem 1.5rem;
      min-height: 52px;
    }

    /* Back button */
    .glass-product-section__back {
      font-size: clamp(0.8rem, 3vw, 1rem);
      padding: 0.5rem 1rem;
      min-height: 40px;
    }

    /* Collapsible titles */
    .glass-product-section__collapsible-title {
      font-size: clamp(0.95rem, 3.5vw, 1.1rem);
      padding: 0.875rem 0;
      min-height: 44px;
    }

    /* Collapsible content */
    .glass-product-section__collapsible-content {
      font-size: clamp(0.875rem, 3.2vw, 1rem);
      line-height: 1.65;
    }

    /* Size table — readable on small screens */
    .glass-product-section__size-table th,
    .glass-product-section__size-table td {
      font-size: clamp(0.8rem, 3vw, 0.95rem);
      padding: 0.6rem 0.5rem;
    }

    /* Wishlist toggle */
    .glass-product-section__wishlist-toggle {
      font-size: clamp(0.875rem, 3.2vw, 1rem);
      min-height: 44px;
      padding: 0.6rem 1.2rem;
    }

    /* Delivery estimate */
    .glass-product-section__delivery {
      font-size: clamp(0.875rem, 3.2vw, 1rem);
    }

    /* Share buttons */
    .glass-product-section__share-label {
      font-size: clamp(0.8rem, 3vw, 0.95rem);
    }

    .glass-product-section__share-btn {
      font-size: clamp(0.8rem, 3vw, 0.95rem);
    }

    /* Eid badge */
    .glass-product-section__eid-badge {
      font-size: clamp(0.875rem, 3.2vw, 1rem);
    }

    /* Payment buttons — full width on mobile */
    .glass-product-section .shopify-payment-button {
      max-width: 100%;
    }

    .glass-product-section .shopify-payment-button__button {
      font-size: 0.9rem !important;
    }

    /* Related products heading */
    .glass-product-section__related-title {
      font-size: clamp(1.1rem, 4.5vw, 1.4rem);
    }

    /* Thumbs — larger on mobile */
    .glass-product-section__thumb {
      width: 52px;
      height: 70px;
    }
  }

  /* Small phones only (≤390px — iPhone SE, older Androids) */
  @media screen and (max-width: 390px) {
    .glass-product-section {
      padding: 0.75rem;
    }

    .glass-product-section__title {
      font-size: clamp(1.3rem, 7vw, 1.6rem);
    }

    .glass-product-section__price {
      font-size: clamp(1.25rem, 6vw, 1.5rem);
    }

    .glass-product-section__add-to-cart {
      font-size: 1rem;
      padding: 0.875rem 1rem;
    }

    .glass-product-section__variant-button {
      font-size: 0.875rem;
      padding: 0.5rem 0.875rem;
    }

    /* Stack share buttons on very small screens */
    .glass-product-section__share-buttons {
      flex-wrap: wrap;
      gap: 0.5rem;
    }
  }

  /* ── Prev / Next product navigation ─────────────────── */
  .glass-product-section__product-nav {
    display: flex;
    align-items: stretch;
    justify-content: space-between;
    gap: 0.75rem;
    margin-bottom: 2rem;
  }

  .glass-product-section__product-nav-btn {
    display: flex;
    align-items: center;
    gap: 0.625rem;
    flex: 1;
    padding: 0.75rem 1rem;
    background: rgba(8, 12, 24, 0.85);
    border: 1px solid rgba(212, 175, 55, 0.2);
    border-radius: 0.5rem;
    color: rgba(255, 255, 255, 0.75);
    cursor: pointer;
    text-align: left;
    transition: border-color 0.2s ease, background 0.2s ease, color 0.2s ease;
    min-width: 0;
  }

  .glass-product-section__product-nav-btn--next {
    justify-content: flex-end;
    text-align: right;
  }

  .glass-product-section__product-nav-btn--placeholder {
    flex: 1;
    background: none;
    border: none;
    cursor: default;
  }

  .glass-product-section__product-nav-btn:not(.glass-product-section__product-nav-btn--placeholder):hover {
    border-color: rgba(212, 175, 55, 0.5);
    background: rgba(212, 175, 55, 0.08);
    color: #fff;
  }

  .glass-product-section__product-nav-btn:focus-visible {
    outline: 2px solid #d4af37;
    outline-offset: 2px;
    border-radius: 0.5rem;
  }

  .glass-product-section__product-nav-btn svg {
    flex-shrink: 0;
    color: #d4af37;
  }

  .glass-product-section__product-nav-label {
    display: flex;
    flex-direction: column;
    gap: 0.125rem;
    min-width: 0;
    overflow: hidden;
  }

  .glass-product-section__product-nav-hint {
    font-size: 0.65rem;
    text-transform: uppercase;
    letter-spacing: 0.12em;
    color: rgba(212, 175, 55, 0.7);
  }

  .glass-product-section__product-nav-title {
    font-size: 0.8125rem;
    font-weight: 500;
    white-space: nowrap;
    overflow: hidden;
    text-overflow: ellipsis;
  }

  @media (max-width: 480px) {
    .glass-product-section__product-nav-title {
      display: none;
    }
    .glass-product-section__product-nav-btn {
      flex: 0 0 auto;
      padding: 0.75rem;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .glass-product-section__product-nav-btn {
      transition: none !important;
    }
  }
{% endstylesheet %}

