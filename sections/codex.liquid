{% comment %}
  SHAHANA COLLECTION — CODEX SECTION
  An interactive Three.js 3D object section for the 2D storefront.
  Renders a draggable/touch-rotatable 3D mesh using the locally-hosted
  three.min.js asset (already present in assets/ for the immersive store).

  Three.js is only loaded on page.immersive normally, so this section
  injects its own deferred script tag when placed on other templates.
  On page.immersive the global THREE object is already available.

  Accessibility:
  - Canvas is aria-hidden; section has a visible heading and description.
  - Pointer/touch events are guarded by prefers-reduced-motion.
  - Resize observer keeps the canvas pixel-perfect without layout shift.
{% endcomment %}

<section
  id="codex-{{ section.id }}"
  class="codex"
  data-section-id="{{ section.id }}"
  data-background-color="{{ section.settings.background_color | escape }}"
  data-rotation-speed="{{ section.settings.rotation_speed }}"
  data-enable-auto-rotate="{{ section.settings.enable_auto_rotate }}"
>
  <header class="codex__header">
    {%- if section.settings.heading != blank -%}
      <h2 class="codex__heading">
        {{ section.settings.heading | escape }}
      </h2>
    {%- endif -%}
    {%- if section.settings.subheading != blank -%}
      <p class="codex__subheading">
        {{ section.settings.subheading | escape }}
      </p>
    {%- endif -%}
  </header>

  <div class="codex__canvas-wrapper">
    <canvas
      class="codex__canvas"
      aria-hidden="true"
    ></canvas>
  </div>

  <p class="codex__instructions">
    {{ 'sections.codex.instructions' | t }}
  </p>
</section>

{%- comment -%}
  Inject Three.js only when it hasn't already been loaded by the
  immersive store (page.immersive loads it globally via theme.liquid).
{%- endcomment -%}
{%- unless template == 'page.immersive' -%}
  <script src="{{ 'three.min.js' | asset_url }}" defer="defer"></script>
{%- endunless -%}

{% stylesheet %}
  .codex {
    position: relative;
    padding: 3rem 1.5rem;
    background-color: var(--codex-bg, #050509);
    color: #f5f5f5;
    overflow: hidden;
  }

  .codex__header {
    max-width: 60rem;
    margin: 0 auto 1.5rem auto;
    text-align: center;
  }

  .codex__heading {
    font-size: clamp(1.8rem, 3vw, 2.4rem);
    font-weight: 600;
    letter-spacing: 0.04em;
    margin: 0 0 0.5rem 0;
    color: #d4af37;
  }

  .codex__subheading {
    font-size: 1rem;
    max-width: 40rem;
    margin: 0 auto;
    opacity: 0.8;
    line-height: 1.6;
  }

  .codex__canvas-wrapper {
    position: relative;
    max-width: 80rem;
    margin: 2rem auto;
    aspect-ratio: 16 / 9;
    border-radius: 1.25rem;
    overflow: hidden;
    background: radial-gradient(ellipse at top, #202040, #050509);
    border: 1px solid rgba(212, 175, 55, 0.15);
    cursor: grab;
  }

  .codex--interacting .codex__canvas-wrapper {
    cursor: grabbing;
  }

  .codex__canvas {
    width: 100%;
    height: 100%;
    display: block;
  }

  .codex__instructions {
    text-align: center;
    font-size: 0.875rem;
    opacity: 0.6;
    max-width: 30rem;
    margin: 0.5rem auto 0 auto;
    letter-spacing: 0.02em;
  }

  @media (max-width: 768px) {
    .codex {
      padding-inline: 1rem;
    }

    .codex__canvas-wrapper {
      aspect-ratio: 4 / 3;
      border-radius: 0.75rem;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .codex__canvas-wrapper {
      cursor: default;
    }
  }
{% endstylesheet %}

{% javascript %}
  (function () {
    var sectionEl = document.querySelector('#codex-{{ section.id }}');
    if (!sectionEl) return;

    var canvas = sectionEl.querySelector('.codex__canvas');
    if (!canvas) return;

    var bgColor = sectionEl.dataset.backgroundColor || '#050509';
    var rotationSpeed = parseFloat(sectionEl.dataset.rotationSpeed || '0.004');
    var enableAutoRotate = sectionEl.dataset.enableAutoRotate === 'true';

    sectionEl.style.setProperty('--codex-bg', bgColor);

    var prefersReducedMotion = window.matchMedia && window.matchMedia('(prefers-reduced-motion: reduce)').matches;

    // ── Wait for THREE to be available ──────────────────────────────
    function waitForThree(cb, attempts) {
      attempts = attempts || 0;
      if (typeof THREE !== 'undefined') {
        cb();
      } else if (attempts < 40) {
        setTimeout(function () {
          waitForThree(cb, attempts + 1);
        }, 100);
      } else {
        console.warn('[Codex] Three.js did not load in time.');
      }
    }

    waitForThree(function () {
      // ── Renderer ──────────────────────────────────────────────────
      var renderer = new THREE.WebGLRenderer({
        canvas: canvas,
        antialias: true,
        alpha: true,
      });
      renderer.setPixelRatio(Math.min(window.devicePixelRatio || 1, 2));

      // ── Scene & Camera ────────────────────────────────────────────
      var scene = new THREE.Scene();
      scene.background = null;

      var camera = new THREE.PerspectiveCamera(45, 16 / 9, 0.1, 100);
      camera.position.set(0, 0, 4);

      // ── Lighting ──────────────────────────────────────────────────
      var ambient = new THREE.AmbientLight(0xffffff, 0.4);
      scene.add(ambient);

      var keyLight = new THREE.DirectionalLight(0xffffff, 0.9);
      keyLight.position.set(3, 5, 5);
      scene.add(keyLight);

      var fillLight = new THREE.DirectionalLight(0x4f6fff, 0.6);
      fillLight.position.set(-4, -3, -2);
      scene.add(fillLight);

      var goldRim = new THREE.DirectionalLight(0xd4af37, 0.4);
      goldRim.position.set(0, -4, -3);
      scene.add(goldRim);

      // ── Geometry — book-like box ───────────────────────────────────
      var geometry = new THREE.BoxGeometry(1.8, 2.4, 0.25);

      var faceColors = [
        0x1b1b3a, // right
        0x252547, // left
        0x31315c, // top
        0x3a3a6a, // bottom
        0xd4af37, // front — gold cover
        0x45457a, // back
      ];

      var materials = faceColors.map(function (color) {
        return new THREE.MeshStandardMaterial({
          color: color,
          metalness: color === 0xd4af37 ? 0.7 : 0.3,
          roughness: color === 0xd4af37 ? 0.2 : 0.5,
        });
      });

      var codexMesh = new THREE.Mesh(geometry, materials);
      scene.add(codexMesh);

      // ── Interaction state ─────────────────────────────────────────
      var targetRotX = 0.3;
      var targetRotY = 0.8;
      var isPointerDown = false;
      var lastPointerX = 0;
      var lastPointerY = 0;

      // ── Resize ────────────────────────────────────────────────────
      function resize() {
        var w = canvas.clientWidth;
        var h = canvas.clientHeight;
        if (w === 0 || h === 0) return;
        renderer.setSize(w, h, false);
        camera.aspect = w / h;
        camera.updateProjectionMatrix();
      }

      resize();

      if (typeof ResizeObserver !== 'undefined') {
        new ResizeObserver(resize).observe(canvas);
      } else {
        window.addEventListener('resize', resize);
      }

      // ── Pointer events ────────────────────────────────────────────
      function getClientXY(event) {
        if (event.touches && event.touches[0]) {
          return { x: event.touches[0].clientX, y: event.touches[0].clientY };
        }
        return { x: event.clientX, y: event.clientY };
      }

      function onPointerDown(event) {
        if (prefersReducedMotion) return;
        isPointerDown = true;
        var pos = getClientXY(event);
        lastPointerX = pos.x;
        lastPointerY = pos.y;
        sectionEl.classList.add('codex--interacting');
      }

      function onPointerMove(event) {
        if (!isPointerDown || prefersReducedMotion) return;
        var pos = getClientXY(event);
        var dx = pos.x - lastPointerX;
        var dy = pos.y - lastPointerY;
        targetRotY += dx * 0.005;
        targetRotX += dy * 0.005;
        targetRotX = Math.max(-Math.PI / 2, Math.min(Math.PI / 2, targetRotX));
        lastPointerX = pos.x;
        lastPointerY = pos.y;
      }

      function onPointerUp() {
        isPointerDown = false;
        sectionEl.classList.remove('codex--interacting');
      }

      canvas.addEventListener('mousedown', onPointerDown);
      window.addEventListener('mousemove', onPointerMove);
      window.addEventListener('mouseup', onPointerUp);
      canvas.addEventListener('touchstart', onPointerDown, { passive: true });
      window.addEventListener('touchmove', onPointerMove, { passive: true });
      window.addEventListener('touchend', onPointerUp);

      // ── Animation loop ────────────────────────────────────────────
      var clock = new THREE.Clock();
      var rafId = null;

      function animate() {
        rafId = requestAnimationFrame(animate);
        var elapsed = clock.getElapsedTime();

        if (enableAutoRotate && !isPointerDown && !prefersReducedMotion) {
          targetRotY += rotationSpeed;
        }

        // Lerp toward target rotation
        codexMesh.rotation.x += (targetRotX - codexMesh.rotation.x) * 0.1;
        codexMesh.rotation.y += (targetRotY - codexMesh.rotation.y) * 0.1;

        // Gentle float
        if (!prefersReducedMotion) {
          codexMesh.position.y = Math.sin(elapsed * 1.2) * 0.12;
        }

        renderer.render(scene, camera);
      }

      animate();

      // ── Theme editor cleanup ──────────────────────────────────────
      document.addEventListener('shopify:section:unload', function (e) {
        if (e.detail.sectionId !== '{{ section.id }}') return;
        if (rafId) cancelAnimationFrame(rafId);
        canvas.removeEventListener('mousedown', onPointerDown);
        canvas.removeEventListener('touchstart', onPointerDown);
        window.removeEventListener('mousemove', onPointerMove);
        window.removeEventListener('mouseup', onPointerUp);
        window.removeEventListener('touchmove', onPointerMove);
        window.removeEventListener('touchend', onPointerUp);
        renderer.dispose();
      });
    });
  })();
{% endjavascript %}

{% schema %}
{
  "name": "t:sections.codex.name",
  "settings": [
    {
      "type": "header",
      "content": "t:sections.codex.settings.display_header"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "t:sections.codex.settings.heading.label",
      "default": "The Codex"
    },
    {
      "type": "textarea",
      "id": "subheading",
      "label": "t:sections.codex.settings.subheading.label",
      "default": "Explore the Shahana Codex in three dimensions."
    },
    {
      "type": "header",
      "content": "t:sections.codex.settings.behavior_header"
    },
    {
      "type": "checkbox",
      "id": "enable_auto_rotate",
      "label": "t:sections.codex.settings.enable_auto_rotate.label",
      "default": true
    },
    {
      "type": "range",
      "id": "rotation_speed",
      "label": "t:sections.codex.settings.rotation_speed.label",
      "min": 0,
      "max": 0.03,
      "step": 0.001,
      "default": 0.004,
      "info": "t:sections.codex.settings.rotation_speed.info"
    },
    {
      "type": "header",
      "content": "t:sections.codex.settings.style_header"
    },
    {
      "type": "color",
      "id": "background_color",
      "label": "t:sections.codex.settings.background_color.label",
      "default": "#050509"
    }
  ],
  "blocks": [],
  "presets": [
    {
      "name": "t:sections.codex.presets.default"
    }
  ]
}
{% endschema %}
