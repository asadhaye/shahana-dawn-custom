{% comment %}
  SHAHANA COLLECTION - IMMERSIVE PRODUCT GRID
  This section is loaded dynamically via AJAX.
  It displays products from a specified collection for the immersive store.
{% endcomment %}

{%- liquid
  assign collection = section.settings.collection
  assign products_to_show = section.settings.products_per_page | default: 8
  assign columns_desktop = section.settings.columns_desktop | default: 3
  assign columns_mobile = section.settings.columns_mobile | default: '2'

  assign filter_active = false
  if collection.filters.size > 0
    for filter in collection.filters
      if filter.active_values.size > 0
        assign filter_active = true
        break
      endif
      if filter.min_value.value != blank or filter.max_value.value != blank
        assign filter_active = true
        break
      endif
    endfor
  endif
-%}

<div
  class="immersive-product-grid-wrapper"
  data-collection-handle="{{ collection.handle }}"
  {%- if filter_active -%}
    data-filter-active="true"
  {%- endif -%}
>
  {%- if collection and collection.title != blank -%}
    <h2 class="immersive-product-grid__title">
      {{ collection.title }}
    </h2>
  {%- endif -%}

  {%- if section.settings.show_description and collection and collection.description != blank -%}
    <div class="immersive-product-grid__description">
      {{ collection.description }}
    </div>
  {%- endif -%}

  <!-- Filter chips container -->
  <div data-filter-chips-container hidden></div>

  <div class="immersive-product-grid immersive-product-grid--{{ columns_desktop }}-col-desktop immersive-product-grid--{{ columns_mobile }}-col-mobile">
    {%- if collection and collection.products.size > 0 -%}
      {%- paginate collection.products by products_to_show -%}
        <div class="immersive-product-grid__inner">
          {%- for product in collection.products -%}
            {% render 'immersive-product-card',
              product: product,
              collection: collection,
              show_vendor: section.settings.show_vendor,
              show_secondary_image: section.settings.show_secondary_image,
              show_quick_view: true
            %}
          {%- endfor -%}
        </div>
      {%- endpaginate -%}
    {%- elsif filter_active -%}
      <p class="immersive-product-grid__empty immersive-product-grid__empty--filtered">
        {{ 'sections.immersive.product_grid.no_results_filtered' | t }}
      </p>
    {%- else -%}
      <div class="immersive-empty-state" data-empty-state="collection">
        <svg
          class="immersive-empty-state__icon"
          aria-hidden="true"
          viewBox="0 0 24 24"
          fill="none"
          stroke="currentColor"
          stroke-width="2"
        >
          <path d="M20 7h-4V5a2 2 0 0 0-2-2h-4a2 2 0 0 0-2 2v2H4a1 1 0 0 0-1 1v11a2 2 0 0 0 2 2h14a2 2 0 0 0 2-2V8a1 1 0 0 0-1-1zM10 5h4v2h-4V5z"/>
        </svg>
        <h3 class="immersive-empty-state__heading">
          {{ 'sections.immersive_store.empty_states.collection_heading' | t }}
        </h3>
        <p class="immersive-empty-state__body">
          {{ 'sections.immersive_store.empty_states.collection_body' | t }}
        </p>
        <div class="immersive-empty-state__actions">
          <button type="button" class="immersive-empty-state__action" data-empty-action="search">
            {{ 'sections.immersive_store.empty_states.collection_search' | t }}
          </button>
          <button
            type="button"
            class="immersive-empty-state__action immersive-empty-state__action--secondary"
            data-empty-action="browse"
          >
            {{ 'sections.immersive_store.empty_states.collection_browse' | t }}
          </button>
        </div>
      </div>
    {%- endif -%}
  </div>
</div>

{% stylesheet %}
  .immersive-product-grid-wrapper {
    display: grid;
    gap: 1.5rem;
  }

  .immersive-product-grid__title {
    color: #d4af37;
    font-size: 1.75rem;
    font-weight: 700;
    letter-spacing: 0.2em;
    margin: 0 0 1.5rem 0;
    text-transform: uppercase;
  }

  .immersive-product-grid__description {
    color: rgba(255, 255, 255, 0.7);
    font-size: 0.875rem;
    line-height: 1.6;
    margin-bottom: 1.5rem;
  }

  .immersive-product-grid {
    display: grid;
  }

  .immersive-product-grid__inner {
    display: grid;
    grid-template-columns: repeat(2, 1fr);
    gap: 1.5rem;
  }

  @media screen and (min-width: 750px) {
    .immersive-product-grid--3-col-desktop .immersive-product-grid__inner {
      grid-template-columns: repeat(3, 1fr);
    }
    .immersive-product-grid--4-col-desktop .immersive-product-grid__inner {
      grid-template-columns: repeat(4, 1fr);
    }
    .immersive-product-grid--2-col-desktop .immersive-product-grid__inner {
      grid-template-columns: repeat(2, 1fr);
    }
  }

  .immersive-product-grid--1-col-mobile .immersive-product-grid__inner {
    grid-template-columns: 1fr;
  }

  .immersive-product-grid__empty {
    font-size: 0.875rem;
  }
{% endstylesheet %}

{% schema %}
{
  "name": "t:sections.immersive_product_grid.name",
  "settings": [
    {
      "type": "collection",
      "id": "collection",
      "label": "t:sections.immersive_product_grid.settings.collection.label"
    },
    {
      "type": "range",
      "id": "products_per_page",
      "label": "t:sections.immersive_product_grid.settings.products_per_page.label",
      "min": 2,
      "max": 24,
      "step": 2,
      "default": 8
    },
    {
      "type": "header",
      "content": "t:sections.immersive_product_grid.settings.header_grid_layout.content"
    },
    {
      "type": "range",
      "id": "columns_desktop",
      "label": "t:sections.immersive_product_grid.settings.columns_desktop.label",
      "min": 2,
      "max": 4,
      "step": 1,
      "default": 3
    },
    {
      "type": "select",
      "id": "columns_mobile",
      "label": "t:sections.immersive_product_grid.settings.columns_mobile.label",
      "options": [
        { "value": "1", "label": "t:sections.immersive_product_grid.settings.columns_mobile.options__1.label" },
        { "value": "2", "label": "t:sections.immersive_product_grid.settings.columns_mobile.options__2.label" }
      ],
      "default": "2"
    },
    {
      "type": "header",
      "content": "t:sections.immersive_product_grid.settings.header_product_card.content"
    },
    {
      "type": "select",
      "id": "image_ratio",
      "label": "t:sections.immersive_product_grid.settings.image_ratio.label",
      "options": [
        { "value": "adapt", "label": "t:sections.immersive_product_grid.settings.image_ratio.options__1.label" },
        { "value": "portrait", "label": "t:sections.immersive_product_grid.settings.image_ratio.options__2.label" },
        { "value": "square", "label": "t:sections.immersive_product_grid.settings.image_ratio.options__3.label" }
      ],
      "default": "portrait"
    },
    {
      "type": "checkbox",
      "id": "show_secondary_image",
      "label": "t:sections.immersive_product_grid.settings.show_secondary_image.label",
      "default": true
    },
    {
      "type": "checkbox",
      "id": "show_vendor",
      "label": "t:sections.immersive_product_grid.settings.show_vendor.label",
      "default": true
    },
    {
      "type": "checkbox",
      "id": "show_description",
      "label": "t:sections.immersive_product_grid.settings.show_description.label",
      "default": false
    }
  ],
  "presets": [
    {
      "name": "t:sections.immersive_product_grid.presets.name"
    }
  ]
}
{% endschema %}
