{% comment %}
  SHAHANA COLLECTION - IMMERSIVE PRODUCT GRID
  This section is loaded dynamically via AJAX.
  It displays products from a specified collection for the immersive store.
{% endcomment %}

{%- liquid
  assign collection_handle = section.settings.collection

  if collection_handle == blank
    assign collection_handle = 'all'
  endif

  assign collection = collections[collection_handle]
  assign products_to_show = section.settings.products_per_page | default: 8
-%}

<div class="immersive-product-grid-wrapper">
  {%- if collection and collection.title != blank -%}
    <h2 class="immersive-product-grid__title">
      {{ collection.title }}
    </h2>
  {%- endif -%}

  {%- if collection and collection.description != blank -%}
    <div class="immersive-product-grid__description">
      {{ collection.description }}
    </div>
  {%- endif -%}

  <div class="immersive-product-grid">
    {%- if collection and collection.products_count > 0 -%}
      {%- paginate collection.products by products_to_show -%}
        <div class="immersive-product-grid__inner">
          {%- for product in collection.products -%}
            {% render 'immersive-product-card', product: product %}
          {%- endfor -%}
        </div>
      {%- endpaginate -%}
    {%- else -%}
      <p class="immersive-product-grid__empty">
        {{ 'sections.immersive.product_grid.empty' | t }}
      </p>
    {%- endif -%}
  </div>
</div>

{% stylesheet %}
  .immersive-product-grid-wrapper {
    display: grid;
    gap: 1.5rem;
  }

  .immersive-product-grid__title {
    color: #d4af37;
    font-size: 1.75rem;
    font-weight: 700;
    letter-spacing: 0.2em;
    margin: 0 0 1.5rem 0;
    text-transform: uppercase;
  }

  .immersive-product-grid__description {
    color: rgba(255, 255, 255, 0.7);
    font-size: 0.875rem;
    line-height: 1.6;
    margin-bottom: 1.5rem;
  }

  .immersive-product-grid {
    display: grid;
  }

  .immersive-product-grid__inner {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(220px, 1fr));
    gap: 1.5rem;
  }

  .immersive-product-grid__empty {
    font-size: 0.875rem;
  }
{% endstylesheet %}

{% schema %}
{
  "name": "Immersive product grid",
  "settings": [
    {
      "type": "collection",
      "id": "collection",
      "label": "Collection"
    },
    {
      "type": "range",
      "id": "products_per_page",
      "label": "Products to show",
      "min": 1,
      "max": 20,
      "step": 1,
      "default": 8
    }
  ],
  "presets": [
    {
      "name": "Immersive product grid"
    }
  ]
}
{% endschema %}