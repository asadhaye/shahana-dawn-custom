{% liquid
  assign collection_handle = request.params.collection_handle
  assign panel_collection = nil

  if collection_handle != blank
    assign panel_collection = collections[collection_handle]
  endif
%}

<section class="glass-panel-section" aria-label="Collection panel">
  {% if panel_collection %}
    <header class="glass-panel-section__header">
      <h2 class="glass-panel-section__title">{{ panel_collection.title | escape }}</h2>
      {% if panel_collection.description != blank %}
        <p class="glass-panel-section__description">{{ panel_collection.description }}</p>
      {% endif %}
    </header>

    <div class="glass-panel-section__grid">
      {% for product in panel_collection.products %}
        {% render 'immersive-product-card', product: product %}
      {% else %}
        <p class="glass-panel-section__empty">{{ 'sections.immersive.product_grid.empty' | t }}</p>
      {% endfor %}
    </div>
  {% else %}
    <p class="glass-panel-section__empty">{{ 'sections.immersive.product_grid.empty' | t }}</p>
  {% endif %}
</section>

{% stylesheet %}
.glass-panel-section {
  padding: 1.5rem 1.5rem 2rem;
}

.glass-panel-section__header {
  margin-bottom: 1.25rem;
}

.glass-panel-section__title {
  margin: 0 0 0.5rem;
  font-size: 1.125rem;
  font-weight: 600;
}

.glass-panel-section__description {
  margin: 0;
  font-size: 0.875rem;
  opacity: 0.8;
}

.glass-panel-section__grid {
  display: grid;
  grid-template-columns: repeat(auto-fill, minmax(220px, 1fr));
  gap: 1.25rem;
}

.glass-panel-section__empty {
  font-size: 0.875rem;
  opacity: 0.8;
}
{% endstylesheet %}

{% schema %}
{
  "name": "t:sections.immersive_store.panel_title",
  "settings": []
}
{% endschema %}