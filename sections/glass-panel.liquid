{% liquid
  comment
    When fetched via Section Rendering API from /collections/{handle}?section_id=glass-panel,
    the 'collection' object is automatically available in the context
  endcomment
  assign panel_collection = collection
%}

<section class="glass-panel-section" aria-label="{{ 'sections.immersive_store.collection_panel_aria' | t }}">
  {% if panel_collection %}
    <header class="glass-panel-section__header">
      <nav class="glass-panel-section__breadcrumb" aria-label="Breadcrumb">
        <a
          href="{{ routes.root_url }}"
          class="glass-panel-section__breadcrumb-root glass-panel-section__breadcrumb-btn"
          data-breadcrumb-action="go-home"
        >
          {{- 'sections.immersive_store.breadcrumb_store' | t -}}
        </a>
        <span class="glass-panel-section__breadcrumb-separator" aria-hidden="true">/</span>
        <span class="glass-panel-section__breadcrumb-current" aria-current="page">
          {{- panel_collection.title | escape -}}
        </span>
      </nav>
      <h2 class="glass-panel-section__title">{{ panel_collection.title | escape }}</h2>
      {% if panel_collection.description != blank %}
        <div class="glass-panel-section__description">{{ panel_collection.description }}</div>
      {% endif %}
    </header>

    {% if panel_collection.products.size > 0 %}
      <div class="glass-panel-section__grid">
        {% for product in panel_collection.products limit: 50 %}
          <div
            class="glass-panel-section__item"
            style="--animation-order: {{ forloop.index0 }};"
          >
            {% render 'immersive-product-card',
              product: product,
              collection: panel_collection,
              collection_handle: panel_collection.handle,
              show_quick_add: false
            %}
          </div>
        {% endfor %}
      </div>
    {% else %}
      <div class="glass-panel-section__empty">
        <p>{{ 'sections.immersive_store.collection_empty' | t }}</p>
        {% comment %}Issue 11: Provide navigation options when collection is empty{% endcomment %}
        <div class="glass-panel-section__empty-actions">
          <button type="button" class="glass-panel-section__empty-action" data-empty-action="go-home">
            {{ 'sections.immersive_store.breadcrumb_store' | t }}
          </button>
          <button type="button" class="glass-panel-section__empty-action" data-empty-action="close-panel">
            {{ 'sections.immersive_store.breadcrumb_store' | t }}
          </button>
        </div>
      </div>
    {% endif %}
  {% else %}
    <div class="glass-panel-section__empty">
      <p>{{ 'sections.immersive_store.collection_not_found' | t }}</p>
    </div>
  {% endif %}
</section>

{% stylesheet %}
  .glass-panel-section {
    padding: 0;
    width: 100%;
  }

  .glass-panel-section__header {
    margin-bottom: 3.5rem;
    padding: 3.5rem 2rem;
    background: rgba(10, 15, 30, 0.45);
    backdrop-filter: blur(24px);
    border-radius: 1px;
    border: 1px solid rgba(255, 255, 255, 0.15);
    text-align: center;
    box-shadow: inset 0 0 20px rgba(255, 255, 255, 0.05);
  }

  .glass-panel-section__breadcrumb {
    display: flex;
    align-items: center;
    justify-content: center;
    gap: 0.75rem;
    margin-bottom: 1.5rem;
    font-size: 0.75rem;
    text-transform: uppercase;
    letter-spacing: 0.15em;
    color: rgba(212, 175, 55, 0.6);
  }

  .glass-panel-section__breadcrumb-separator {
    opacity: 0.4;
  }

  .glass-panel-section__breadcrumb-current {
    color: #d4af37;
    font-weight: 600;
  }

  .glass-panel-section__breadcrumb-btn {
    background: none;
    border: none;
    padding: 0;
    margin: 0;
    font: inherit;
    font-size: 0.75rem;
    text-transform: uppercase;
    letter-spacing: 0.15em;
    color: rgba(212, 175, 55, 0.6);
    cursor: pointer;
    transition: color 0.2s ease;
  }

  .glass-panel-section__breadcrumb-btn:hover {
    color: #d4af37;
    text-decoration: underline;
    text-underline-offset: 3px;
  }

  .glass-panel-section__breadcrumb-btn:focus-visible {
    outline: 2px solid #d4af37;
    outline-offset: 3px;
    border-radius: 2px;
  }

  .glass-panel-section__title {
    margin: 0 0 1.25rem;
    font-size: clamp(2rem, 5vw, 3.5rem);
    font-weight: 600;
    color: #d4af37;
    text-transform: uppercase;
    letter-spacing: 0.1em;
    line-height: 1.1;
  }

  .glass-panel-section__description {
    margin: 0;
    font-size: 1rem;
    color: rgba(255, 255, 255, 0.8);
    line-height: 1.6;
  }

  .glass-panel-section__grid {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(300px, 1fr));
    gap: 2rem;
    width: 100%;
  }

  .glass-panel-section__item {
    width: 100%;
    max-width: 100%;
    opacity: 0;
    transform: translateY(20px);
    animation: immersive-fade-in-up 0.6s cubic-bezier(0.16, 1, 0.3, 1) forwards;
    animation-delay: calc(var(--animation-order) * 0.08s);
  }

  @keyframes immersive-fade-in-up {
    from {
      opacity: 0;
      transform: translateY(20px);
    }
    to {
      opacity: 1;
      transform: translateY(0);
    }
  }

  @media screen and (prefers-reduced-motion: reduce) {
    .glass-panel-section__item {
      opacity: 1;
      transform: none;
      animation: none;
    }
  }

  @media (max-width: 768px) {
    .glass-panel-section__grid {
      grid-template-columns: repeat(auto-fill, minmax(250px, 1fr));
      gap: 1.5rem;
    }

    .glass-panel-section__title {
      font-size: 1.5rem;
    }
  }

  .glass-panel-section__empty {
    font-size: 1rem;
    color: rgba(255, 255, 255, 0.6);
    text-align: center;
    padding: 4rem 2rem;
  }
{% endstylesheet %}

{% schema %}
{
  "name": "t:sections.immersive_store.panel_title",
  "settings": []
}
{% endschema %}
