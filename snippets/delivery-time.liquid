{% doc %}
  Displays estimated delivery time based on product's collection.
  Checks all collections the product belongs to and displays the first one found.
  @param {product} product - The product object
  @param {string} [prefix_text] - Text before the delivery time
@example
{% render 'delivery-time', product: product %}
{% enddoc %}

{%- assign delivery_time = nil -%}

{%- if product != blank -%}
  {%- for collection in product.collections -%}
    {%- if collection.metafields.custom.lead_time != blank -%}
      {%- assign delivery_time = collection.metafields.custom.lead_time -%}
      {%- break -%}
    {%- endif -%}
  {%- endfor -%}
{%- endif -%}

{%- if delivery_time -%}

{%- assign prefix_text = prefix_text | default: 'Estimated delivery:' -%}

<div class="delivery-time" data-delivery-time>
  <svg class="delivery-time__icon" width="16" height="16" viewBox="0 0 16 16" fill="none">
    <path d="M8 1.333A6.667 6.667 0 1 0 8 14.667 6.667 6.667 0 0 0 8 1.333ZM7.333 10H8v-2.667h-.667V10ZM8 7.333A.667.667 0 1 1 8 6a.667.667 0 0 1 0 1.333Z" fill="currentColor"/>
  </svg>
  <span class="delivery-time__text">
    {{ prefix_text }} {{ delivery_time }}
  </span>
</div>
{%- endif -%}

{% stylesheet %}
.delivery-time {
  display: flex;
  align-items: center;
  gap: 0.5rem;
  font-size: 0.8125rem;
  color: var(--color-foreground-secondary);
  margin-top: 0.5rem;
}

.delivery-time__icon {
  flex-shrink: 0;
  color: var(--color-foreground-secondary);
}

.delivery-time__text {
  line-height: 1.4;
}
{% endstylesheet %}