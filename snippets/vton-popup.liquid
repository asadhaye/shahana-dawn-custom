{% doc %}
  Renders an AI virtual try-on popup for product pages.

  Frontend responsibilities:
  - Capture user image via file input
  - Convert user and product images to Base64
  - Send both to a Vercel endpoint
  
  Backend responsibilities:
  - Use Puter/Nano Banana (or any AI) to generate the try-on image
  - Return { success: true, generated_image: "<base64>" }
{% enddoc %}

<button type="button" id="vton-trigger-btn" class="vton-btn">
  ✨ Virtual Try-On
</button>

<div
  id="vton-modal-overlay"
  class="vton-overlay"
  data-product-image-url="{{ product.featured_image | image_url: width: 1024 }}"
>
  <div class="vton-modal" id="vton-modal-content">
    <div class="vton-modal-header">
      <h3>AI Virtual Try-On</h3>
      <button class="vton-close-btn" type="button" id="vton-close-btn">&times;</button>
    </div>

    <div class="vton-modal-body">
      <p class="vton-instruction">
        Upload a clear, front-facing photo of yourself to see how this beautiful Pakistani ethnic wear looks on you!
      </p>

      <div class="vton-upload-area">
        <input type="file" id="user-image-upload-input" accept="image/*">
        <label for="user-image-upload-input" class="vton-upload-label" id="vton-upload-label">
          📸 Tap to upload your photo
        </label>
        <img
          id="vton-user-preview"
          src=""
          alt="Your uploaded photo"
          style="display: none;"
          width="600"
          height="800"
        >
      </div>

      <button type="button" id="vton-submit-btn" class="vton-btn vton-btn-primary">
        👗 Try it on!
      </button>

      <div id="loading-spinner" style="display: none;">
        <div class="vton-spinner"></div>
        <p id="loading-text" class="vton-loading-text">
          AI is tailoring the dress... (Takes about 15 seconds)
        </p>
      </div>

      <div id="vton-result-area" style="display: none;">
        <h4>Your virtual fitting</h4>
        <img
          id="result-image-element"
          src=""
          alt="Virtual try-on result"
          width="600"
          height="800"
        >
        <p class="vton-success-text">Looking gorgeous! ✨</p>
      </div>
    </div>
  </div>
</div>

{% stylesheet %}
  .vton-btn {
    background-color: #000;
    color: #fff;
    border: none;
    padding: 12px 24px;
    font-size: 16px;
    cursor: pointer;
    border-radius: 4px;
    font-weight: bold;
    width: 100%;
    margin-top: 10px;
    transition: background 0.3s;
  }

  .vton-btn:hover {
    background-color: #333;
  }

  .vton-btn-primary {
    background-color: #d4af37;
    color: #000;
  }

  .vton-btn-primary:hover {
    background-color: #b5952f;
  }

  .vton-overlay {
    position: fixed;
    inset: 0;
    width: 100%;
    height: 100%;
    background: rgba(0, 0, 0, 0.7);
    display: none;
    justify-content: center;
    align-items: center;
    z-index: 999999;
    padding: 20px;
    box-sizing: border-box;
  }

  .vton-modal {
    background: #fff;
    width: 100%;
    max-width: 450px;
    border-radius: 12px;
    overflow: hidden;
    box-shadow: 0 10px 30px rgba(0,0,0,0.3);
    display: flex;
    flex-direction: column;
    max-height: 90vh;
  }

  .vton-modal-header {
    display: flex;
    justify-content: space-between;
    align-items: center;
    padding: 15px 20px;
    background: #f8f8f8;
    border-bottom: 1px solid #eee;
  }

  .vton-modal-header h3 {
    margin: 0;
    font-size: 18px;
    color: #333;
  }

  .vton-close-btn {
    background: none;
    border: none;
    font-size: 24px;
    cursor: pointer;
    color: #666;
    padding: 0;
    line-height: 1;
  }

  .vton-modal-body {
    padding: 20px;
    overflow-y: auto;
    text-align: center;
  }

  .vton-instruction {
    font-size: 14px;
    color: #666;
    margin-bottom: 20px;
  }

  .vton-upload-area {
    border: 2px dashed #ccc;
    border-radius: 8px;
    padding: 20px;
    margin-bottom: 20px;
    background: #fafafa;
    position: relative;
  }

  .vton-upload-area input[type="file"] {
    display: none;
  }

  .vton-upload-label {
    display: inline-block;
    padding: 10px 20px;
    background: #eee;
    border-radius: 4px;
    cursor: pointer;
    font-weight: bold;
    color: #333;
    transition: background 0.2s;
  }

  .vton-upload-label:hover {
    background: #e0e0e0;
  }

  #vton-user-preview,
  #result-image-element {
    max-width: 100%;
    border-radius: 8px;
    margin-top: 15px;
    box-shadow: 0 4px 10px rgba(0,0,0,0.1);
    height: auto;
  }

  #loading-spinner {
    margin: 20px 0;
  }

  .vton-spinner {
    border: 4px solid #f3f3f3;
    border-top: 4px solid #d4af37;
    border-radius: 50%;
    width: 40px;
    height: 40px;
    animation: vton-spin 1s linear infinite;
    margin: 0 auto;
  }

  .vton-loading-text {
    margin-top: 15px;
    font-weight: bold;
    color: #d4af37;
  }

  @keyframes vton-spin {
    0% {
      transform: rotate(0deg);
    }

    100% {
      transform: rotate(360deg);
    }
  }

  .vton-success-text {
    margin-top: 15px;
    font-weight: bold;
    color: #28a745;
    font-size: 18px;
  }
{% endstylesheet %}

{% javascript %}
  (function() {
    const triggerBtn = document.getElementById('vton-trigger-btn');
    const overlay = document.getElementById('vton-modal-overlay');
    const closeBtn = document.getElementById('vton-close-btn');
    const modalContent = document.getElementById('vton-modal-content');
    const fileInput = document.getElementById('user-image-upload-input');
    const submitBtn = document.getElementById('vton-submit-btn');

    if (!triggerBtn || !overlay || !closeBtn || !modalContent || !fileInput || !submitBtn) {
      return;
    }

    triggerBtn.addEventListener('click', () => {
      overlay.style.display = 'flex';
    });

    closeBtn.addEventListener('click', () => {
      overlay.style.display = 'none';
    });

    overlay.addEventListener('click', event => {
      if (!modalContent.contains(event.target)) {
        overlay.style.display = 'none';
      }
    });

    fileInput.addEventListener('change', event => {
      const file = event.target.files && event.target.files[0];
      if (!file) return;

      const reader = new FileReader();
      reader.onload = function(e) {
        const previewImg = document.getElementById('vton-user-preview');
        const label = document.getElementById('vton-upload-label');
        if (!previewImg || !label) return;

        previewImg.src = e.target.result;
        previewImg.style.display = 'block';
        label.innerText = '🔄 Change photo';
      };
      reader.readAsDataURL(file);
    });

    submitBtn.addEventListener('click', generateVirtualTryOn);

    function getRawBase64FromFile(file) {
      return new Promise((resolve, reject) => {
        const reader = new FileReader();
        reader.readAsDataURL(file);
        reader.onload = () => {
          const result = reader.result || '';
          const parts = String(result).split(',');
          resolve(parts.length > 1 ? parts[1] : '');
        };
        reader.onerror = error => reject(error);
      });
    }

    async function getRawBase64FromUrl(url) {
      const response = await fetch(url);
      const blob = await response.blob();
      return getRawBase64FromFile(blob);
    }

    async function generateVirtualTryOn() {
      const loadingSpinner = document.getElementById('loading-spinner');
      const resultArea = document.getElementById('vton-result-area');
      const loadingText = document.getElementById('loading-text');

      submitBtn.style.display = 'none';
      if (loadingSpinner) loadingSpinner.style.display = 'block';
      if (resultArea) resultArea.style.display = 'none';
      if (loadingText) {
        loadingText.innerText = 'AI is tailoring the dress... (Takes about 15 seconds)';
      }

      try {
        if (!fileInput.files || !fileInput.files[0]) {
          alert('Please upload your photo first!');
          resetUI();
          return;
        }

        const userBase64 = await getRawBase64FromFile(fileInput.files[0]);

        const productImageUrlRaw = overlay.getAttribute('data-product-image-url') || '';
        const productImageUrl =
          typeof productImageUrlRaw === 'string' ? productImageUrlRaw : String(productImageUrlRaw);
        const formattedProductUrl = productImageUrl.startsWith('//')
          ? 'https:' + productImageUrl
          : productImageUrl;

        const productBase64 = await getRawBase64FromUrl(formattedProductUrl);

        const vercelUrl = 'https://YOUR_VERCEL_APP_URL.vercel.app/api/tryon';

        const response = await fetch(vercelUrl, {
          method: 'POST',
          headers: { 'Content-Type': 'application/json' },
          body: JSON.stringify({
            user_image_base64: userBase64,
            product_image_base64: productBase64
          })
        });

        const data = await response.json();

        if (data && data.success) {
          const resultImg = document.getElementById('result-image-element');
          if (resultImg && data.generated_image) {
            resultImg.src = 'data:image/jpeg;base64,' + data.generated_image;
          }

          if (loadingSpinner) loadingSpinner.style.display = 'none';
          if (resultArea) resultArea.style.display = 'block';
          submitBtn.innerText = 'Try another photo!';
          submitBtn.style.display = 'block';
        } else {
          const errorMessage = data && data.error ? data.error : 'Unknown error';
          alert('AI error: ' + errorMessage);
          resetUI();
        }
      } catch (error) {
        console.error('Try-on error:', error);
        alert('Something went wrong with the connection. Please try again.');
        resetUI();
      }
    }

    function resetUI() {
      const loadingSpinner = document.getElementById('loading-spinner');
      if (loadingSpinner) loadingSpinner.style.display = 'none';
      submitBtn.style.display = 'block';
    }
  })();
{% endjavascript %}