{% doc %}
  Renders a virtual try-on UI for product pages.
  Calls the IDM-VTON backend at VTON_API_URL/api/tryon.

  Usage: {% render 'virtual-tryon', product: product %}
{% enddoc %}

<div
  class="vtryon"
  id="virtual-tryon-container"
  data-product-image-url="{{ product.featured_image | image_url: width: 768 | prepend: 'https:' }}"
  data-product-title="{{ product.title | escape }}"
  data-api-url="{{ settings.vton_api_url | default: 'https://scuk-vton.vercel.app' }}"
>
  <div class="vtryon__header">
    <svg class="vtryon__icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" aria-hidden="true">
      <path stroke-linecap="round" stroke-linejoin="round" d="M15.75 6a3.75 3.75 0 1 1-7.5 0 3.75 3.75 0 0 1 7.5 0ZM4.501 20.118a7.5 7.5 0 0 1 14.998 0A17.933 17.933 0 0 1 12 21.75c-2.676 0-5.216-.584-7.499-1.632Z" />
    </svg>
    <h3 class="vtryon__title">Virtual Try-On</h3>
  </div>

  <p class="vtryon__subtitle">See how this looks on you — upload a photo to get started</p>

  <label class="vtryon__upload-label" for="virtual-tryon-user-photo">
    <span class="vtryon__upload-icon" id="vtryon-upload-icon" aria-hidden="true">
      <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5">
        <path stroke-linecap="round" stroke-linejoin="round" d="M3 16.5v2.25A2.25 2.25 0 0 0 5.25 21h13.5A2.25 2.25 0 0 0 21 18.75V16.5m-13.5-9L12 3m0 0 4.5 4.5M12 3v13.5" />
      </svg>
    </span>
    <img id="vtryon-preview" class="vtryon__preview" alt="Your photo preview" style="display:none;" width="40" height="40" />
    <span class="vtryon__upload-text" id="vtryon-upload-text">Choose a photo</span>
    <input type="file" id="virtual-tryon-user-photo" accept="image/*" class="vtryon__file-input" aria-label="Upload your photo for virtual try-on" />
  </label>

  <button id="virtual-tryon-btn" class="vtryon__btn" disabled>
    Try this on
  </button>

  <div id="virtual-tryon-error" class="vtryon__error" style="display:none;" role="alert"></div>

  <div id="virtual-tryon-loading" class="vtryon__loading" style="display:none;" aria-live="polite">
    <div class="vtryon__spinner" aria-hidden="true"></div>
    <p class="vtryon__status">Generating your look…</p>
    <p class="vtryon__loading-sub">This takes about 30–45 seconds</p>
  </div>

  <div id="virtual-tryon-result" class="vtryon__result" style="display:none;">
    <p class="vtryon__result-label">Your virtual try-on</p>
    <img
      id="virtual-tryon-result-img"
      alt="Virtual try-on result"
      class="vtryon__result-img"
      width="768"
      height="1024"
    />
  </div>
</div>

{% stylesheet %}
.vtryon {
  padding: 1.5rem;
  background: rgba(15, 23, 42, 0.6);
  backdrop-filter: blur(12px);
  -webkit-backdrop-filter: blur(12px);
  border-radius: 16px;
  border: 1px solid rgba(212, 175, 55, 0.2);
  margin-top: 1.5rem;
  color: #d4af37;
}

.vtryon__header {
  display: flex;
  align-items: center;
  gap: 0.6rem;
  margin-bottom: 0.4rem;
}

.vtryon__icon {
  width: 20px;
  height: 20px;
  color: #d4af37;
  flex-shrink: 0;
}

.vtryon__title {
  margin: 0;
  font-size: 1rem;
  font-weight: 600;
  color: #d4af37;
  text-transform: uppercase;
  letter-spacing: 0.08em;
}

.vtryon__subtitle {
  margin: 0 0 1.25rem;
  font-size: 0.8rem;
  color: rgba(212, 175, 55, 0.6);
  line-height: 1.5;
}

/* Upload area */
.vtryon__upload-label {
  display: flex;
  align-items: center;
  gap: 0.75rem;
  padding: 0.85rem 1rem;
  background: rgba(212, 175, 55, 0.05);
  border: 1px dashed rgba(212, 175, 55, 0.3);
  border-radius: 10px;
  cursor: pointer;
  transition: background 0.2s, border-color 0.2s;
  margin-bottom: 1rem;
}

.vtryon__upload-label:hover {
  background: rgba(212, 175, 55, 0.1);
  border-color: rgba(212, 175, 55, 0.5);
}

.vtryon__upload-icon svg {
  width: 18px;
  height: 18px;
  color: #d4af37;
}

.vtryon__upload-text {
  font-size: 0.85rem;
  color: rgba(212, 175, 55, 0.8);
  white-space: nowrap;
  overflow: hidden;
  text-overflow: ellipsis;
  flex: 1;
}

.vtryon__preview {
  width: 40px;
  height: 40px;
  border-radius: 6px;
  object-fit: cover;
  border: 1px solid rgba(212, 175, 55, 0.3);
  flex-shrink: 0;
}

.vtryon__file-input {
  display: none;
}

/* Button */
.vtryon__btn {
  width: 100%;
  padding: 0.8rem 1rem;
  background: rgba(212, 175, 55, 0.1);
  border: 1px solid rgba(212, 175, 55, 0.4);
  border-radius: 10px;
  color: #d4af37;
  font-size: 0.9rem;
  font-weight: 600;
  letter-spacing: 0.04em;
  cursor: pointer;
  transition: background 0.2s, border-color 0.2s, opacity 0.2s;
}

.vtryon__btn:hover:not(:disabled) {
  background: rgba(212, 175, 55, 0.2);
  border-color: rgba(212, 175, 55, 0.7);
}

.vtryon__btn:disabled {
  opacity: 0.35;
  cursor: not-allowed;
}

/* Error */
.vtryon__error {
  margin-top: 1rem;
  padding: 0.75rem 1rem;
  background: rgba(220, 38, 38, 0.15);
  border: 1px solid rgba(220, 38, 38, 0.35);
  border-radius: 8px;
  font-size: 0.82rem;
  color: #fca5a5;
  line-height: 1.5;
}

/* Loading */
.vtryon__loading {
  margin-top: 1.25rem;
  text-align: center;
  padding: 1rem 0;
}

.vtryon__loading p {
  margin: 0.25rem 0 0;
  font-size: 0.88rem;
  color: rgba(212, 175, 55, 0.85);
}

.vtryon__status {
  margin: 0.25rem 0 0;
  font-size: 0.88rem;
  color: rgba(212, 175, 55, 0.85);
  min-height: 1.3em;
  transition: opacity 0.3s;
}

.vtryon__loading-sub {
  font-size: 0.75rem !important;
  color: rgba(212, 175, 55, 0.45) !important;
}

.vtryon__spinner {
  width: 32px;
  height: 32px;
  border: 2px solid rgba(212, 175, 55, 0.15);
  border-top-color: #d4af37;
  border-radius: 50%;
  animation: vtryon-spin 0.8s linear infinite;
  margin: 0 auto 0.75rem;
}

@keyframes vtryon-spin {
  to { transform: rotate(360deg); }
}

/* Result */
.vtryon__result {
  margin-top: 1.25rem;
}

.vtryon__result-label {
  margin: 0 0 0.75rem;
  font-size: 0.78rem;
  text-transform: uppercase;
  letter-spacing: 0.08em;
  color: rgba(212, 175, 55, 0.55);
}

.vtryon__result-img {
  width: 100%;
  border-radius: 10px;
  border: 1px solid rgba(212, 175, 55, 0.2);
  display: block;
}
{% endstylesheet %}

{% javascript %}
(function () {
  const container = document.getElementById('virtual-tryon-container');
  if (!container) return;

  const fileInput  = document.getElementById('virtual-tryon-user-photo');
  const uploadText = document.getElementById('vtryon-upload-text');
  const uploadIcon = document.getElementById('vtryon-upload-icon');
  const preview    = document.getElementById('vtryon-preview');
  const btn        = document.getElementById('virtual-tryon-btn');
  const loading    = document.getElementById('virtual-tryon-loading');
  const resultBox  = document.getElementById('virtual-tryon-result');
  const resultImg  = document.getElementById('virtual-tryon-result-img');
  const errorBox   = document.getElementById('virtual-tryon-error');

  const productImageUrl = container.dataset.productImageUrl;
  const apiUrl          = (container.dataset.apiUrl || '').replace(/\/$/, '');
  const productTitle    = container.dataset.productTitle || 'Pakistani ethnic wear';

  fileInput.addEventListener('change', () => {
    if (fileInput.files.length) {
      const file = fileInput.files[0];
      uploadText.textContent = file.name;
      btn.disabled = false;
      // Show thumbnail preview
      const reader = new FileReader();
      reader.onload = (e) => {
        preview.src = e.target.result;
        preview.style.display = 'block';
        uploadIcon.style.display = 'none';
      };
      reader.readAsDataURL(file);
    } else {
      uploadText.textContent = 'Choose a photo';
      preview.style.display = 'none';
      uploadIcon.style.display = '';
      btn.disabled = true;
    }
  });

  btn.addEventListener('click', async () => {
    const file = fileInput.files[0];
    if (!file) {
      errorBox.textContent   = 'Please upload a photo first.';
      errorBox.style.display = 'block';
      return;
    }

    errorBox.style.display  = 'none';
    errorBox.textContent    = '';
    resultBox.style.display = 'none';
    loading.style.display   = 'block';
    btn.disabled = true;

    let statusEl = loading.querySelector('.vtryon__status');
    function setStatus(msg) { if (statusEl) statusEl.textContent = msg; }

    try {
      // Step 1: Resize client-side to 768x1024
      setStatus('Preparing your photo…');
      const resizedBlob = await new Promise((resolve, reject) => {
        const reader = new FileReader();
        reader.onload = (e) => {
          const img = new Image();
          img.onload = () => {
            const canvas = document.createElement('canvas');
            canvas.width = 768; canvas.height = 1024;
            const ctx = canvas.getContext('2d');
            ctx.fillStyle = 'white';
            ctx.fillRect(0, 0, 768, 1024);
            const scale = Math.min(768 / img.width, 1024 / img.height);
            const x = (768 - img.width * scale) / 2;
            const y = (1024 - img.height * scale) / 2;
            ctx.drawImage(img, x, y, img.width * scale, img.height * scale);
            canvas.toBlob(resolve, 'image/jpeg', 0.8);
          };
          img.onerror = reject;
          img.src = e.target.result;
        };
        reader.onerror = reject;
        reader.readAsDataURL(file);
      });

      // Step 2: Upload raw binary to /api/upload
      setStatus('Uploading your photo…');
      const uploadRes = await fetch(`${apiUrl}/api/upload`, {
        method: 'POST',
        headers: { 'Content-Type': 'image/jpeg' },
        body: resizedBlob,
      });
      const uploadData = await uploadRes.json();
      if (!uploadRes.ok || !uploadData.url) throw new Error(uploadData.error || 'Upload failed');

      // Step 3: Call /api/tryon with URLs only
      setStatus('Processing embroidery & texture details…');
      let seconds = 0;
      const timer = setInterval(() => {
        seconds++;
        if (seconds === 10) setStatus('Generating realistic drapes…');
        if (seconds === 25) setStatus('Finalizing your look… almost there!');
      }, 1000);

      const tryonRes = await fetch(`${apiUrl}/api/tryon`, {
        method: 'POST',
        headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify({
          user_image_url: uploadData.url,
          product_image_url: productImageUrl,
          full_body: true,
          garment_description: productTitle,
        }),
      });
      clearInterval(timer);

      if (!tryonRes.ok) {
        const errData = await tryonRes.json().catch(() => ({}));
        throw new Error(errData.error || 'Try-on failed. Please try again.');
      }

      // Step 4: Result is streamed as image/jpeg
      const imgBlob = await tryonRes.blob();
      const objectUrl = URL.createObjectURL(imgBlob);
      setStatus('Looking great!');
      resultImg.src = objectUrl;
      resultImg.onload = () => { resultBox.style.display = 'block'; };
      resultImg.onerror = () => { throw new Error('Result image failed to load.'); };
    } catch (err) {
      errorBox.textContent   = err.message;
      errorBox.style.display = 'block';
    } finally {
      loading.style.display = 'none';
      btn.disabled = false;
    }
  });
})();
{% endjavascript %}
