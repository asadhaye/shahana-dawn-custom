{% doc %}
  Renders a virtual try-on UI for product pages.
  Requires customer to be signed in. Enforces quota via /api/tryon.
  Usage: {% render 'virtual-tryon', product: product %}
{% enddoc %}

{% liquid
  assign vton_signed_in = false
  assign vton_customer_id = ''
  assign vton_customer_token = ''
  assign vton_is_recent_purchaser = false
  assign vton_quota_max = 1

  if customer
    assign vton_signed_in = true
    assign vton_customer_id = customer.id | append: ''

    # HMAC token: sign customer_id with SHOPIFY_CUSTOMER_TOKEN_SECRET
    assign vton_customer_token = vton_customer_id | hmac_sha256: settings.vton_customer_secret

    # Check for a recent purchase (within 45 days)
    assign cutoff_days = 45
    for order in customer.orders limit: 5
      assign order_age = order.created_at | date: '%s' | plus: 0
      assign now_ts = 'now' | date: '%s' | plus: 0
      assign age_days = now_ts | minus: order_age | divided_by: 86400
      if age_days <= cutoff_days
        assign vton_is_recent_purchaser = true
        assign vton_quota_max = 2
        break
      endif
    endfor
  endif
%}

<div
  class="vtryon"
  id="virtual-tryon-container"
  data-product-image-url="{{ product.featured_image | image_url: width: 768 | prepend: 'https:' }}"
  data-product-title="{{ product.title | escape }}"
  data-api-url="{{ settings.vton_api_url | default: 'https://scuk-vton.vercel.app' }}"
  data-customer-id="{{ vton_customer_id }}"
  data-customer-token="{{ vton_customer_token }}"
  data-is-recent-purchaser="{{ vton_is_recent_purchaser }}"
  data-quota-max="{{ vton_quota_max }}"
  data-signed-in="{{ vton_signed_in }}"
  data-upload-label="{{ 'sections.virtual_tryon.upload_label' | t | escape }}"
  data-loading-title="{{ 'sections.virtual_tryon.loading_title' | t | escape }}"
  data-loading-subtitle="{{ 'sections.virtual_tryon.loading_subtitle' | t | escape }}"
  data-result-label="{{ 'sections.virtual_tryon.result_label' | t | escape }}"
  data-quota-available="{{ 'sections.virtual_tryon.quota_available' | t | escape }}"
  data-quota-remaining="{{ 'sections.virtual_tryon.quota_remaining' | t | escape }}"
  data-error-photo-read="{{ 'sections.virtual_tryon.error_photo_read' | t | escape }}"
  data-error-quota-exceeded="{{ 'sections.virtual_tryon.error_quota_exceeded' | t | escape }}"
  data-error-auth-required="{{ 'sections.virtual_tryon.error_auth_required' | t | escape }}"
  data-status-uploading="{{ 'sections.virtual_tryon.status_uploading' | t | escape }}"
  data-status-processing="{{ 'sections.virtual_tryon.status_processing' | t | escape }}"
  data-status-draping="{{ 'sections.virtual_tryon.status_draping' | t | escape }}"
  data-status-finalizing="{{ 'sections.virtual_tryon.status_finalizing' | t | escape }}"
  data-status-success="{{ 'sections.virtual_tryon.status_success' | t | escape }}"
  data-share-copied="{{ 'general.share.success_message' | t | escape }}"
>
  <div class="vtryon__header">
    <svg
      class="vtryon__icon"
      viewBox="0 0 24 24"
      fill="none"
      stroke="currentColor"
      stroke-width="1.5"
      aria-hidden="true"
    >
      <path stroke-linecap="round" stroke-linejoin="round" d="M15.75 6a3.75 3.75 0 1 1-7.5 0 3.75 3.75 0 0 1 7.5 0ZM4.501 20.118a7.5 7.5 0 0 1 14.998 0A17.933 17.933 0 0 1 12 21.75c-2.676 0-5.216-.584-7.499-1.632Z" />
    </svg>
    <h3 class="vtryon__title">{{ 'sections.virtual_tryon.title' | t }}</h3>
    {% if vton_signed_in %}
      <span
        class="vtryon__quota-badge"
        id="vtryon-quota-badge"
        title="{{ 'sections.virtual_tryon.quota_badge_title' | t }}"
      ></span>
    {% endif %}
  </div>

  {% unless vton_signed_in %}
    {%- comment -%} ── NOT SIGNED IN: show login gate ── {%- endcomment -%}
    <div class="vtryon__gate">
      <svg
        class="vtryon__gate-icon"
        viewBox="0 0 24 24"
        fill="none"
        stroke="currentColor"
        stroke-width="1.5"
        aria-hidden="true"
      >
        <path stroke-linecap="round" stroke-linejoin="round" d="M16.5 10.5V6.75a4.5 4.5 0 1 0-9 0v3.75m-.75 11.25h10.5a2.25 2.25 0 0 0 2.25-2.25v-6.75a2.25 2.25 0 0 0-2.25-2.25H6.75a2.25 2.25 0 0 0-2.25 2.25v6.75a2.25 2.25 0 0 0 2.25 2.25Z" />
      </svg>
      <p class="vtryon__gate-title">{{ 'sections.virtual_tryon.gate_title' | t }}</p>
      <p class="vtryon__gate-sub">{{ 'sections.virtual_tryon.gate_subtitle' | t }}</p>
      <a href="{{ routes.account_login_url }}?return_url={{ request.path | url_encode }}" class="vtryon__gate-btn">
        {{ 'sections.virtual_tryon.gate_button' | t }}
      </a>
    </div>
  {% else %}
    {%- comment -%} ── SIGNED IN: show full UI ── {%- endcomment -%}
    <p class="vtryon__subtitle">{{ 'sections.virtual_tryon.subtitle' | t }}</p>

    <label class="vtryon__upload-label" for="virtual-tryon-user-photo">
      <span class="vtryon__upload-icon" id="vtryon-upload-icon" aria-hidden="true">
        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5">
          <path stroke-linecap="round" stroke-linejoin="round" d="M3 16.5v2.25A2.25 2.25 0 0 0 5.25 21h13.5A2.25 2.25 0 0 0 21 18.75V16.5m-13.5-9L12 3m0 0 4.5 4.5M12 3v13.5" />
        </svg>
      </span>
      <img
        id="vtryon-preview"
        class="vtryon__preview"
        alt="{{ product.title | escape }}"
        style="display:none;"
        width="40"
        height="40"
      >
      <span class="vtryon__upload-text" id="vtryon-upload-text">{{ 'sections.virtual_tryon.upload_label' | t }}</span>
      <input
        type="file"
        id="virtual-tryon-user-photo"
        accept="image/*"
        class="vtryon__file-input"
        aria-label="{{ 'sections.virtual_tryon.upload_aria' | t }}"
      >
    </label>

    <label class="vtryon__consent" for="vtryon-consent-check">
      <input type="checkbox" id="vtryon-consent-check" class="vtryon__consent-input" checked>
      <span class="vtryon__consent-text">{{ 'sections.virtual_tryon.consent_text' | t }}</span>
    </label>

    <button id="virtual-tryon-btn" class="vtryon__btn" disabled>{{ 'sections.virtual_tryon.button_label' | t }}</button>

    <div id="virtual-tryon-error" class="vtryon__error" role="alert" aria-live="assertive" aria-atomic="true"></div>

    <div id="virtual-tryon-loading" class="vtryon__loading" style="display:none;" role="status" aria-live="polite">
      <div class="vtryon__spinner" aria-hidden="true"></div>
      <p class="vtryon__status">{{ 'sections.virtual_tryon.loading_title' | t }}</p>
      <p class="vtryon__loading-sub">{{ 'sections.virtual_tryon.loading_subtitle' | t }}</p>
    </div>

    <div id="virtual-tryon-result" class="vtryon__result" style="display:none;">
      <p class="vtryon__result-label">{{ 'sections.virtual_tryon.result_label' | t }}</p>
      <img
        id="virtual-tryon-result-img"
        alt="{{ 'sections.virtual_tryon.result_label' | t }}"
        class="vtryon__result-img"
        width="768"
        height="1024"
      >
    </div>
  {% endunless %}
</div>

{% stylesheet %}
  .vtryon {
    padding: 1.5rem;
    background: rgba(var(--color-foreground, 15, 23, 42), 0.04);
    border-radius: 16px;
    border: 1px solid rgba(var(--color-foreground, 15, 23, 42), 0.12);
    margin-top: 1.5rem;
    color: rgb(var(--color-foreground, 15, 23, 42));
  }

  /* On the immersive page (dark background), keep the glass look */
  .template-page-immersive .vtryon {
    background: rgba(15, 23, 42, 0.6);
    backdrop-filter: blur(12px);
    -webkit-backdrop-filter: blur(12px);
    border: 1px solid rgba(212, 175, 55, 0.2);
    color: #d4af37;
  }

  .vtryon__header {
    display: flex;
    align-items: center;
    gap: 0.6rem;
    margin-bottom: 0.4rem;
  }

  .vtryon__icon {
    width: 20px;
    height: 20px;
    color: #d4af37;
    flex-shrink: 0;
  }

  .vtryon__title {
    margin: 0;
    font-size: 1rem;
    font-weight: 600;
    color: #d4af37;
    text-transform: uppercase;
    letter-spacing: 0.08em;
    flex: 1;
  }

  .vtryon__quota-badge {
    font-size: 0.72rem;
    color: rgba(212, 175, 55, 0.6);
    border: 1px solid rgba(212, 175, 55, 0.2);
    border-radius: 999px;
    padding: 0.15rem 0.55rem;
    white-space: nowrap;
  }

  /* Login gate */
  .vtryon__gate {
    text-align: center;
    padding: 1.25rem 0.5rem;
  }

  .vtryon__gate-icon {
    width: 32px;
    height: 32px;
    color: rgba(212, 175, 55, 0.5);
    margin: 0 auto 0.75rem;
    display: block;
  }

  .vtryon__gate-title {
    margin: 0 0 0.4rem;
    font-size: 0.95rem;
    font-weight: 600;
    color: #d4af37;
  }

  .vtryon__gate-sub {
    margin: 0 0 1.1rem;
    font-size: 0.78rem;
    color: rgba(212, 175, 55, 0.55);
    line-height: 1.5;
  }

  .vtryon__gate-btn {
    display: inline-block;
    padding: 0.6rem 1.4rem;
    background: rgba(212, 175, 55, 0.12);
    border: 1px solid rgba(212, 175, 55, 0.4);
    border-radius: 999px;
    color: #d4af37;
    font-size: 0.85rem;
    font-weight: 600;
    text-decoration: none;
    transition: background 0.2s, border-color 0.2s;
  }

  .vtryon__gate-btn:hover {
    background: rgba(212, 175, 55, 0.22);
    border-color: rgba(212, 175, 55, 0.7);
    color: #d4af37;
  }

  .vtryon__gate-btn:focus-visible {
    outline: 2px solid #d4af37;
    outline-offset: 3px;
  }

  .vtryon__subtitle {
    margin: 0 0 1.25rem;
    font-size: 0.8rem;
    color: rgba(212, 175, 55, 0.6);
    line-height: 1.5;
  }

  /* Upload area */
  .vtryon__upload-label {
    display: flex;
    align-items: center;
    gap: 0.75rem;
    padding: 0.85rem 1rem;
    background: rgba(212, 175, 55, 0.05);
    border: 1px dashed rgba(212, 175, 55, 0.3);
    border-radius: 10px;
    cursor: pointer;
    transition: background 0.2s, border-color 0.2s;
    margin-bottom: 0.75rem;
  }

  .vtryon__upload-label:hover {
    background: rgba(212, 175, 55, 0.1);
    border-color: rgba(212, 175, 55, 0.5);
  }

  .vtryon__upload-label:focus-within {
    border-color: #d4af37;
    box-shadow: 0 0 0 2px rgba(212, 175, 55, 0.2);
  }

  .vtryon__upload-icon svg {
    width: 18px;
    height: 18px;
    color: #d4af37;
  }

  .vtryon__upload-text {
    font-size: 0.85rem;
    color: rgba(212, 175, 55, 0.8);
    white-space: nowrap;
    overflow: hidden;
    text-overflow: ellipsis;
    flex: 1;
  }

  .vtryon__preview {
    width: 40px;
    height: 40px;
    border-radius: 6px;
    object-fit: cover;
    border: 1px solid rgba(212, 175, 55, 0.3);
    flex-shrink: 0;
  }

  .vtryon__file-input {
    display: none;
  }

  /* Marketing consent */
  .vtryon__consent {
    display: flex;
    align-items: flex-start;
    gap: 0.5rem;
    margin-bottom: 0.9rem;
    cursor: pointer;
  }

  .vtryon__consent-input {
    margin-top: 2px;
    accent-color: #d4af37;
    flex-shrink: 0;
  }

  .vtryon__consent-input:focus-visible {
    outline: 2px solid #d4af37;
    outline-offset: 2px;
    border-radius: 2px;
  }

  .vtryon__consent-text {
    font-size: 0.75rem;
    color: rgba(212, 175, 55, 0.55);
    line-height: 1.4;
  }

  /* Button */
  .vtryon__btn {
    width: 100%;
    padding: 0.8rem 1rem;
    background: rgba(212, 175, 55, 0.1);
    border: 1px solid rgba(212, 175, 55, 0.4);
    border-radius: 10px;
    color: #d4af37;
    font-size: 0.9rem;
    font-weight: 600;
    letter-spacing: 0.04em;
    cursor: pointer;
    transition: background 0.2s, border-color 0.2s, opacity 0.2s;
  }

  .vtryon__btn:hover:not(:disabled) {
    background: rgba(212, 175, 55, 0.2);
    border-color: rgba(212, 175, 55, 0.7);
  }

  .vtryon__btn:focus-visible {
    outline: 2px solid #d4af37;
    outline-offset: 3px;
  }

  .vtryon__btn:disabled {
    opacity: 0.35;
    cursor: not-allowed;
  }

  /* Error */
  .vtryon__error {
    margin-top: 1rem;
    padding: 0.75rem 1rem;
    background: rgba(220, 38, 38, 0.15);
    border: 1px solid rgba(220, 38, 38, 0.35);
    border-radius: 8px;
    font-size: 0.82rem;
    color: #fca5a5;
    line-height: 1.5;
  }

  .vtryon__error:empty {
    display: none;
  }

  /* Loading */
  .vtryon__loading {
    margin-top: 1.25rem;
    text-align: center;
    padding: 1rem 0;
  }

  .vtryon__loading p {
    margin: 0.25rem 0 0;
    font-size: 0.88rem;
    color: rgba(212, 175, 55, 0.85);
  }

  .vtryon__status {
    margin: 0.25rem 0 0;
    font-size: 0.88rem;
    color: rgba(212, 175, 55, 0.85);
    min-height: 1.3em;
  }

  .vtryon__loading-sub {
    font-size: 0.75rem !important;
    color: rgba(212, 175, 55, 0.45) !important;
  }

  .vtryon__spinner {
    width: 32px;
    height: 32px;
    border: 2px solid rgba(212, 175, 55, 0.15);
    border-top-color: #d4af37;
    border-radius: 50%;
    animation: vtryon-spin 0.8s linear infinite;
    margin: 0 auto 0.75rem;
  }

  @keyframes vtryon-spin {
    to {
      transform: rotate(360deg);
    }
  }

  /* Result */
  .vtryon__result {
    margin-top: 1.25rem;
  }

  .vtryon__result-label {
    margin: 0 0 0.75rem;
    font-size: 0.78rem;
    text-transform: uppercase;
    letter-spacing: 0.08em;
    color: rgba(212, 175, 55, 0.55);
  }

  .vtryon__result-img {
    width: 100%;
    border-radius: 10px;
    border: 1px solid rgba(212, 175, 55, 0.2);
    display: block;
  }
{% endstylesheet %}
