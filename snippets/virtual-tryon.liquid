{% doc %}
  Renders a virtual try-on UI for product pages.

  Frontend responsibilities:
  - Capture the customer's photo via file input
  - Read basic product metadata (title, description) and product image URL
  - POST this data to a Vercel /api/tryon endpoint
  - Display the returned image URL from the backend

  Backend responsibilities (in /api/tryon):
  - Accept JSON such as:
      {
        "user_image_base64": "<data URL or raw base64>",
        "product_image_base64": "<data URL or raw base64>",
        "product_title": "<string>",
        "product_description": "<string>"
      }
  - Use /lib helpers for CORS, image processing, caching, rate limiting, and MiniMax calls
  - Return:
      {
        "success": true,
        "image_url": "<final image URL>"
      }
{% enddoc %}

<div
  class="virtual-tryon-container"
  id="virtual-tryon-container"
  data-product-title="{{ product.title | escape }}"
  data-product-description="{{ product.description | strip_html | escape | truncate: 200 }}"
  data-product-image-url="{{ product.featured_image | image_url: width: 1024 }}"
>
  <h3>Virtual Try-On</h3>
  
  <div class="tryon-upload">
    <label for="virtual-tryon-user-photo">Upload your photo:</label>
    <input type="file" id="virtual-tryon-user-photo" accept="image/*" />
  </div>
  
  <button id="virtual-tryon-btn" class="btn btn-primary" disabled>
    Try this item on
  </button>
  
  <div id="virtual-tryon-result" style="display: none;">
    <h4>Your virtual try-on</h4>
    <img
      id="virtual-tryon-result-img"
      alt="Virtual try-on result"
      width="600"
      height="900"
      hidden
    />
    </div>
  <div id="virtual-tryon-loading" style="display: none;">
    <p>Generating your look...</p>
  </div>

</div>


{% stylesheet %}
.virtual-tryon-container {
  padding: 20px;
  border: 1px solid #eee;
  border-radius: 8px;
  margin-top: 20px;
}

.virtual-tryon-container h3 {
  margin-top: 0;
}

.tryon-upload {
  margin-bottom: 15px;
}

virtual-tryon-result-img {
  max-width: 100%;
  border-radius: 8px;
  margin-top: 10px;
}

virtual-tryon-loading {
  text-align: center;
  padding: 20px;
}
{% endstylesheet %}