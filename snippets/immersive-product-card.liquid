{% doc %}
  Renders a product card used inside the immersive store experience.

  @param {product} product - The product to render

  @example
  {% render 'immersive-product-card', product: product %}
{% enddoc %}

<article class="immersive-product-card" data-product-id="{{ product.id }}">
  {%- if product.featured_image -%}
    <a
      href="{{ product.url }}"
      class="immersive-product-link"
      aria-label="{{ 'sections.immersive.product_card.view_product' | t: title: product.title | escape }}"
    >
      <img
        class="immersive-product-image"
        src="{{ product.featured_image | image_url: width: 600 }}"
        srcset="{{ product.featured_image | image_url: width: 300 }} 300w,
                {{ product.featured_image | image_url: width: 600 }} 600w,
                {{ product.featured_image | image_url: width: 900 }} 900w"
        sizes="(max-width: 768px) 100vw, 300px"
        alt="{{ product.featured_image.alt | default: product.title | escape }}"
        loading="lazy"
        width="600"
        height="800"
      >

      {%- if product.images[1] -%}
        <img
          class="immersive-product-image-hover"
          src="{{ product.images[1] | image_url: width: 600 }}"
          alt="{{ product.images[1].alt | default: product.title | escape }}"
          loading="lazy"
          width="600"
          height="800"
        >
      {%- endif -%}
    </a>
  {%- else -%}
    <div class="immersive-product-image immersive-product-image-placeholder">
      {{ 'products.product.no_image' | t }}
    </div>
  {%- endif -%}

  <div class="immersive-product-info">
    {%- if product.vendor != blank -%}
      <div class="immersive-product-vendor">
        {{ product.vendor }}
      </div>
    {%- endif -%}

    <h3 class="immersive-product-title">
      <a href="{{ product.url }}" class="immersive-product-title-link">
        {{ product.title }}
      </a>
    </h3>

    {%- if product.metafields.custom.short_description != blank -%}
      <p class="immersive-product-description">
        {{ product.metafields.custom.short_description | truncate: 80 }}
      </p>
    {%- endif -%}

    <div class="immersive-product-price">
      {%- if product.compare_at_price > product.price -%}
        <span class="immersive-product-price-compare">
          {{ product.compare_at_price | money }}
        </span>
        <span class="immersive-product-price-sale">
          {{ product.price | money }}
        </span>
      {%- elsif product.price_varies -%}
        <span>
          {{ 'products.product.from_text' | t }} {{ product.price_min | money }}
        </span>
      {%- else -%}
        <span>{{ product.price | money }}</span>
      {%- endif -%}
    </div>

    {%- if product.available -%}
      <form method="post" action=" {{ routes.cart_add_url }}" class="immersive-product-form" data-product-form>
        {%- if product.variants.size > 1 -%}
          <label class="visually-hidden" for="immersive-variant-select-{{ product.id }}">
            {{ 'sections.immersive.product_card.select_variant' | t }}
          </label>
          <select
            id="immersive-variant-select-{{ product.id }}"
            name="id"
            class="immersive-variant-select"
          >
            {%- for variant in product.variants -%}
              <option
                value="{{ variant.id }}"
                {% unless variant.available %}disabled{% endunless %}
                data-price="{{ variant.price | money }}"
              >
                {{ variant.title }}
                {%- unless variant.available -%}
                  – {{ 'products.product.sold_out' | t }}
                {%- endunless -%}
                – {{ variant.price | money }}
              </option>
            {%- endfor -%}
          </select>
        {%- else -%}
          <input type="hidden" name="id" value="{{ product.selected_or_first_available_variant.id }}">
        {%- endif -%}

        <button
          type="submit"
          class="immersive-add-to-cart"
          {% unless product.selected_or_first_available_variant.available %}disabled{% endunless %}
          aria-label="{{ 'sections.immersive.product_card.add_to_cart_aria' | t: title: product.title | escape }}"
        >
          {%- if product.selected_or_first_available_variant.available -%}
            {{ 'products.product.add_to_cart' | t }}
          {%- else -%}
            {{ 'products.product.sold_out' | t }}
          {%- endif -%}
        </button>
      </form>
    {%- else -%}
      <button
        class="immersive-add-to-cart immersive-add-to-cart--disabled"
        disabled
        aria-label="{{ 'sections.immersive.product_card.unavailable_aria' | t }}"
      >
        {{ 'products.product.sold_out' | t }}
      </button>
    {%- endif -%}

    {%- if product.tags contains 'new' -%}
      <div class="immersive-product-badge">
        {{ 'sections.immersive.product_card.badge_new' | t }}
      </div>
    {%- endif -%}
  </div>
</article>

{% stylesheet %}
  .immersive-product-card {
    position: relative;
  }

  .immersive-product-link {
    position: relative;
    display: block;
    overflow: hidden;
  }

  .immersive-product-image-hover {
    position: absolute;
    inset: 0;
    opacity: 0;
    transition: opacity 0.3s ease;
  }

  .immersive-product-card:hover .immersive-product-image-hover {
    opacity: 1;
  }

  .immersive-product-image-placeholder {
    background: rgba(255, 255, 255, 0.05);
    display: flex;
    align-items: center;
    justify-content: center;
    color: rgba(255, 255, 255, 0.3);
    font-size: 12px;
  }

  .immersive-product-info {
    position: relative;
  }

  .immersive-product-vendor {
    font-size: 11px;
    color: rgba(212, 175, 55, 0.8);
    text-transform: uppercase;
    letter-spacing: 1px;
    margin-bottom: 6px;
  }

  .immersive-product-title {
    margin: 0;
  }

  .immersive-product-title-link {
    color: inherit;
    text-decoration: none;
  }

  .immersive-product-description {
    font-size: 12px;
    color: rgba(255, 255, 255, 0.6);
    margin: 8px 0;
    line-height: 1.4;
  }

  .immersive-product-price {
    font-size: 14px;
  }

  .immersive-product-price-compare {
    text-decoration: line-through;
    opacity: 0.5;
    margin-right: 8px;
  }

  .immersive-product-price-sale {
    color: #ff6b6b;
  }

  .immersive-product-form {
    margin-top: 8px;
  }

  .immersive-variant-select {
    width: 100%;
    padding: 8px;
    margin-bottom: 12px;
    background: rgba(255, 255, 255, 0.1);
    border: 1px solid rgba(212, 175, 55, 0.3);
    color: #ffffff;
    border-radius: 4px;
    font-size: 12px;
    cursor: pointer;
  }

  .immersive-variant-select:focus {
    outline: 2px solid #d4af37;
    outline-offset: 2px;
  }

  .immersive-variant-select option:disabled {
    color: rgba(255, 255, 255, 0.3);
  }

  .immersive-add-to-cart {
    width: 100%;
    padding: 10px 14px;
    font-size: 12px;
    border-radius: 4px;
    border: none;
    cursor: pointer;
  }

  .immersive-add-to-cart--disabled {
    opacity: 0.5;
    cursor: not-allowed;
  }

  .immersive-product-badge {
    position: absolute;
    top: 12px;
    right: 12px;
    background: linear-gradient(135deg, #d4af37 0%, #f4e5a1 100%);
    color: #000000;
    padding: 4px 12px;
    border-radius: 12px;
    font-size: 10px;
    font-weight: 700;
    letter-spacing: 1px;
  }
{% endstylesheet %}