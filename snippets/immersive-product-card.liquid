{% doc %}
  Renders a product card used inside the immersive store experience.
  Renders the immersive product card payment button.

  @param {product} product - The product to be rendered
  @param {boolean} [show_vendor] - Show the product vendor. Default: true
  @param {boolean} [show_secondary_image] - Show second image on hover. Default: true
  @param {form} [form] - Product form object; snippet must be used inside a product form or passed an explicit form.
  @param {collection} [collection] - Optional originating collection object for back-navigation context.
  @param {string} [collection_handle] - Optional originating collection handle (used when collection object is unavailable).

  @example
  {% render 'immersive-product-card', product: product %}
  {% render 'immersive-product-card', product: product, collection: collection %}
{% enddoc %}

{%- liquid
  assign collection_handle_resolved = ''
  if collection_handle != blank
    assign collection_handle_resolved = collection_handle
  elsif collection != blank
    assign collection_handle_resolved = collection.handle
  endif
-%}

<article
  class="immersive-product-card"
  data-product-id="{{ product.id }}"
  data-product-handle="{{ product.handle }}"
  {%- if collection_handle_resolved != blank -%}
    data-collection-handle="{{ collection_handle_resolved | escape }}"
  {%- endif -%}
>
  {%- if product.featured_image -%}
    <a
      href="{{ product.url }}"
      class="immersive-product-link"
      data-product-handle="{{ product.handle }}"
      aria-label="{{ 'sections.immersive.product_card.view_product' | t: title: product.title | escape }}"
    >
      <div data-parallax-container data-parallax-intensity="12">
        <img
          class="immersive-product-image"
          src="{{ product.featured_image | image_url: width: 600 }}"
          srcset="
            {{ product.featured_image | image_url: width: 300 }} 300w,
            {{ product.featured_image | image_url: width: 600 }} 600w,
            {{ product.featured_image | image_url: width: 900 }} 900w
          "
          sizes="(max-width: 768px) 100vw, 300px"
          alt="{{ product.featured_image.alt | default: product.title | escape }}"
          loading="lazy"
          width="600"
          height="800"
          data-parallax-image
        >

        {%- if product.images[1] and show_secondary_image != false -%}
          <img
            class="immersive-product-image-hover"
            src="{{ product.images[1] | image_url: width: 600 }}"
            alt="{{ product.images[1].alt | default: product.title | escape }}"
            loading="lazy"
            width="600"
            height="800"
            data-parallax-image
          >
        {%- endif -%}
      </div>
    </a>
    <button
      type="button"
      class="immersive-product-card__wishlist-toggle"
      data-wishlist-toggle
      data-product-handle="{{ product.handle }}"
      aria-pressed="false"
      aria-label="{{ 'sections.immersive_store.wishlist.save' | t: title: product.title | escape }}"
      data-label-save="{{ 'sections.immersive_store.wishlist.save' | t: title: product.title | escape }}"
      data-label-saved="{{ 'sections.immersive_store.wishlist.saved' | t: title: product.title | escape }}"
    >
      <svg
        class="immersive-product-card__heart immersive-product-card__heart--outline"
        xmlns="http://www.w3.org/2000/svg"
        width="16"
        height="16"
        viewBox="0 0 24 24"
        fill="none"
        stroke="currentColor"
        stroke-width="2"
        stroke-linecap="round"
        stroke-linejoin="round"
        aria-hidden="true"
      >
        <path d="M20.84 4.61a5.5 5.5 0 0 0-7.78 0L12 5.67l-1.06-1.06a5.5 5.5 0 0 0-7.78 7.78l1.06 1.06L12 21.23l7.78-7.78 1.06-1.06a5.5 5.5 0 0 0 0-7.78z"></path>
      </svg>
      <svg
        class="immersive-product-card__heart immersive-product-card__heart--filled"
        xmlns="http://www.w3.org/2000/svg"
        width="16"
        height="16"
        viewBox="0 0 24 24"
        fill="currentColor"
        stroke="currentColor"
        stroke-width="2"
        stroke-linecap="round"
        stroke-linejoin="round"
        aria-hidden="true"
      >
        <path d="M20.84 4.61a5.5 5.5 0 0 0-7.78 0L12 5.67l-1.06-1.06a5.5 5.5 0 0 0-7.78 7.78l1.06 1.06L12 21.23l7.78-7.78 1.06-1.06a5.5 5.5 0 0 0 0-7.78z"></path>
      </svg>
    </button>
  {%- else -%}
    <div class="immersive-product-image immersive-product-image-placeholder">
      {{ 'products.product.no_image' | t }}
    </div>
  {%- endif -%}

  <div class="immersive-product-info">
    {%- if product.vendor != blank and show_vendor != false -%}
      <div class="immersive-product-vendor">
        {{ product.vendor }}
      </div>
    {%- endif -%}

    <h3 class="immersive-product-title">
      <a
        href="{{ product.url }}"
        class="immersive-product-title-link"
        data-product-handle="{{ product.handle }}"
      >
        {{ product.title }}
      </a>
    </h3>

    {%- if product.metafields.custom.short_description != blank -%}
      <p class="immersive-product-description">
        {{ product.metafields.custom.short_description | truncate: 80 }}
      </p>
    {%- endif -%}

    <div class="immersive-product-price">
      {%- if product.compare_at_price_max > product.price_min -%}
        <span class="immersive-product-price-compare">
          {{ product.compare_at_price_max | money }}
        </span>
        <span class="immersive-product-price-sale">
          {{ product.price_min | money }}
        </span>
      {%- elsif product.price_varies -%}
        <span>
          {{ 'products.product.from_text' | t }}
          {{ product.price_min | money }}
        </span>
      {%- else -%}
        <span>{{ product.price_min | money }}</span>
      {%- endif -%}
    </div>

    {%- if product.available -%}
      <form method="post" action="{{ routes.cart_add_url }}" class="immersive-product-form" data-product-form>
        {%- if product.variants.size > 1 -%}
          <div
            class="immersive-variant-buttons"
            role="radiogroup"
            aria-label="{{ 'sections.immersive.product_card.select_variant' | t }}"
          >
            {%- for variant in product.variants -%}
              <button
                type="button"
                role="radio"
                class="immersive-variant-button"
                data-variant-id="{{ variant.id }}"
                data-available="{{ variant.available }}"
                aria-checked="{% if forloop.first %}true{% else %}false{% endif %}"
                aria-label="{{ variant.title }}"
                {% unless variant.available %}
                  disabled
                {% endunless %}
              >
                {{ variant.title | split: ' / ' | first }}
              </button>
            {%- endfor -%}
          </div>
          <input
            type="hidden"
            name="id"
            class="immersive-variant-input"
            value="{{ product.selected_or_first_available_variant.id }}"
          >
        {%- else -%}
          <input type="hidden" name="id" value="{{ product.selected_or_first_available_variant.id }}">
        {%- endif -%}

        <button
          type="submit"
          name="add"
          class="immersive-add-to-cart"
          {% unless product.selected_or_first_available_variant.available %}
            disabled
          {% endunless %}
          aria-label="{{ 'sections.immersive_store.add_to_edit' | t }} - {{ product.title | escape }}"
        >
          {%- if product.selected_or_first_available_variant.available -%}
            {{ 'sections.immersive_store.add_to_edit' | t }}
          {%- else -%}
            {{ 'products.product.sold_out' | t }}
          {%- endif -%}
        </button>
        {%- if form -%}
          {{ form | payment_button }}
        {%- endif -%}
      </form>
    {%- else -%}
      <button
        class="immersive-add-to-cart immersive-add-to-cart--disabled"
        disabled
        aria-label="{{ 'sections.immersive.product_card.unavailable_aria' | t }}"
      >
        {{ 'products.product.sold_out' | t }}
      </button>
    {%- endif -%}

    {%- if product.tags contains 'new' -%}
      <div class="immersive-product-badge">
        {{ 'sections.immersive.product_card.badge_new' | t }}
      </div>
    {%- endif -%}
  </div>
</article>

{% stylesheet %}
  .immersive-product-card {
    position: relative;
    background: rgba(15, 23, 42, 0.6);
    backdrop-filter: blur(12px);
    -webkit-backdrop-filter: blur(12px);
    border-radius: 16px;
    border: 1px solid rgba(255, 255, 255, 0.1);
    overflow: hidden;
    transition: transform 0.3s ease, box-shadow 0.3s ease, border-color 0.3s ease;
  }

  .immersive-product-card:hover {
    transform: translateY(-4px);
    box-shadow: 0 12px 40px rgba(212, 175, 55, 0.2);
    border-color: rgba(212, 175, 55, 0.3);
  }

  .immersive-product-link {
    position: relative;
    display: block;
    overflow: hidden;
    text-decoration: none;
    aspect-ratio: 2 / 3;
    width: 100%;
  }

  .immersive-product-image {
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: center;
    display: block;
    transition: transform 0.1s ease-out, opacity 0.3s ease;
    will-change: transform;
  }

  .immersive-product-image-hover {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: center;
    opacity: 0;
    transition: transform 0.1s ease-out, opacity 0.3s ease;
    will-change: transform;
  }

  .immersive-product-card:hover .immersive-product-image-hover {
    opacity: 1;
  }

  .immersive-product-image-placeholder {
    background: rgba(255, 255, 255, 0.05);
    display: flex;
    align-items: center;
    justify-content: center;
    color: rgba(255, 255, 255, 0.3);
    font-size: 12px;
  }

  .immersive-product-info {
    position: relative;
    padding: 1.25rem;
  }

  .immersive-product-vendor {
    font-size: 0.75rem;
    color: rgba(212, 175, 55, 0.9);
    text-transform: uppercase;
    letter-spacing: 0.08em;
    margin-bottom: 0.5rem;
    font-weight: 600;
  }

  .immersive-product-title {
    margin: 0 0 0.5rem;
    font-size: 1rem;
    font-weight: 600;
    color: #d4af37;
    line-height: 1.4;
  }

  .immersive-product-title-link {
    border: none;
    padding: 0;
    background: transparent;
    color: inherit;
    text-decoration: none;
    text-align: left;
    cursor: pointer;
    transition: color 0.2s ease;
    display: block;
  }

  .immersive-product-title-link:hover {
    color: rgba(212, 175, 55, 1);
  }

  .immersive-product-description {
    font-size: 0.875rem;
    color: rgba(249, 250, 251, 0.7);
    margin: 0.5rem 0;
    line-height: 1.5;
  }

  .immersive-product-price {
    font-size: 1.125rem;
    font-weight: 600;
    color: #d4af37;
  }

  .immersive-product-price-compare {
    text-decoration: line-through;
    opacity: 0.5;
    margin-right: 0.5rem;
    font-size: 1rem;
  }

  .immersive-product-price-sale {
    color: #ff6b6b;
  }

  .immersive-product-form {
    margin-top: 1rem;
  }

  .immersive-variant-buttons {
    display: flex;
    flex-wrap: wrap;
    gap: 0.5rem;
    margin-bottom: 0.75rem;
  }

  .immersive-variant-button {
    padding: 0.5rem 1rem;
    background: rgba(255, 255, 255, 0.1);
    border: 1px solid rgba(212, 175, 55, 0.3);
    color: #d4af37;
    border-radius: 8px;
    font-size: 0.875rem;
    cursor: pointer;
    transition: border-color 0.2s ease, background-color 0.2s ease, transform 0.2s ease;
    backdrop-filter: blur(8px);
    -webkit-backdrop-filter: blur(8px);
  }

  .immersive-variant-button:hover:not(:disabled) {
    background: rgba(255, 255, 255, 0.15);
    border-color: rgba(212, 175, 55, 0.5);
    transform: translateY(-1px);
  }

  .immersive-variant-button:focus {
    outline: 2px solid #d4af37;
    outline-offset: 2px;
  }

  .immersive-variant-button.active {
    border: 2px solid #d4af37;
    background: rgba(212, 175, 55, 0.2);
  }

  .immersive-variant-button:disabled {
    opacity: 0.5;
    cursor: not-allowed;
  }

  .immersive-variant-input {
    display: none;
  }

  .immersive-add-to-cart {
    width: 100%;
    padding: 10px 14px;
    font-size: 12px;
    border-radius: 4px;
    border: 1px solid rgba(212, 175, 55, 0.5);
    cursor: pointer;
    background: rgba(212, 175, 55, 0.15);
    backdrop-filter: blur(8px);
    -webkit-backdrop-filter: blur(8px);
    color: #d4af37;
    font-weight: 600;
    transition: background 0.2s ease, transform 0.2s ease;
  }

  .immersive-add-to-cart:hover:not(:disabled) {
    background: rgba(212, 175, 55, 0.3);
    transform: translateY(-1px);
  }

  .immersive-add-to-cart--disabled {
    opacity: 0.5;
    cursor: not-allowed;
  }

  /* Accelerated checkout buttons (Shop Pay, Apple Pay, etc.) */
  .immersive-product-form .shopify-payment-button {
    margin-top: 0.5rem;
  }

  .immersive-product-form .shopify-payment-button__button {
    border-radius: 4px;
    min-height: 36px;
    font-size: 12px;
  }

  .immersive-product-form .shopify-payment-button__button--unbranded {
    background: rgba(212, 175, 55, 0.9);
    color: #000;
    font-weight: 600;
  }

  .immersive-product-form .shopify-payment-button__button--unbranded:hover {
    background: #d4af37;
  }

  .immersive-product-badge {
    position: absolute;
    top: 12px;
    right: 12px;
    background: linear-gradient(135deg, #d4af37 0%, #f4e5a1 100%);
    color: #000000;
    padding: 4px 12px;
    border-radius: 12px;
    font-size: 10px;
    font-weight: 700;
    letter-spacing: 1px;
  }

  @media (prefers-reduced-motion: reduce) {
    .immersive-product-card,
    .immersive-product-image,
    .immersive-product-image-hover,
    .immersive-variant-button {
      transform: none !important;
      transition: none !important;
      animation: none !important;
    }
  }

  /* ── Wishlist Toggle (card) ───────────────────────────── */
  .immersive-product-card__wishlist-toggle {
    position: absolute;
    top: 0.5rem;
    right: 0.5rem;
    width: 32px;
    height: 32px;
    background: rgba(10, 15, 30, 0.7);
    border: 1px solid rgba(212, 175, 55, 0.3);
    border-radius: 50%;
    display: flex;
    align-items: center;
    justify-content: center;
    cursor: pointer;
    padding: 0;
    transition: background 0.2s, border-color 0.2s, transform 0.15s;
    z-index: 2;
    color: #d4af37;
  }

  .immersive-product-card__wishlist-toggle:hover {
    background: rgba(212, 175, 55, 0.15);
    border-color: rgba(212, 175, 55, 0.6);
    transform: scale(1.1);
  }

  .immersive-product-card__wishlist-toggle:focus-visible {
    outline: 2px solid #d4af37;
    outline-offset: 2px;
  }

  .immersive-product-card__heart--filled {
    display: none;
  }

  .immersive-product-card__wishlist-toggle.is-saved .immersive-product-card__heart--outline {
    display: none;
  }

  .immersive-product-card__wishlist-toggle.is-saved .immersive-product-card__heart--filled {
    display: block;
  }

  @media (prefers-reduced-motion: reduce) {
    .immersive-product-card__wishlist-toggle {
      transition: none !important;
      transform: none !important;
    }
  }
{% endstylesheet %}
