{
  "enabled": true,
  "name": "Sync Docs on Source Change",
  "description": "When any source file (Liquid templates, JS, CSS, or JSON config/locale files) changes, ask the agent to update README.md or IMMERSIVE-STORE.md to reflect the changes.",
  "version": "1",
  "when": {
    "type": "fileEdited",
    "patterns": [
      "**/*.liquid",
      "**/*.js",
      "**/*.css",
      "locales/**/*.json",
      "config/settings_schema.json"
    ]
  },
  "then": {
    "type": "askAgent",
    "prompt": "A source file was just edited. Review the change and determine if README.md or IMMERSIVE-STORE.md need to be updated to reflect it. Update only the relevant sections — do not rewrite the entire doc. If no documentation update is needed, do nothing."
  }
}