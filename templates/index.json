{
  "sections": {
    "slideshow_banner": {
      "type": "slideshow",
      "settings": {
        "slide_height": "medium",
        "slide_height_mobile": "small",
        "slider_visual": "dots",
        "color_scheme": "scheme-1",
        "auto_rotate": true,
        "change_slides_speed": 5,
        "image_behavior": "ambient",
        "mobile_text_box_position": "bottom-left",
        "padding_top": 0,
        "padding_bottom": 0
      },
      "blocks": {
        "slide_1": {
          "type": "slide",
          "settings": {
            "image": "shopify://shop_images/SBS-Summer-Pret-26.webp",
            "mobile_image": "shopify://shop_images/SBS-Summer-Pret-26.webp",
            "heading": "Summer Collection 2026",
            "heading_size": "h1",
            "subheading": "Discover our latest luxury pret collection",
            "button_label": "Shop Now",
            "link": "shopify://collections/all",
            "button_style": "button",
            "text_alignment": "center",
            "text_color": "#ffffff",
            "overlay_opacity": 30
          }
        },
        "slide_2": {
          "type": "slide",
          "settings": {
            "image": "shopify://shop_images/suffuse_casual_pret_2026_1_f07d568f-3373-40bd-b02f-9f38fcc7d515.webp",
