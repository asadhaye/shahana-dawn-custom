            "link": "shopify://collections/suffuse",
            "button_style": "button",
            "text_alignment": "center",
            "text_color": "#ffffff",
            "overlay_opacity": 30
          }
        }
      },
      "block_order": [
        "slide_1",
        "slide_2"
      ]
    },
