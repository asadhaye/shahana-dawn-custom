    "editorial_occasions": {
      "type": "immersive-editorial",
      "blocks": {
        "occasion_eid": {
          "type": "occasion_card",
          "settings": {
            "heading": "Eid Collection",
            "body": "<p>Celebrate in colour. Our Eid edit brings together the finest embroidered lawns, silk kurtas, and festive separates for every gathering.</p>",
            "collection": "eid-collection",
            "cta_url": ""
          }
        },
        "occasion_bridal": {
          "type": "occasion_card",
          "settings": {
            "heading": "Bridal & Mehndi",
            "body": "<p>From the mehndi morning to the walima evening — a complete bridal wardrobe curated for every ritual of the celebration.</p>",
            "collection": "bridal-mehndi",
            "cta_url": ""
          }
        },
        "occasion_formals": {
          "type": "occasion_card",
          "settings": {
            "heading": "Luxury Formals",
            "body": "<p>Dawat, nikah, and formal evenings call for something extraordinary. Discover heavily embellished pieces crafted for the moments that matter.</p>",
            "collection": "luxury-formals",
            "cta_url": ""
          }
        },
        "occasion_pret": {
          "type": "occasion_card",
          "settings": {
            "heading": "Casual Pret",
            "body": "<p>Effortless elegance for everyday. Our pret line brings the same quality and craft to your daily wardrobe.</p>",
            "collection": "casual-pret",
            "cta_url": ""
          }
        }
      },
      "block_order": [
        "occasion_eid",
        "occasion_bridal",
        "occasion_formals",
        "occasion_pret"
      ],
      "disabled": true,
      "settings": {
        "room_key": "occasions",
        "layout": "occasions",
        "hero_heading": "Dress the Occasion",
        "hero_eyebrow": "Curated for every moment",
        "hero_subheading": "<p>From intimate gatherings to grand celebrations — find the perfect expression for every chapter of your story.</p>"
      }
    },
    "editorial_featured_collections": {
      "type": "immersive-editorial",
      "blocks": {
        "featured_ss5": {
          "type": "featured_item",
          "settings": {
            "heading": "SS5 Summer Pret '26",
            "body": "<p>Saad Bin Shahzad's summer pret edit — lightweight fabrics, architectural cuts, and the quiet confidence of a house at its peak.</p>",
            "collection": "summer-pret-26-eid-edit-saad-bin-shahzad",
            "cta_url": ""
          }
        },
        "featured_suffuse_pret": {
          "type": "featured_item",
          "settings": {
            "heading": "Suffuse Luxury Pret",
            "body": "<p>The everyday elevated. Suffuse's luxury pret line brings signature embroidery and refined silhouettes to your daily wardrobe.</p>",
            "collection": "luxury-pret-suffuse",
            "cta_url": ""
          }
        },
        "featured_soraya_eid": {
          "type": "featured_item",
          "settings": {
            "heading": "Soraya Eid Pret",
            "body": "<p>Lumene Festive '25–'26 — Soraya's most celebrated seasonal collection, now available in the immersive store.</p>",
            "collection": "lumene-festive-25-26-soraya-official",
            "cta_url": ""
          }
        }
      },
      "block_order": [
        "featured_ss5",
        "featured_suffuse_pret",
        "featured_soraya_eid"
      ],
      "disabled": true,
