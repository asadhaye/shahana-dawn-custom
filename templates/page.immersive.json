    "immersive_story": {
      "type": "immersive-story-rail",
      "blocks": {
        "story_intro": {
          "type": "intro",
          "settings": {
            "eyebrow": "Origins",
            "heading": "From Lahore ateliers to London evenings",
            "body": "<p>Shahana Collection was born from a simple belief: that Pakistani luxury fashion deserves a stage as extraordinary as the craft itself. Each piece in our world carries the weight of generations — the embroiderer's patience, the weaver's precision, the designer's vision.</p>"
          }
        },
        "story_marquee": {
          "type": "marquee",
          "settings": {
            "marquee_text": "Craft · Heritage · Exclusives · Shahana Collection"
          }
        },
        "story_journey": {
          "type": "journey",
          "settings": {
            "eyebrow": "The journey",
            "heading": "Craft, ritual, and the garments that carry them",
            "body": "<p>From the first sketch in a Lahore atelier to the final stitch of zardozi, every Shahana piece passes through hands that have spent lifetimes perfecting their art. These are not garments — they are preserved rituals, worn at the moments that define us.</p>"
          }
        },
        "story_closing": {
          "type": "closing",
          "settings": {
            "eyebrow": "Enter the store",
            "heading": "Explore the collection",
            "body": "<p>Step into the immersive 3D store and discover the pieces that carry these stories.</p>",
            "cta_label": "Open the 3D Store",
            "cta_url": "/pages/immersive"
          }
        }
      },
