{
  "name": "dawn-tests",
  "version": "1.0.0",
  "description": "Property-based and unit tests for immersive store glass panel",
  "scripts": {
    "test": "jest --forceExit",
    "test:run": "jest --testPathPattern=glass-panel --forceExit",
    "lint:theme": "shopify theme check",
    "lint:js": "eslint assets/**/*.js",
    "lint": "npm run lint:theme && npm run lint:js",
    "build:immersive": "bash assets/build-immersive-bundle.sh"
  },
  "devDependencies": {
    "@shopify/prettier-plugin-liquid": "^1.10.2",
    "eslint": "^8.57.1",
    "fast-check": "^3.23.2",
    "jest": "^29.7.0",
    "jest-environment-jsdom": "^29.7.0",
    "prettier": "^3.8.3"
  },
  "jest": {
    "testEnvironment": "jsdom",
    "testMatch": [
      "**/tests/**/*.test.js"
    ]
  },
  "directories": {
    "doc": "docs",
    "test": "tests"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/asadhaye/shahana-dawn-custom.git"
  },
  "bugs": {
    "url": "https://github.com/asadhaye/shahana-dawn-custom/issues"
  },
  "homepage": "https://github.com/asadhaye/shahana-dawn-custom#readme",
  "license": "ISC",
  "threeJsVersion": "r150 (vendored as assets/three.min.js — cannot upgrade to r160+ which dropped script-tag builds)"
}
